// selfhost/formatter/format.intent — Phase 38 / ADR 0040 stage2 formatter.
//
// AST → canonical Intent source. Round-trips programs the stage2 parser
// understands: module + imports + functions + entities + enums + traits +
// impls + intent blocks + tests + externs, plus the statement and
// expression grammar Phases 34-37 already cover. The dogfood goal is
// byte-equality with stage1's `intentc fmt` on a small corpus — initially
// `examples/hello.intent`. Constructs the parser doesn't yet handle
// (requires/ensures contracts, async functions, pattern matching, etc.)
// are out of scope.
//
// Design notes:
//   - Decl order in the output: module → imports → functions → entities →
//     enums → traits → impls → intent_blocks → tests → externs. Stage2's
//     `Program` uses parallel arrays per kind (Phase 36), so the source
//     order across kinds is already lost — emitting in a fixed order is
//     the cleanest match to that. hello.intent's source order happens to
//     coincide.
//   - Parens are preserved as-written via `ex_paren`. Stage1's formatter
//     strips unnecessary parens; matching that exactly is a Phase 39
//     refinement.
//   - All emitters return Strings; the caller assembles them. No
//     stream/buffer abstraction yet — string concat is fine for hello.intent
//     scale.
module formatter_format version "0.1.0";

import "ast.intent";

// --- Indentation helpers ----------------------------------------------------
public function indent_string(level: Int) returns String {
    let mutable s: String = "";
    let mutable i: Int = 0;
    while i < level {
        s = s + "    ";
        i = i + 1;
    }
    return s;
}

// ADR 0044: format the leading-comments block for a top-level decl.
// Each comment is emitted on its own line; a trailing newline ensures the
// decl that follows starts on a fresh line. If no comments, returns "".
public function format_comments_before(cmts: Array<String>) returns String {
    if len(cmts) == 0 {
        return "";
    }
    let mutable s: String = "";
    let mutable i: Int = 0;
    while i < len(cmts) {
        s = s + cmts[i] + "\n";
        i = i + 1;
    }
    return s;
}

// --- Module + imports ------------------------------------------------------
public function format_module_decl(m: ModuleDecl) returns String {
    return "module " + m.name + " version \"" + m.module_version + "\";";
}

public function format_import_decl(imp: ImportDecl) returns String {
    if imp.is_package {
        return "import " + imp.path + ";";
    }
    return "import \"" + imp.path + "\";";
}

// --- Params ----------------------------------------------------------------
public function format_param(p: Param) returns String {
    return p.name + ": " + p.type_name;
}

public function format_param_list(ps: Array<Param>) returns String {
    let mutable s: String = "";
    let mutable i: Int = 0;
    while i < len(ps) {
        if i > 0 {
            s = s + ", ";
        }
        s = s + format_param(ps[i]);
        i = i + 1;
    }
    return s;
}

// --- Expressions -----------------------------------------------------------
// --- Precedence table (ADR 0043) -------------------------------------------
//
// Mirrors the Pratt parser in parser.intent. Higher numbers bind tighter.
// `min_precedence = 0` is the top-level context (no surrounding operator).
public function binop_precedence(op: String) returns Int {
    if op == "=" {
        return 1;
    }
    if op == "implies" {
        return 1;
    }
    if op == "or" {
        return 2;
    }
    if op == "and" {
        return 3;
    }
    if op == "==" {
        return 4;
    }
    if op == "!=" {
        return 4;
    }
    if op == "<" {
        return 5;
    }
    if op == "<=" {
        return 5;
    }
    if op == ">" {
        return 5;
    }
    if op == ">=" {
        return 5;
    }
    if op == "+" {
        return 7;
    }
    if op == "-" {
        return 7;
    }
    if op == "*" {
        return 8;
    }
    if op == "/" {
        return 8;
    }
    if op == "%" {
        return 8;
    }
    // Unknown operator — treat as primary so it doesn't accidentally trigger
    // paren stripping at unexpected levels.
    return 11;
}

public function binop_is_right_assoc(op: String) returns Bool {
    if op == "=" {
        return true;
    }
    if op == "implies" {
        return true;
    }
    return false;
}

// Intrinsic precedence of an expression. For an `ex_paren`, the value is the
// precedence of its inner expr — that's the binding strength a reader sees.
public function expr_precedence(e: Expr) returns Int {
    if e.kind == formatter_ast.ex_binop() {
        return binop_precedence(e.name);
    }
    if e.kind == formatter_ast.ex_unary() {
        return 9;
    }
    if e.kind == formatter_ast.ex_call() {
        return 10;
    }
    if e.kind == formatter_ast.ex_index() {
        return 10;
    }
    if e.kind == formatter_ast.ex_field() {
        return 10;
    }
    if e.kind == formatter_ast.ex_try() {
        return 10;
    }
    if e.kind == formatter_ast.ex_await() {
        return 10;
    }
    if e.kind == formatter_ast.ex_spawn() {
        return 10;
    }
    if e.kind == formatter_ast.ex_range() {
        return 6;
    }
    if e.kind == formatter_ast.ex_paren() {
        // The paren itself is a primary, but for stripping purposes its
        // effective precedence is what the wrapped expr would be.
        return expr_precedence(e.children[0]);
    }
    // Everything else is a primary (literals, idents, array literals).
    return 11;
}

// --- Expressions -----------------------------------------------------------
//
// Top-level entry. Callers outside the expression formatter pass no context,
// which we interpret as `min_precedence = 0` (full re-evaluation — nothing
// surrounds this expr, so no parens are needed at this layer).
public function format_expr(e: Expr) returns String {
    return format_expr_at(e, 0);
}

// Precedence-aware emitter (ADR 0043). `min_prec` is the binding power
// required by the surrounding context. When `e`'s intrinsic precedence is
// below `min_prec`, we wrap it in parens; otherwise we emit unwrapped.
// `ex_paren` is stripped here — its inner is forwarded with the same
// `min_prec`, so a redundant paren around a sufficiently-binding inner expr
// disappears.
public function format_expr_at(e: Expr, min_prec: Int) returns String {
    if e.kind == formatter_ast.ex_paren() {
        // Strip the outer paren — forward min_prec to the inner. If the
        // inner needs parens to bind at the surrounding context, the inner
        // call below will re-wrap.
        return format_expr_at(e.children[0], min_prec);
    }
    let body: String = format_expr_inner(e);
    if expr_precedence(e) < min_prec {
        return "(" + body + ")";
    }
    return body;
}

// Emits `e`'s content using recursive `format_expr_at` calls that pick
// appropriate min-precedences for each sub-expression. Never wraps the
// outermost expression — that decision belongs to `format_expr_at`.
public function format_expr_inner(e: Expr) returns String {
    if e.kind == formatter_ast.ex_void() {
        return "";
    }
    if e.kind == formatter_ast.ex_int() {
        return e.int_value.to_string();
    }
    if e.kind == formatter_ast.ex_float() {
        return e.str_value;
    }
    if e.kind == formatter_ast.ex_char() {
        return e.str_value;
    }
    if e.kind == formatter_ast.ex_string() {
        return "\"" + e.str_value + "\"";
    }
    if e.kind == formatter_ast.ex_bool() {
        if e.bool_value {
            return "true";
        }
        return "false";
    }
    if e.kind == formatter_ast.ex_ident() {
        return e.name;
    }
    if e.kind == formatter_ast.ex_unary() {
        // Unary prec is 9. Operand needs at least that to avoid surprise
        // grouping (`-(1 + 2)` keeps parens since `+` is below 9).
        let operand: String = format_expr_at(e.children[0], 9);
        if e.name == "not" {
            return "not " + operand;
        }
        return e.name + operand;
    }
    if e.kind == formatter_ast.ex_binop() {
        let p: Int = binop_precedence(e.name);
        let mutable lhs_min: Int = p;
        let mutable rhs_min: Int = p + 1;
        if binop_is_right_assoc(e.name) {
            lhs_min = p + 1;
            rhs_min = p;
        }
        let lhs: String = format_expr_at(e.children[0], lhs_min);
        let rhs: String = format_expr_at(e.children[1], rhs_min);
        return lhs + " " + e.name + " " + rhs;
    }
    if e.kind == formatter_ast.ex_call() {
        // Callee position requires postfix-prec (10). Args are in their own
        // parenthesised context — full re-evaluation (min_prec = 0).
        let callee: String = format_expr_at(e.children[0], 10);
        let mutable args: String = "";
        let mutable i: Int = 1;
        while i < len(e.children) {
            if i > 1 {
                args = args + ", ";
            }
            args = args + format_expr_at(e.children[i], 0);
            i = i + 1;
        }
        return callee + "(" + args + ")";
    }
    if e.kind == formatter_ast.ex_index() {
        let obj: String = format_expr_at(e.children[0], 10);
        let idx: String = format_expr_at(e.children[1], 0);
        return obj + "[" + idx + "]";
    }
    if e.kind == formatter_ast.ex_field() {
        let obj: String = format_expr_at(e.children[0], 10);
        return obj + "." + e.name;
    }
    if e.kind == formatter_ast.ex_try() {
        // Phase 41.4: postfix `?`. Inner binds at postfix prec (10) so a
        // lower-precedence inner expression keeps its parens.
        let inner: String = format_expr_at(e.children[0], 10);
        return inner + "?";
    }
    if e.kind == formatter_ast.ex_await() {
        // Phase 42: prefix `await <expr>`. Inner treated as unary-prec (9)
        // so lower-prec expressions keep their parens.
        let inner: String = format_expr_at(e.children[0], 9);
        return "await " + inner;
    }
    if e.kind == formatter_ast.ex_spawn() {
        // Phase 42: prefix `spawn <expr>`. Same prec convention as await.
        let inner: String = format_expr_at(e.children[0], 9);
        return "spawn " + inner;
    }
    if e.kind == formatter_ast.ex_array() {
        let mutable elems: String = "";
        let mutable i: Int = 0;
        while i < len(e.children) {
            if i > 0 {
                elems = elems + ", ";
            }
            elems = elems + format_expr_at(e.children[i], 0);
            i = i + 1;
        }
        return "[" + elems + "]";
    }
    if e.kind == formatter_ast.ex_range() {
        // Range is non-associative at prec 6. Both sides need at least 7
        // to bind tighter — otherwise the user's intent could be lost.
        let start: String = format_expr_at(e.children[0], 7);
        let end: String = format_expr_at(e.children[1], 7);
        return start + ".." + end;
    }
    if e.kind == formatter_ast.ex_paren() {
        // Defensive — `format_expr_at` strips paren before reaching here.
        // If we land in this branch via a direct `format_expr_inner` call,
        // emit literally to avoid silent loss of grouping.
        return "(" + format_expr_at(e.children[0], 0) + ")";
    }
    if e.kind == formatter_ast.ex_match() {
        // Match is multi-line and indent-sensitive. At statement level the
        // caller uses format_expr_indented with the real level; reaching here
        // means a match in a non-statement position (e.g. a call arg) — fall
        // back to level 0.
        return format_match(e, 0);
    }
    // Unknown kind — emit a placeholder so the formatter doesn't silently
    // drop. Phase 41+ will tighten this.
    return "<unknown_expr>";
}

// Phase 41.2: a match arm's pattern: `_`, `Variant`, or `Variant(a, b)`.
public function format_match_pattern(arm: MatchArm) returns String {
    if arm.is_wildcard {
        return "_";
    }
    if len(arm.bindings) == 0 {
        return arm.variant;
    }
    let mutable s: String = arm.variant + "(";
    let mutable i: Int = 0;
    while i < len(arm.bindings) {
        if i > 0 {
            s = s + ", ";
        }
        s = s + arm.bindings[i];
        i = i + 1;
    }
    return s + ")";
}

// Phase 41.2: a match expression. `level` is the indent of the line the match
// starts on; arms are emitted one level deeper, the closing `}` at `level`.
// Each arm body recurses through format_expr_indented so nested matches indent
// correctly.
public function format_match(e: Expr, level: Int) returns String {
    let mutable s: String = "match " + format_expr(e.children[0]) + " " + '{'.to_string() + "\n";
    let mutable i: Int = 0;
    while i < len(e.match_arms) {
        let arm: MatchArm = e.match_arms[i];
        s = s + indent_string(level + 1) + format_match_pattern(arm) + " => " + format_expr_indented(arm.body, level + 1) + ",\n";
        i = i + 1;
    }
    return s + indent_string(level) + '}'.to_string();
}

// Phase 41.2: format an expression that may be a multi-line match, given the
// indent level of the line it sits on. Non-match expressions are single-line
// and ignore the level (delegating to format_expr). Statement formatters call
// this for their main expression.
public function format_expr_indented(e: Expr, level: Int) returns String {
    if e.kind == formatter_ast.ex_match() {
        return format_match(e, level);
    }
    return format_expr(e);
}

// --- Statements ------------------------------------------------------------
// Emit a statement's leading comments (indented) then the statement itself.
// All callers go through this wrapper; the inner logic lives in
// format_stmt_inner so the two concerns are separate.
public function format_stmt(s: Stmt, level: Int) returns String {
    let mutable lead: String = "";
    let mutable ci: Int = 0;
    while ci < len(s.comments_before) {
        lead = lead + indent_string(level) + s.comments_before[ci] + "\n";
        ci = ci + 1;
    }
    let mutable trail: String = "";
    if s.comment_after != "" {
        trail = " " + s.comment_after;
    }
    return lead + format_stmt_inner(s, level) + trail;
}

public function format_stmt_inner(s: Stmt, level: Int) returns String {
    let pad: String = indent_string(level);
    if s.kind == formatter_ast.st_let() {
        let mutable mut_kw: String = "";
        if s.is_mutable {
            mut_kw = "mutable ";
        }
        return pad + "let " + mut_kw + s.name + ": " + s.type_name + " = " + format_expr_indented(s.expr, level) + ";";
    }
    if s.kind == formatter_ast.st_return() {
        if s.expr.kind == formatter_ast.ex_void() {
            return pad + "return;";
        }
        return pad + "return " + format_expr_indented(s.expr, level) + ";";
    }
    if s.kind == formatter_ast.st_expr() {
        return pad + format_expr_indented(s.expr, level) + ";";
    }
    if s.kind == formatter_ast.st_if() {
        let mutable out: String = pad + "if " + format_expr(s.expr) + " " + '{'.to_string() + "\n";
        out = out + format_block_body(s.then_block, level + 1);
        out = out + pad + '}'.to_string();
        if s.has_else {
            out = out + " else " + '{'.to_string() + "\n";
            out = out + format_block_body(s.else_block, level + 1);
            out = out + pad + '}'.to_string();
        }
        return out;
    }
    if s.kind == formatter_ast.st_while() {
        let mutable out: String = pad + "while " + format_expr(s.expr) + " " + '{'.to_string() + "\n";
        out = out + format_block_body(s.then_block, level + 1);
        out = out + pad + '}'.to_string();
        return out;
    }
    if s.kind == formatter_ast.st_for() {
        // Phase 41.3: `for <var> in <iter> { body }`.
        let mutable out: String = pad + "for " + s.name + " in " + format_expr(s.expr) + " " + '{'.to_string() + "\n";
        out = out + format_block_body(s.then_block, level + 1);
        out = out + pad + '}'.to_string();
        return out;
    }
    return pad + "<unknown_stmt>;";
}

// Block body (statements only, no braces). Each statement gets a trailing
// newline; the caller emits the enclosing braces.
public function format_block_body(b: Block, level: Int) returns String {
    let mutable out: String = "";
    let mutable i: Int = 0;
    while i < len(b.stmts) {
        out = out + format_stmt(b.stmts[i], level) + "\n";
        i = i + 1;
    }
    // ADR 0044 (Phase 40A.3): comments at the end of the block (before `}`).
    let mutable ti: Int = 0;
    while ti < len(b.trailing_comments) {
        out = out + indent_string(level) + b.trailing_comments[ti] + "\n";
        ti = ti + 1;
    }
    return out;
}

// --- Function declaration --------------------------------------------------
// ADR 0044 (Phase 40A.3): an inline comment after a block's closing `}`
// (e.g. a one-liner `function f() { return 1; } // note`). Returns " // note"
// or "" — appended by the decl formatters after they emit the closing brace.
public function brace_trail(b: Block) returns String {
    if b.brace_comment_after != "" {
        return " " + b.brace_comment_after;
    }
    return "";
}

// Phase 41.1: contract clauses between a signature and its body. Each clause
// is emitted on its own line, indented at `level`, prefixed with a newline so
// it follows the signature line. Order: requires, ensures, decreases (matches
// stage1's formatter). Returns "" when there are no clauses. `indent_string`
// is called fresh per clause to avoid reusing a moved String local.
public function format_contract_clauses(decl: FunctionDecl, level: Int) returns String {
    let mutable s: String = "";
    let mutable i: Int = 0;
    while i < len(decl.requires_clauses) {
        s = s + "\n" + indent_string(level) + "requires " + format_expr(decl.requires_clauses[i]);
        i = i + 1;
    }
    let mutable j: Int = 0;
    while j < len(decl.ensures_clauses) {
        s = s + "\n" + indent_string(level) + "ensures " + format_expr(decl.ensures_clauses[j]);
        j = j + 1;
    }
    let mutable k: Int = 0;
    while k < len(decl.decreases_clauses) {
        s = s + "\n" + indent_string(level) + "decreases " + format_expr(decl.decreases_clauses[k]);
        k = k + 1;
    }
    return s;
}

public function format_function_decl(fn_decl: FunctionDecl, level: Int) returns String {
    // `pad` is built twice (open + close) to avoid moving a single String
    // into both spots; the stage1 Rust backend doesn't yet auto-clone
    // multi-use locals.
    let pad_open: String = indent_string(level);
    let pad_close: String = indent_string(level);
    let mutable head: String = "";
    if fn_decl.is_public {
        head = head + "public ";
    }
    if fn_decl.is_async {
        head = head + "async ";
    }
    if fn_decl.is_entry {
        head = head + "entry ";
    }
    head = head + "function " + fn_decl.name + "(" + format_param_list(fn_decl.params) + ")";
    if not fn_decl.is_constructor and fn_decl.return_type != "" {
        head = head + " returns " + fn_decl.return_type;
    }
    // Phase 41.1: contracts go between the signature and the `{`, which then
    // moves onto its own line at the decl's indent level.
    let contracts: String = format_contract_clauses(fn_decl, level + 1);
    if contracts != "" {
        head = head + contracts + "\n" + indent_string(level) + '{'.to_string() + "\n";
    } else {
        head = head + " " + '{'.to_string() + "\n";
    }
    let body: String = format_block_body(fn_decl.body, level + 1);
    return pad_open + head + body + pad_close + '}'.to_string() + brace_trail(fn_decl.body);
}

// Constructor: same as a function but no `function` keyword and no return
// type. Used inside entity bodies.
public function format_constructor_decl(c: FunctionDecl, level: Int) returns String {
    let pad_open: String = indent_string(level);
    let pad_close: String = indent_string(level);
    let mutable head: String = pad_open + "constructor(" + format_param_list(c.params) + ")";
    // Phase 42.5: contract clauses between signature and `{` (same as methods).
    let contracts: String = format_contract_clauses(c, level + 1);
    if contracts != "" {
        head = head + contracts + "\n" + indent_string(level) + '{'.to_string() + "\n";
    } else {
        head = head + " " + '{'.to_string() + "\n";
    }
    let body: String = format_block_body(c.body, level + 1);
    return head + body + pad_close + '}'.to_string() + brace_trail(c.body);
}

// Method: like a function but uses `method` keyword.
public function format_method_decl(m: FunctionDecl, level: Int) returns String {
    let pad_open: String = indent_string(level);
    let pad_close: String = indent_string(level);
    let mutable head: String = "";
    if m.is_async {
        head = head + "async ";
    }
    head = head + "method " + m.name + "(" + format_param_list(m.params) + ")";
    if m.return_type != "" {
        head = head + " returns " + m.return_type;
    }
    // Phase 41.1: contracts between signature and `{` (same as functions).
    let contracts: String = format_contract_clauses(m, level + 1);
    if contracts != "" {
        head = head + contracts + "\n" + indent_string(level) + '{'.to_string() + "\n";
    } else {
        head = head + " " + '{'.to_string() + "\n";
    }
    let body: String = format_block_body(m.body, level + 1);
    return pad_open + head + body + pad_close + '}'.to_string() + brace_trail(m.body);
}

// --- Test declaration ------------------------------------------------------
public function format_test_decl(t: TestDecl) returns String {
    let mutable prefix: String = "";
    if t.is_async {
        prefix = "async ";
    }
    let mutable out: String = prefix + "test \"" + t.name + "\" " + '{'.to_string() + "\n";
    out = out + format_block_body(t.body, 1);
    out = out + '}'.to_string() + brace_trail(t.body);
    return out;
}

// --- Entity / enum / trait / impl ------------------------------------------
public function format_entity_decl(e: EntityDecl) returns String {
    let mutable head: String = "";
    if e.is_public {
        head = head + "public ";
    }
    head = head + "entity " + e.name + " " + '{'.to_string() + "\n";
    let mutable body: String = "";
    let mutable fi: Int = 0;
    while fi < len(e.fields) {
        let f: FieldDecl = e.fields[fi];
        let mutable fci: Int = 0;
        while fci < len(f.comments_before) {
            body = body + "    " + f.comments_before[fci] + "\n";
            fci = fci + 1;
        }
        body = body + "    field " + f.name + ": " + f.type_name + ";";
        if f.comment_after != "" {
            body = body + " " + f.comment_after;
        }
        body = body + "\n";
        fi = fi + 1;
    }
    if len(e.invariants) > 0 {
        if len(e.fields) > 0 {
            body = body + "\n";
        }
        let mutable ii: Int = 0;
        while ii < len(e.invariants) {
            body = body + "    invariant " + format_expr(e.invariants[ii]) + ";\n";
            ii = ii + 1;
        }
    }
    if e.has_constructor {
        body = body + "\n";
        let mutable cci: Int = 0;
        while cci < len(e.ctor.comments_before) {
            body = body + "    " + e.ctor.comments_before[cci] + "\n";
            cci = cci + 1;
        }
        body = body + format_constructor_decl(e.ctor, 1) + "\n";
    }
    let mutable mi: Int = 0;
    while mi < len(e.methods) {
        body = body + "\n";
        let m: FunctionDecl = e.methods[mi];
        let mutable mci: Int = 0;
        while mci < len(m.comments_before) {
            body = body + "    " + m.comments_before[mci] + "\n";
            mci = mci + 1;
        }
        body = body + format_method_decl(m, 1) + "\n";
        mi = mi + 1;
    }
    return head + body + '}'.to_string();
}

public function format_enum_decl(en: EnumDecl) returns String {
    let mutable head: String = "";
    if en.is_public {
        head = head + "public ";
    }
    head = head + "enum " + en.name + " " + '{'.to_string() + "\n";
    let mutable body: String = "";
    let mutable i: Int = 0;
    while i < len(en.variants) {
        let v: EnumVariant = en.variants[i];
        if len(v.params) == 0 {
            body = body + "    " + v.name + ",\n";
        } else {
            body = body + "    " + v.name + "(" + format_param_list(v.params) + "),\n";
        }
        i = i + 1;
    }
    return head + body + '}'.to_string();
}

public function format_trait_method_sig(sig: TraitMethodSig) returns String {
    let mutable s: String = "    method " + sig.name + "(" + format_param_list(sig.params) + ")";
    if sig.return_type != "" {
        s = s + " returns " + sig.return_type;
    }
    s = s + ";";
    return s;
}

public function format_trait_decl(tr: TraitDecl) returns String {
    let mutable head: String = "";
    if tr.is_public {
        head = head + "public ";
    }
    head = head + "trait " + tr.name + " " + '{'.to_string() + "\n";
    let mutable body: String = "";
    let mutable i: Int = 0;
    while i < len(tr.methods) {
        body = body + format_trait_method_sig(tr.methods[i]) + "\n";
        i = i + 1;
    }
    return head + body + '}'.to_string();
}

public function format_impl_decl(im: ImplDecl) returns String {
    let mutable head: String = "impl " + im.trait_name + " for " + im.entity_name + " " + '{'.to_string() + "\n";
    let mutable body: String = "";
    let mutable i: Int = 0;
    while i < len(im.methods) {
        if i > 0 {
            body = body + "\n";
        }
        let m: FunctionDecl = im.methods[i];
        let mutable mci: Int = 0;
        while mci < len(m.comments_before) {
            body = body + "    " + m.comments_before[mci] + "\n";
            mci = mci + 1;
        }
        body = body + format_method_decl(m, 1) + "\n";
        i = i + 1;
    }
    return head + body + '}'.to_string();
}

// --- Intent block + extern ------------------------------------------------
public function format_intent_block(ib: IntentBlock) returns String {
    let mutable s: String = "intent \"" + ib.description + "\" " + '{'.to_string() + "\n";
    let mutable gi: Int = 0;
    while gi < len(ib.goals) {
        s = s + "    goal: \"" + ib.goals[gi] + "\";\n";
        gi = gi + 1;
    }
    let mutable ci: Int = 0;
    while ci < len(ib.constraints) {
        s = s + "    constraint: \"" + ib.constraints[ci] + "\";\n";
        ci = ci + 1;
    }
    let mutable gti: Int = 0;
    while gti < len(ib.guarantees) {
        s = s + "    guarantee: \"" + ib.guarantees[gti] + "\";\n";
        gti = gti + 1;
    }
    if len(ib.verifications) > 0 {
        s = s + "    verified_by: [";
        let mutable i: Int = 0;
        while i < len(ib.verifications) {
            if i > 0 {
                s = s + ", ";
            }
            s = s + ib.verifications[i];
            i = i + 1;
        }
        s = s + "];\n";
    }
    s = s + '}'.to_string();
    return s;
}

public function format_extern_decl(ex: ExternDecl) returns String {
    let mutable s: String = "extern \"" + ex.target + "\" function " + ex.func_name + "(" + format_param_list(ex.params) + ")";
    if ex.return_type != "" {
        s = s + " returns " + ex.return_type;
    }
    s = s + ";";
    return s;
}

// --- Top-level ------------------------------------------------------------
// Top-level decls are emitted in source order (ADR 0042). The parser
// populates `line: Int` on every top-level decl entity; this function
// k-way merges the nine per-kind arrays by line, falling back to a
// canonical kind order on ties. Each per-kind array is already sorted
// by line since the parser appends in source order, so a single pass
// with nine index pointers and a min-by-line pick suffices.
//
// Decl kind tags (used as `best_kind` below):
//   0 = imports, 1 = functions, 2 = entities, 3 = enums, 4 = traits,
//   5 = impls, 6 = intent_blocks, 7 = tests, 8 = externs
public function format_program(prog: Program) returns String {
    // ADR 0044 (Phase 40A.3): file-header comments precede the module line.
    let mutable out: String = format_comments_before(prog.module_decl.comments_before) + format_module_decl(prog.module_decl) + "\n\n";
    let mutable i_imp: Int = 0;
    let mutable i_fn: Int = 0;
    let mutable i_ent: Int = 0;
    let mutable i_enum: Int = 0;
    let mutable i_trait: Int = 0;
    let mutable i_impl: Int = 0;
    let mutable i_ib: Int = 0;
    let mutable i_test: Int = 0;
    let mutable i_ext: Int = 0;
    let mutable done: Bool = false;
    while not done {
        // Find the smallest current line across all non-exhausted kinds.
        // best_kind == -1 means every array is exhausted; we're done.
        let mutable best_kind: Int = -1;
        let mutable best_line: Int = 0;
        if i_imp < len(prog.imports) {
            let candidate: Int = prog.imports[i_imp].line;
            if best_kind == -1 or candidate < best_line {
                best_kind = 0;
                best_line = candidate;
            }
        }
        if i_fn < len(prog.functions) {
            let candidate: Int = prog.functions[i_fn].line;
            if best_kind == -1 or candidate < best_line {
                best_kind = 1;
                best_line = candidate;
            }
        }
        if i_ent < len(prog.entities) {
            let candidate: Int = prog.entities[i_ent].line;
            if best_kind == -1 or candidate < best_line {
                best_kind = 2;
                best_line = candidate;
            }
        }
        if i_enum < len(prog.enums) {
            let candidate: Int = prog.enums[i_enum].line;
            if best_kind == -1 or candidate < best_line {
                best_kind = 3;
                best_line = candidate;
            }
        }
        if i_trait < len(prog.traits) {
            let candidate: Int = prog.traits[i_trait].line;
            if best_kind == -1 or candidate < best_line {
                best_kind = 4;
                best_line = candidate;
            }
        }
        if i_impl < len(prog.impls) {
            let candidate: Int = prog.impls[i_impl].line;
            if best_kind == -1 or candidate < best_line {
                best_kind = 5;
                best_line = candidate;
            }
        }
        if i_ib < len(prog.intent_blocks) {
            let candidate: Int = prog.intent_blocks[i_ib].line;
            if best_kind == -1 or candidate < best_line {
                best_kind = 6;
                best_line = candidate;
            }
        }
        if i_test < len(prog.tests) {
            let candidate: Int = prog.tests[i_test].line;
            if best_kind == -1 or candidate < best_line {
                best_kind = 7;
                best_line = candidate;
            }
        }
        if i_ext < len(prog.externs) {
            let candidate: Int = prog.externs[i_ext].line;
            if best_kind == -1 or candidate < best_line {
                best_kind = 8;
                best_line = candidate;
            }
        }
        if best_kind == -1 {
            done = true;
        } else {
            // ADR 0044: prepend the decl's leading comments. Each comment
            // gets its own line; the decl follows on the next.
            if best_kind == 0 {
                let imp: ImportDecl = prog.imports[i_imp];
                out = out + format_comments_before(imp.comments_before) + format_import_decl(imp) + "\n\n";
                i_imp = i_imp + 1;
            } else {
                if best_kind == 1 {
                    let fn_decl: FunctionDecl = prog.functions[i_fn];
                    out = out + format_comments_before(fn_decl.comments_before) + format_function_decl(fn_decl, 0) + "\n\n";
                    i_fn = i_fn + 1;
                } else {
                    if best_kind == 2 {
                        let ent: EntityDecl = prog.entities[i_ent];
                        out = out + format_comments_before(ent.comments_before) + format_entity_decl(ent) + "\n\n";
                        i_ent = i_ent + 1;
                    } else {
                        if best_kind == 3 {
                            let en: EnumDecl = prog.enums[i_enum];
                            out = out + format_comments_before(en.comments_before) + format_enum_decl(en) + "\n\n";
                            i_enum = i_enum + 1;
                        } else {
                            if best_kind == 4 {
                                let tr: TraitDecl = prog.traits[i_trait];
                                out = out + format_comments_before(tr.comments_before) + format_trait_decl(tr) + "\n\n";
                                i_trait = i_trait + 1;
                            } else {
                                if best_kind == 5 {
                                    let im: ImplDecl = prog.impls[i_impl];
                                    out = out + format_comments_before(im.comments_before) + format_impl_decl(im) + "\n\n";
                                    i_impl = i_impl + 1;
                                } else {
                                    if best_kind == 6 {
                                        let ib: IntentBlock = prog.intent_blocks[i_ib];
                                        out = out + format_comments_before(ib.comments_before) + format_intent_block(ib) + "\n\n";
                                        i_ib = i_ib + 1;
                                    } else {
                                        if best_kind == 7 {
                                            let t: TestDecl = prog.tests[i_test];
                                            out = out + format_comments_before(t.comments_before) + format_test_decl(t) + "\n\n";
                                            i_test = i_test + 1;
                                        } else {
                                            // best_kind == 8
                                            let ex: ExternDecl = prog.externs[i_ext];
                                            out = out + format_comments_before(ex.comments_before) + format_extern_decl(ex) + "\n\n";
                                            i_ext = i_ext + 1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    // Phase 40A.2 / ADR 0044: emit comments that trailed the last decl.
    // `out` already ends in the "\n\n" separator from the final decl
    // (or from the module decl when the program has no decls), so the
    // comments start on their own line after a blank line — matching the
    // leading-comment spacing produced by the merge above.
    out = out + format_comments_before(prog.trailing_comments);
    return out;
}

