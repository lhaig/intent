// selfhost/formatter/parser.intent — Phases 33-36 / ADR 0040 stage2.
//
// Parses Intent source into a structured AST:
//   - module declaration
//   - imports
//   - top-level declarations: function, entity, enum, trait, impl,
//     test, extern, intent block (Phase 36).
//   - function bodies as Block of statements (let / return / if-else /
//     while / expression statements) — Phase 34.
//   - expressions inside statements: literals, identifiers, calls,
//     field/method access, indexing, ranges, array literals, unary +
//     binary operators with full precedence — Phase 35.
//
// Out of scope (deferred to Phase 37+):
//   - type-argument lists (Array<T>, Result<T,E>, etc.) — captures a
//     primitive type or bare identifier with a "<...>" suffix marker.
//   - match expressions / for / break / continue / try / await.
//   - lambdas (`(x) => expr`), interpolated strings (`${expr}`), char
//     literals (`'a'`), float literals — stage2 lexer doesn't tokenise
//     them yet either.
//   - contract clauses (requires / ensures / decreases / invariant
//     expressions) — Phase 36 skips them with the Phase 33 ident-eat
//     heuristic; a real contract parser is Phase 38+.
//
// AST shape choice: each AST node is one entity with an Int `kind`
// discriminator + per-kind fields. See ast.intent for the entity
// definitions and the rationale.
//
// File layout: AST entities + kind constants + AST helpers live in
// `ast.intent`. This file holds the `Parser` entity, parse methods,
// the top-level `parse(source)` convenience, and the in-language tests.

module formatter_parser version "0.1.0";

import "lexer.intent";
import "ast.intent";

// --- Parser -----------------------------------------------------------------

public entity Parser {
    field tokens: Array<Token>;
    field position: Int;
    field error: String;

    constructor(source: String) {
        self.tokens = formatter_lexer.lex(source);
        self.position = 0;
        self.error = "";
    }

    method at_end() returns Bool {
        return self.peek_kind() == formatter_lexer.tk_eof();
    }

    method peek_kind() returns Int {
        return self.tokens[self.position].kind;
    }

    method peek_text() returns String {
        return self.tokens[self.position].text;
    }

    method peek_n(n: Int) returns Int {
        let idx: Int = self.position + n;
        if idx >= len(self.tokens) {
            return formatter_lexer.tk_eof();
        }
        return self.tokens[idx].kind;
    }

    method advance() returns Token {
        let tok: Token = self.tokens[self.position];
        if self.position < len(self.tokens) - 1 {
            self.position = self.position + 1;
        }
        return tok;
    }

    method check(kind: Int) returns Bool {
        return self.peek_kind() == kind;
    }

    method check_consume(kind: Int) returns Bool {
        if self.check(kind) {
            self.advance();
            return true;
        }
        return false;
    }

    // Records an error and advances past one token so we make progress.
    // Returns the offending token's text for callers that want it.
    method fail(message: String) returns String {
        if self.error == "" {
            let tok: Token = self.tokens[self.position];
            self.error = "line " + tok.line.to_string() + " col " + tok.column.to_string() + ": " + message;
        }
        if not self.at_end() {
            self.advance();
        }
        return "";
    }

    method expect(kind: Int, what: String) returns Token {
        if self.check(kind) {
            return self.advance();
        }
        self.fail("expected " + what);
        return self.tokens[self.position];
    }

    // Strips the surrounding quotes from a string-literal token text.
    method unquote(text: String) returns String {
        let n: Int = len(text);
        if n < 2 {
            return text;
        }
        return text[1..n - 1];
    }

    // --- top-level parse entry points -------------------------------------

    method parse_module_decl() returns ModuleDecl {
        self.expect(formatter_lexer.kw_module(), "'module' keyword");
        let name_tok: Token = self.expect(formatter_lexer.tk_ident(), "module name");
        self.expect(formatter_lexer.kw_version(), "'version' keyword");
        let ver_tok: Token = self.expect(formatter_lexer.tk_string(), "version string literal");
        self.expect(formatter_lexer.tk_semicolon(), "';' after module declaration");
        return ModuleDecl(name_tok.text, self.unquote(ver_tok.text));
    }

    // ADR 0044: `leading_comments` is passed by parse_program (captured
    // BEFORE consuming any modifier so `public` lookahead doesn't strand
    // them). When non-empty it overrides the keyword token's own
    // comments_before — which is empty in the post-`public` case anyway.
    method parse_import_decl(leading_comments: Array<String>) returns ImportDecl {
        // ADR 0042: capture source line from the `import` keyword token.
        let import_tok: Token = self.expect(formatter_lexer.kw_import_marker(), "'import' keyword");
        let line: Int = import_tok.line;
        let cmts: Array<String> = leading_comments;
        if self.check(formatter_lexer.tk_string()) {
            let path_tok: Token = self.advance();
            self.expect(formatter_lexer.tk_semicolon(), "';' after import");
            return ImportDecl(false, self.unquote(path_tok.text), line, cmts);
        }
        if self.check(formatter_lexer.tk_ident()) {
            let pkg_tok: Token = self.advance();
            let mutable path: String = pkg_tok.text;
            // Dotted package paths: pkg.sub.deeper
            while self.check_consume(formatter_lexer.tk_dot()) {
                if self.check(formatter_lexer.tk_ident()) {
                    let seg: Token = self.advance();
                    path = path + "." + seg.text;
                } else {
                    self.fail("expected identifier after '.' in import");
                    return ImportDecl(true, path, line, cmts);
                }
            }
            self.expect(formatter_lexer.tk_semicolon(), "';' after import");
            return ImportDecl(true, path, line, cmts);
        }
        self.fail("expected string or identifier after 'import'");
        return ImportDecl(false, "", line, cmts);
    }

    method parse_param() returns Param {
        let name_tok: Token = self.expect(formatter_lexer.tk_ident(), "parameter name");
        self.expect(formatter_lexer.tk_colon(), "':' after parameter name");
        let type_name: String = self.parse_type_name();
        return Param(name_tok.text, type_name);
    }

    // Recognises a primitive type (Int / String / Bool / Void / Char) or a
    // bare identifier. Generic arguments (Array<T>, Result<T, E>) are
    // consumed but not modelled — Phase 33 stores the head only and
    // discards the args. Phase 34+ will replace this with a real TypeRef.
    method parse_type_name() returns String {
        let tok: Token = self.advance();
        let mutable name: String = tok.text;
        // Skip a single optional <...> generic-arg list (no nesting in v1).
        if self.check_consume(formatter_lexer.tk_lt()) {
            let mutable depth: Int = 1;
            while depth > 0 and not self.at_end() {
                if self.check_consume(formatter_lexer.tk_lt()) {
                    depth = depth + 1;
                } else {
                    if self.check_consume(formatter_lexer.tk_gt()) {
                        depth = depth - 1;
                    } else {
                        self.advance();
                    }
                }
            }
            name = name + "<...>";
        }
        return name;
    }

    method parse_function_decl(leading_comments: Array<String>) returns FunctionDecl {
        // ADR 0042 / 0044: capture source line from the first token; comments
        // are passed by the caller (parse_program) so the `public` modifier
        // path doesn't strand them.
        let first_tok: Token = self.tokens[self.position];
        let line: Int = first_tok.line;
        let cmts: Array<String> = leading_comments;
        let mutable is_public: Bool = false;
        let mutable is_async: Bool = false;
        let mutable is_entry: Bool = false;

        // Optional modifiers in any order before `function`.
        // (The full grammar restricts ordering more tightly; v1 parser
        // accepts any.)
        let mutable scanning_modifiers: Bool = true;
        while scanning_modifiers {
            if self.check(formatter_lexer.kw_public_marker()) {
                self.advance();
                is_public = true;
            } else {
                if self.check(formatter_lexer.kw_async_marker()) {
                    self.advance();
                    is_async = true;
                } else {
                    if self.check(formatter_lexer.kw_entry()) {
                        self.advance();
                        is_entry = true;
                    } else {
                        scanning_modifiers = false;
                    }
                }
            }
        }

        self.expect(formatter_lexer.kw_function(), "'function' keyword");
        let name_tok: Token = self.expect(formatter_lexer.tk_ident(), "function name");

        self.expect(formatter_lexer.tk_lparen(), "'(' after function name");
        let mutable params: Array<Param> = [];
        if not self.check(formatter_lexer.tk_rparen()) {
            params.push(self.parse_param());
            while self.check_consume(formatter_lexer.tk_comma()) {
                params.push(self.parse_param());
            }
        }
        self.expect(formatter_lexer.tk_rparen(), "')' to close parameter list");

        // Contracts on top-level functions are part of the surface (`requires`
        // / `ensures` / `decreases`) but they aren't tokenised as keywords
        // in v1's lexer. Skip them by scanning identifiers/expressions until
        // we hit `returns` or `{`.

        self.expect(formatter_lexer.kw_returns(), "'returns' after parameter list");
        let return_type: String = self.parse_type_name();

        // Skip optional contract clauses (requires/ensures/decreases). Each
        // starts with an identifier and runs to end-of-line-ish. v1 just
        // bails out when we see `{` or EOF.
        while self.check(formatter_lexer.tk_ident()) {
            // Skip the contract keyword + its predicate up to the next
            // top-level boundary. Heuristic: consume until newline-ish — we
            // approximate by skipping tokens until { or end of function.
            self.advance();
            // crude scan: keep going until we hit `{` or another contract-
            // looking ident at column 1 — Phase 34 will replace this.
            while not self.at_end() and not self.check(formatter_lexer.tk_lbrace()) and not self.check(formatter_lexer.tk_ident()) {
                self.advance();
            }
        }

        let body: Block = self.parse_block();
        return FunctionDecl(name_tok.text, is_public, is_entry, is_async, false, params, return_type, body, line, cmts);
    }

    // --- statement-level parse -------------------------------------------

    // Parses a brace-delimited `{ ... }` block: consumes opening `{`, then
    // dispatches into statement parsers until it sees a `}` at this level.
    // Records (but does not propagate via panic) any error via self.fail.
    method parse_block() returns Block {
        self.expect(formatter_lexer.tk_lbrace(), "'" + '{'.to_string() + "' to start block");
        let mutable stmts: Array<Stmt> = [];
        while not self.at_end() and not self.check(formatter_lexer.tk_rbrace()) and self.error == "" {
            stmts.push(self.parse_statement());
        }
        self.expect(formatter_lexer.tk_rbrace(), "'" + '}'.to_string() + "' to close block");
        return Block(stmts);
    }

    method parse_statement() returns Stmt {
        if self.check(formatter_lexer.kw_let()) {
            return self.parse_let_stmt();
        }
        if self.check(formatter_lexer.kw_return()) {
            return self.parse_return_stmt();
        }
        if self.check(formatter_lexer.kw_if()) {
            return self.parse_if_stmt();
        }
        if self.check(formatter_lexer.kw_while()) {
            return self.parse_while_stmt();
        }
        return self.parse_expr_stmt();
    }

    // `let [mutable] IDENT [: TYPE] = EXPR;`
    method parse_let_stmt() returns Stmt {
        self.expect(formatter_lexer.kw_let(), "'let'");
        let mutable is_mut: Bool = false;
        if self.check_consume(formatter_lexer.kw_mutable()) {
            is_mut = true;
        }
        let name_tok: Token = self.expect(formatter_lexer.tk_ident(), "binding name");
        let mutable type_name: String = "";
        if self.check_consume(formatter_lexer.tk_colon()) {
            type_name = self.parse_type_name();
        }
        self.expect(formatter_lexer.tk_assign(), "'=' in let binding");
        let rhs: Expr = self.parse_expr();
        self.expect(formatter_lexer.tk_semicolon(), "';' to end let statement");
        return Stmt(formatter_ast.st_let(), rhs, name_tok.text, type_name, is_mut, formatter_ast.empty_block(), formatter_ast.empty_block(), false);
    }

    // `return [EXPR];`
    method parse_return_stmt() returns Stmt {
        self.expect(formatter_lexer.kw_return(), "'return'");
        let mutable rhs: Expr = formatter_ast.empty_expr();
        if not self.check(formatter_lexer.tk_semicolon()) {
            rhs = self.parse_expr();
        }
        self.expect(formatter_lexer.tk_semicolon(), "';' to end return statement");
        return Stmt(formatter_ast.st_return(), rhs, "", "", false, formatter_ast.empty_block(), formatter_ast.empty_block(), false);
    }

    // `if EXPR { BLOCK } [else (if-stmt | { BLOCK })]`. `else if` chains
    // are folded into a single-statement else-block whose only statement
    // is the nested if.
    method parse_if_stmt() returns Stmt {
        self.expect(formatter_lexer.kw_if(), "'if'");
        let cond: Expr = self.parse_expr();
        let then_blk: Block = self.parse_block();
        let mutable else_blk: Block = formatter_ast.empty_block();
        let mutable has_else: Bool = false;
        if self.check_consume(formatter_lexer.kw_else()) {
            has_else = true;
            if self.check(formatter_lexer.kw_if()) {
                let mutable inner: Array<Stmt> = [];
                inner.push(self.parse_if_stmt());
                else_blk = Block(inner);
            } else {
                else_blk = self.parse_block();
            }
        }
        return Stmt(formatter_ast.st_if(), cond, "", "", false, then_blk, else_blk, has_else);
    }

    // `while EXPR { BLOCK }`
    method parse_while_stmt() returns Stmt {
        self.expect(formatter_lexer.kw_while(), "'while'");
        let cond: Expr = self.parse_expr();
        let body: Block = self.parse_block();
        return Stmt(formatter_ast.st_while(), cond, "", "", false, body, formatter_ast.empty_block(), false);
    }

    // Anything else (assignment, bare call, etc.) — parse a full expression
    // and require a trailing `;`.
    method parse_expr_stmt() returns Stmt {
        let e: Expr = self.parse_expr();
        self.expect(formatter_lexer.tk_semicolon(), "';' to end expression statement");
        return Stmt(formatter_ast.st_expr(), e, "", "", false, formatter_ast.empty_block(), formatter_ast.empty_block(), false);
    }

    // --- expression parser (Pratt / precedence climbing) ------------------
    //
    // Grammar (lowest to highest precedence):
    //
    //   parse_expr   = parse_assign
    //   parse_assign = parse_or ( '='  parse_assign )?        (right-assoc, single)
    //   parse_or     = parse_and ( 'or'  parse_and )*
    //   parse_and    = parse_eq  ( 'and' parse_eq  )*
    //   parse_eq     = parse_cmp ( ('=='|'!=')   parse_cmp   )*
    //   parse_cmp    = parse_range ( ('<'|'>'|'<='|'>=') parse_range )*
    //   parse_range  = parse_add ( '..' parse_add )?           (non-assoc, single)
    //   parse_add    = parse_mul ( ('+'|'-')   parse_mul   )*
    //   parse_mul    = parse_unary ( ('*'|'/'|'%') parse_unary )*
    //   parse_unary  = ('-' | 'not') parse_unary | parse_postfix
    //   parse_postfix = parse_primary ( '(' args ')' | '[' expr ']' | '.' ident )*
    //   parse_primary = INT_LIT | FLOAT_LIT | CHAR_LIT | STR_LIT | 'true' | 'false' | IDENT
    //               | '(' parse_expr ')' | '[' parse_array_literal_body ']'
    //
    // Assignment is parsed as a binop with op "=" at the lowest precedence.
    // The surface language reserves it for statement contexts; treating it
    // as an expression here keeps the AST uniform.

    method parse_expr() returns Expr {
        return self.parse_assign();
    }

    method parse_assign() returns Expr {
        let lhs: Expr = self.parse_or();
        if self.check(formatter_lexer.tk_assign()) {
            let op_tok: Token = self.advance();
            let rhs: Expr = self.parse_assign();
            let mutable children: Array<Expr> = [];
            children.push(lhs);
            children.push(rhs);
            return Expr(formatter_ast.ex_binop(), 0, "", false, op_tok.text, children);
        }
        return lhs;
    }

    method parse_or() returns Expr {
        let mutable lhs: Expr = self.parse_and();
        while self.check(formatter_lexer.kw_or()) {
            let op_tok: Token = self.advance();
            let rhs: Expr = self.parse_and();
            let mutable children: Array<Expr> = [];
            children.push(lhs);
            children.push(rhs);
            lhs = Expr(formatter_ast.ex_binop(), 0, "", false, op_tok.text, children);
        }
        return lhs;
    }

    method parse_and() returns Expr {
        let mutable lhs: Expr = self.parse_eq();
        while self.check(formatter_lexer.kw_and()) {
            let op_tok: Token = self.advance();
            let rhs: Expr = self.parse_eq();
            let mutable children: Array<Expr> = [];
            children.push(lhs);
            children.push(rhs);
            lhs = Expr(formatter_ast.ex_binop(), 0, "", false, op_tok.text, children);
        }
        return lhs;
    }

    method parse_eq() returns Expr {
        let mutable lhs: Expr = self.parse_cmp();
        while self.check(formatter_lexer.tk_eq()) or self.check(formatter_lexer.tk_neq()) {
            let op_tok: Token = self.advance();
            let rhs: Expr = self.parse_cmp();
            let mutable children: Array<Expr> = [];
            children.push(lhs);
            children.push(rhs);
            lhs = Expr(formatter_ast.ex_binop(), 0, "", false, op_tok.text, children);
        }
        return lhs;
    }

    method parse_cmp() returns Expr {
        let mutable lhs: Expr = self.parse_range();
        while self.is_cmp_op() {
            let op_tok: Token = self.advance();
            let rhs: Expr = self.parse_range();
            let mutable children: Array<Expr> = [];
            children.push(lhs);
            children.push(rhs);
            lhs = Expr(formatter_ast.ex_binop(), 0, "", false, op_tok.text, children);
        }
        return lhs;
    }

    method is_cmp_op() returns Bool {
        if self.check(formatter_lexer.tk_lt()) { return true; }
        if self.check(formatter_lexer.tk_gt()) { return true; }
        if self.check(formatter_lexer.tk_leq()) { return true; }
        if self.check(formatter_lexer.tk_geq()) { return true; }
        return false;
    }

    method parse_range() returns Expr {
        let lhs: Expr = self.parse_add();
        if self.check_consume(formatter_lexer.tk_dotdot()) {
            let rhs: Expr = self.parse_add();
            let mutable children: Array<Expr> = [];
            children.push(lhs);
            children.push(rhs);
            return Expr(formatter_ast.ex_range(), 0, "", false, "", children);
        }
        return lhs;
    }

    method parse_add() returns Expr {
        let mutable lhs: Expr = self.parse_mul();
        while self.check(formatter_lexer.tk_plus()) or self.check(formatter_lexer.tk_minus()) {
            let op_tok: Token = self.advance();
            let rhs: Expr = self.parse_mul();
            let mutable children: Array<Expr> = [];
            children.push(lhs);
            children.push(rhs);
            lhs = Expr(formatter_ast.ex_binop(), 0, "", false, op_tok.text, children);
        }
        return lhs;
    }

    method parse_mul() returns Expr {
        let mutable lhs: Expr = self.parse_unary();
        while self.is_mul_op() {
            let op_tok: Token = self.advance();
            let rhs: Expr = self.parse_unary();
            let mutable children: Array<Expr> = [];
            children.push(lhs);
            children.push(rhs);
            lhs = Expr(formatter_ast.ex_binop(), 0, "", false, op_tok.text, children);
        }
        return lhs;
    }

    method is_mul_op() returns Bool {
        if self.check(formatter_lexer.tk_star()) { return true; }
        if self.check(formatter_lexer.tk_slash()) { return true; }
        if self.check(formatter_lexer.tk_percent()) { return true; }
        return false;
    }

    method parse_unary() returns Expr {
        if self.check(formatter_lexer.tk_minus()) {
            self.advance();
            let operand: Expr = self.parse_unary();
            let mutable children: Array<Expr> = [];
            children.push(operand);
            return Expr(formatter_ast.ex_unary(), 0, "", false, "-", children);
        }
        if self.check(formatter_lexer.kw_not()) {
            self.advance();
            let operand: Expr = self.parse_unary();
            let mutable children: Array<Expr> = [];
            children.push(operand);
            return Expr(formatter_ast.ex_unary(), 0, "", false, "not", children);
        }
        return self.parse_postfix();
    }

    method parse_postfix() returns Expr {
        let mutable e: Expr = self.parse_primary();
        while true {
            if self.check_consume(formatter_lexer.tk_lparen()) {
                let mutable children: Array<Expr> = [];
                children.push(e);
                if not self.check(formatter_lexer.tk_rparen()) {
                    children.push(self.parse_expr());
                    while self.check_consume(formatter_lexer.tk_comma()) {
                        children.push(self.parse_expr());
                    }
                }
                self.expect(formatter_lexer.tk_rparen(), "')' to close call");
                e = Expr(formatter_ast.ex_call(), 0, "", false, "", children);
            } else {
                if self.check_consume(formatter_lexer.tk_lbracket()) {
                    let idx: Expr = self.parse_expr();
                    self.expect(formatter_lexer.tk_rbracket(), "']' to close index");
                    let mutable children: Array<Expr> = [];
                    children.push(e);
                    children.push(idx);
                    e = Expr(formatter_ast.ex_index(), 0, "", false, "", children);
                } else {
                    if self.check_consume(formatter_lexer.tk_dot()) {
                        let fld: Token = self.expect(formatter_lexer.tk_ident(), "field name after '.'");
                        let mutable children: Array<Expr> = [];
                        children.push(e);
                        e = Expr(formatter_ast.ex_field(), 0, "", false, fld.text, children);
                    } else {
                        return e;
                    }
                }
            }
        }
        return e;
    }

    method parse_primary() returns Expr {
        let kind: Int = self.peek_kind();
        if kind == formatter_lexer.tk_int() {
            let tok: Token = self.advance();
            let mutable children: Array<Expr> = [];
            return Expr(formatter_ast.ex_int(), formatter_ast.parse_int(tok.text), "", false, "", children);
        }
        if kind == formatter_lexer.tk_string() {
            let tok: Token = self.advance();
            let mutable children: Array<Expr> = [];
            return Expr(formatter_ast.ex_string(), 0, self.unquote(tok.text), false, "", children);
        }
        if kind == formatter_lexer.tk_float() {
            let tok: Token = self.advance();
            let mutable children: Array<Expr> = [];
            return Expr(formatter_ast.ex_float(), 0, tok.text, false, "", children);
        }
        if kind == formatter_lexer.tk_char() {
            let tok: Token = self.advance();
            let mutable children: Array<Expr> = [];
            return Expr(formatter_ast.ex_char(), 0, tok.text, false, "", children);
        }
        if kind == formatter_lexer.kw_true() {
            self.advance();
            let mutable children: Array<Expr> = [];
            return Expr(formatter_ast.ex_bool(), 0, "", true, "", children);
        }
        if kind == formatter_lexer.kw_false() {
            self.advance();
            let mutable children: Array<Expr> = [];
            return Expr(formatter_ast.ex_bool(), 0, "", false, "", children);
        }
        if kind == formatter_lexer.tk_ident() {
            let tok: Token = self.advance();
            let mutable children: Array<Expr> = [];
            return Expr(formatter_ast.ex_ident(), 0, "", false, tok.text, children);
        }
        if kind == formatter_lexer.tk_lparen() {
            self.advance();
            let inner: Expr = self.parse_expr();
            self.expect(formatter_lexer.tk_rparen(), "')' to close parenthesised expression");
            let mutable children: Array<Expr> = [];
            children.push(inner);
            return Expr(formatter_ast.ex_paren(), 0, "", false, "", children);
        }
        if kind == formatter_lexer.tk_lbracket() {
            self.advance();
            let mutable elems: Array<Expr> = [];
            if not self.check(formatter_lexer.tk_rbracket()) {
                elems.push(self.parse_expr());
                while self.check_consume(formatter_lexer.tk_comma()) {
                    elems.push(self.parse_expr());
                }
            }
            self.expect(formatter_lexer.tk_rbracket(), "']' to close array literal");
            return Expr(formatter_ast.ex_array(), 0, "", false, "", elems);
        }
        self.fail("expected expression");
        return formatter_ast.empty_expr();
    }

    method parse_program() returns Program {
        let module_decl: ModuleDecl = self.parse_module_decl();
        let mutable prog: Program = formatter_ast.empty_program(module_decl);

        while not self.at_end() and self.error == "" {
            // ADR 0044: capture leading comments from the very first token
            // of this decl, BEFORE consuming any `public` modifier. The
            // `public` token (when present) is what carries the comments
            // in the lexer's attachment model; if we read after consuming
            // it, the comments would be on a previous, lost token.
            let cmts: Array<String> = self.tokens[self.position].comments_before;
            if self.check(formatter_lexer.kw_import_marker()) {
                prog.imports.push(self.parse_import_decl(cmts));
            } else {
                if self.check(formatter_lexer.kw_entity_marker()) {
                    prog.entities.push(self.parse_entity_decl(false, cmts));
                } else {
                    if self.check(formatter_lexer.kw_enum_marker()) {
                        prog.enums.push(self.parse_enum_decl(false, cmts));
                    } else {
                        if self.check(formatter_lexer.kw_trait_marker()) {
                            prog.traits.push(self.parse_trait_decl(false, cmts));
                        } else {
                            if self.check(formatter_lexer.kw_impl_marker()) {
                                prog.impls.push(self.parse_impl_decl(cmts));
                            } else {
                                if self.check(formatter_lexer.kw_test_marker()) {
                                    prog.tests.push(self.parse_test_decl(cmts));
                                } else {
                                    if self.check(formatter_lexer.kw_extern_marker()) {
                                        prog.externs.push(self.parse_extern_decl(cmts));
                                    } else {
                                        if self.check(formatter_lexer.kw_intent_marker()) {
                                            prog.intent_blocks.push(self.parse_intent_block(cmts));
                                        } else {
                                            if self.check(formatter_lexer.kw_public_marker()) {
                                                // `public` can precede function, entity, enum, trait.
                                                // Consume `public` and dispatch on what follows; we
                                                // already captured `cmts` above so they survive.
                                                self.advance();
                                                if self.check(formatter_lexer.kw_entity_marker()) {
                                                    prog.entities.push(self.parse_entity_decl(true, cmts));
                                                } else {
                                                    if self.check(formatter_lexer.kw_enum_marker()) {
                                                        prog.enums.push(self.parse_enum_decl(true, cmts));
                                                    } else {
                                                        if self.check(formatter_lexer.kw_trait_marker()) {
                                                            prog.traits.push(self.parse_trait_decl(true, cmts));
                                                        } else {
                                                            // `public function ...` — parse the function
                                                            // and mark it public after.
                                                            let mutable fd: FunctionDecl = self.parse_function_decl(cmts);
                                                            fd.is_public = true;
                                                            prog.functions.push(fd);
                                                        }
                                                    }
                                                }
                                            } else {
                                                if self.is_at_function_start() {
                                                    prog.functions.push(self.parse_function_decl(cmts));
                                                } else {
                                                    self.fail("expected a top-level declaration (module / import / function / entity / enum / trait / impl / test / extern / intent)");
                                                    prog.error = self.error;
                                                    return prog;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Phase 40A.2 / ADR 0044: trailing comments after the last decl are
        // attached by the lexer to the EOF token. The loop exits with
        // `self.position` on that token (when no error stopped us early), so
        // drain its leading comments into the Program.
        if self.at_end() {
            prog.trailing_comments = self.tokens[self.position].comments_before;
        }

        prog.error = self.error;
        return prog;
    }

    // True if the next 1-3 tokens introduce a function declaration. The
    // `public function` case is dispatched inline in parse_program because
    // entity mutation across a helper call doesn't propagate in the Rust
    // backend (entities are passed by value / cloned).
    method is_at_function_start() returns Bool {
        if self.check(formatter_lexer.kw_function()) { return true; }
        if self.check(formatter_lexer.kw_entry()) { return true; }
        if self.check(formatter_lexer.kw_async_marker()) { return true; }
        return false;
    }

    // --- Phase 36: top-level declaration parsers --------------------------

    // `entity NAME { field*; ctor?; method*; invariant?; }`
    method parse_entity_decl(is_public: Bool, leading_comments: Array<String>) returns EntityDecl {
        // ADR 0042: capture source line from the `entity` keyword. `public`
        // modifier (if present) is consumed by parse_program before this is
        // called; for typical one-line `public entity Foo {...}` source the
        // line matches. ADR 0044: leading_comments passed by caller.
        let entity_tok: Token = self.expect(formatter_lexer.kw_entity_marker(), "'entity'");
        let line: Int = entity_tok.line;
        let cmts: Array<String> = leading_comments;
        let name_tok: Token = self.expect(formatter_lexer.tk_ident(), "entity name");
        self.expect(formatter_lexer.tk_lbrace(), "'" + '{'.to_string() + "' to start entity body");
        let mutable fields: Array<FieldDecl> = [];
        let mutable methods: Array<FunctionDecl> = [];
        let mutable has_ctor: Bool = false;
        let mutable ctor: FunctionDecl = formatter_ast.empty_function_decl();
        let mutable invariants: Array<Expr> = [];
        while not self.at_end() and not self.check(formatter_lexer.tk_rbrace()) and self.error == "" {
            if self.check(formatter_lexer.kw_field_marker()) {
                fields.push(self.parse_field_decl());
            } else {
                if self.check(formatter_lexer.kw_constructor_marker()) {
                    ctor = self.parse_constructor_decl();
                    has_ctor = true;
                } else {
                    if self.check(formatter_lexer.kw_method_marker()) {
                        methods.push(self.parse_method_decl());
                    } else {
                        if self.check(formatter_lexer.kw_invariant_marker()) {
                            let invs: Array<Expr> = self.parse_invariant_block();
                            let mutable j: Int = 0;
                            while j < len(invs) {
                                invariants.push(invs[j]);
                                j = j + 1;
                            }
                        } else {
                            self.fail("expected 'field', 'constructor', 'method', or 'invariant' in entity body");
                            return EntityDecl(name_tok.text, is_public, fields, methods, has_ctor, ctor, invariants, line, cmts);
                        }
                    }
                }
            }
        }
        self.expect(formatter_lexer.tk_rbrace(), "'" + '}'.to_string() + "' to close entity body");
        return EntityDecl(name_tok.text, is_public, fields, methods, has_ctor, ctor, invariants, line, cmts);
    }

    // `field NAME: TYPE;`
    method parse_field_decl() returns FieldDecl {
        self.expect(formatter_lexer.kw_field_marker(), "'field'");
        let name_tok: Token = self.expect(formatter_lexer.tk_ident(), "field name");
        self.expect(formatter_lexer.tk_colon(), "':' after field name");
        let type_name: String = self.parse_type_name();
        self.expect(formatter_lexer.tk_semicolon(), "';' after field declaration");
        return FieldDecl(name_tok.text, type_name);
    }

    // `constructor(params) { body }` — constructors live inside entity
    // bodies so don't accept leading comments (the entity carries them).
    method parse_constructor_decl() returns FunctionDecl {
        let ctor_tok: Token = self.expect(formatter_lexer.kw_constructor_marker(), "'constructor'");
        let line: Int = ctor_tok.line;
        let mutable no_cmts: Array<String> = [];
        self.expect(formatter_lexer.tk_lparen(), "'(' after 'constructor'");
        let mutable params: Array<Param> = [];
        if not self.check(formatter_lexer.tk_rparen()) {
            params.push(self.parse_param());
            while self.check_consume(formatter_lexer.tk_comma()) {
                params.push(self.parse_param());
            }
        }
        self.expect(formatter_lexer.tk_rparen(), "')' to close constructor params");
        let body: Block = self.parse_block();
        return FunctionDecl("constructor", false, false, false, true, params, "", body, line, no_cmts);
    }

    // `method NAME(params) returns TYPE { body }` — contract clauses are
    // currently skipped between `returns TYPE` and `{` the same way
    // parse_function_decl does for top-level functions. Methods live
    // inside entity / impl bodies so don't accept leading comments at this
    // layer (their enclosing decl carries them).
    method parse_method_decl() returns FunctionDecl {
        let method_tok: Token = self.expect(formatter_lexer.kw_method_marker(), "'method'");
        let line: Int = method_tok.line;
        let mutable no_cmts: Array<String> = [];
        let name_tok: Token = self.expect(formatter_lexer.tk_ident(), "method name");
        self.expect(formatter_lexer.tk_lparen(), "'(' after method name");
        let mutable params: Array<Param> = [];
        if not self.check(formatter_lexer.tk_rparen()) {
            params.push(self.parse_param());
            while self.check_consume(formatter_lexer.tk_comma()) {
                params.push(self.parse_param());
            }
        }
        self.expect(formatter_lexer.tk_rparen(), "')' to close method params");
        self.expect(formatter_lexer.kw_returns(), "'returns' after method params");
        let ret: String = self.parse_type_name();
        self.skip_method_contracts();
        let body: Block = self.parse_block();
        return FunctionDecl(name_tok.text, false, false, false, false, params, ret, body, line, no_cmts);
    }

    // `invariant { EXPR; EXPR; ... }` — collect the bodies as Exprs.
    method parse_invariant_block() returns Array<Expr> {
        self.expect(formatter_lexer.kw_invariant_marker(), "'invariant'");
        self.expect(formatter_lexer.tk_lbrace(), "'" + '{'.to_string() + "' to start invariant block");
        let mutable exprs: Array<Expr> = [];
        while not self.at_end() and not self.check(formatter_lexer.tk_rbrace()) and self.error == "" {
            exprs.push(self.parse_expr());
            self.expect(formatter_lexer.tk_semicolon(), "';' after invariant expression");
        }
        self.expect(formatter_lexer.tk_rbrace(), "'" + '}'.to_string() + "' to close invariant block");
        return exprs;
    }

    // Crude contract-clause skip — same heuristic as parse_function_decl
    // uses at the top level. Replaced by a real contract parser in Phase 38+.
    method skip_method_contracts() returns Void {
        while self.check(formatter_lexer.tk_ident()) {
            self.advance();
            while not self.at_end() and not self.check(formatter_lexer.tk_lbrace()) and not self.check(formatter_lexer.tk_ident()) {
                self.advance();
            }
        }
    }

    // `enum NAME { VARIANT, VARIANT, ... }`
    method parse_enum_decl(is_public: Bool, leading_comments: Array<String>) returns EnumDecl {
        let enum_tok: Token = self.expect(formatter_lexer.kw_enum_marker(), "'enum'");
        let line: Int = enum_tok.line;
        let cmts: Array<String> = leading_comments;
        let name_tok: Token = self.expect(formatter_lexer.tk_ident(), "enum name");
        self.expect(formatter_lexer.tk_lbrace(), "'" + '{'.to_string() + "' to start enum body");
        let mutable variants: Array<EnumVariant> = [];
        if not self.check(formatter_lexer.tk_rbrace()) {
            variants.push(self.parse_enum_variant());
            while self.check_consume(formatter_lexer.tk_comma()) {
                if self.check(formatter_lexer.tk_rbrace()) {
                    // Trailing comma — accepted.
                    self.fail_off();
                } else {
                    variants.push(self.parse_enum_variant());
                }
            }
        }
        self.expect(formatter_lexer.tk_rbrace(), "'" + '}'.to_string() + "' to close enum body");
        return EnumDecl(name_tok.text, is_public, variants, line, cmts);
    }

    // Helper used by the trailing-comma branch: a no-op that documents
    // that we deliberately consume nothing when accepting the trailing
    // comma case. Kept as a method to centralise the intent.
    method fail_off() returns Void {
        return;
    }

    // `NAME` or `NAME(param, param, ...)`
    method parse_enum_variant() returns EnumVariant {
        let name_tok: Token = self.expect(formatter_lexer.tk_ident(), "enum variant name");
        let mutable params: Array<Param> = [];
        if self.check_consume(formatter_lexer.tk_lparen()) {
            if not self.check(formatter_lexer.tk_rparen()) {
                params.push(self.parse_param());
                while self.check_consume(formatter_lexer.tk_comma()) {
                    params.push(self.parse_param());
                }
            }
            self.expect(formatter_lexer.tk_rparen(), "')' to close variant params");
        }
        return EnumVariant(name_tok.text, params);
    }

    // `trait NAME { method NAME(params) returns TYPE; ... }`
    method parse_trait_decl(is_public: Bool, leading_comments: Array<String>) returns TraitDecl {
        let trait_tok: Token = self.expect(formatter_lexer.kw_trait_marker(), "'trait'");
        let line: Int = trait_tok.line;
        let cmts: Array<String> = leading_comments;
        let name_tok: Token = self.expect(formatter_lexer.tk_ident(), "trait name");
        self.expect(formatter_lexer.tk_lbrace(), "'" + '{'.to_string() + "' to start trait body");
        let mutable methods: Array<TraitMethodSig> = [];
        while not self.at_end() and not self.check(formatter_lexer.tk_rbrace()) and self.error == "" {
            methods.push(self.parse_trait_method_sig());
        }
        self.expect(formatter_lexer.tk_rbrace(), "'" + '}'.to_string() + "' to close trait body");
        return TraitDecl(name_tok.text, is_public, methods, line, cmts);
    }

    method parse_trait_method_sig() returns TraitMethodSig {
        self.expect(formatter_lexer.kw_method_marker(), "'method' in trait body");
        let name_tok: Token = self.expect(formatter_lexer.tk_ident(), "method name");
        self.expect(formatter_lexer.tk_lparen(), "'(' after method name");
        let mutable params: Array<Param> = [];
        if not self.check(formatter_lexer.tk_rparen()) {
            params.push(self.parse_param());
            while self.check_consume(formatter_lexer.tk_comma()) {
                params.push(self.parse_param());
            }
        }
        self.expect(formatter_lexer.tk_rparen(), "')' to close method params");
        self.expect(formatter_lexer.kw_returns(), "'returns' after method params");
        let ret: String = self.parse_type_name();
        self.expect(formatter_lexer.tk_semicolon(), "';' to end trait method signature");
        return TraitMethodSig(name_tok.text, params, ret);
    }

    // `impl TRAIT for ENTITY { method ... method ... }`
    method parse_impl_decl(leading_comments: Array<String>) returns ImplDecl {
        let impl_tok: Token = self.expect(formatter_lexer.kw_impl_marker(), "'impl'");
        let line: Int = impl_tok.line;
        let cmts: Array<String> = leading_comments;
        let trait_tok: Token = self.expect(formatter_lexer.tk_ident(), "trait name");
        self.expect(formatter_lexer.kw_for_marker(), "'for' in impl declaration");
        let entity_tok: Token = self.expect(formatter_lexer.tk_ident(), "entity name");
        self.expect(formatter_lexer.tk_lbrace(), "'" + '{'.to_string() + "' to start impl body");
        let mutable methods: Array<FunctionDecl> = [];
        while not self.at_end() and not self.check(formatter_lexer.tk_rbrace()) and self.error == "" {
            methods.push(self.parse_method_decl());
        }
        self.expect(formatter_lexer.tk_rbrace(), "'" + '}'.to_string() + "' to close impl body");
        return ImplDecl(trait_tok.text, entity_tok.text, methods, line, cmts);
    }

    // `test "name" { body }`
    method parse_test_decl(leading_comments: Array<String>) returns TestDecl {
        let test_tok: Token = self.expect(formatter_lexer.kw_test_marker(), "'test'");
        let line: Int = test_tok.line;
        let cmts: Array<String> = leading_comments;
        let name_tok: Token = self.expect(formatter_lexer.tk_string(), "test name (string literal)");
        let body: Block = self.parse_block();
        return TestDecl(self.unquote(name_tok.text), body, line, cmts);
    }

    // `extern "target" function NAME(params) returns TYPE;`
    method parse_extern_decl(leading_comments: Array<String>) returns ExternDecl {
        let extern_tok: Token = self.expect(formatter_lexer.kw_extern_marker(), "'extern'");
        let line: Int = extern_tok.line;
        let cmts: Array<String> = leading_comments;
        let target_tok: Token = self.expect(formatter_lexer.tk_string(), "target string literal");
        self.expect(formatter_lexer.kw_function(), "'function' after extern target");
        let name_tok: Token = self.expect(formatter_lexer.tk_ident(), "extern function name");
        self.expect(formatter_lexer.tk_lparen(), "'(' after extern function name");
        let mutable params: Array<Param> = [];
        if not self.check(formatter_lexer.tk_rparen()) {
            params.push(self.parse_param());
            while self.check_consume(formatter_lexer.tk_comma()) {
                params.push(self.parse_param());
            }
        }
        self.expect(formatter_lexer.tk_rparen(), "')' to close extern params");
        self.expect(formatter_lexer.kw_returns(), "'returns' after extern params");
        let ret: String = self.parse_type_name();
        self.expect(formatter_lexer.tk_semicolon(), "';' to end extern declaration");
        return ExternDecl(self.unquote(target_tok.text), name_tok.text, params, ret, line, cmts);
    }

    // `intent "description" { verified_by ident; verified_by ident; ... }`
    method parse_intent_block(leading_comments: Array<String>) returns IntentBlock {
        let intent_tok: Token = self.expect(formatter_lexer.kw_intent_marker(), "'intent'");
        let line: Int = intent_tok.line;
        let cmts: Array<String> = leading_comments;
        let goal_tok: Token = self.expect(formatter_lexer.tk_string(), "intent goal (string literal)");
        self.expect(formatter_lexer.tk_lbrace(), "'" + '{'.to_string() + "' to start intent block");
        let mutable verifs: Array<String> = [];
        while not self.at_end() and not self.check(formatter_lexer.tk_rbrace()) and self.error == "" {
            // `verified_by` isn't a lexer keyword — it's a regular ident
            // that we consume by text match. Anything else here is a
            // parse error.
            if self.check(formatter_lexer.tk_ident()) and self.peek_text() == "verified_by" {
                self.advance();
                let ref_tok: Token = self.expect(formatter_lexer.tk_ident(), "contract identifier after 'verified_by'");
                self.expect(formatter_lexer.tk_semicolon(), "';' after verified_by clause");
                verifs.push(ref_tok.text);
            } else {
                self.fail("expected 'verified_by' clause in intent block");
                return IntentBlock(self.unquote(goal_tok.text), verifs, line, cmts);
            }
        }
        self.expect(formatter_lexer.tk_rbrace(), "'" + '}'.to_string() + "' to close intent block");
        return IntentBlock(self.unquote(goal_tok.text), verifs, line, cmts);
    }
}

// AST helpers (empty_block, empty_expr, parse_int) moved to ast.intent in
// Phase 36 along with the entity declarations.

public function parse(source: String) returns Program {
    let mutable p: Parser = Parser(source);
    return p.parse_program();
}

entry function main() returns Int { return 0; }

// --- In-language tests ------------------------------------------------------

test "parse minimal module declaration" {
    let prog: Program = parse("module foo version \"1.0\";");
    assert_eq(prog.error, "");
    assert_eq(prog.module_decl.name, "foo");
    assert_eq(prog.module_decl.module_version, "1.0");
    assert_eq(len(prog.imports), 0);
    assert_eq(len(prog.functions), 0);
}

test "parse module with file imports" {
    let prog: Program = parse("module app version \"0.1\"; import \"helpers.intent\"; import \"types.intent\";");
    assert_eq(prog.error, "");
    assert_eq(len(prog.imports), 2);
    assert_eq(prog.imports[0].is_package, false);
    assert_eq(prog.imports[0].path, "helpers.intent");
    assert_eq(prog.imports[1].path, "types.intent");
}

test "parse module with package import" {
    let prog: Program = parse("module app version \"0.1\"; import graph_types;");
    assert_eq(prog.error, "");
    assert_eq(len(prog.imports), 1);
    assert_eq(prog.imports[0].is_package, true);
    assert_eq(prog.imports[0].path, "graph_types");
}

test "parse module with dotted package import" {
    let prog: Program = parse("module app version \"0.1\"; import graph_types.validation;");
    assert_eq(prog.error, "");
    assert_eq(prog.imports[0].is_package, true);
    assert_eq(prog.imports[0].path, "graph_types.validation");
}

test "parse function signature with no params" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions), 1);
    assert_eq(prog.functions[0].name, "f");
    assert_eq(prog.functions[0].is_public, false);
    assert_eq(prog.functions[0].is_entry, false);
    assert_eq(prog.functions[0].is_async, false);
    assert_eq(len(prog.functions[0].params), 0);
    assert_eq(prog.functions[0].return_type, "Int");
}

test "parse function with parameters" {
    let src: String = "module m version \"1.0\"; function add(a: Int, b: Int) returns Int " + '{'.to_string() + " return a + b; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions[0].params), 2);
    assert_eq(prog.functions[0].params[0].name, "a");
    assert_eq(prog.functions[0].params[0].type_name, "Int");
    assert_eq(prog.functions[0].params[1].name, "b");
}

test "parse entry function" {
    let src: String = "module m version \"1.0\"; entry function main() returns Int " + '{'.to_string() + " return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(prog.functions[0].is_entry, true);
    assert_eq(prog.functions[0].name, "main");
}

test "parse public function" {
    let src: String = "module m version \"1.0\"; public function helper() returns Void " + '{'.to_string() + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(prog.functions[0].is_public, true);
}

test "parse multiple functions" {
    let src: String = "module m version \"1.0\"; function a() returns Int " + '{'.to_string() + " return 1; " + '}'.to_string() + " function b() returns Int " + '{'.to_string() + " return 2; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions), 2);
    assert_eq(prog.functions[0].name, "a");
    assert_eq(prog.functions[1].name, "b");
}

test "function with generic return type captures head" {
    let src: String = "module m version \"1.0\"; function get_items() returns Array<Int> " + '{'.to_string() + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(prog.functions[0].return_type, "Array<...>");
}

test "parser reports unexpected token at top level" {
    // A bare integer literal at the top level isn't a valid declaration
    // start in any phase. Entities / enums / traits / impls / tests /
    // externs / intent blocks are now accepted (Phase 36).
    let prog: Program = parse("module m version \"1.0\"; 42;");
    assert(prog.error != "");
}

test "missing semicolon after module records error" {
    let prog: Program = parse("module foo version \"1.0\"");
    assert(prog.error != "");
}

// --- Phase 34: statement parser tests ---------------------------------------

test "empty function body produces empty block" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + '{'.to_string() + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions[0].body.stmts), 0);
}

test "single return parses as one st_return statement" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions[0].body.stmts), 1);
    let s: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(s.kind, formatter_ast.st_return());
    assert_eq(s.expr.kind, formatter_ast.ex_int());
    assert_eq(s.expr.int_value, 0);
}

test "return without value records ex_void" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + '{'.to_string() + " return; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let s: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(s.kind, formatter_ast.st_return());
    assert_eq(s.expr.kind, formatter_ast.ex_void());
}

test "let with type annotation" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " let x: Int = 7; return x; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions[0].body.stmts), 2);
    let l: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(l.kind, formatter_ast.st_let());
    assert_eq(l.name, "x");
    assert_eq(l.type_name, "Int");
    assert_eq(l.is_mutable, false);
    assert_eq(l.expr.kind, formatter_ast.ex_int());
    assert_eq(l.expr.int_value, 7);
    let r: Stmt = prog.functions[0].body.stmts[1];
    assert_eq(r.kind, formatter_ast.st_return());
    assert_eq(r.expr.kind, formatter_ast.ex_ident());
    assert_eq(r.expr.name, "x");
}

test "let mutable without annotation" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " let mutable y = 0; return y; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let l: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(l.kind, formatter_ast.st_let());
    assert_eq(l.name, "y");
    assert_eq(l.type_name, "");
    assert_eq(l.is_mutable, true);
    assert_eq(l.expr.kind, formatter_ast.ex_int());
    assert_eq(l.expr.int_value, 0);
}

test "expression statement is parsed as assignment binop" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " let mutable y = 0; y = y + 1; return y; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions[0].body.stmts), 3);
    let s: Stmt = prog.functions[0].body.stmts[1];
    assert_eq(s.kind, formatter_ast.st_expr());
    assert_eq(s.expr.kind, formatter_ast.ex_binop());
    assert_eq(s.expr.name, "=");
    assert_eq(s.expr.children[0].kind, formatter_ast.ex_ident());
    assert_eq(s.expr.children[0].name, "y");
    let rhs: Expr = s.expr.children[1];
    assert_eq(rhs.kind, formatter_ast.ex_binop());
    assert_eq(rhs.name, "+");
    assert_eq(rhs.children[0].name, "y");
    assert_eq(rhs.children[1].kind, formatter_ast.ex_int());
    assert_eq(rhs.children[1].int_value, 1);
}

test "if statement without else" {
    let src: String = "module m version \"1.0\"; function f(x: Int) returns Int " + '{'.to_string() + " if x > 0 " + '{'.to_string() + " return 1; " + '}'.to_string() + " return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions[0].body.stmts), 2);
    let iff: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(iff.kind, formatter_ast.st_if());
    assert_eq(iff.expr.kind, formatter_ast.ex_binop());
    assert_eq(iff.expr.name, ">");
    assert_eq(iff.expr.children[0].name, "x");
    assert_eq(iff.expr.children[1].int_value, 0);
    assert_eq(iff.has_else, false);
    assert_eq(len(iff.then_block.stmts), 1);
    let inner: Stmt = iff.then_block.stmts[0];
    assert_eq(inner.kind, formatter_ast.st_return());
    assert_eq(inner.expr.kind, formatter_ast.ex_int());
    assert_eq(inner.expr.int_value, 1);
}

test "if-else statement" {
    let src: String = "module m version \"1.0\"; function f(x: Int) returns Int " + '{'.to_string() + " if x > 0 " + '{'.to_string() + " return 1; " + '}'.to_string() + " else " + '{'.to_string() + " return 0; " + '}'.to_string() + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let iff: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(iff.kind, formatter_ast.st_if());
    assert_eq(iff.has_else, true);
    assert_eq(len(iff.else_block.stmts), 1);
    let else_ret: Stmt = iff.else_block.stmts[0];
    assert_eq(else_ret.expr.kind, formatter_ast.ex_int());
    assert_eq(else_ret.expr.int_value, 0);
}

test "else if chains into nested if in else_block" {
    let src: String = "module m version \"1.0\"; function f(x: Int) returns Int " + '{'.to_string()
        + " if x > 0 " + '{'.to_string() + " return 1; " + '}'.to_string()
        + " else if x < 0 " + '{'.to_string() + " return 0 - 1; " + '}'.to_string()
        + " else " + '{'.to_string() + " return 0; " + '}'.to_string()
        + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let outer: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(outer.kind, formatter_ast.st_if());
    assert_eq(outer.has_else, true);
    assert_eq(len(outer.else_block.stmts), 1);
    let inner: Stmt = outer.else_block.stmts[0];
    assert_eq(inner.kind, formatter_ast.st_if());
    assert_eq(inner.expr.kind, formatter_ast.ex_binop());
    assert_eq(inner.expr.name, "<");
    assert_eq(inner.has_else, true);
    assert_eq(inner.else_block.stmts[0].expr.int_value, 0);
}

test "while statement" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string()
        + " let mutable i: Int = 0; while i < 10 " + '{'.to_string() + " i = i + 1; " + '}'.to_string()
        + " return i; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let w: Stmt = prog.functions[0].body.stmts[1];
    assert_eq(w.kind, formatter_ast.st_while());
    assert_eq(w.expr.kind, formatter_ast.ex_binop());
    assert_eq(w.expr.name, "<");
    assert_eq(w.expr.children[0].name, "i");
    assert_eq(w.expr.children[1].int_value, 10);
    assert_eq(len(w.then_block.stmts), 1);
    let inc: Stmt = w.then_block.stmts[0];
    assert_eq(inc.kind, formatter_ast.st_expr());
    assert_eq(inc.expr.kind, formatter_ast.ex_binop());
    assert_eq(inc.expr.name, "=");
}

test "call expression with arguments parses as ex_call" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string()
        + " let x: Int = add(1, 2); return x; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let l: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(l.expr.kind, formatter_ast.ex_call());
    assert_eq(len(l.expr.children), 3);
    assert_eq(l.expr.children[0].kind, formatter_ast.ex_ident());
    assert_eq(l.expr.children[0].name, "add");
    assert_eq(l.expr.children[1].int_value, 1);
    assert_eq(l.expr.children[2].int_value, 2);
}

test "nested if inside if then-block" {
    let src: String = "module m version \"1.0\"; function f(x: Int, y: Int) returns Int " + '{'.to_string()
        + " if x > 0 " + '{'.to_string()
        + " if y > 0 " + '{'.to_string() + " return 1; " + '}'.to_string()
        + " " + '}'.to_string()
        + " return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let outer: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(outer.kind, formatter_ast.st_if());
    let inner: Stmt = outer.then_block.stmts[0];
    assert_eq(inner.kind, formatter_ast.st_if());
    assert_eq(inner.expr.kind, formatter_ast.ex_binop());
    assert_eq(inner.expr.name, ">");
    assert_eq(inner.expr.children[0].name, "y");
}

test "missing semicolon after return is reported" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " return 0 " + '}'.to_string();
    let prog: Program = parse(src);
    assert(prog.error != "");
}

// --- Phase 35: expression parser tests --------------------------------------

// Small helper: extract the RHS Expr of the let-binding in `let x = E;`
// from a one-statement function body. Keeps test fixtures terse.
public function single_let_rhs(prog: Program) returns Expr {
    return prog.functions[0].body.stmts[0].expr;
}

public function wrap_in_let(rhs_text: String) returns String {
    return "module m version \"1.0\"; function f() returns Int " + '{'.to_string()
         + " let x: Int = " + rhs_text + "; return x; " + '}'.to_string();
}

test "parse_int converts decimal token text" {
    assert_eq(formatter_ast.parse_int("0"), 0);
    assert_eq(formatter_ast.parse_int("7"), 7);
    assert_eq(formatter_ast.parse_int("42"), 42);
    assert_eq(formatter_ast.parse_int("12345"), 12345);
}

test "integer literal expression" {
    let prog: Program = parse(wrap_in_let("99"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, formatter_ast.ex_int());
    assert_eq(e.int_value, 99);
}

test "bool literals parse as ex_bool" {
    let prog_t: Program = parse(wrap_in_let("true"));
    let e_t: Expr = single_let_rhs(prog_t);
    assert_eq(e_t.kind, formatter_ast.ex_bool());
    assert_eq(e_t.bool_value, true);
    let prog_f: Program = parse(wrap_in_let("false"));
    let e_f: Expr = single_let_rhs(prog_f);
    assert_eq(e_f.kind, formatter_ast.ex_bool());
    assert_eq(e_f.bool_value, false);
}

test "float literal expression" {
    let prog: Program = parse(wrap_in_let("3.14"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, formatter_ast.ex_float());
    assert_eq(e.str_value, "3.14");
}

test "float literal with exponent expression" {
    let prog: Program = parse(wrap_in_let("1.5e-3"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, formatter_ast.ex_float());
    assert_eq(e.str_value, "1.5e-3");
}

test "char literal expression" {
    let prog: Program = parse(wrap_in_let("'a'"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, formatter_ast.ex_char());
    assert_eq(e.str_value, "'a'");
}

test "char escape literal expression" {
    let prog: Program = parse(wrap_in_let("'\\n'"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, formatter_ast.ex_char());
    assert_eq(e.str_value, "'\\n'");
}

test "string literal preserves quotes-stripped value" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string()
        + " let s: String = \"hello\"; return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, formatter_ast.ex_string());
    assert_eq(e.str_value, "hello");
}

test "unary minus on int literal" {
    let prog: Program = parse(wrap_in_let("-5"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, formatter_ast.ex_unary());
    assert_eq(e.name, "-");
    assert_eq(e.children[0].kind, formatter_ast.ex_int());
    assert_eq(e.children[0].int_value, 5);
}

test "unary not on bool" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string()
        + " let b: Bool = not true; return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, formatter_ast.ex_unary());
    assert_eq(e.name, "not");
    assert_eq(e.children[0].kind, formatter_ast.ex_bool());
    assert_eq(e.children[0].bool_value, true);
}

test "operator precedence: 1 + 2 * 3 binds * tighter" {
    let prog: Program = parse(wrap_in_let("1 + 2 * 3"));
    assert_eq(prog.error, "");
    let root: Expr = single_let_rhs(prog);
    assert_eq(root.kind, formatter_ast.ex_binop());
    assert_eq(root.name, "+");
    assert_eq(root.children[0].int_value, 1);
    let rhs: Expr = root.children[1];
    assert_eq(rhs.kind, formatter_ast.ex_binop());
    assert_eq(rhs.name, "*");
    assert_eq(rhs.children[0].int_value, 2);
    assert_eq(rhs.children[1].int_value, 3);
}

test "operator precedence: comparison binds tighter than and" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string()
        + " let b: Bool = 1 < 2 and 3 > 4; return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let root: Expr = single_let_rhs(prog);
    assert_eq(root.kind, formatter_ast.ex_binop());
    assert_eq(root.name, "and");
    assert_eq(root.children[0].name, "<");
    assert_eq(root.children[1].name, ">");
}

test "parens override precedence" {
    let prog: Program = parse(wrap_in_let("(1 + 2) * 3"));
    assert_eq(prog.error, "");
    let root: Expr = single_let_rhs(prog);
    assert_eq(root.kind, formatter_ast.ex_binop());
    assert_eq(root.name, "*");
    assert_eq(root.children[0].kind, formatter_ast.ex_paren());
    let inner: Expr = root.children[0].children[0];
    assert_eq(inner.kind, formatter_ast.ex_binop());
    assert_eq(inner.name, "+");
}

test "assignment is right-associative" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string()
        + " a = b = c; return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let s: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(s.expr.kind, formatter_ast.ex_binop());
    assert_eq(s.expr.name, "=");
    assert_eq(s.expr.children[0].name, "a");
    let rhs: Expr = s.expr.children[1];
    assert_eq(rhs.kind, formatter_ast.ex_binop());
    assert_eq(rhs.name, "=");
    assert_eq(rhs.children[0].name, "b");
    assert_eq(rhs.children[1].name, "c");
}

test "field access via dot" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string()
        + " let n: Int = self.position; return n; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, formatter_ast.ex_field());
    assert_eq(e.name, "position");
    assert_eq(e.children[0].kind, formatter_ast.ex_ident());
    assert_eq(e.children[0].name, "self");
}

test "method call: x.to_string()" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string()
        + " let s: String = x.to_string(); return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    // x.to_string() = call(field(ident "x", "to_string"))
    assert_eq(e.kind, formatter_ast.ex_call());
    let callee: Expr = e.children[0];
    assert_eq(callee.kind, formatter_ast.ex_field());
    assert_eq(callee.name, "to_string");
    assert_eq(callee.children[0].name, "x");
}

test "indexing: arr[0]" {
    let prog: Program = parse(wrap_in_let("arr[0]"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, formatter_ast.ex_index());
    assert_eq(e.children[0].name, "arr");
    assert_eq(e.children[1].int_value, 0);
}

test "slice: s[i..j] parses as index of range" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string()
        + " let sub: String = s[1..5]; return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, formatter_ast.ex_index());
    let idx: Expr = e.children[1];
    assert_eq(idx.kind, formatter_ast.ex_range());
    assert_eq(idx.children[0].int_value, 1);
    assert_eq(idx.children[1].int_value, 5);
}

test "array literal parses as ex_array" {
    let prog: Program = parse(wrap_in_let("[10, 20, 30]"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, formatter_ast.ex_array());
    assert_eq(len(e.children), 3);
    assert_eq(e.children[0].int_value, 10);
    assert_eq(e.children[1].int_value, 20);
    assert_eq(e.children[2].int_value, 30);
}

test "empty array literal" {
    let prog: Program = parse(wrap_in_let("[]"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, formatter_ast.ex_array());
    assert_eq(len(e.children), 0);
}

test "no-arg call: f()" {
    let prog: Program = parse(wrap_in_let("f()"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, formatter_ast.ex_call());
    assert_eq(len(e.children), 1);
    assert_eq(e.children[0].name, "f");
}

test "nested call f(g(x))" {
    let prog: Program = parse(wrap_in_let("f(g(x))"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, formatter_ast.ex_call());
    assert_eq(e.children[0].name, "f");
    let arg: Expr = e.children[1];
    assert_eq(arg.kind, formatter_ast.ex_call());
    assert_eq(arg.children[0].name, "g");
    assert_eq(arg.children[1].name, "x");
}

test "method chain a.b().c() left-associates" {
    let prog: Program = parse(wrap_in_let("a.b().c()"));
    assert_eq(prog.error, "");
    let outer: Expr = single_let_rhs(prog);
    // outer = call(field(call(field(a, b)), c))
    assert_eq(outer.kind, formatter_ast.ex_call());
    let callee_c: Expr = outer.children[0];
    assert_eq(callee_c.kind, formatter_ast.ex_field());
    assert_eq(callee_c.name, "c");
    let inner_call: Expr = callee_c.children[0];
    assert_eq(inner_call.kind, formatter_ast.ex_call());
    let callee_b: Expr = inner_call.children[0];
    assert_eq(callee_b.kind, formatter_ast.ex_field());
    assert_eq(callee_b.name, "b");
    assert_eq(callee_b.children[0].name, "a");
}

test "qualified call via module path: mod.func(arg)" {
    let prog: Program = parse(wrap_in_let("formatter_lexer.tk_eof()"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, formatter_ast.ex_call());
    let callee: Expr = e.children[0];
    assert_eq(callee.kind, formatter_ast.ex_field());
    assert_eq(callee.name, "tk_eof");
    assert_eq(callee.children[0].name, "formatter_lexer");
}

test "equality and comparison both parse" {
    let prog_eq: Program = parse(wrap_in_let("a == b"));
    let e_eq: Expr = single_let_rhs(prog_eq);
    assert_eq(e_eq.name, "==");
    let prog_neq: Program = parse(wrap_in_let("a != b"));
    let e_neq: Expr = single_let_rhs(prog_neq);
    assert_eq(e_neq.name, "!=");
    let prog_leq: Program = parse(wrap_in_let("a <= b"));
    let e_leq: Expr = single_let_rhs(prog_leq);
    assert_eq(e_leq.name, "<=");
}

test "missing expression after = reports error" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string()
        + " let x: Int = ; return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert(prog.error != "");
}

// --- Phase 36: top-level declaration tests ----------------------------------

test "entity with two fields and no methods" {
    let src: String = "module m version \"1.0\"; entity Point " + '{'.to_string()
        + " field x: Int; field y: Int; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.entities), 1);
    let e: EntityDecl = prog.entities[0];
    assert_eq(e.name, "Point");
    assert_eq(e.is_public, false);
    assert_eq(len(e.fields), 2);
    assert_eq(e.fields[0].name, "x");
    assert_eq(e.fields[0].type_name, "Int");
    assert_eq(e.fields[1].name, "y");
    assert_eq(e.has_constructor, false);
}

test "public entity is marked public" {
    let src: String = "module m version \"1.0\"; public entity Token " + '{'.to_string()
        + " field kind: Int; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.entities), 1);
    assert_eq(prog.entities[0].is_public, true);
    assert_eq(prog.entities[0].name, "Token");
}

test "entity with constructor" {
    let src: String = "module m version \"1.0\"; entity Pair " + '{'.to_string()
        + " field a: Int; field b: Int; "
        + " constructor(a: Int, b: Int) " + '{'.to_string() + " self.a = a; self.b = b; " + '}'.to_string()
        + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let e: EntityDecl = prog.entities[0];
    assert_eq(e.has_constructor, true);
    assert_eq(e.ctor.is_constructor, true);
    assert_eq(len(e.ctor.params), 2);
    assert_eq(e.ctor.params[0].name, "a");
    assert_eq(len(e.ctor.body.stmts), 2);
}

test "entity with method" {
    let src: String = "module m version \"1.0\"; entity Counter " + '{'.to_string()
        + " field n: Int; "
        + " method get() returns Int " + '{'.to_string() + " return self.n; " + '}'.to_string()
        + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let e: EntityDecl = prog.entities[0];
    assert_eq(len(e.methods), 1);
    assert_eq(e.methods[0].name, "get");
    assert_eq(e.methods[0].return_type, "Int");
    assert_eq(e.methods[0].is_constructor, false);
}

test "entity with invariant block" {
    let src: String = "module m version \"1.0\"; entity Bounded " + '{'.to_string()
        + " field n: Int; "
        + " invariant " + '{'.to_string() + " self.n >= 0; self.n < 100; " + '}'.to_string()
        + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let e: EntityDecl = prog.entities[0];
    assert_eq(len(e.invariants), 2);
    assert_eq(e.invariants[0].kind, formatter_ast.ex_binop());
    assert_eq(e.invariants[0].name, ">=");
}

test "enum with unit variants" {
    let src: String = "module m version \"1.0\"; enum Status " + '{'.to_string()
        + " Pending, Running, Complete " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.enums), 1);
    let e: EnumDecl = prog.enums[0];
    assert_eq(e.name, "Status");
    assert_eq(len(e.variants), 3);
    assert_eq(e.variants[0].name, "Pending");
    assert_eq(len(e.variants[0].params), 0);
}

test "enum with data-carrying variants" {
    let src: String = "module m version \"1.0\"; enum Shape " + '{'.to_string()
        + " Circle(radius: Int), Square(side: Int), Point " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let e: EnumDecl = prog.enums[0];
    assert_eq(len(e.variants), 3);
    assert_eq(e.variants[0].name, "Circle");
    assert_eq(len(e.variants[0].params), 1);
    assert_eq(e.variants[0].params[0].name, "radius");
    assert_eq(e.variants[1].name, "Square");
    assert_eq(len(e.variants[1].params), 1);
    assert_eq(e.variants[2].name, "Point");
    assert_eq(len(e.variants[2].params), 0);
}

test "trait with method signatures" {
    let src: String = "module m version \"1.0\"; trait Drawable " + '{'.to_string()
        + " method draw() returns Void; method area() returns Int; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.traits), 1);
    let t: TraitDecl = prog.traits[0];
    assert_eq(t.name, "Drawable");
    assert_eq(len(t.methods), 2);
    assert_eq(t.methods[0].name, "draw");
    assert_eq(t.methods[0].return_type, "Void");
    assert_eq(t.methods[1].name, "area");
}

test "impl Trait for Entity with methods" {
    let src: String = "module m version \"1.0\"; impl Drawable for Circle " + '{'.to_string()
        + " method draw() returns Void " + '{'.to_string() + " " + '}'.to_string()
        + " method area() returns Int " + '{'.to_string() + " return 0; " + '}'.to_string()
        + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.impls), 1);
    let i: ImplDecl = prog.impls[0];
    assert_eq(i.trait_name, "Drawable");
    assert_eq(i.entity_name, "Circle");
    assert_eq(len(i.methods), 2);
}

test "test declaration captures name and body" {
    let src: String = "module m version \"1.0\"; test \"sanity\" " + '{'.to_string()
        + " let x: Int = 1; assert_eq(x, 1); " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.tests), 1);
    let t: TestDecl = prog.tests[0];
    assert_eq(t.name, "sanity");
    assert_eq(len(t.body.stmts), 2);
}

test "extern declaration captures target + signature" {
    let src: String = "module m version \"1.0\"; extern \"rust\" function panic(msg: String) returns Void;";
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.externs), 1);
    let e: ExternDecl = prog.externs[0];
    assert_eq(e.target, "rust");
    assert_eq(e.func_name, "panic");
    assert_eq(len(e.params), 1);
    assert_eq(e.params[0].name, "msg");
    assert_eq(e.return_type, "Void");
}

test "intent block captures goal and verified_by refs" {
    let src: String = "module m version \"1.0\"; intent \"non-negative balance\" " + '{'.to_string()
        + " verified_by ensures_positive; verified_by no_overdraft; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.intent_blocks), 1);
    let ib: IntentBlock = prog.intent_blocks[0];
    assert_eq(ib.goal_text, "non-negative balance");
    assert_eq(len(ib.verifications), 2);
    assert_eq(ib.verifications[0], "ensures_positive");
    assert_eq(ib.verifications[1], "no_overdraft");
}

test "mixed declarations parse in any order" {
    let src: String = "module m version \"1.0\"; "
        + "entity E " + '{'.to_string() + " field a: Int; " + '}'.to_string()
        + " function f() returns Int " + '{'.to_string() + " return 0; " + '}'.to_string()
        + " test \"t\" " + '{'.to_string() + " " + '}'.to_string()
        + " enum K " + '{'.to_string() + " A " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.entities), 1);
    assert_eq(len(prog.functions), 1);
    assert_eq(len(prog.tests), 1);
    assert_eq(len(prog.enums), 1);
}

test "phase 37 dogfood: float + char literals + block comments parse end-to-end" {
    // Exercises the three Phase 37 lexer additions in one program.
    let src: String = "module sample version \"0.1\"; "
        + "/* block comment with /* nested */ inside */ "
        + "function f() returns Int " + '{'.to_string()
        + " let pi: Float = 3.14; "
        + " let exp: Float = 1.5e-3; "
        + " let nl: Char = '\\n'; "
        + " return 0; "
        + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions), 1);
    let fn_decl: FunctionDecl = prog.functions[0];
    assert_eq(fn_decl.name, "f");
    let stmts: Array<Stmt> = fn_decl.body.stmts;
    // 3 let stmts + 1 return
    assert_eq(len(stmts), 4);
    assert_eq(stmts[0].expr.kind, formatter_ast.ex_float());
    assert_eq(stmts[0].expr.str_value, "3.14");
    assert_eq(stmts[1].expr.kind, formatter_ast.ex_float());
    assert_eq(stmts[1].expr.str_value, "1.5e-3");
    assert_eq(stmts[2].expr.kind, formatter_ast.ex_char());
    assert_eq(stmts[2].expr.str_value, "'\\n'");
}

test "synthetic dogfood: parse a small entity with methods and tests" {
    let src: String = "module sample version \"0.1\"; "
        + "public entity Counter " + '{'.to_string()
        + " field n: Int; "
        + " constructor(initial: Int) " + '{'.to_string() + " self.n = initial; " + '}'.to_string()
        + " method increment() returns Int " + '{'.to_string()
        + " self.n = self.n + 1; return self.n; " + '}'.to_string()
        + " " + '}'.to_string()
        + " test \"counter increments\" " + '{'.to_string()
        + " let c: Counter = Counter(0); let n: Int = c.increment(); assert_eq(n, 1); " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.entities), 1);
    let counter: EntityDecl = prog.entities[0];
    assert_eq(counter.name, "Counter");
    assert_eq(counter.is_public, true);
    assert_eq(counter.has_constructor, true);
    assert_eq(len(counter.methods), 1);
    assert_eq(len(prog.tests), 1);
    assert_eq(prog.tests[0].name, "counter increments");
}
