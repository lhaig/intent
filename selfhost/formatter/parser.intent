// selfhost/formatter/parser.intent — Phase 33 + 34 / ADR 0040 stage2.
//
// Parses the top-level shape of an Intent program:
//   - module declaration
//   - imports
//   - function declarations (modifiers + signature)
//   - function bodies as Block of statements (let / return / if-else /
//     while / expression statements). Phase 34 addition.
//
// Out of scope (deferred to Phase 35+):
//   - parsing expressions properly — Phase 34 captures expression text as
//     a raw token-joined String via depth-balanced bracket scanning.
//   - entity / trait / impl / intent / test / extern declarations.
//   - type-argument lists (Array<T>, Result<T,E>, etc.) — captures a
//     primitive type or bare identifier with a "<...>" suffix marker.
//   - match / for / break / continue / try / await statements.
//
// Builds on Phase 32's lexer (formatter_lexer module).
//
// AST shape choice (Phase 34): one `Stmt` entity with Int discriminator
// + per-kind fields, mirroring how Token uses `kind: Int`. Intent enums
// with payloads would force every field access through a match arm and
// each arm is a single expression, so a sum-typed Stmt would be awkward
// to consume. Single-entity-with-tag is the same trade Token already
// makes; recursive sizing isn't a problem because nested Block fields
// are reached via Array<Stmt> which is heap-allocated.

module formatter_parser version "0.1.0";

import "lexer.intent";

// --- Statement kind constants -----------------------------------------------
//
// Same Int-discriminator pattern as Token's tk_*() functions in the lexer.

public function st_let() returns Int { return 1; }
public function st_return() returns Int { return 2; }
public function st_if() returns Int { return 3; }
public function st_while() returns Int { return 4; }
public function st_expr() returns Int { return 5; }

// --- AST entities -----------------------------------------------------------

public entity Param {
    field name: String;
    field type_name: String;

    constructor(name: String, type_name: String) {
        self.name = name;
        self.type_name = type_name;
    }
}

// Statement node. Field usage by kind:
//   st_let    — name, type_name, is_mutable, expr_text (rhs)
//   st_return — expr_text (may be empty for `return;`)
//   st_expr   — expr_text
//   st_if     — expr_text (condition), then_block, else_block, has_else
//   st_while  — expr_text (condition), then_block (body)
// Unused fields are populated with default values ("" / false / empty_block()).
public entity Stmt {
    field kind: Int;
    field expr_text: String;
    field name: String;
    field type_name: String;
    field is_mutable: Bool;
    field then_block: Block;
    field else_block: Block;
    field has_else: Bool;

    constructor(kind: Int, expr_text: String, name: String, type_name: String, is_mutable: Bool, then_block: Block, else_block: Block, has_else: Bool) {
        self.kind = kind;
        self.expr_text = expr_text;
        self.name = name;
        self.type_name = type_name;
        self.is_mutable = is_mutable;
        self.then_block = then_block;
        self.else_block = else_block;
        self.has_else = has_else;
    }
}

public entity Block {
    field stmts: Array<Stmt>;

    constructor(stmts: Array<Stmt>) {
        self.stmts = stmts;
    }
}

public entity FunctionDecl {
    field name: String;
    field is_public: Bool;
    field is_entry: Bool;
    field is_async: Bool;
    field params: Array<Param>;
    field return_type: String;
    field body: Block;

    constructor(name: String, is_public: Bool, is_entry: Bool, is_async: Bool, params: Array<Param>, return_type: String, body: Block) {
        self.name = name;
        self.is_public = is_public;
        self.is_entry = is_entry;
        self.is_async = is_async;
        self.params = params;
        self.return_type = return_type;
        self.body = body;
    }
}

public entity ImportDecl {
    field is_package: Bool;
    field path: String; // file path for file imports; package identifier for package imports

    constructor(is_package: Bool, path: String) {
        self.is_package = is_package;
        self.path = path;
    }
}

public entity ModuleDecl {
    field name: String;
    field module_version: String;

    constructor(name: String, module_version: String) {
        self.name = name;
        self.module_version = module_version;
    }
}

public entity Program {
    field module_decl: ModuleDecl;
    field imports: Array<ImportDecl>;
    field functions: Array<FunctionDecl>;
    field error: String; // empty when parse succeeded

    constructor(module_decl: ModuleDecl, imports: Array<ImportDecl>, functions: Array<FunctionDecl>, error: String) {
        self.module_decl = module_decl;
        self.imports = imports;
        self.functions = functions;
        self.error = error;
    }
}

// --- Parser -----------------------------------------------------------------

public entity Parser {
    field tokens: Array<Token>;
    field position: Int;
    field error: String;

    constructor(source: String) {
        self.tokens = formatter_lexer.lex(source);
        self.position = 0;
        self.error = "";
    }

    method at_end() returns Bool {
        return self.peek_kind() == formatter_lexer.tk_eof();
    }

    method peek_kind() returns Int {
        return self.tokens[self.position].kind;
    }

    method peek_text() returns String {
        return self.tokens[self.position].text;
    }

    method peek_n(n: Int) returns Int {
        let idx: Int = self.position + n;
        if idx >= len(self.tokens) {
            return formatter_lexer.tk_eof();
        }
        return self.tokens[idx].kind;
    }

    method advance() returns Token {
        let tok: Token = self.tokens[self.position];
        if self.position < len(self.tokens) - 1 {
            self.position = self.position + 1;
        }
        return tok;
    }

    method check(kind: Int) returns Bool {
        return self.peek_kind() == kind;
    }

    method check_consume(kind: Int) returns Bool {
        if self.check(kind) {
            self.advance();
            return true;
        }
        return false;
    }

    // Records an error and advances past one token so we make progress.
    // Returns the offending token's text for callers that want it.
    method fail(message: String) returns String {
        if self.error == "" {
            let tok: Token = self.tokens[self.position];
            self.error = "line " + tok.line.to_string() + " col " + tok.column.to_string() + ": " + message;
        }
        if not self.at_end() {
            self.advance();
        }
        return "";
    }

    method expect(kind: Int, what: String) returns Token {
        if self.check(kind) {
            return self.advance();
        }
        self.fail("expected " + what);
        return self.tokens[self.position];
    }

    // Strips the surrounding quotes from a string-literal token text.
    method unquote(text: String) returns String {
        let n: Int = len(text);
        if n < 2 {
            return text;
        }
        return text[1..n - 1];
    }

    // --- top-level parse entry points -------------------------------------

    method parse_module_decl() returns ModuleDecl {
        self.expect(formatter_lexer.kw_module(), "'module' keyword");
        let name_tok: Token = self.expect(formatter_lexer.tk_ident(), "module name");
        self.expect(formatter_lexer.kw_version(), "'version' keyword");
        let ver_tok: Token = self.expect(formatter_lexer.tk_string(), "version string literal");
        self.expect(formatter_lexer.tk_semicolon(), "';' after module declaration");
        return ModuleDecl(name_tok.text, self.unquote(ver_tok.text));
    }

    method parse_import_decl() returns ImportDecl {
        self.expect(formatter_lexer.kw_import_marker(), "'import' keyword");
        if self.check(formatter_lexer.tk_string()) {
            let path_tok: Token = self.advance();
            self.expect(formatter_lexer.tk_semicolon(), "';' after import");
            return ImportDecl(false, self.unquote(path_tok.text));
        }
        if self.check(formatter_lexer.tk_ident()) {
            let pkg_tok: Token = self.advance();
            let mutable path: String = pkg_tok.text;
            // Dotted package paths: pkg.sub.deeper
            while self.check_consume(formatter_lexer.tk_dot()) {
                if self.check(formatter_lexer.tk_ident()) {
                    let seg: Token = self.advance();
                    path = path + "." + seg.text;
                } else {
                    self.fail("expected identifier after '.' in import");
                    return ImportDecl(true, path);
                }
            }
            self.expect(formatter_lexer.tk_semicolon(), "';' after import");
            return ImportDecl(true, path);
        }
        self.fail("expected string or identifier after 'import'");
        return ImportDecl(false, "");
    }

    method parse_param() returns Param {
        let name_tok: Token = self.expect(formatter_lexer.tk_ident(), "parameter name");
        self.expect(formatter_lexer.tk_colon(), "':' after parameter name");
        let type_name: String = self.parse_type_name();
        return Param(name_tok.text, type_name);
    }

    // Recognises a primitive type (Int / String / Bool / Void / Char) or a
    // bare identifier. Generic arguments (Array<T>, Result<T, E>) are
    // consumed but not modelled — Phase 33 stores the head only and
    // discards the args. Phase 34+ will replace this with a real TypeRef.
    method parse_type_name() returns String {
        let tok: Token = self.advance();
        let mutable name: String = tok.text;
        // Skip a single optional <...> generic-arg list (no nesting in v1).
        if self.check_consume(formatter_lexer.tk_lt()) {
            let mutable depth: Int = 1;
            while depth > 0 and not self.at_end() {
                if self.check_consume(formatter_lexer.tk_lt()) {
                    depth = depth + 1;
                } else {
                    if self.check_consume(formatter_lexer.tk_gt()) {
                        depth = depth - 1;
                    } else {
                        self.advance();
                    }
                }
            }
            name = name + "<...>";
        }
        return name;
    }

    method parse_function_decl() returns FunctionDecl {
        let mutable is_public: Bool = false;
        let mutable is_async: Bool = false;
        let mutable is_entry: Bool = false;

        // Optional modifiers in any order before `function`.
        // (The full grammar restricts ordering more tightly; v1 parser
        // accepts any.)
        let mutable scanning_modifiers: Bool = true;
        while scanning_modifiers {
            if self.check(formatter_lexer.kw_public_marker()) {
                self.advance();
                is_public = true;
            } else {
                if self.check(formatter_lexer.kw_async_marker()) {
                    self.advance();
                    is_async = true;
                } else {
                    if self.check(formatter_lexer.kw_entry()) {
                        self.advance();
                        is_entry = true;
                    } else {
                        scanning_modifiers = false;
                    }
                }
            }
        }

        self.expect(formatter_lexer.kw_function(), "'function' keyword");
        let name_tok: Token = self.expect(formatter_lexer.tk_ident(), "function name");

        self.expect(formatter_lexer.tk_lparen(), "'(' after function name");
        let mutable params: Array<Param> = [];
        if not self.check(formatter_lexer.tk_rparen()) {
            params.push(self.parse_param());
            while self.check_consume(formatter_lexer.tk_comma()) {
                params.push(self.parse_param());
            }
        }
        self.expect(formatter_lexer.tk_rparen(), "')' to close parameter list");

        // Contracts on top-level functions are part of the surface (`requires`
        // / `ensures` / `decreases`) but they aren't tokenised as keywords
        // in v1's lexer. Skip them by scanning identifiers/expressions until
        // we hit `returns` or `{`.

        self.expect(formatter_lexer.kw_returns(), "'returns' after parameter list");
        let return_type: String = self.parse_type_name();

        // Skip optional contract clauses (requires/ensures/decreases). Each
        // starts with an identifier and runs to end-of-line-ish. v1 just
        // bails out when we see `{` or EOF.
        while self.check(formatter_lexer.tk_ident()) {
            // Skip the contract keyword + its predicate up to the next
            // top-level boundary. Heuristic: consume until newline-ish — we
            // approximate by skipping tokens until { or end of function.
            self.advance();
            // crude scan: keep going until we hit `{` or another contract-
            // looking ident at column 1 — Phase 34 will replace this.
            while not self.at_end() and not self.check(formatter_lexer.tk_lbrace()) and not self.check(formatter_lexer.tk_ident()) {
                self.advance();
            }
        }

        let body: Block = self.parse_block();
        return FunctionDecl(name_tok.text, is_public, is_entry, is_async, params, return_type, body);
    }

    // --- statement-level parse -------------------------------------------

    // Parses a brace-delimited `{ ... }` block: consumes opening `{`, then
    // dispatches into statement parsers until it sees a `}` at this level.
    // Records (but does not propagate via panic) any error via self.fail.
    method parse_block() returns Block {
        self.expect(formatter_lexer.tk_lbrace(), "'" + '{'.to_string() + "' to start block");
        let mutable stmts: Array<Stmt> = [];
        while not self.at_end() and not self.check(formatter_lexer.tk_rbrace()) and self.error == "" {
            stmts.push(self.parse_statement());
        }
        self.expect(formatter_lexer.tk_rbrace(), "'" + '}'.to_string() + "' to close block");
        return Block(stmts);
    }

    method parse_statement() returns Stmt {
        if self.check(formatter_lexer.kw_let()) {
            return self.parse_let_stmt();
        }
        if self.check(formatter_lexer.kw_return()) {
            return self.parse_return_stmt();
        }
        if self.check(formatter_lexer.kw_if()) {
            return self.parse_if_stmt();
        }
        if self.check(formatter_lexer.kw_while()) {
            return self.parse_while_stmt();
        }
        return self.parse_expr_stmt();
    }

    // `let [mutable] IDENT [: TYPE] = EXPR;`
    method parse_let_stmt() returns Stmt {
        self.expect(formatter_lexer.kw_let(), "'let'");
        let mutable is_mut: Bool = false;
        if self.check_consume(formatter_lexer.kw_mutable()) {
            is_mut = true;
        }
        let name_tok: Token = self.expect(formatter_lexer.tk_ident(), "binding name");
        let mutable type_name: String = "";
        if self.check_consume(formatter_lexer.tk_colon()) {
            type_name = self.parse_type_name();
        }
        self.expect(formatter_lexer.tk_assign(), "'=' in let binding");
        let rhs: String = self.capture_expr_until_semi();
        self.expect(formatter_lexer.tk_semicolon(), "';' to end let statement");
        return Stmt(st_let(), rhs, name_tok.text, type_name, is_mut, empty_block(), empty_block(), false);
    }

    // `return [EXPR];`
    method parse_return_stmt() returns Stmt {
        self.expect(formatter_lexer.kw_return(), "'return'");
        let mutable rhs: String = "";
        if not self.check(formatter_lexer.tk_semicolon()) {
            rhs = self.capture_expr_until_semi();
        }
        self.expect(formatter_lexer.tk_semicolon(), "';' to end return statement");
        return Stmt(st_return(), rhs, "", "", false, empty_block(), empty_block(), false);
    }

    // `if EXPR { BLOCK } [else (if-stmt | { BLOCK })]`. `else if` chains
    // are folded into a single-statement else-block whose only statement
    // is the nested if.
    method parse_if_stmt() returns Stmt {
        self.expect(formatter_lexer.kw_if(), "'if'");
        let cond: String = self.capture_expr_until_lbrace();
        let then_blk: Block = self.parse_block();
        let mutable else_blk: Block = empty_block();
        let mutable has_else: Bool = false;
        if self.check_consume(formatter_lexer.kw_else()) {
            has_else = true;
            if self.check(formatter_lexer.kw_if()) {
                let mutable inner: Array<Stmt> = [];
                inner.push(self.parse_if_stmt());
                else_blk = Block(inner);
            } else {
                else_blk = self.parse_block();
            }
        }
        return Stmt(st_if(), cond, "", "", false, then_blk, else_blk, has_else);
    }

    // `while EXPR { BLOCK }`
    method parse_while_stmt() returns Stmt {
        self.expect(formatter_lexer.kw_while(), "'while'");
        let cond: String = self.capture_expr_until_lbrace();
        let body: Block = self.parse_block();
        return Stmt(st_while(), cond, "", "", false, body, empty_block(), false);
    }

    // Anything else: capture until `;` and consume it.
    method parse_expr_stmt() returns Stmt {
        let text: String = self.capture_expr_until_semi();
        self.expect(formatter_lexer.tk_semicolon(), "';' to end expression statement");
        return Stmt(st_expr(), text, "", "", false, empty_block(), empty_block(), false);
    }

    // --- expression-text capture (Phase 34 stub) -------------------------
    //
    // Scans tokens, tracking nesting depth of `(`, `[`, `{`, until a
    // terminator at depth 0 is seen. The terminator is NOT consumed —
    // the caller is responsible. Joins captured token texts with single
    // spaces. Phase 35 replaces this with a real expression parser.

    method capture_expr_until_semi() returns String {
        let mutable parts: Array<String> = [];
        let mutable paren_d: Int = 0;
        let mutable bracket_d: Int = 0;
        let mutable brace_d: Int = 0;
        while not self.at_end() {
            let k: Int = self.peek_kind();
            if paren_d == 0 and bracket_d == 0 and brace_d == 0 and k == formatter_lexer.tk_semicolon() {
                return join_with_space(parts);
            }
            // Bail out before consuming an unbalanced closing brace —
            // that's the enclosing block's terminator, not ours.
            if brace_d == 0 and k == formatter_lexer.tk_rbrace() {
                self.fail("unterminated expression (missing ';')");
                return join_with_space(parts);
            }
            let t: Token = self.advance();
            parts.push(t.text);
            if k == formatter_lexer.tk_lparen() { paren_d = paren_d + 1; }
            if k == formatter_lexer.tk_rparen() { paren_d = paren_d - 1; }
            if k == formatter_lexer.tk_lbracket() { bracket_d = bracket_d + 1; }
            if k == formatter_lexer.tk_rbracket() { bracket_d = bracket_d - 1; }
            if k == formatter_lexer.tk_lbrace() { brace_d = brace_d + 1; }
            if k == formatter_lexer.tk_rbrace() { brace_d = brace_d - 1; }
        }
        return join_with_space(parts);
    }

    // For if / while conditions: capture until `{` at depth 0. Conditions
    // don't contain block expressions in the surface language yet, so we
    // only balance `(` and `[`.
    method capture_expr_until_lbrace() returns String {
        let mutable parts: Array<String> = [];
        let mutable paren_d: Int = 0;
        let mutable bracket_d: Int = 0;
        while not self.at_end() {
            let k: Int = self.peek_kind();
            if paren_d == 0 and bracket_d == 0 and k == formatter_lexer.tk_lbrace() {
                return join_with_space(parts);
            }
            let t: Token = self.advance();
            parts.push(t.text);
            if k == formatter_lexer.tk_lparen() { paren_d = paren_d + 1; }
            if k == formatter_lexer.tk_rparen() { paren_d = paren_d - 1; }
            if k == formatter_lexer.tk_lbracket() { bracket_d = bracket_d + 1; }
            if k == formatter_lexer.tk_rbracket() { bracket_d = bracket_d - 1; }
        }
        return join_with_space(parts);
    }

    method parse_program() returns Program {
        let mutable imports: Array<ImportDecl> = [];
        let mutable functions: Array<FunctionDecl> = [];
        let module_decl: ModuleDecl = self.parse_module_decl();

        while not self.at_end() and self.error == "" {
            if self.check(formatter_lexer.kw_import_marker()) {
                imports.push(self.parse_import_decl());
            } else {
                // Look ahead for a function declaration. Accept `function`,
                // `public function`, `entry function`, `async function`, or
                // any combination of those modifiers. Other declaration
                // kinds (entity, enum, trait, etc.) are not in Phase 33's
                // scope — we surface a clear error and stop.
                if self.is_at_function_start() {
                    functions.push(self.parse_function_decl());
                } else {
                    self.fail("unexpected top-level token (Phase 33 parses module/import/function only)");
                    return Program(module_decl, imports, functions, self.error);
                }
            }
        }

        return Program(module_decl, imports, functions, self.error);
    }

    // True if the next 1-3 tokens introduce a function declaration.
    method is_at_function_start() returns Bool {
        if self.check(formatter_lexer.kw_function()) { return true; }
        if self.check(formatter_lexer.kw_entry()) { return true; }
        if self.check(formatter_lexer.kw_public_marker()) { return true; }
        if self.check(formatter_lexer.kw_async_marker()) { return true; }
        return false;
    }
}

// Empty Block constructor (avoids a bare `Block([])` literal where the
// element type cannot be inferred at the call site).
public function empty_block() returns Block {
    let mutable s: Array<Stmt> = [];
    return Block(s);
}

// Joins string parts with single spaces. Phase 33 helper for body capture.
public function join_with_space(parts: Array<String>) returns String {
    let mutable out: String = "";
    let mutable i: Int = 0;
    while i < len(parts) {
        if i > 0 {
            out = out + " ";
        }
        out = out + parts[i];
        i = i + 1;
    }
    return out;
}

public function parse(source: String) returns Program {
    let mutable p: Parser = Parser(source);
    return p.parse_program();
}

entry function main() returns Int { return 0; }

// --- In-language tests ------------------------------------------------------

test "parse minimal module declaration" {
    let prog: Program = parse("module foo version \"1.0\";");
    assert_eq(prog.error, "");
    assert_eq(prog.module_decl.name, "foo");
    assert_eq(prog.module_decl.module_version, "1.0");
    assert_eq(len(prog.imports), 0);
    assert_eq(len(prog.functions), 0);
}

test "parse module with file imports" {
    let prog: Program = parse("module app version \"0.1\"; import \"helpers.intent\"; import \"types.intent\";");
    assert_eq(prog.error, "");
    assert_eq(len(prog.imports), 2);
    assert_eq(prog.imports[0].is_package, false);
    assert_eq(prog.imports[0].path, "helpers.intent");
    assert_eq(prog.imports[1].path, "types.intent");
}

test "parse module with package import" {
    let prog: Program = parse("module app version \"0.1\"; import graph_types;");
    assert_eq(prog.error, "");
    assert_eq(len(prog.imports), 1);
    assert_eq(prog.imports[0].is_package, true);
    assert_eq(prog.imports[0].path, "graph_types");
}

test "parse module with dotted package import" {
    let prog: Program = parse("module app version \"0.1\"; import graph_types.validation;");
    assert_eq(prog.error, "");
    assert_eq(prog.imports[0].is_package, true);
    assert_eq(prog.imports[0].path, "graph_types.validation");
}

test "parse function signature with no params" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions), 1);
    assert_eq(prog.functions[0].name, "f");
    assert_eq(prog.functions[0].is_public, false);
    assert_eq(prog.functions[0].is_entry, false);
    assert_eq(prog.functions[0].is_async, false);
    assert_eq(len(prog.functions[0].params), 0);
    assert_eq(prog.functions[0].return_type, "Int");
}

test "parse function with parameters" {
    let src: String = "module m version \"1.0\"; function add(a: Int, b: Int) returns Int " + '{'.to_string() + " return a + b; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions[0].params), 2);
    assert_eq(prog.functions[0].params[0].name, "a");
    assert_eq(prog.functions[0].params[0].type_name, "Int");
    assert_eq(prog.functions[0].params[1].name, "b");
}

test "parse entry function" {
    let src: String = "module m version \"1.0\"; entry function main() returns Int " + '{'.to_string() + " return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(prog.functions[0].is_entry, true);
    assert_eq(prog.functions[0].name, "main");
}

test "parse public function" {
    let src: String = "module m version \"1.0\"; public function helper() returns Void " + '{'.to_string() + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(prog.functions[0].is_public, true);
}

test "parse multiple functions" {
    let src: String = "module m version \"1.0\"; function a() returns Int " + '{'.to_string() + " return 1; " + '}'.to_string() + " function b() returns Int " + '{'.to_string() + " return 2; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions), 2);
    assert_eq(prog.functions[0].name, "a");
    assert_eq(prog.functions[1].name, "b");
}

test "function with generic return type captures head" {
    let src: String = "module m version \"1.0\"; function get_items() returns Array<Int> " + '{'.to_string() + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(prog.functions[0].return_type, "Array<...>");
}

test "parser reports unexpected token at top level" {
    let prog: Program = parse("module m version \"1.0\"; entity Foo " + '{'.to_string() + " field x: Int; " + '}'.to_string());
    // Entities are not in Phase 33 scope; expect an error.
    assert(prog.error != "");
}

test "missing semicolon after module records error" {
    let prog: Program = parse("module foo version \"1.0\"");
    assert(prog.error != "");
}

// --- Phase 34: statement parser tests ---------------------------------------

test "empty function body produces empty block" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + '{'.to_string() + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions[0].body.stmts), 0);
}

test "single return parses as one st_return statement" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions[0].body.stmts), 1);
    assert_eq(prog.functions[0].body.stmts[0].kind, st_return());
    assert_eq(prog.functions[0].body.stmts[0].expr_text, "0");
}

test "return without value records empty expr" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + '{'.to_string() + " return; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(prog.functions[0].body.stmts[0].kind, st_return());
    assert_eq(prog.functions[0].body.stmts[0].expr_text, "");
}

test "let with type annotation" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " let x: Int = 7; return x; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions[0].body.stmts), 2);
    assert_eq(prog.functions[0].body.stmts[0].kind, st_let());
    assert_eq(prog.functions[0].body.stmts[0].name, "x");
    assert_eq(prog.functions[0].body.stmts[0].type_name, "Int");
    assert_eq(prog.functions[0].body.stmts[0].is_mutable, false);
    assert_eq(prog.functions[0].body.stmts[0].expr_text, "7");
    assert_eq(prog.functions[0].body.stmts[1].kind, st_return());
    assert_eq(prog.functions[0].body.stmts[1].expr_text, "x");
}

test "let mutable without annotation" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " let mutable y = 0; return y; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(prog.functions[0].body.stmts[0].kind, st_let());
    assert_eq(prog.functions[0].body.stmts[0].name, "y");
    assert_eq(prog.functions[0].body.stmts[0].type_name, "");
    assert_eq(prog.functions[0].body.stmts[0].is_mutable, true);
    assert_eq(prog.functions[0].body.stmts[0].expr_text, "0");
}

test "expression statement (assignment)" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " let mutable y = 0; y = y + 1; return y; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions[0].body.stmts), 3);
    assert_eq(prog.functions[0].body.stmts[1].kind, st_expr());
    assert_eq(prog.functions[0].body.stmts[1].expr_text, "y = y + 1");
}

test "if statement without else" {
    let src: String = "module m version \"1.0\"; function f(x: Int) returns Int " + '{'.to_string() + " if x > 0 " + '{'.to_string() + " return 1; " + '}'.to_string() + " return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions[0].body.stmts), 2);
    assert_eq(prog.functions[0].body.stmts[0].kind, st_if());
    assert_eq(prog.functions[0].body.stmts[0].expr_text, "x > 0");
    assert_eq(prog.functions[0].body.stmts[0].has_else, false);
    assert_eq(len(prog.functions[0].body.stmts[0].then_block.stmts), 1);
    assert_eq(prog.functions[0].body.stmts[0].then_block.stmts[0].kind, st_return());
    assert_eq(prog.functions[0].body.stmts[0].then_block.stmts[0].expr_text, "1");
}

test "if-else statement" {
    let src: String = "module m version \"1.0\"; function f(x: Int) returns Int " + '{'.to_string() + " if x > 0 " + '{'.to_string() + " return 1; " + '}'.to_string() + " else " + '{'.to_string() + " return 0; " + '}'.to_string() + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(prog.functions[0].body.stmts[0].kind, st_if());
    assert_eq(prog.functions[0].body.stmts[0].has_else, true);
    assert_eq(len(prog.functions[0].body.stmts[0].else_block.stmts), 1);
    assert_eq(prog.functions[0].body.stmts[0].else_block.stmts[0].expr_text, "0");
}

test "else if chains into nested if in else_block" {
    let src: String = "module m version \"1.0\"; function f(x: Int) returns Int " + '{'.to_string()
        + " if x > 0 " + '{'.to_string() + " return 1; " + '}'.to_string()
        + " else if x < 0 " + '{'.to_string() + " return -1; " + '}'.to_string()
        + " else " + '{'.to_string() + " return 0; " + '}'.to_string()
        + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let outer: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(outer.kind, st_if());
    assert_eq(outer.has_else, true);
    assert_eq(len(outer.else_block.stmts), 1);
    let inner: Stmt = outer.else_block.stmts[0];
    assert_eq(inner.kind, st_if());
    assert_eq(inner.expr_text, "x < 0");
    assert_eq(inner.has_else, true);
    assert_eq(inner.else_block.stmts[0].expr_text, "0");
}

test "while statement" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string()
        + " let mutable i: Int = 0; while i < 10 " + '{'.to_string() + " i = i + 1; " + '}'.to_string()
        + " return i; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let w: Stmt = prog.functions[0].body.stmts[1];
    assert_eq(w.kind, st_while());
    assert_eq(w.expr_text, "i < 10");
    assert_eq(len(w.then_block.stmts), 1);
    assert_eq(w.then_block.stmts[0].kind, st_expr());
    assert_eq(w.then_block.stmts[0].expr_text, "i = i + 1");
}

test "expression with balanced parens captures correctly" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string()
        + " let x: Int = add(1, 2); return x; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(prog.functions[0].body.stmts[0].expr_text, "add ( 1 , 2 )");
}

test "nested if inside if then-block" {
    let src: String = "module m version \"1.0\"; function f(x: Int, y: Int) returns Int " + '{'.to_string()
        + " if x > 0 " + '{'.to_string()
        + " if y > 0 " + '{'.to_string() + " return 1; " + '}'.to_string()
        + " " + '}'.to_string()
        + " return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let outer: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(outer.kind, st_if());
    let inner: Stmt = outer.then_block.stmts[0];
    assert_eq(inner.kind, st_if());
    assert_eq(inner.expr_text, "y > 0");
}

test "missing semicolon after return is reported" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " return 0 " + '}'.to_string();
    let prog: Program = parse(src);
    assert(prog.error != "");
}
