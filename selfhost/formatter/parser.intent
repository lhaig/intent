// selfhost/formatter/parser.intent — Phases 33-35 / ADR 0040 stage2.
//
// Parses Intent source into a structured AST:
//   - module declaration
//   - imports
//   - function declarations (modifiers + signature)
//   - function bodies as Block of statements (let / return / if-else /
//     while / expression statements) — Phase 34.
//   - expressions inside statements: literals, identifiers, calls,
//     field/method access, indexing, ranges, array literals, unary +
//     binary operators with full precedence — Phase 35.
//
// Out of scope (deferred to Phase 36+):
//   - entity / trait / impl / intent / test / extern declarations.
//   - type-argument lists (Array<T>, Result<T,E>, etc.) — captures a
//     primitive type or bare identifier with a "<...>" suffix marker.
//   - match expressions / for / break / continue / try / await.
//   - lambdas (`(x) => expr`), interpolated strings (`${expr}`), char
//     literals (`'a'`), float literals — stage2 lexer doesn't tokenise
//     them yet either.
//
// Builds on Phase 32's lexer (formatter_lexer module).
//
// AST shape choice: each AST node is one entity with an Int `kind`
// discriminator + per-kind fields, mirroring how Token uses `kind: Int`
// in the lexer. Intent enums with payloads would force every field
// access through a match arm and each arm is a single expression, so a
// sum-typed Stmt/Expr would be awkward to consume. Single-entity-with-
// tag is the same trade Token already makes; recursive sizing isn't a
// problem because nested children are reached via Array<...> which is
// heap-allocated.

module formatter_parser version "0.1.0";

import "lexer.intent";

// --- Statement kind constants -----------------------------------------------
//
// Same Int-discriminator pattern as Token's tk_*() functions in the lexer.

public function st_let() returns Int { return 1; }
public function st_return() returns Int { return 2; }
public function st_if() returns Int { return 3; }
public function st_while() returns Int { return 4; }
public function st_expr() returns Int { return 5; }

// --- Expression kind constants ----------------------------------------------

public function ex_void() returns Int { return 0; }        // placeholder for absent expr (e.g. `return;`)
public function ex_int() returns Int { return 1; }
public function ex_string() returns Int { return 2; }
public function ex_bool() returns Int { return 3; }
public function ex_ident() returns Int { return 4; }
public function ex_unary() returns Int { return 5; }       // children=[operand], name=op
public function ex_binop() returns Int { return 6; }       // children=[lhs, rhs], name=op
public function ex_call() returns Int { return 7; }        // children=[callee, arg1..argN]
public function ex_index() returns Int { return 8; }       // children=[object, index]
public function ex_field() returns Int { return 9; }       // children=[object], name=field
public function ex_array() returns Int { return 10; }      // children=[elem1..elemN]
public function ex_range() returns Int { return 11; }      // children=[start, end]
public function ex_paren() returns Int { return 12; }      // children=[inner]

// --- AST entities -----------------------------------------------------------

public entity Param {
    field name: String;
    field type_name: String;

    constructor(name: String, type_name: String) {
        self.name = name;
        self.type_name = type_name;
    }
}

// Expression node. Field usage by kind:
//   ex_void    — no fields set (placeholder for absent expression)
//   ex_int     — int_value
//   ex_string  — str_value (unquoted, escapes still raw)
//   ex_bool    — bool_value
//   ex_ident   — name
//   ex_unary   — name (operator: "-", "not"), children=[operand]
//   ex_binop   — name (operator), children=[lhs, rhs]
//   ex_call    — children=[callee, arg1..argN]
//   ex_index   — children=[object, index]
//   ex_field   — name (field), children=[object]
//   ex_array   — children=[elem1..elemN]
//   ex_range   — children=[start, end]
//   ex_paren   — children=[inner]
// Mutually-recursive sizing through Stmt is safe: every back-edge to Expr
// goes through Array<Expr> (heap-allocated).
public entity Expr {
    field kind: Int;
    field int_value: Int;
    field str_value: String;
    field bool_value: Bool;
    field name: String;
    field children: Array<Expr>;

    constructor(kind: Int, int_value: Int, str_value: String, bool_value: Bool, name: String, children: Array<Expr>) {
        self.kind = kind;
        self.int_value = int_value;
        self.str_value = str_value;
        self.bool_value = bool_value;
        self.name = name;
        self.children = children;
    }
}

// Statement node. Field usage by kind:
//   st_let    — name, type_name, is_mutable, expr (rhs)
//   st_return — expr (may be ex_void for `return;`)
//   st_expr   — expr
//   st_if     — expr (condition), then_block, else_block, has_else
//   st_while  — expr (condition), then_block (body)
// Unused fields are populated with defaults ("" / false / empty_block() / empty_expr()).
public entity Stmt {
    field kind: Int;
    field expr: Expr;
    field name: String;
    field type_name: String;
    field is_mutable: Bool;
    field then_block: Block;
    field else_block: Block;
    field has_else: Bool;

    constructor(kind: Int, expr: Expr, name: String, type_name: String, is_mutable: Bool, then_block: Block, else_block: Block, has_else: Bool) {
        self.kind = kind;
        self.expr = expr;
        self.name = name;
        self.type_name = type_name;
        self.is_mutable = is_mutable;
        self.then_block = then_block;
        self.else_block = else_block;
        self.has_else = has_else;
    }
}

public entity Block {
    field stmts: Array<Stmt>;

    constructor(stmts: Array<Stmt>) {
        self.stmts = stmts;
    }
}

public entity FunctionDecl {
    field name: String;
    field is_public: Bool;
    field is_entry: Bool;
    field is_async: Bool;
    field params: Array<Param>;
    field return_type: String;
    field body: Block;

    constructor(name: String, is_public: Bool, is_entry: Bool, is_async: Bool, params: Array<Param>, return_type: String, body: Block) {
        self.name = name;
        self.is_public = is_public;
        self.is_entry = is_entry;
        self.is_async = is_async;
        self.params = params;
        self.return_type = return_type;
        self.body = body;
    }
}

public entity ImportDecl {
    field is_package: Bool;
    field path: String; // file path for file imports; package identifier for package imports

    constructor(is_package: Bool, path: String) {
        self.is_package = is_package;
        self.path = path;
    }
}

public entity ModuleDecl {
    field name: String;
    field module_version: String;

    constructor(name: String, module_version: String) {
        self.name = name;
        self.module_version = module_version;
    }
}

public entity Program {
    field module_decl: ModuleDecl;
    field imports: Array<ImportDecl>;
    field functions: Array<FunctionDecl>;
    field error: String; // empty when parse succeeded

    constructor(module_decl: ModuleDecl, imports: Array<ImportDecl>, functions: Array<FunctionDecl>, error: String) {
        self.module_decl = module_decl;
        self.imports = imports;
        self.functions = functions;
        self.error = error;
    }
}

// --- Parser -----------------------------------------------------------------

public entity Parser {
    field tokens: Array<Token>;
    field position: Int;
    field error: String;

    constructor(source: String) {
        self.tokens = formatter_lexer.lex(source);
        self.position = 0;
        self.error = "";
    }

    method at_end() returns Bool {
        return self.peek_kind() == formatter_lexer.tk_eof();
    }

    method peek_kind() returns Int {
        return self.tokens[self.position].kind;
    }

    method peek_text() returns String {
        return self.tokens[self.position].text;
    }

    method peek_n(n: Int) returns Int {
        let idx: Int = self.position + n;
        if idx >= len(self.tokens) {
            return formatter_lexer.tk_eof();
        }
        return self.tokens[idx].kind;
    }

    method advance() returns Token {
        let tok: Token = self.tokens[self.position];
        if self.position < len(self.tokens) - 1 {
            self.position = self.position + 1;
        }
        return tok;
    }

    method check(kind: Int) returns Bool {
        return self.peek_kind() == kind;
    }

    method check_consume(kind: Int) returns Bool {
        if self.check(kind) {
            self.advance();
            return true;
        }
        return false;
    }

    // Records an error and advances past one token so we make progress.
    // Returns the offending token's text for callers that want it.
    method fail(message: String) returns String {
        if self.error == "" {
            let tok: Token = self.tokens[self.position];
            self.error = "line " + tok.line.to_string() + " col " + tok.column.to_string() + ": " + message;
        }
        if not self.at_end() {
            self.advance();
        }
        return "";
    }

    method expect(kind: Int, what: String) returns Token {
        if self.check(kind) {
            return self.advance();
        }
        self.fail("expected " + what);
        return self.tokens[self.position];
    }

    // Strips the surrounding quotes from a string-literal token text.
    method unquote(text: String) returns String {
        let n: Int = len(text);
        if n < 2 {
            return text;
        }
        return text[1..n - 1];
    }

    // --- top-level parse entry points -------------------------------------

    method parse_module_decl() returns ModuleDecl {
        self.expect(formatter_lexer.kw_module(), "'module' keyword");
        let name_tok: Token = self.expect(formatter_lexer.tk_ident(), "module name");
        self.expect(formatter_lexer.kw_version(), "'version' keyword");
        let ver_tok: Token = self.expect(formatter_lexer.tk_string(), "version string literal");
        self.expect(formatter_lexer.tk_semicolon(), "';' after module declaration");
        return ModuleDecl(name_tok.text, self.unquote(ver_tok.text));
    }

    method parse_import_decl() returns ImportDecl {
        self.expect(formatter_lexer.kw_import_marker(), "'import' keyword");
        if self.check(formatter_lexer.tk_string()) {
            let path_tok: Token = self.advance();
            self.expect(formatter_lexer.tk_semicolon(), "';' after import");
            return ImportDecl(false, self.unquote(path_tok.text));
        }
        if self.check(formatter_lexer.tk_ident()) {
            let pkg_tok: Token = self.advance();
            let mutable path: String = pkg_tok.text;
            // Dotted package paths: pkg.sub.deeper
            while self.check_consume(formatter_lexer.tk_dot()) {
                if self.check(formatter_lexer.tk_ident()) {
                    let seg: Token = self.advance();
                    path = path + "." + seg.text;
                } else {
                    self.fail("expected identifier after '.' in import");
                    return ImportDecl(true, path);
                }
            }
            self.expect(formatter_lexer.tk_semicolon(), "';' after import");
            return ImportDecl(true, path);
        }
        self.fail("expected string or identifier after 'import'");
        return ImportDecl(false, "");
    }

    method parse_param() returns Param {
        let name_tok: Token = self.expect(formatter_lexer.tk_ident(), "parameter name");
        self.expect(formatter_lexer.tk_colon(), "':' after parameter name");
        let type_name: String = self.parse_type_name();
        return Param(name_tok.text, type_name);
    }

    // Recognises a primitive type (Int / String / Bool / Void / Char) or a
    // bare identifier. Generic arguments (Array<T>, Result<T, E>) are
    // consumed but not modelled — Phase 33 stores the head only and
    // discards the args. Phase 34+ will replace this with a real TypeRef.
    method parse_type_name() returns String {
        let tok: Token = self.advance();
        let mutable name: String = tok.text;
        // Skip a single optional <...> generic-arg list (no nesting in v1).
        if self.check_consume(formatter_lexer.tk_lt()) {
            let mutable depth: Int = 1;
            while depth > 0 and not self.at_end() {
                if self.check_consume(formatter_lexer.tk_lt()) {
                    depth = depth + 1;
                } else {
                    if self.check_consume(formatter_lexer.tk_gt()) {
                        depth = depth - 1;
                    } else {
                        self.advance();
                    }
                }
            }
            name = name + "<...>";
        }
        return name;
    }

    method parse_function_decl() returns FunctionDecl {
        let mutable is_public: Bool = false;
        let mutable is_async: Bool = false;
        let mutable is_entry: Bool = false;

        // Optional modifiers in any order before `function`.
        // (The full grammar restricts ordering more tightly; v1 parser
        // accepts any.)
        let mutable scanning_modifiers: Bool = true;
        while scanning_modifiers {
            if self.check(formatter_lexer.kw_public_marker()) {
                self.advance();
                is_public = true;
            } else {
                if self.check(formatter_lexer.kw_async_marker()) {
                    self.advance();
                    is_async = true;
                } else {
                    if self.check(formatter_lexer.kw_entry()) {
                        self.advance();
                        is_entry = true;
                    } else {
                        scanning_modifiers = false;
                    }
                }
            }
        }

        self.expect(formatter_lexer.kw_function(), "'function' keyword");
        let name_tok: Token = self.expect(formatter_lexer.tk_ident(), "function name");

        self.expect(formatter_lexer.tk_lparen(), "'(' after function name");
        let mutable params: Array<Param> = [];
        if not self.check(formatter_lexer.tk_rparen()) {
            params.push(self.parse_param());
            while self.check_consume(formatter_lexer.tk_comma()) {
                params.push(self.parse_param());
            }
        }
        self.expect(formatter_lexer.tk_rparen(), "')' to close parameter list");

        // Contracts on top-level functions are part of the surface (`requires`
        // / `ensures` / `decreases`) but they aren't tokenised as keywords
        // in v1's lexer. Skip them by scanning identifiers/expressions until
        // we hit `returns` or `{`.

        self.expect(formatter_lexer.kw_returns(), "'returns' after parameter list");
        let return_type: String = self.parse_type_name();

        // Skip optional contract clauses (requires/ensures/decreases). Each
        // starts with an identifier and runs to end-of-line-ish. v1 just
        // bails out when we see `{` or EOF.
        while self.check(formatter_lexer.tk_ident()) {
            // Skip the contract keyword + its predicate up to the next
            // top-level boundary. Heuristic: consume until newline-ish — we
            // approximate by skipping tokens until { or end of function.
            self.advance();
            // crude scan: keep going until we hit `{` or another contract-
            // looking ident at column 1 — Phase 34 will replace this.
            while not self.at_end() and not self.check(formatter_lexer.tk_lbrace()) and not self.check(formatter_lexer.tk_ident()) {
                self.advance();
            }
        }

        let body: Block = self.parse_block();
        return FunctionDecl(name_tok.text, is_public, is_entry, is_async, params, return_type, body);
    }

    // --- statement-level parse -------------------------------------------

    // Parses a brace-delimited `{ ... }` block: consumes opening `{`, then
    // dispatches into statement parsers until it sees a `}` at this level.
    // Records (but does not propagate via panic) any error via self.fail.
    method parse_block() returns Block {
        self.expect(formatter_lexer.tk_lbrace(), "'" + '{'.to_string() + "' to start block");
        let mutable stmts: Array<Stmt> = [];
        while not self.at_end() and not self.check(formatter_lexer.tk_rbrace()) and self.error == "" {
            stmts.push(self.parse_statement());
        }
        self.expect(formatter_lexer.tk_rbrace(), "'" + '}'.to_string() + "' to close block");
        return Block(stmts);
    }

    method parse_statement() returns Stmt {
        if self.check(formatter_lexer.kw_let()) {
            return self.parse_let_stmt();
        }
        if self.check(formatter_lexer.kw_return()) {
            return self.parse_return_stmt();
        }
        if self.check(formatter_lexer.kw_if()) {
            return self.parse_if_stmt();
        }
        if self.check(formatter_lexer.kw_while()) {
            return self.parse_while_stmt();
        }
        return self.parse_expr_stmt();
    }

    // `let [mutable] IDENT [: TYPE] = EXPR;`
    method parse_let_stmt() returns Stmt {
        self.expect(formatter_lexer.kw_let(), "'let'");
        let mutable is_mut: Bool = false;
        if self.check_consume(formatter_lexer.kw_mutable()) {
            is_mut = true;
        }
        let name_tok: Token = self.expect(formatter_lexer.tk_ident(), "binding name");
        let mutable type_name: String = "";
        if self.check_consume(formatter_lexer.tk_colon()) {
            type_name = self.parse_type_name();
        }
        self.expect(formatter_lexer.tk_assign(), "'=' in let binding");
        let rhs: Expr = self.parse_expr();
        self.expect(formatter_lexer.tk_semicolon(), "';' to end let statement");
        return Stmt(st_let(), rhs, name_tok.text, type_name, is_mut, empty_block(), empty_block(), false);
    }

    // `return [EXPR];`
    method parse_return_stmt() returns Stmt {
        self.expect(formatter_lexer.kw_return(), "'return'");
        let mutable rhs: Expr = empty_expr();
        if not self.check(formatter_lexer.tk_semicolon()) {
            rhs = self.parse_expr();
        }
        self.expect(formatter_lexer.tk_semicolon(), "';' to end return statement");
        return Stmt(st_return(), rhs, "", "", false, empty_block(), empty_block(), false);
    }

    // `if EXPR { BLOCK } [else (if-stmt | { BLOCK })]`. `else if` chains
    // are folded into a single-statement else-block whose only statement
    // is the nested if.
    method parse_if_stmt() returns Stmt {
        self.expect(formatter_lexer.kw_if(), "'if'");
        let cond: Expr = self.parse_expr();
        let then_blk: Block = self.parse_block();
        let mutable else_blk: Block = empty_block();
        let mutable has_else: Bool = false;
        if self.check_consume(formatter_lexer.kw_else()) {
            has_else = true;
            if self.check(formatter_lexer.kw_if()) {
                let mutable inner: Array<Stmt> = [];
                inner.push(self.parse_if_stmt());
                else_blk = Block(inner);
            } else {
                else_blk = self.parse_block();
            }
        }
        return Stmt(st_if(), cond, "", "", false, then_blk, else_blk, has_else);
    }

    // `while EXPR { BLOCK }`
    method parse_while_stmt() returns Stmt {
        self.expect(formatter_lexer.kw_while(), "'while'");
        let cond: Expr = self.parse_expr();
        let body: Block = self.parse_block();
        return Stmt(st_while(), cond, "", "", false, body, empty_block(), false);
    }

    // Anything else (assignment, bare call, etc.) — parse a full expression
    // and require a trailing `;`.
    method parse_expr_stmt() returns Stmt {
        let e: Expr = self.parse_expr();
        self.expect(formatter_lexer.tk_semicolon(), "';' to end expression statement");
        return Stmt(st_expr(), e, "", "", false, empty_block(), empty_block(), false);
    }

    // --- expression parser (Pratt / precedence climbing) ------------------
    //
    // Grammar (lowest to highest precedence):
    //
    //   parse_expr   = parse_assign
    //   parse_assign = parse_or ( '='  parse_assign )?        (right-assoc, single)
    //   parse_or     = parse_and ( 'or'  parse_and )*
    //   parse_and    = parse_eq  ( 'and' parse_eq  )*
    //   parse_eq     = parse_cmp ( ('=='|'!=')   parse_cmp   )*
    //   parse_cmp    = parse_range ( ('<'|'>'|'<='|'>=') parse_range )*
    //   parse_range  = parse_add ( '..' parse_add )?           (non-assoc, single)
    //   parse_add    = parse_mul ( ('+'|'-')   parse_mul   )*
    //   parse_mul    = parse_unary ( ('*'|'/'|'%') parse_unary )*
    //   parse_unary  = ('-' | 'not') parse_unary | parse_postfix
    //   parse_postfix = parse_primary ( '(' args ')' | '[' expr ']' | '.' ident )*
    //   parse_primary = INT_LIT | STR_LIT | 'true' | 'false' | IDENT
    //               | '(' parse_expr ')' | '[' parse_array_literal_body ']'
    //
    // Assignment is parsed as a binop with op "=" at the lowest precedence.
    // The surface language reserves it for statement contexts; treating it
    // as an expression here keeps the AST uniform.

    method parse_expr() returns Expr {
        return self.parse_assign();
    }

    method parse_assign() returns Expr {
        let lhs: Expr = self.parse_or();
        if self.check(formatter_lexer.tk_assign()) {
            let op_tok: Token = self.advance();
            let rhs: Expr = self.parse_assign();
            let mutable children: Array<Expr> = [];
            children.push(lhs);
            children.push(rhs);
            return Expr(ex_binop(), 0, "", false, op_tok.text, children);
        }
        return lhs;
    }

    method parse_or() returns Expr {
        let mutable lhs: Expr = self.parse_and();
        while self.check(formatter_lexer.kw_or()) {
            let op_tok: Token = self.advance();
            let rhs: Expr = self.parse_and();
            let mutable children: Array<Expr> = [];
            children.push(lhs);
            children.push(rhs);
            lhs = Expr(ex_binop(), 0, "", false, op_tok.text, children);
        }
        return lhs;
    }

    method parse_and() returns Expr {
        let mutable lhs: Expr = self.parse_eq();
        while self.check(formatter_lexer.kw_and()) {
            let op_tok: Token = self.advance();
            let rhs: Expr = self.parse_eq();
            let mutable children: Array<Expr> = [];
            children.push(lhs);
            children.push(rhs);
            lhs = Expr(ex_binop(), 0, "", false, op_tok.text, children);
        }
        return lhs;
    }

    method parse_eq() returns Expr {
        let mutable lhs: Expr = self.parse_cmp();
        while self.check(formatter_lexer.tk_eq()) or self.check(formatter_lexer.tk_neq()) {
            let op_tok: Token = self.advance();
            let rhs: Expr = self.parse_cmp();
            let mutable children: Array<Expr> = [];
            children.push(lhs);
            children.push(rhs);
            lhs = Expr(ex_binop(), 0, "", false, op_tok.text, children);
        }
        return lhs;
    }

    method parse_cmp() returns Expr {
        let mutable lhs: Expr = self.parse_range();
        while self.is_cmp_op() {
            let op_tok: Token = self.advance();
            let rhs: Expr = self.parse_range();
            let mutable children: Array<Expr> = [];
            children.push(lhs);
            children.push(rhs);
            lhs = Expr(ex_binop(), 0, "", false, op_tok.text, children);
        }
        return lhs;
    }

    method is_cmp_op() returns Bool {
        if self.check(formatter_lexer.tk_lt()) { return true; }
        if self.check(formatter_lexer.tk_gt()) { return true; }
        if self.check(formatter_lexer.tk_leq()) { return true; }
        if self.check(formatter_lexer.tk_geq()) { return true; }
        return false;
    }

    method parse_range() returns Expr {
        let lhs: Expr = self.parse_add();
        if self.check_consume(formatter_lexer.tk_dotdot()) {
            let rhs: Expr = self.parse_add();
            let mutable children: Array<Expr> = [];
            children.push(lhs);
            children.push(rhs);
            return Expr(ex_range(), 0, "", false, "", children);
        }
        return lhs;
    }

    method parse_add() returns Expr {
        let mutable lhs: Expr = self.parse_mul();
        while self.check(formatter_lexer.tk_plus()) or self.check(formatter_lexer.tk_minus()) {
            let op_tok: Token = self.advance();
            let rhs: Expr = self.parse_mul();
            let mutable children: Array<Expr> = [];
            children.push(lhs);
            children.push(rhs);
            lhs = Expr(ex_binop(), 0, "", false, op_tok.text, children);
        }
        return lhs;
    }

    method parse_mul() returns Expr {
        let mutable lhs: Expr = self.parse_unary();
        while self.is_mul_op() {
            let op_tok: Token = self.advance();
            let rhs: Expr = self.parse_unary();
            let mutable children: Array<Expr> = [];
            children.push(lhs);
            children.push(rhs);
            lhs = Expr(ex_binop(), 0, "", false, op_tok.text, children);
        }
        return lhs;
    }

    method is_mul_op() returns Bool {
        if self.check(formatter_lexer.tk_star()) { return true; }
        if self.check(formatter_lexer.tk_slash()) { return true; }
        if self.check(formatter_lexer.tk_percent()) { return true; }
        return false;
    }

    method parse_unary() returns Expr {
        if self.check(formatter_lexer.tk_minus()) {
            self.advance();
            let operand: Expr = self.parse_unary();
            let mutable children: Array<Expr> = [];
            children.push(operand);
            return Expr(ex_unary(), 0, "", false, "-", children);
        }
        if self.check(formatter_lexer.kw_not()) {
            self.advance();
            let operand: Expr = self.parse_unary();
            let mutable children: Array<Expr> = [];
            children.push(operand);
            return Expr(ex_unary(), 0, "", false, "not", children);
        }
        return self.parse_postfix();
    }

    method parse_postfix() returns Expr {
        let mutable e: Expr = self.parse_primary();
        while true {
            if self.check_consume(formatter_lexer.tk_lparen()) {
                let mutable children: Array<Expr> = [];
                children.push(e);
                if not self.check(formatter_lexer.tk_rparen()) {
                    children.push(self.parse_expr());
                    while self.check_consume(formatter_lexer.tk_comma()) {
                        children.push(self.parse_expr());
                    }
                }
                self.expect(formatter_lexer.tk_rparen(), "')' to close call");
                e = Expr(ex_call(), 0, "", false, "", children);
            } else {
                if self.check_consume(formatter_lexer.tk_lbracket()) {
                    let idx: Expr = self.parse_expr();
                    self.expect(formatter_lexer.tk_rbracket(), "']' to close index");
                    let mutable children: Array<Expr> = [];
                    children.push(e);
                    children.push(idx);
                    e = Expr(ex_index(), 0, "", false, "", children);
                } else {
                    if self.check_consume(formatter_lexer.tk_dot()) {
                        let fld: Token = self.expect(formatter_lexer.tk_ident(), "field name after '.'");
                        let mutable children: Array<Expr> = [];
                        children.push(e);
                        e = Expr(ex_field(), 0, "", false, fld.text, children);
                    } else {
                        return e;
                    }
                }
            }
        }
        return e;
    }

    method parse_primary() returns Expr {
        let kind: Int = self.peek_kind();
        if kind == formatter_lexer.tk_int() {
            let tok: Token = self.advance();
            let mutable children: Array<Expr> = [];
            return Expr(ex_int(), parse_int(tok.text), "", false, "", children);
        }
        if kind == formatter_lexer.tk_string() {
            let tok: Token = self.advance();
            let mutable children: Array<Expr> = [];
            return Expr(ex_string(), 0, self.unquote(tok.text), false, "", children);
        }
        if kind == formatter_lexer.kw_true() {
            self.advance();
            let mutable children: Array<Expr> = [];
            return Expr(ex_bool(), 0, "", true, "", children);
        }
        if kind == formatter_lexer.kw_false() {
            self.advance();
            let mutable children: Array<Expr> = [];
            return Expr(ex_bool(), 0, "", false, "", children);
        }
        if kind == formatter_lexer.tk_ident() {
            let tok: Token = self.advance();
            let mutable children: Array<Expr> = [];
            return Expr(ex_ident(), 0, "", false, tok.text, children);
        }
        if kind == formatter_lexer.tk_lparen() {
            self.advance();
            let inner: Expr = self.parse_expr();
            self.expect(formatter_lexer.tk_rparen(), "')' to close parenthesised expression");
            let mutable children: Array<Expr> = [];
            children.push(inner);
            return Expr(ex_paren(), 0, "", false, "", children);
        }
        if kind == formatter_lexer.tk_lbracket() {
            self.advance();
            let mutable elems: Array<Expr> = [];
            if not self.check(formatter_lexer.tk_rbracket()) {
                elems.push(self.parse_expr());
                while self.check_consume(formatter_lexer.tk_comma()) {
                    elems.push(self.parse_expr());
                }
            }
            self.expect(formatter_lexer.tk_rbracket(), "']' to close array literal");
            return Expr(ex_array(), 0, "", false, "", elems);
        }
        self.fail("expected expression");
        return empty_expr();
    }

    method parse_program() returns Program {
        let mutable imports: Array<ImportDecl> = [];
        let mutable functions: Array<FunctionDecl> = [];
        let module_decl: ModuleDecl = self.parse_module_decl();

        while not self.at_end() and self.error == "" {
            if self.check(formatter_lexer.kw_import_marker()) {
                imports.push(self.parse_import_decl());
            } else {
                // Look ahead for a function declaration. Accept `function`,
                // `public function`, `entry function`, `async function`, or
                // any combination of those modifiers. Other declaration
                // kinds (entity, enum, trait, etc.) are not in Phase 33's
                // scope — we surface a clear error and stop.
                if self.is_at_function_start() {
                    functions.push(self.parse_function_decl());
                } else {
                    self.fail("unexpected top-level token (Phase 33 parses module/import/function only)");
                    return Program(module_decl, imports, functions, self.error);
                }
            }
        }

        return Program(module_decl, imports, functions, self.error);
    }

    // True if the next 1-3 tokens introduce a function declaration.
    method is_at_function_start() returns Bool {
        if self.check(formatter_lexer.kw_function()) { return true; }
        if self.check(formatter_lexer.kw_entry()) { return true; }
        if self.check(formatter_lexer.kw_public_marker()) { return true; }
        if self.check(formatter_lexer.kw_async_marker()) { return true; }
        return false;
    }
}

// Empty Block constructor (avoids a bare `Block([])` literal where the
// element type cannot be inferred at the call site).
public function empty_block() returns Block {
    let mutable s: Array<Stmt> = [];
    return Block(s);
}

// Placeholder Expr for absent expressions (e.g. `return;`). kind == ex_void.
public function empty_expr() returns Expr {
    let mutable c: Array<Expr> = [];
    return Expr(ex_void(), 0, "", false, "", c);
}

// Parses a decimal integer-literal token's text into an Int. The stage2
// lexer only emits tk_int for runs of digit characters (no sign, no
// leading whitespace), so input is assumed well-formed. Negative numbers
// reach this via unary minus in the expression parser, not via a sign in
// the token text.
public function parse_int(text: String) returns Int {
    let mutable n: Int = 0;
    let mutable i: Int = 0;
    let zero_cp: Int = '0'.to_codepoint();
    while i < len(text) {
        let c: Char = text[i];
        if c.is_digit() {
            n = n * 10 + (c.to_codepoint() - zero_cp);
        }
        i = i + 1;
    }
    return n;
}

// Joins string parts with single spaces. Phase 33 helper for body capture.
public function join_with_space(parts: Array<String>) returns String {
    let mutable out: String = "";
    let mutable i: Int = 0;
    while i < len(parts) {
        if i > 0 {
            out = out + " ";
        }
        out = out + parts[i];
        i = i + 1;
    }
    return out;
}

public function parse(source: String) returns Program {
    let mutable p: Parser = Parser(source);
    return p.parse_program();
}

entry function main() returns Int { return 0; }

// --- In-language tests ------------------------------------------------------

test "parse minimal module declaration" {
    let prog: Program = parse("module foo version \"1.0\";");
    assert_eq(prog.error, "");
    assert_eq(prog.module_decl.name, "foo");
    assert_eq(prog.module_decl.module_version, "1.0");
    assert_eq(len(prog.imports), 0);
    assert_eq(len(prog.functions), 0);
}

test "parse module with file imports" {
    let prog: Program = parse("module app version \"0.1\"; import \"helpers.intent\"; import \"types.intent\";");
    assert_eq(prog.error, "");
    assert_eq(len(prog.imports), 2);
    assert_eq(prog.imports[0].is_package, false);
    assert_eq(prog.imports[0].path, "helpers.intent");
    assert_eq(prog.imports[1].path, "types.intent");
}

test "parse module with package import" {
    let prog: Program = parse("module app version \"0.1\"; import graph_types;");
    assert_eq(prog.error, "");
    assert_eq(len(prog.imports), 1);
    assert_eq(prog.imports[0].is_package, true);
    assert_eq(prog.imports[0].path, "graph_types");
}

test "parse module with dotted package import" {
    let prog: Program = parse("module app version \"0.1\"; import graph_types.validation;");
    assert_eq(prog.error, "");
    assert_eq(prog.imports[0].is_package, true);
    assert_eq(prog.imports[0].path, "graph_types.validation");
}

test "parse function signature with no params" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions), 1);
    assert_eq(prog.functions[0].name, "f");
    assert_eq(prog.functions[0].is_public, false);
    assert_eq(prog.functions[0].is_entry, false);
    assert_eq(prog.functions[0].is_async, false);
    assert_eq(len(prog.functions[0].params), 0);
    assert_eq(prog.functions[0].return_type, "Int");
}

test "parse function with parameters" {
    let src: String = "module m version \"1.0\"; function add(a: Int, b: Int) returns Int " + '{'.to_string() + " return a + b; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions[0].params), 2);
    assert_eq(prog.functions[0].params[0].name, "a");
    assert_eq(prog.functions[0].params[0].type_name, "Int");
    assert_eq(prog.functions[0].params[1].name, "b");
}

test "parse entry function" {
    let src: String = "module m version \"1.0\"; entry function main() returns Int " + '{'.to_string() + " return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(prog.functions[0].is_entry, true);
    assert_eq(prog.functions[0].name, "main");
}

test "parse public function" {
    let src: String = "module m version \"1.0\"; public function helper() returns Void " + '{'.to_string() + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(prog.functions[0].is_public, true);
}

test "parse multiple functions" {
    let src: String = "module m version \"1.0\"; function a() returns Int " + '{'.to_string() + " return 1; " + '}'.to_string() + " function b() returns Int " + '{'.to_string() + " return 2; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions), 2);
    assert_eq(prog.functions[0].name, "a");
    assert_eq(prog.functions[1].name, "b");
}

test "function with generic return type captures head" {
    let src: String = "module m version \"1.0\"; function get_items() returns Array<Int> " + '{'.to_string() + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(prog.functions[0].return_type, "Array<...>");
}

test "parser reports unexpected token at top level" {
    let prog: Program = parse("module m version \"1.0\"; entity Foo " + '{'.to_string() + " field x: Int; " + '}'.to_string());
    // Entities are not in Phase 33 scope; expect an error.
    assert(prog.error != "");
}

test "missing semicolon after module records error" {
    let prog: Program = parse("module foo version \"1.0\"");
    assert(prog.error != "");
}

// --- Phase 34: statement parser tests ---------------------------------------

test "empty function body produces empty block" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + '{'.to_string() + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions[0].body.stmts), 0);
}

test "single return parses as one st_return statement" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions[0].body.stmts), 1);
    let s: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(s.kind, st_return());
    assert_eq(s.expr.kind, ex_int());
    assert_eq(s.expr.int_value, 0);
}

test "return without value records ex_void" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + '{'.to_string() + " return; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let s: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(s.kind, st_return());
    assert_eq(s.expr.kind, ex_void());
}

test "let with type annotation" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " let x: Int = 7; return x; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions[0].body.stmts), 2);
    let l: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(l.kind, st_let());
    assert_eq(l.name, "x");
    assert_eq(l.type_name, "Int");
    assert_eq(l.is_mutable, false);
    assert_eq(l.expr.kind, ex_int());
    assert_eq(l.expr.int_value, 7);
    let r: Stmt = prog.functions[0].body.stmts[1];
    assert_eq(r.kind, st_return());
    assert_eq(r.expr.kind, ex_ident());
    assert_eq(r.expr.name, "x");
}

test "let mutable without annotation" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " let mutable y = 0; return y; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let l: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(l.kind, st_let());
    assert_eq(l.name, "y");
    assert_eq(l.type_name, "");
    assert_eq(l.is_mutable, true);
    assert_eq(l.expr.kind, ex_int());
    assert_eq(l.expr.int_value, 0);
}

test "expression statement is parsed as assignment binop" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " let mutable y = 0; y = y + 1; return y; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions[0].body.stmts), 3);
    let s: Stmt = prog.functions[0].body.stmts[1];
    assert_eq(s.kind, st_expr());
    assert_eq(s.expr.kind, ex_binop());
    assert_eq(s.expr.name, "=");
    assert_eq(s.expr.children[0].kind, ex_ident());
    assert_eq(s.expr.children[0].name, "y");
    let rhs: Expr = s.expr.children[1];
    assert_eq(rhs.kind, ex_binop());
    assert_eq(rhs.name, "+");
    assert_eq(rhs.children[0].name, "y");
    assert_eq(rhs.children[1].kind, ex_int());
    assert_eq(rhs.children[1].int_value, 1);
}

test "if statement without else" {
    let src: String = "module m version \"1.0\"; function f(x: Int) returns Int " + '{'.to_string() + " if x > 0 " + '{'.to_string() + " return 1; " + '}'.to_string() + " return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions[0].body.stmts), 2);
    let iff: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(iff.kind, st_if());
    assert_eq(iff.expr.kind, ex_binop());
    assert_eq(iff.expr.name, ">");
    assert_eq(iff.expr.children[0].name, "x");
    assert_eq(iff.expr.children[1].int_value, 0);
    assert_eq(iff.has_else, false);
    assert_eq(len(iff.then_block.stmts), 1);
    let inner: Stmt = iff.then_block.stmts[0];
    assert_eq(inner.kind, st_return());
    assert_eq(inner.expr.kind, ex_int());
    assert_eq(inner.expr.int_value, 1);
}

test "if-else statement" {
    let src: String = "module m version \"1.0\"; function f(x: Int) returns Int " + '{'.to_string() + " if x > 0 " + '{'.to_string() + " return 1; " + '}'.to_string() + " else " + '{'.to_string() + " return 0; " + '}'.to_string() + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let iff: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(iff.kind, st_if());
    assert_eq(iff.has_else, true);
    assert_eq(len(iff.else_block.stmts), 1);
    let else_ret: Stmt = iff.else_block.stmts[0];
    assert_eq(else_ret.expr.kind, ex_int());
    assert_eq(else_ret.expr.int_value, 0);
}

test "else if chains into nested if in else_block" {
    let src: String = "module m version \"1.0\"; function f(x: Int) returns Int " + '{'.to_string()
        + " if x > 0 " + '{'.to_string() + " return 1; " + '}'.to_string()
        + " else if x < 0 " + '{'.to_string() + " return 0 - 1; " + '}'.to_string()
        + " else " + '{'.to_string() + " return 0; " + '}'.to_string()
        + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let outer: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(outer.kind, st_if());
    assert_eq(outer.has_else, true);
    assert_eq(len(outer.else_block.stmts), 1);
    let inner: Stmt = outer.else_block.stmts[0];
    assert_eq(inner.kind, st_if());
    assert_eq(inner.expr.kind, ex_binop());
    assert_eq(inner.expr.name, "<");
    assert_eq(inner.has_else, true);
    assert_eq(inner.else_block.stmts[0].expr.int_value, 0);
}

test "while statement" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string()
        + " let mutable i: Int = 0; while i < 10 " + '{'.to_string() + " i = i + 1; " + '}'.to_string()
        + " return i; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let w: Stmt = prog.functions[0].body.stmts[1];
    assert_eq(w.kind, st_while());
    assert_eq(w.expr.kind, ex_binop());
    assert_eq(w.expr.name, "<");
    assert_eq(w.expr.children[0].name, "i");
    assert_eq(w.expr.children[1].int_value, 10);
    assert_eq(len(w.then_block.stmts), 1);
    let inc: Stmt = w.then_block.stmts[0];
    assert_eq(inc.kind, st_expr());
    assert_eq(inc.expr.kind, ex_binop());
    assert_eq(inc.expr.name, "=");
}

test "call expression with arguments parses as ex_call" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string()
        + " let x: Int = add(1, 2); return x; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let l: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(l.expr.kind, ex_call());
    assert_eq(len(l.expr.children), 3);
    assert_eq(l.expr.children[0].kind, ex_ident());
    assert_eq(l.expr.children[0].name, "add");
    assert_eq(l.expr.children[1].int_value, 1);
    assert_eq(l.expr.children[2].int_value, 2);
}

test "nested if inside if then-block" {
    let src: String = "module m version \"1.0\"; function f(x: Int, y: Int) returns Int " + '{'.to_string()
        + " if x > 0 " + '{'.to_string()
        + " if y > 0 " + '{'.to_string() + " return 1; " + '}'.to_string()
        + " " + '}'.to_string()
        + " return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let outer: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(outer.kind, st_if());
    let inner: Stmt = outer.then_block.stmts[0];
    assert_eq(inner.kind, st_if());
    assert_eq(inner.expr.kind, ex_binop());
    assert_eq(inner.expr.name, ">");
    assert_eq(inner.expr.children[0].name, "y");
}

test "missing semicolon after return is reported" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " return 0 " + '}'.to_string();
    let prog: Program = parse(src);
    assert(prog.error != "");
}

// --- Phase 35: expression parser tests --------------------------------------

// Small helper: extract the RHS Expr of the let-binding in `let x = E;`
// from a one-statement function body. Keeps test fixtures terse.
public function single_let_rhs(prog: Program) returns Expr {
    return prog.functions[0].body.stmts[0].expr;
}

public function wrap_in_let(rhs_text: String) returns String {
    return "module m version \"1.0\"; function f() returns Int " + '{'.to_string()
         + " let x: Int = " + rhs_text + "; return x; " + '}'.to_string();
}

test "parse_int converts decimal token text" {
    assert_eq(parse_int("0"), 0);
    assert_eq(parse_int("7"), 7);
    assert_eq(parse_int("42"), 42);
    assert_eq(parse_int("12345"), 12345);
}

test "integer literal expression" {
    let prog: Program = parse(wrap_in_let("99"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, ex_int());
    assert_eq(e.int_value, 99);
}

test "bool literals parse as ex_bool" {
    let prog_t: Program = parse(wrap_in_let("true"));
    let e_t: Expr = single_let_rhs(prog_t);
    assert_eq(e_t.kind, ex_bool());
    assert_eq(e_t.bool_value, true);
    let prog_f: Program = parse(wrap_in_let("false"));
    let e_f: Expr = single_let_rhs(prog_f);
    assert_eq(e_f.kind, ex_bool());
    assert_eq(e_f.bool_value, false);
}

test "string literal preserves quotes-stripped value" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string()
        + " let s: String = \"hello\"; return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, ex_string());
    assert_eq(e.str_value, "hello");
}

test "unary minus on int literal" {
    let prog: Program = parse(wrap_in_let("-5"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, ex_unary());
    assert_eq(e.name, "-");
    assert_eq(e.children[0].kind, ex_int());
    assert_eq(e.children[0].int_value, 5);
}

test "unary not on bool" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string()
        + " let b: Bool = not true; return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, ex_unary());
    assert_eq(e.name, "not");
    assert_eq(e.children[0].kind, ex_bool());
    assert_eq(e.children[0].bool_value, true);
}

test "operator precedence: 1 + 2 * 3 binds * tighter" {
    let prog: Program = parse(wrap_in_let("1 + 2 * 3"));
    assert_eq(prog.error, "");
    let root: Expr = single_let_rhs(prog);
    assert_eq(root.kind, ex_binop());
    assert_eq(root.name, "+");
    assert_eq(root.children[0].int_value, 1);
    let rhs: Expr = root.children[1];
    assert_eq(rhs.kind, ex_binop());
    assert_eq(rhs.name, "*");
    assert_eq(rhs.children[0].int_value, 2);
    assert_eq(rhs.children[1].int_value, 3);
}

test "operator precedence: comparison binds tighter than and" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string()
        + " let b: Bool = 1 < 2 and 3 > 4; return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let root: Expr = single_let_rhs(prog);
    assert_eq(root.kind, ex_binop());
    assert_eq(root.name, "and");
    assert_eq(root.children[0].name, "<");
    assert_eq(root.children[1].name, ">");
}

test "parens override precedence" {
    let prog: Program = parse(wrap_in_let("(1 + 2) * 3"));
    assert_eq(prog.error, "");
    let root: Expr = single_let_rhs(prog);
    assert_eq(root.kind, ex_binop());
    assert_eq(root.name, "*");
    assert_eq(root.children[0].kind, ex_paren());
    let inner: Expr = root.children[0].children[0];
    assert_eq(inner.kind, ex_binop());
    assert_eq(inner.name, "+");
}

test "assignment is right-associative" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string()
        + " a = b = c; return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let s: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(s.expr.kind, ex_binop());
    assert_eq(s.expr.name, "=");
    assert_eq(s.expr.children[0].name, "a");
    let rhs: Expr = s.expr.children[1];
    assert_eq(rhs.kind, ex_binop());
    assert_eq(rhs.name, "=");
    assert_eq(rhs.children[0].name, "b");
    assert_eq(rhs.children[1].name, "c");
}

test "field access via dot" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string()
        + " let n: Int = self.position; return n; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, ex_field());
    assert_eq(e.name, "position");
    assert_eq(e.children[0].kind, ex_ident());
    assert_eq(e.children[0].name, "self");
}

test "method call: x.to_string()" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string()
        + " let s: String = x.to_string(); return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    // x.to_string() = call(field(ident "x", "to_string"))
    assert_eq(e.kind, ex_call());
    let callee: Expr = e.children[0];
    assert_eq(callee.kind, ex_field());
    assert_eq(callee.name, "to_string");
    assert_eq(callee.children[0].name, "x");
}

test "indexing: arr[0]" {
    let prog: Program = parse(wrap_in_let("arr[0]"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, ex_index());
    assert_eq(e.children[0].name, "arr");
    assert_eq(e.children[1].int_value, 0);
}

test "slice: s[i..j] parses as index of range" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string()
        + " let sub: String = s[1..5]; return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, ex_index());
    let idx: Expr = e.children[1];
    assert_eq(idx.kind, ex_range());
    assert_eq(idx.children[0].int_value, 1);
    assert_eq(idx.children[1].int_value, 5);
}

test "array literal parses as ex_array" {
    let prog: Program = parse(wrap_in_let("[10, 20, 30]"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, ex_array());
    assert_eq(len(e.children), 3);
    assert_eq(e.children[0].int_value, 10);
    assert_eq(e.children[1].int_value, 20);
    assert_eq(e.children[2].int_value, 30);
}

test "empty array literal" {
    let prog: Program = parse(wrap_in_let("[]"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, ex_array());
    assert_eq(len(e.children), 0);
}

test "no-arg call: f()" {
    let prog: Program = parse(wrap_in_let("f()"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, ex_call());
    assert_eq(len(e.children), 1);
    assert_eq(e.children[0].name, "f");
}

test "nested call f(g(x))" {
    let prog: Program = parse(wrap_in_let("f(g(x))"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, ex_call());
    assert_eq(e.children[0].name, "f");
    let arg: Expr = e.children[1];
    assert_eq(arg.kind, ex_call());
    assert_eq(arg.children[0].name, "g");
    assert_eq(arg.children[1].name, "x");
}

test "method chain a.b().c() left-associates" {
    let prog: Program = parse(wrap_in_let("a.b().c()"));
    assert_eq(prog.error, "");
    let outer: Expr = single_let_rhs(prog);
    // outer = call(field(call(field(a, b)), c))
    assert_eq(outer.kind, ex_call());
    let callee_c: Expr = outer.children[0];
    assert_eq(callee_c.kind, ex_field());
    assert_eq(callee_c.name, "c");
    let inner_call: Expr = callee_c.children[0];
    assert_eq(inner_call.kind, ex_call());
    let callee_b: Expr = inner_call.children[0];
    assert_eq(callee_b.kind, ex_field());
    assert_eq(callee_b.name, "b");
    assert_eq(callee_b.children[0].name, "a");
}

test "qualified call via module path: mod.func(arg)" {
    let prog: Program = parse(wrap_in_let("formatter_lexer.tk_eof()"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, ex_call());
    let callee: Expr = e.children[0];
    assert_eq(callee.kind, ex_field());
    assert_eq(callee.name, "tk_eof");
    assert_eq(callee.children[0].name, "formatter_lexer");
}

test "equality and comparison both parse" {
    let prog_eq: Program = parse(wrap_in_let("a == b"));
    let e_eq: Expr = single_let_rhs(prog_eq);
    assert_eq(e_eq.name, "==");
    let prog_neq: Program = parse(wrap_in_let("a != b"));
    let e_neq: Expr = single_let_rhs(prog_neq);
    assert_eq(e_neq.name, "!=");
    let prog_leq: Program = parse(wrap_in_let("a <= b"));
    let e_leq: Expr = single_let_rhs(prog_leq);
    assert_eq(e_leq.name, "<=");
}

test "missing expression after = reports error" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string()
        + " let x: Int = ; return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert(prog.error != "");
}
