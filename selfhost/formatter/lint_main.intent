// selfhost/formatter/lint_main.intent — Phase 43.10 / stage2 runnable linter.
//
// The stage2 linter as an invokable CLI tool. Reads a single file path from
// args()[1] (ADR 0045), reads the file, parses it, and prints lint diagnostics
// to stdout matching stage1 `intentc lint` output exactly.
//
// Output format (byte-equal with stage1):
//   - Zero diags: "No lint warnings.\n"
//   - N > 0 diags: each "warning[path:line:col]: msg\n" followed by
//     "N warning(s) found.\n" (always "(s)", even for N=1).
//
// Note: print() lowers to println!/console.log, appending exactly one
// trailing newline. format_diags() ends each warning line with "\n", so
// `format_diags(...) + "N warning(s) found."` + print's "\n" gives the
// correct final newline.
//
// Exit codes:
//   0  diagnostics printed (including zero-warning case)
//   1  usage error (no file argument)
//   2  file could not be read
//   3  parse error (the source is not valid Intent the stage2 parser accepts)
module formatter_lint_main version "0.1.0";

import "lint.intent";
import "parser.intent";
import "ast.intent";
import "lexer.intent";

entry function main() returns Int {
    let argv: Array<String> = args();
    if len(argv) < 2 {
        print("usage: intent-lint <file.intent>");
        return 1;
    }
    let path: String = argv[1];
    let r: Result<String, String> = read_file(path);
    if r.is_err() {
        print("error: cannot read file: " + path);
        return 2;
    }
    let src: String = match r {
        Ok(s) => s,
        Err(_) => "",
    };
    let prog: Program = formatter_parser.parse(src);
    if prog.error != "" {
        print("parse error: " + prog.error);
        return 3;
    }
    let diags: Array<LintDiag> = formatter_linter.lint_program(prog);
    if len(diags) == 0 {
        print("No lint warnings.");
        return 0;
    }
    print(formatter_linter.format_diags(diags, path) + len(diags).to_string() + " warning(s) found.");
    return 0;
}
