// selfhost/formatter/format_test.intent — Phase 38 stage2 formatter tests.
//
// Lives separately from `format.intent` to keep the formatter file pure
// (matches stage1's convention of test-free implementation files when the
// test count grows). Imports format.intent and parser.intent and verifies
// round-trip behaviour on synthetic and real-file fixtures.

module formatter_format_test version "0.1.0";

import "format.intent";
import "parser.intent";
import "ast.intent";
import "lexer.intent";

// --- Unit tests: individual emitters ----------------------------------------

test "format_module_decl emits canonical form" {
    let m: ModuleDecl = ModuleDecl("hello", "1.0.0");
    let s: String = formatter_format.format_module_decl(m);
    assert_eq(s, "module hello version \"1.0.0\";");
}

test "format_import_decl file form" {
    let mutable no_cmts: Array<String> = [];
    let imp: ImportDecl = ImportDecl(false, "lexer.intent", 1, no_cmts);
    let s: String = formatter_format.format_import_decl(imp);
    assert_eq(s, "import \"lexer.intent\";");
}

test "format_import_decl package form" {
    let mutable no_cmts: Array<String> = [];
    let imp: ImportDecl = ImportDecl(true, "math", 1, no_cmts);
    let s: String = formatter_format.format_import_decl(imp);
    assert_eq(s, "import math;");
}

test "format_expr int literal" {
    let mutable children: Array<Expr> = [];
    let e: Expr = Expr(formatter_ast.ex_int(), 42, "", false, "", children);
    assert_eq(formatter_format.format_expr(e), "42");
}

test "format_expr bool literals" {
    let mutable c1: Array<Expr> = [];
    let t: Expr = Expr(formatter_ast.ex_bool(), 0, "", true, "", c1);
    assert_eq(formatter_format.format_expr(t), "true");
    let mutable c2: Array<Expr> = [];
    let f: Expr = Expr(formatter_ast.ex_bool(), 0, "", false, "", c2);
    assert_eq(formatter_format.format_expr(f), "false");
}

test "format_expr string literal re-quotes" {
    let mutable children: Array<Expr> = [];
    let e: Expr = Expr(formatter_ast.ex_string(), 0, "hello", false, "", children);
    assert_eq(formatter_format.format_expr(e), "\"hello\"");
}

test "format_expr char literal preserves raw lexeme" {
    let mutable children: Array<Expr> = [];
    let e: Expr = Expr(formatter_ast.ex_char(), 0, "'a'", false, "", children);
    assert_eq(formatter_format.format_expr(e), "'a'");
}

test "format_expr float literal preserves raw lexeme" {
    let mutable children: Array<Expr> = [];
    let e: Expr = Expr(formatter_ast.ex_float(), 0, "3.14", false, "", children);
    assert_eq(formatter_format.format_expr(e), "3.14");
}

test "format_expr ident" {
    let mutable children: Array<Expr> = [];
    let e: Expr = Expr(formatter_ast.ex_ident(), 0, "", false, "foo", children);
    assert_eq(formatter_format.format_expr(e), "foo");
}

// --- Round-trip tests: parse + format ---------------------------------------

// Helper: parse a source string and format it. Asserts no parse error.
public function roundtrip(src: String) returns String {
    let prog: Program = formatter_parser.parse(src);
    assert_eq(prog.error, "");
    return formatter_format.format_program(prog);
}

test "source order: interleaved decl kinds preserve user order (ADR 0042)" {
    // Source order is: function, test, function, test. Without source-order
    // tracking (per-kind sort), the formatter would emit both functions
    // first then both tests — breaking byte-equality with stage1 fmt.
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function a() returns Int " + '{'.to_string() + "\n    return 1;\n" + '}'.to_string() + "\n\n"
        + "test \"first\" " + '{'.to_string() + "\n    assert(true);\n" + '}'.to_string() + "\n\n"
        + "function b() returns Int " + '{'.to_string() + "\n    return 2;\n" + '}'.to_string() + "\n\n"
        + "test \"second\" " + '{'.to_string() + "\n    assert(true);\n" + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "source order: line field populated by parser" {
    let src: String = "module m version \"1.0.0\";\n\nfunction a() returns Int " + '{'.to_string() + " return 0; " + '}'.to_string() + "\n\nfunction b() returns Int " + '{'.to_string() + " return 0; " + '}'.to_string();
    let prog: Program = formatter_parser.parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions), 2);
    // Module is line 1, blank line is 2, function a is line 3, blank is 4,
    // function b is line 5.
    assert_eq(prog.functions[0].line, 3);
    assert_eq(prog.functions[1].line, 5);
}

// --- Comment preservation tests (ADR 0044) ----------------------------------

test "comments: single-line comment before a function survives roundtrip" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "// Returns zero.\n"
        + "function f() returns Int " + '{'.to_string() + "\n    return 0;\n" + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "comments: multiple single-line comments before a decl" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "// First line of doc.\n"
        + "// Second line of doc.\n"
        + "function f() returns Int " + '{'.to_string() + "\n    return 0;\n" + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "comments: block comment before a function" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "/* block comment */\n"
        + "function f() returns Int " + '{'.to_string() + "\n    return 0;\n" + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "comments: comments before a public function (post-public consumption)" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "// Documents the public helper.\n"
        + "public function helper() returns Int " + '{'.to_string() + "\n    return 0;\n" + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "comments: comments before an entity decl" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "// A counter.\n"
        + "entity Counter " + '{'.to_string() + "\n    field n: Int;\n" + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "comments: comments between interleaved decls preserved with source order" {
    // Bodies in canonical multi-line form so the formatter doesn't reflow
    // them and produce a diff unrelated to comment preservation.
    let src: String = "module m version \"1.0.0\";\n\n"
        + "// First function.\n"
        + "function a() returns Int " + '{'.to_string() + "\n    return 1;\n" + '}'.to_string() + "\n\n"
        + "// First test.\n"
        + "test \"t1\" " + '{'.to_string() + "\n    assert(true);\n" + '}'.to_string() + "\n\n"
        + "// Second function.\n"
        + "function b() returns Int " + '{'.to_string() + "\n    return 2;\n" + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

// --- Trailing comment tests (Phase 40A.2 / ADR 0044) ------------------------

test "trailing: single comment after the last decl survives roundtrip" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + "\n    return 0;\n" + '}'.to_string() + "\n\n"
        + "// Trailing note.\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "trailing: multiple comments after the last decl" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + "\n    return 0;\n" + '}'.to_string() + "\n\n"
        + "// First trailing line.\n"
        + "// Second trailing line.\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "trailing: block comment after the last decl" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + "\n    return 0;\n" + '}'.to_string() + "\n\n"
        + "/* trailing block */\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "trailing: parser populates Program.trailing_comments from EOF token" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + " return 0; " + '}'.to_string() + "\n\n"
        + "// Trailing note.\n";
    let prog: Program = formatter_parser.parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.trailing_comments), 1);
    assert_eq(prog.trailing_comments[0], "// Trailing note.");
}

test "trailing: no trailing comment leaves trailing_comments empty" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + " return 0; " + '}'.to_string() + "\n\n";
    let prog: Program = formatter_parser.parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.trailing_comments), 0);
}

// --- Body / between-statement comment tests (Phase 40A.2 / ADR 0044) -------

// AC1: a single `//` comment between two statements in a function body
// round-trips byte-equal.
test "body comments: single comment between two statements survives roundtrip" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + "\n"
        + "    let x: Int = 1;\n"
        + "    // a comment\n"
        + "    let y: Int = 2;\n"
        + "    return x;\n"
        + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

// AC2: two consecutive `//` comment lines between statements round-trip.
test "body comments: two comment lines between statements survive roundtrip" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + "\n"
        + "    let x: Int = 1;\n"
        + "    // first comment\n"
        + "    // second comment\n"
        + "    return x;\n"
        + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

// AC3: a comment before the FIRST statement in a body round-trips.
test "body comments: comment before first statement survives roundtrip" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + "\n"
        + "    // leading body comment\n"
        + "    return 0;\n"
        + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

// AC4: a `/* block */` comment between statements round-trips.
test "body comments: block comment between statements survives roundtrip" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + "\n"
        + "    let x: Int = 1;\n"
        + "    /* block comment */\n"
        + "    return x;\n"
        + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

// AC5: assert that the parser populates Stmt.comments_before correctly.
test "body comments: parser populates Stmt.comments_before" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + "\n"
        + "    let x: Int = 1;\n"
        + "    // annotated\n"
        + "    return x;\n"
        + '}'.to_string() + "\n\n";
    let prog: Program = formatter_parser.parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions), 1);
    let body: Block = prog.functions[0].body;
    // body has two stmts: `let x` and `return x`
    assert_eq(len(body.stmts), 2);
    // the `return x` statement should carry the comment
    assert_eq(len(body.stmts[1].comments_before), 1);
    assert_eq(body.stmts[1].comments_before[0], "// annotated");
}

// --- Inline-after comment tests (Phase 40A.2 / ADR 0044) -------------------

// AC1: a `let` statement with an inline-after comment round-trips.
test "inline-after: let statement with inline comment survives roundtrip" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + "\n"
        + "    let x: Int = 1; // note\n"
        + "    return x;\n"
        + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

// AC2: an expression statement with an inline-after comment round-trips.
test "inline-after: expr statement with inline comment survives roundtrip" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Void " + '{'.to_string() + "\n"
        + "    print(x); // show\n"
        + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

// AC3: a statement with both a leading comment and an inline-after comment
// round-trips.
test "inline-after: leading comment plus inline comment survives roundtrip" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + "\n"
        + "    // leading\n"
        + "    let x: Int = 1; // trailing\n"
        + "    return x;\n"
        + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

// AC4: parser populates Stmt.comment_after for a let statement.
test "inline-after: parser populates Stmt.comment_after" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + "\n"
        + "    let x: Int = 1; // note\n"
        + "    return x;\n"
        + '}'.to_string() + "\n\n";
    let prog: Program = formatter_parser.parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions), 1);
    let body: Block = prog.functions[0].body;
    assert_eq(len(body.stmts), 2);
    assert_eq(body.stmts[0].comment_after, "// note");
}

// AC5: a statement with no inline comment has comment_after == "".
test "inline-after: statement without inline comment has empty comment_after" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + "\n"
        + "    let x: Int = 1;\n"
        + "    return x;\n"
        + '}'.to_string() + "\n\n";
    let prog: Program = formatter_parser.parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions), 1);
    let body: Block = prog.functions[0].body;
    assert_eq(body.stmts[0].comment_after, "");
}

// --- Comprehensive comment round-trip (Phase 40A.2 step 4, partial gate) -----
// Exercises all FOUR comment positions the formatter now preserves in one
// program: leading-decl, inline-after-statement, leading body comment, and
// trailing-EOF. Real-file byte-equal self-format on the stage2 sources needs
// the remaining positions (module-leading, entity fields/methods, end-of-block)
// plus de-aligning the source — tracked as Phase 40A.3.
test "comprehensive: all supported comment positions round-trip" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "// A documented function.\n"
        + "function f() returns Int " + '{'.to_string() + "\n"
        + "    let x: Int = 1; // inline note\n"
        + "    // a leading body comment\n"
        + "    let y: Int = 2;\n"
        + "    return x;\n"
        + '}'.to_string() + "\n\n"
        + "// trailing file comment\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

// --- Module-leading comment tests (Phase 40A.3 / ADR 0044) ------------------

test "module-leading: comments before module survive roundtrip" {
    let src: String = "// File header line one.\n"
        + "// File header line two.\n"
        + "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + "\n    return 0;\n" + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "module-leading: parser populates ModuleDecl.comments_before" {
    let src: String = "// Header.\nmodule m version \"1.0.0\";\n\nfunction f() returns Int " + '{'.to_string() + " return 0; " + '}'.to_string() + "\n\n";
    let prog: Program = formatter_parser.parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.module_decl.comments_before), 1);
    assert_eq(prog.module_decl.comments_before[0], "// Header.");
}

// --- Entity field / method comment tests (Phase 40A.3 / ADR 0044) -----------

// AC1: a leading comment before a field survives roundtrip.
test "entity comments: leading comment before field survives roundtrip" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "entity E " + '{'.to_string() + "\n"
        + "    // count\n"
        + "    field n: Int;\n"
        + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

// AC2: an inline-after comment on a field survives roundtrip.
test "entity comments: inline-after comment on field survives roundtrip" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "entity E " + '{'.to_string() + "\n"
        + "    field n: Int; // the count\n"
        + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

// AC3: a leading comment before a method survives roundtrip.
test "entity comments: leading comment before method survives roundtrip" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "entity E " + '{'.to_string() + "\n"
        + "    field n: Int;\n\n"
        + "    // doc\n"
        + "    method get() returns Int " + '{'.to_string() + "\n"
        + "        return self.n;\n"
        + "    " + '}'.to_string() + "\n"
        + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

// AC4: parser populates FieldDecl.comments_before and FieldDecl.comment_after.
test "entity comments: parser populates FieldDecl comments_before and comment_after" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "entity E " + '{'.to_string() + "\n"
        + "    // count\n"
        + "    field n: Int; // inline\n"
        + '}'.to_string() + "\n\n";
    let prog: Program = formatter_parser.parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.entities[0].fields[0].comments_before), 1);
    assert_eq(prog.entities[0].fields[0].comments_before[0], "// count");
    assert_eq(prog.entities[0].fields[0].comment_after, "// inline");
}

// --- End-of-block comment tests (Phase 40A.3 / ADR 0044) --------------------

test "end-of-block: comment before closing brace survives roundtrip" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + "\n"
        + "    return 0;\n"
        + "    // end of block\n"
        + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "end-of-block: parser populates Block.trailing_comments" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + "\n"
        + "    return 0;\n"
        + "    // tail\n"
        + '}'.to_string() + "\n\n";
    let prog: Program = formatter_parser.parse(src);
    assert_eq(prog.error, "");
    let body: Block = prog.functions[0].body;
    assert_eq(len(body.trailing_comments), 1);
    assert_eq(body.trailing_comments[0], "// tail");
}

// --- Trailing-brace inline comment tests (Phase 40A.3 / ADR 0044) -----------

test "brace-after: inline comment after a function's closing brace round-trips" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + "\n    return 1;\n" + '}'.to_string() + " // note\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "brace-after: parser populates Block.brace_comment_after" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + " return 1; " + '}'.to_string() + " // note\n\n";
    let prog: Program = formatter_parser.parse(src);
    assert_eq(prog.error, "");
    assert_eq(prog.functions[0].body.brace_comment_after, "// note");
}

// --- Contract clause tests (Phase 41.1) -------------------------------------

test "contracts: function requires + ensures round-trips" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function fib(n: Int) returns Int\n"
        + "    requires n >= 0\n"
        + "    ensures result >= 0\n"
        + '{'.to_string() + "\n    return n;\n" + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "contracts: function decreases round-trips" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f(n: Int) returns Int\n"
        + "    decreases n\n"
        + '{'.to_string() + "\n    return n;\n" + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "contracts: method requires + ensures round-trips" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "entity E " + '{'.to_string() + "\n"
        + "    field n: Int;\n"
        + "\n"
        + "    method get() returns Int\n"
        + "        requires self.n >= 0\n"
        + "        ensures result >= 0\n"
        + "    " + '{'.to_string() + "\n"
        + "        return self.n;\n"
        + "    " + '}'.to_string() + "\n"
        + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "contracts: parser populates requires/ensures clauses" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function fib(n: Int) returns Int\n"
        + "    requires n >= 0\n"
        + "    ensures result >= 0\n"
        + '{'.to_string() + "\n    return n;\n" + '}'.to_string() + "\n\n";
    let prog: Program = formatter_parser.parse(src);
    assert_eq(prog.error, "");
    let decl: FunctionDecl = prog.functions[0];
    assert_eq(len(decl.requires_clauses), 1);
    assert_eq(len(decl.ensures_clauses), 1);
    assert_eq(formatter_format.format_expr(decl.requires_clauses[0]), "n >= 0");
    assert_eq(formatter_format.format_expr(decl.ensures_clauses[0]), "result >= 0");
}

// --- Match expression tests (Phase 41.2) ------------------------------------

test "match: let with variant-binding + wildcard arms round-trips" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + "\n"
        + "    let recovered: Int = match back " + '{'.to_string() + "\n"
        + "        Ok(c) => c,\n"
        + "        Err(_) => 0,\n"
        + "    " + '}'.to_string() + ";\n"
        + "    return recovered;\n"
        + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "match: return with bare-variant + wildcard arms round-trips" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + "\n"
        + "    return match color " + '{'.to_string() + "\n"
        + "        Red => 1,\n"
        + "        Green => 2,\n"
        + "        _ => 0,\n"
        + "    " + '}'.to_string() + ";\n"
        + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "match: parser populates arms, bindings, and wildcard" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + "\n"
        + "    let recovered: Int = match back " + '{'.to_string() + "\n"
        + "        Ok(c) => c,\n"
        + "        Err(_) => 0,\n"
        + "    " + '}'.to_string() + ";\n"
        + "    return recovered;\n"
        + '}'.to_string() + "\n\n";
    let prog: Program = formatter_parser.parse(src);
    assert_eq(prog.error, "");
    let body: Block = prog.functions[0].body;
    let rhs: Expr = body.stmts[0].expr;
    assert_eq(rhs.kind, formatter_ast.ex_match());
    assert_eq(len(rhs.match_arms), 2);
    assert_eq(rhs.match_arms[0].variant, "Ok");
    assert_eq(len(rhs.match_arms[0].bindings), 1);
    assert_eq(rhs.match_arms[0].bindings[0], "c");
    assert_eq(rhs.match_arms[1].variant, "Err");
}

// --- for-in loop tests (Phase 41.3) -----------------------------------------

test "for-in: loop over a collection round-trips" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + "\n"
        + "    for x in numbers " + '{'.to_string() + "\n"
        + "        return x;\n"
        + "    " + '}'.to_string() + "\n"
        + "    return 0;\n"
        + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "for-in: loop over a range round-trips" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + "\n"
        + "    for i in 0..n " + '{'.to_string() + "\n"
        + "        return i;\n"
        + "    " + '}'.to_string() + "\n"
        + "    return 0;\n"
        + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "for-in: parser populates loop var, iterable, body" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + "\n"
        + "    for x in numbers " + '{'.to_string() + "\n"
        + "        return x;\n"
        + "    " + '}'.to_string() + "\n"
        + "    return 0;\n"
        + '}'.to_string() + "\n\n";
    let prog: Program = formatter_parser.parse(src);
    assert_eq(prog.error, "");
    let s: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(s.kind, formatter_ast.st_for());
    assert_eq(s.name, "x");
    assert_eq(formatter_format.format_expr(s.expr), "numbers");
}

// --- try operator tests (Phase 41.4) ----------------------------------------

test "try: postfix ? on a call round-trips" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + "\n"
        + "    let x: Int = parse(s)?;\n"
        + "    return x;\n"
        + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "try: parser populates ex_try wrapping the inner expr" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f() returns Int " + '{'.to_string() + "\n"
        + "    let x: Int = parse(s)?;\n"
        + "    return x;\n"
        + '}'.to_string() + "\n\n";
    let prog: Program = formatter_parser.parse(src);
    assert_eq(prog.error, "");
    let rhs: Expr = prog.functions[0].body.stmts[0].expr;
    assert_eq(rhs.kind, formatter_ast.ex_try());
    assert_eq(rhs.children[0].kind, formatter_ast.ex_call());
}

// --- Paren stripping tests (ADR 0043) ---------------------------------------

// Helper: roundtrip a `let x: Int = RHS;` expression and assert the formatter
// emits the same `RHS` text we provide. Catches both gain (parser missing
// something) and loss (formatter dropping something).
public function expr_roundtrips_to(rhs_in: String, rhs_out: String) returns Void {
    let src: String = "module m version \"1.0.0\";\n\nfunction f() returns Int " + '{'.to_string()
        + "\n    let x: Int = " + rhs_in + ";\n    return x;\n" + '}'.to_string() + "\n\n";
    let expected: String = "module m version \"1.0.0\";\n\nfunction f() returns Int " + '{'.to_string()
        + "\n    let x: Int = " + rhs_out + ";\n    return x;\n" + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, expected);
}

test "paren strip: redundant parens around a primary disappear" {
    expr_roundtrips_to("(42)", "42");
    expr_roundtrips_to("(x)", "x");
}

test "paren strip: necessary parens around lower-precedence binop kept" {
    // `*` is prec 8, `+` is prec 7. (a + b) * c requires the parens.
    expr_roundtrips_to("(a + b) * c", "(a + b) * c");
}

test "paren strip: redundant parens around higher-precedence binop stripped" {
    // `1 + (2 * 3)` — `*` already binds tighter, parens unnecessary.
    expr_roundtrips_to("1 + (2 * 3)", "1 + 2 * 3");
}

test "paren strip: same-precedence left-associative chain strips left paren" {
    // `(a + b) + c` is the natural left-assoc grouping for `+`. Strip.
    expr_roundtrips_to("(a + b) + c", "a + b + c");
}

test "paren strip: same-precedence right-side paren on left-assoc op kept" {
    // `a - (b - c)` is right-grouping for left-assoc `-`. Different from
    // `a - b - c`. Paren stays.
    expr_roundtrips_to("a - (b - c)", "a - (b - c)");
}

test "paren strip: logical operators across precedences" {
    // `or` is 2, `and` is 3, `==` is 4. `(a == b) and (c == d)` — both
    // parens unnecessary.
    expr_roundtrips_to("(a == b) and (c == d)", "a == b and c == d");
}

test "paren strip: parens around unary operand kept when needed" {
    // `not (a or b)` — `or` is 2, unary is 9. Paren keeps the meaning.
    expr_roundtrips_to("not (a or b)", "not (a or b)");
}

test "paren strip: parens inside call args unwrap" {
    // Function args are a fresh context — `(x + y)` becomes `x + y`.
    expr_roundtrips_to("f((x + y))", "f(x + y)");
}

test "round-trip: minimal module + function" {
    let src: String = "module m version \"1.0.0\";\n\nfunction f() returns Int " + '{'.to_string() + "\n    return 0;\n" + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "round-trip: entry function" {
    let src: String = "module hello version \"1.0.0\";\n\nentry function main() returns Int " + '{'.to_string() + "\n    return 0;\n" + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "round-trip: test declaration" {
    let src: String = "module m version \"1.0.0\";\n\ntest \"my test\" " + '{'.to_string() + "\n    assert(true);\n" + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "round-trip: let + return + arithmetic" {
    let src: String = "module m version \"1.0.0\";\n\nfunction f() returns Int " + '{'.to_string() + "\n    let mutable x: Int = 1 + 2;\n    return x;\n" + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "round-trip: function call expression" {
    let src: String = "module m version \"1.0.0\";\n\nfunction f() returns Int " + '{'.to_string() + "\n    let x: Int = fib(10);\n    return x;\n" + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "round-trip: if statement" {
    let src: String = "module m version \"1.0.0\";\n\nfunction f(n: Int) returns Int " + '{'.to_string() + "\n    if n <= 0 " + '{'.to_string() + "\n        return 0;\n    " + '}'.to_string() + "\n    return 1;\n" + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "round-trip: while loop" {
    let src: String = "module m version \"1.0.0\";\n\nfunction f() returns Int " + '{'.to_string() + "\n    let mutable i: Int = 0;\n    while i < 10 " + '{'.to_string() + "\n        i = i + 1;\n    " + '}'.to_string() + "\n    return i;\n" + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

