// Byte-equal self-format gate (Phase 40A.3): parsing then formatting a
// stage2 source file reproduces it exactly. The stage2 files were
// canonicalized in 40A.3.6 so the formatter is a fixpoint on them.
// Reads via a repo-root-relative path; when run from elsewhere (e.g. the
// `intentc test` temp cwd) read_file fails and the check is skipped — the
// always-on synthetic gates above cover behaviour in that case.
public function self_format_one(path: String) returns Void {
    let r: Result<String, String> = read_file(path);
    let src: String = match r {
        Ok(s) => s,
        Err(_) => "",
    };
    if src != "" {
        let prog: Program = formatter_parser.parse(src);
        assert_eq(prog.error, "");
        let out: String = formatter_format.format_program(prog);
        assert_eq(out, src);
    }
}

test "self-format: parse + format roundtrip succeeds on all stage2 files" {
    self_format_one("selfhost/formatter/lexer.intent");
    self_format_one("selfhost/formatter/ast.intent");
    self_format_one("selfhost/formatter/parser.intent");
    self_format_one("selfhost/formatter/format.intent");
}

// --- Entity invariant round-trip (Phase 42.5) --------------------------------

// Single-expression `invariant <expr>;` clauses appear between fields and
// constructor, matching stage1's layout exactly (grammar.ebnf:140).
test "entity invariant: fields + invariant + constructor round-trips" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "entity BankAccount " + '{'.to_string() + "\n"
        + "    field owner: String;\n"
        + "    field balance: Int;\n"
        + "\n"
        + "    invariant self.balance >= 0;\n"
        + "\n"
        + "    constructor(owner: String, initial_balance: Int) " + '{'.to_string() + "\n"
        + "    " + '}'.to_string() + "\n"
        + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

// --- implies operator tests (Phase 42) --------------------------------------

test "implies: round-trip in ensures clause" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "function f(b: Int) returns Int\n"
        + "    ensures result > 0 implies b != 0\n"
        + '{'.to_string() + "\n"
        + "    return 1;\n"
        + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "implies: parser produces right-associative ex_binop" {
    let src: String = "module m version \"1.0.0\";\n\nfunction f() returns Int " + '{'.to_string() + "\n    let b: Bool = a implies b implies c;\n    return 0;\n" + '}'.to_string() + "\n\n";
    let prog: Program = formatter_parser.parse(src);
    assert_eq(prog.error, "");
    let e: Expr = prog.functions[0].body.stmts[0].expr;
    assert_eq(e.kind, formatter_ast.ex_binop());
    assert_eq(e.name, "implies");
    // Right-assoc: lhs=a, rhs=(b implies c).
    assert_eq(e.children[0].name, "a");
    assert_eq(e.children[1].kind, formatter_ast.ex_binop());
    assert_eq(e.children[1].name, "implies");
}

// --- await expression tests (Phase 42) --------------------------------------

test "await: round-trip in async function body" {
    let src: String = "module m version \"1.0.0\";\n\n"
        + "async function f() returns Int " + '{'.to_string() + "\n"
        + "    let x: Int = await g();\n"
        + "    return x;\n"
        + '}'.to_string() + "\n\n";
    let out: String = roundtrip(src);
    assert_eq(out, src);
}

test "await: parser produces ex_await wrapping inner expr" {
    let src: String = "module m version \"1.0.0\";\n\nasync function f() returns Int " + '{'.to_string() + "\n    let x: Int = await g();\n    return x;\n" + '}'.to_string() + "\n\n";
    let prog: Program = formatter_parser.parse(src);
    assert_eq(prog.error, "");
    let rhs: Expr = prog.functions[0].body.stmts[0].expr;
    assert_eq(rhs.kind, formatter_ast.ex_await());
    assert_eq(rhs.children[0].kind, formatter_ast.ex_call());
}

test "dogfood: parse + format hello.intent matches expected canonical form" {
    let r: Result<String, String> = read_file("examples/hello.intent");
    let src: String = match r {
        Ok(s) => s,
        Err(_) => "",
    };
    if src != "" {
        // Only assert when the file was read — the synthetic round-trips
        // above cover the core behaviour when run from anywhere else.
        let out: String = roundtrip(src);
        assert_eq(out, src);
    }
}
