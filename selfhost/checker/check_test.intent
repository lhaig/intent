// selfhost/checker/check_test.intent — Phase 45 checker tests.
module checker_test version "0.1.0";

import "check.intent";
import "../shared/parser.intent";
import "../shared/ast.intent";
import "../shared/lexer.intent";

// Curly brace helpers — avoids string interpolation mis-parse of `{` / `}`.
function lbrace() returns String {
    return '{'.to_string();
}

function rbrace() returns String {
    return '}'.to_string();
}

// Helper: minimal function body " { }".
function fn_body() returns String {
    return " " + lbrace() + " " + rbrace();
}

// Helper: parse src and return check diagnostics.
function parse_and_check(src: String) returns Array<CheckDiag> {
    let prog: Program = shared_parser.parse(src);
    return checker.check_program(prog);
}

test "dup function: two functions named 'f' produces exactly one diag" {
    let src: String = "module m version \"1.0\"; function f() returns Void" + fn_body() + " function f() returns Void" + fn_body();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "function 'f' already defined");
}

test "dup function: duplicate diag message matches exactly" {
    let src: String = "module m version \"1.0\"; function foo() returns Void" + fn_body() + " function f() returns Void" + fn_body() + " function f() returns Void" + fn_body();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "function 'f' already defined");
}

test "dup entity: two entities named 'Foo' produces exactly one diag" {
    let src: String = "module m version \"1.0\"; entity Foo " + lbrace() + " field x: Int; " + rbrace() + " entity Foo " + lbrace() + " field y: Int; " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "entity 'Foo' already defined");
}

test "dup enum: two enums named 'Color' produces exactly one diag" {
    let src: String = "module m version \"1.0\"; enum Color " + lbrace() + " Red, " + rbrace() + " enum Color " + lbrace() + " Blue, " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "enum 'Color' already defined");
}

test "clean program: no dups produces zero diags" {
    let src: String = "module m version \"1.0\"; function foo() returns Void" + fn_body() + " function bar() returns Void" + fn_body();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "format_diags: one CheckDiag renders error line with no trailing newline" {
    let mutable one: Array<CheckDiag> = [];
    one.push(CheckDiag(3, 5, "m"));
    let out: String = checker.format_diags(one, "x.intent");
    assert_eq(out, "error[x.intent:3:5]: m");
}

test "format_diags: empty array returns empty string" {
    let empty: Array<CheckDiag> = [];
    let out: String = checker.format_diags(empty, "x.intent");
    assert_eq(out, "");
}

test "format_diags: two diags joined by newline with no trailing newline" {
    let mutable two: Array<CheckDiag> = [];
    two.push(CheckDiag(1, 1, "first"));
    two.push(CheckDiag(2, 3, "second"));
    let out: String = checker.format_diags(two, "f.intent");
    assert_eq(out, "error[f.intent:1:1]: first\nerror[f.intent:2:3]: second");
}

// Helper: build a test block source string: `test "NAME" { BODY }`.
function test_block(tname: String, body: String) returns String {
    return "test \"" + tname + "\" " + lbrace() + " " + body + " " + rbrace();
}

test "dup variant: enum with two identical variant names produces one diag" {
    let src: String = "module m version \"1.0\"; enum Color " + lbrace() + " Red, Red, " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "duplicate variant name 'Red' in enum 'Color'");
}

test "dup variant: enum with distinct variant names produces zero diags" {
    let src: String = "module m version \"1.0\"; enum Color " + lbrace() + " Red, Green, " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "return-in-test: bare return in test body produces one diag" {
    let src: String = "module m version \"1.0\"; " + test_block("t", "return;");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "'return' is not allowed inside a test body; test \"t\" has implicit Void return");
}

test "return-in-test: return nested inside if in test body fires" {
    let if_src: String = "if true " + lbrace() + " return; " + rbrace();
    let src: String = "module m version \"1.0\"; " + test_block("t", if_src);
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "'return' is not allowed inside a test body; test \"t\" has implicit Void return");
}

test "return-in-test: clean test with no return produces zero diags" {
    let src: String = "module m version \"1.0\"; " + test_block("t", "assert_eq(1, 1);");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "ordering: dup-function diag (register) appears before return-in-test diag (check)" {
    let tb: String = test_block("t", "return;");
    let src: String = "module m version \"1.0\"; function f() returns Void" + fn_body() + " function f() returns Void" + fn_body() + " " + tb;
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 2);
    assert_eq(diags[0].message, "function 'f' already defined");
    assert_eq(diags[1].message, "'return' is not allowed inside a test body; test \"t\" has implicit Void return");
}

// Helper: function with a body containing the given statements.
function fn_with_body(body: String) returns String {
    return "function f() returns Void " + lbrace() + " " + body + " " + rbrace();
}

test "break outside loop: bare break in function top level fires" {
    let src: String = "module m version \"1.0\"; " + fn_with_body("break;");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "break statement outside loop");
}

test "break outside loop: break inside while loop does not fire" {
    let loop_src: String = "while true " + lbrace() + " break; " + rbrace();
    let src: String = "module m version \"1.0\"; " + fn_with_body(loop_src);
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "continue outside loop: bare continue in function top level fires" {
    let src: String = "module m version \"1.0\"; " + fn_with_body("continue;");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "continue statement outside loop");
}

test "break outside loop: break inside if NOT in loop fires (if adds no depth)" {
    let if_src: String = "if true " + lbrace() + " break; " + rbrace();
    let src: String = "module m version \"1.0\"; " + fn_with_body(if_src);
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "break statement outside loop");
}

test "break outside loop: break inside if inside while does not fire" {
    let if_src: String = "if true " + lbrace() + " break; " + rbrace();
    let loop_src: String = "while true " + lbrace() + " " + if_src + " " + rbrace();
    let src: String = "module m version \"1.0\"; " + fn_with_body(loop_src);
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "ordering: in unified walk return-in-test fires before break-outside-loop in same test body" {
    let body: String = "return; break;";
    let src: String = "module m version \"1.0\"; " + test_block("t", body);
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 2);
    assert_eq(diags[0].message, "'return' is not allowed inside a test body; test \"t\" has implicit Void return");
    assert_eq(diags[1].message, "break statement outside loop");
}

// =============================================================================
// Scope stack tests (45.6)
// =============================================================================

test "scope: define then resolve finds the name" {
    let s: Scope = checker.scope_define(checker.scope_empty(), "x");
    assert_eq(checker.scope_resolve(s, "x"), true);
    assert_eq(checker.scope_resolve(s, "y"), false);
}

test "scope: resolve_local sees current-scope names only" {
    let parent: Scope = checker.scope_define(checker.scope_empty(), "x");
    let child: Scope = checker.scope_enter(parent);
    assert_eq(checker.scope_resolve(child, "x"), true);
    assert_eq(checker.scope_resolve_local(child, "x"), false);
}

test "scope: shadowing — define same name in child, resolve_local true in child" {
    let parent: Scope = checker.scope_define(checker.scope_empty(), "x");
    let mutable child: Scope = checker.scope_enter(parent);
    child = checker.scope_define(child, "x");
    assert_eq(checker.scope_resolve_local(child, "x"), true);
    assert_eq(checker.scope_resolve(child, "x"), true);
}

test "scope: build_global_scope seeds declared names and builtins" {
    let src: String = "module m version \"1.0\"; function foo() returns Void" + fn_body() + " entity Bar " + lbrace() + " field x: Int; " + rbrace();
    let prog: Program = shared_parser.parse(src);
    let s: Scope = checker.build_global_scope(prog);
    assert_eq(checker.scope_resolve(s, "foo"), true);
    assert_eq(checker.scope_resolve(s, "Bar"), true);
    assert_eq(checker.scope_resolve(s, "print"), true);
    assert_eq(checker.scope_resolve(s, "len"), true);
    assert_eq(checker.scope_resolve(s, "assert_eq"), true);
    assert_eq(checker.scope_resolve(s, "None"), true);
    assert_eq(checker.scope_resolve(s, "nope"), false);
}

// =============================================================================
// Undeclared variable and redefinition tests (45.7)
// =============================================================================

test "undeclared: bare reference to unknown name fires" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " let x: Int = nope; " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "undeclared variable 'nope'");
}

test "undeclared: let then use does NOT fire (let binds name)" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " let x: Int = 1; let y: Int = x; " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "undeclared: function param is visible in body" {
    let src: String = "module m version \"1.0\"; function f(x: Int) returns Int " + lbrace() + " return x; " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "undeclared: global function call target is NOT flagged undeclared" {
    let src: String = "module m version \"1.0\"; function g() returns Void " + fn_body() + " function f() returns Void " + lbrace() + " g(); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "undeclared: builtin call target is NOT flagged undeclared" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " print(\"hi\"); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "undeclared: for-loop variable is visible in for body" {
    let loop_src: String = "for x in items " + lbrace() + " let y: Int = x; " + rbrace();
    let src: String = "module m version \"1.0\"; function f(items: Array<Int>) returns Void " + lbrace() + " " + loop_src + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "redefinition: let same name twice in same scope fires" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " let x: Int = 1; let x: Int = 2; " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "variable 'x' already defined in this scope");
}

test "redefinition: let same name in nested if block is ok (different scope)" {
    let if_src: String = "if true " + lbrace() + " let x: Int = 2; " + rbrace();
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " let x: Int = 1; " + if_src + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "undeclared: method body can use self without firing" {
    let method_src: String = "method get_x() returns Int " + lbrace() + " return self.x; " + rbrace();
    let src: String = "module m version \"1.0\"; entity Foo " + lbrace() + " field x: Int; " + method_src + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "undeclared: name used before let in same scope fires" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " let y: Int = x; let x: Int = 1; " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "undeclared variable 'x'");
}

// =============================================================================
// Arity tests (45.8)
// =============================================================================

// Helper: enclose a body in a function named f.
function fn_f_body(body: String) returns String {
    return "function f() returns Void " + lbrace() + " " + body + " " + rbrace();
}

test "arity: function with wrong arg count fires" {
    let src: String = "module m version \"1.0\"; function g(a: Int, b: Int) returns Int " + lbrace() + " return a; " + rbrace() + " " + fn_f_body("g(1);");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "function 'g' expects 2 arguments, got 1");
}

test "arity: function with correct arg count produces no diag" {
    let src: String = "module m version \"1.0\"; function g(a: Int, b: Int) returns Int " + lbrace() + " return a; " + rbrace() + " " + fn_f_body("g(1, 2);");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "arity: zero-param function called with an arg fires" {
    let src: String = "module m version \"1.0\"; function g() returns Void " + fn_body() + " " + fn_f_body("g(1);");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "function 'g' expects 0 arguments, got 1");
}

test "arity: variant with wrong field count fires" {
    let enum_src: String = "enum Maybe " + lbrace() + " Nothing, Just(x: Int), " + rbrace();
    let src: String = "module m version \"1.0\"; " + enum_src + " " + fn_f_body("let v: Maybe = Just();");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "variant 'Just' expects 1 arguments, got 0");
}

test "arity: variant with correct field count produces no diag" {
    let enum_src: String = "enum Maybe " + lbrace() + " Nothing, Just(x: Int), " + rbrace();
    let src: String = "module m version \"1.0\"; " + enum_src + " " + fn_f_body("let v: Maybe = Just(42);");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "arity: early return — wrong-arity call with undeclared arg emits only arity diag" {
    let src: String = "module m version \"1.0\"; function g(a: Int) returns Void " + fn_body() + " " + fn_f_body("g(nope, extra);");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "function 'g' expects 1 arguments, got 2");
}

test "arity: builtin call is not checked for arity (no false positive)" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " print(\"hi\"); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "arity: variant check fires before function check (variants win on name collision)" {
    // If a variant and function share a name, variant arity fires first.
    let enum_src: String = "enum E " + lbrace() + " Wrap(x: Int), " + rbrace();
    let src: String = "module m version \"1.0\"; " + enum_src + " " + fn_f_body("let v: E = Wrap();");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "variant 'Wrap' expects 1 arguments, got 0");
}

// ---------------------------------------------------------------------------
// Phase 46.2: parse_type — structured Type tree from the AST's type strings.
// Mirrors the forms shared/parser.intent parse_type_name emits.
// ---------------------------------------------------------------------------

test "parse_type: primitive is a bare Type with no args" {
    let t: Type = checker.parse_type("Int");
    assert_eq(t.name, "Int");
    assert_eq(len(t.type_args), 0);
}

test "parse_type: an entity name is a bare Type with no args" {
    let t: Type = checker.parse_type("Widget");
    assert_eq(t.name, "Widget");
    assert_eq(len(t.type_args), 0);
}

test "parse_type: single generic Array<String>" {
    let t: Type = checker.parse_type("Array<String>");
    assert_eq(t.name, "Array");
    assert_eq(len(t.type_args), 1);
    assert_eq(t.type_args[0].name, "String");
    assert_eq(len(t.type_args[0].type_args), 0);
}

test "parse_type: two-arg generic Map<String, Int>" {
    let t: Type = checker.parse_type("Map<String, Int>");
    assert_eq(t.name, "Map");
    assert_eq(len(t.type_args), 2);
    assert_eq(t.type_args[0].name, "String");
    assert_eq(t.type_args[1].name, "Int");
}

test "parse_type: nested generic Array<Map<String, Int>>" {
    let t: Type = checker.parse_type("Array<Map<String, Int>>");
    assert_eq(t.name, "Array");
    assert_eq(len(t.type_args), 1);
    let inner: Type = t.type_args[0];
    assert_eq(inner.name, "Map");
    assert_eq(len(inner.type_args), 2);
    assert_eq(inner.type_args[0].name, "String");
    assert_eq(inner.type_args[1].name, "Int");
}

test "parse_type: function type Fn(Int, Int) -> Int" {
    let t: Type = checker.parse_type("Fn(Int, Int) -> Int");
    assert_eq(t.name, "Fn");
    // type_args = [param1, param2, return]; fn_param_count marks the split.
    assert_eq(len(t.type_args), 3);
    assert_eq(t.fn_param_count, 2);
    assert_eq(t.type_args[0].name, "Int");
    assert_eq(t.type_args[1].name, "Int");
    assert_eq(t.type_args[2].name, "Int");
}

test "parse_type: zero-param function type Fn() -> Bool" {
    let t: Type = checker.parse_type("Fn() -> Bool");
    assert_eq(t.name, "Fn");
    assert_eq(t.fn_param_count, 0);
    assert_eq(len(t.type_args), 1);
    assert_eq(t.type_args[0].name, "Bool");
}

test "parse_type: generic over an entity name Option<Widget>" {
    let t: Type = checker.parse_type("Option<Widget>");
    assert_eq(t.name, "Option");
    assert_eq(len(t.type_args), 1);
    assert_eq(t.type_args[0].name, "Widget");
}
