// selfhost/checker/check_test.intent — Phase 45 checker tests.
module checker_test version "0.1.0";

import "check.intent";
import "../shared/parser.intent";
import "../shared/ast.intent";
import "../shared/lexer.intent";

// Curly brace helpers — avoids string interpolation mis-parse of `{` / `}`.
function lbrace() returns String {
    return '{'.to_string();
}

function rbrace() returns String {
    return '}'.to_string();
}

// Helper: minimal function body " { }".
function fn_body() returns String {
    return " " + lbrace() + " " + rbrace();
}

// Helper: parse src and return check diagnostics.
function parse_and_check(src: String) returns Array<CheckDiag> {
    let prog: Program = shared_parser.parse(src);
    return checker.check_program(prog);
}

test "dup function: two functions named 'f' produces exactly one diag" {
    let src: String = "module m version \"1.0\"; function f() returns Void" + fn_body() + " function f() returns Void" + fn_body();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "function 'f' already defined");
}

test "dup function: duplicate diag message matches exactly" {
    let src: String = "module m version \"1.0\"; function foo() returns Void" + fn_body() + " function f() returns Void" + fn_body() + " function f() returns Void" + fn_body();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "function 'f' already defined");
}

test "dup entity: two entities named 'Foo' produces exactly one diag" {
    let src: String = "module m version \"1.0\"; entity Foo " + lbrace() + " field x: Int; " + rbrace() + " entity Foo " + lbrace() + " field y: Int; " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "entity 'Foo' already defined");
}

test "dup enum: two enums named 'Color' produces exactly one diag" {
    let src: String = "module m version \"1.0\"; enum Color " + lbrace() + " Red, " + rbrace() + " enum Color " + lbrace() + " Blue, " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "enum 'Color' already defined");
}

test "clean program: no dups produces zero diags" {
    let src: String = "module m version \"1.0\"; function foo() returns Void" + fn_body() + " function bar() returns Void" + fn_body();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "format_diags: one CheckDiag renders error line with no trailing newline" {
    let mutable one: Array<CheckDiag> = [];
    one.push(CheckDiag(3, 5, "m"));
    let out: String = checker.format_diags(one, "x.intent");
    assert_eq(out, "error[x.intent:3:5]: m");
}

test "format_diags: empty array returns empty string" {
    let empty: Array<CheckDiag> = [];
    let out: String = checker.format_diags(empty, "x.intent");
    assert_eq(out, "");
}

test "format_diags: two diags joined by newline with no trailing newline" {
    let mutable two: Array<CheckDiag> = [];
    two.push(CheckDiag(1, 1, "first"));
    two.push(CheckDiag(2, 3, "second"));
    let out: String = checker.format_diags(two, "f.intent");
    assert_eq(out, "error[f.intent:1:1]: first\nerror[f.intent:2:3]: second");
}

// Helper: build a test block source string: `test "NAME" { BODY }`.
function test_block(tname: String, body: String) returns String {
    return "test \"" + tname + "\" " + lbrace() + " " + body + " " + rbrace();
}

test "dup variant: enum with two identical variant names produces one diag" {
    let src: String = "module m version \"1.0\"; enum Color " + lbrace() + " Red, Red, " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "duplicate variant name 'Red' in enum 'Color'");
}

test "dup variant: enum with distinct variant names produces zero diags" {
    let src: String = "module m version \"1.0\"; enum Color " + lbrace() + " Red, Green, " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "return-in-test: bare return in test body produces one diag" {
    let src: String = "module m version \"1.0\"; " + test_block("t", "return;");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "'return' is not allowed inside a test body; test \"t\" has implicit Void return");
}

test "return-in-test: return nested inside if in test body fires" {
    let if_src: String = "if true " + lbrace() + " return; " + rbrace();
    let src: String = "module m version \"1.0\"; " + test_block("t", if_src);
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "'return' is not allowed inside a test body; test \"t\" has implicit Void return");
}

test "return-in-test: clean test with no return produces zero diags" {
    let src: String = "module m version \"1.0\"; " + test_block("t", "assert_eq(1, 1);");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "ordering: dup-function diag (register) appears before return-in-test diag (check)" {
    let tb: String = test_block("t", "return;");
    let src: String = "module m version \"1.0\"; function f() returns Void" + fn_body() + " function f() returns Void" + fn_body() + " " + tb;
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 2);
    assert_eq(diags[0].message, "function 'f' already defined");
    assert_eq(diags[1].message, "'return' is not allowed inside a test body; test \"t\" has implicit Void return");
}

// Helper: function with a body containing the given statements.
function fn_with_body(body: String) returns String {
    return "function f() returns Void " + lbrace() + " " + body + " " + rbrace();
}

test "break outside loop: bare break in function top level fires" {
    let src: String = "module m version \"1.0\"; " + fn_with_body("break;");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "break statement outside loop");
}

test "break outside loop: break inside while loop does not fire" {
    let loop_src: String = "while true " + lbrace() + " break; " + rbrace();
    let src: String = "module m version \"1.0\"; " + fn_with_body(loop_src);
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "continue outside loop: bare continue in function top level fires" {
    let src: String = "module m version \"1.0\"; " + fn_with_body("continue;");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "continue statement outside loop");
}

test "break outside loop: break inside if NOT in loop fires (if adds no depth)" {
    let if_src: String = "if true " + lbrace() + " break; " + rbrace();
    let src: String = "module m version \"1.0\"; " + fn_with_body(if_src);
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "break statement outside loop");
}

test "break outside loop: break inside if inside while does not fire" {
    let if_src: String = "if true " + lbrace() + " break; " + rbrace();
    let loop_src: String = "while true " + lbrace() + " " + if_src + " " + rbrace();
    let src: String = "module m version \"1.0\"; " + fn_with_body(loop_src);
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "ordering: in unified walk return-in-test fires before break-outside-loop in same test body" {
    let body: String = "return; break;";
    let src: String = "module m version \"1.0\"; " + test_block("t", body);
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 2);
    assert_eq(diags[0].message, "'return' is not allowed inside a test body; test \"t\" has implicit Void return");
    assert_eq(diags[1].message, "break statement outside loop");
}

// =============================================================================
// Scope stack tests (45.6)
// =============================================================================

test "scope: define then resolve finds the name" {
    let s: Scope = checker.scope_define(checker.scope_empty(), "x");
    assert_eq(checker.scope_resolve(s, "x"), true);
    assert_eq(checker.scope_resolve(s, "y"), false);
}

test "scope: resolve_local sees current-scope names only" {
    let parent: Scope = checker.scope_define(checker.scope_empty(), "x");
    let child: Scope = checker.scope_enter(parent);
    assert_eq(checker.scope_resolve(child, "x"), true);
    assert_eq(checker.scope_resolve_local(child, "x"), false);
}

test "scope: shadowing — define same name in child, resolve_local true in child" {
    let parent: Scope = checker.scope_define(checker.scope_empty(), "x");
    let mutable child: Scope = checker.scope_enter(parent);
    child = checker.scope_define(child, "x");
    assert_eq(checker.scope_resolve_local(child, "x"), true);
    assert_eq(checker.scope_resolve(child, "x"), true);
}

test "scope: build_global_scope seeds declared names and builtins" {
    let src: String = "module m version \"1.0\"; function foo() returns Void" + fn_body() + " entity Bar " + lbrace() + " field x: Int; " + rbrace();
    let prog: Program = shared_parser.parse(src);
    let s: Scope = checker.build_global_scope(prog);
    assert_eq(checker.scope_resolve(s, "foo"), true);
    assert_eq(checker.scope_resolve(s, "Bar"), true);
    assert_eq(checker.scope_resolve(s, "print"), true);
    assert_eq(checker.scope_resolve(s, "len"), true);
    assert_eq(checker.scope_resolve(s, "assert_eq"), true);
    assert_eq(checker.scope_resolve(s, "None"), true);
    assert_eq(checker.scope_resolve(s, "nope"), false);
}

// =============================================================================
// Undeclared variable and redefinition tests (45.7)
// =============================================================================

test "undeclared: bare reference to unknown name fires" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " let x: Int = nope; " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "undeclared variable 'nope'");
}

test "undeclared: let then use does NOT fire (let binds name)" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " let x: Int = 1; let y: Int = x; " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "undeclared: function param is visible in body" {
    let src: String = "module m version \"1.0\"; function f(x: Int) returns Int " + lbrace() + " return x; " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "undeclared: global function call target is NOT flagged undeclared" {
    let src: String = "module m version \"1.0\"; function g() returns Void " + fn_body() + " function f() returns Void " + lbrace() + " g(); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "undeclared: builtin call target is NOT flagged undeclared" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " print(\"hi\"); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "undeclared: for-loop variable is visible in for body" {
    let loop_src: String = "for x in items " + lbrace() + " let y: Int = x; " + rbrace();
    let src: String = "module m version \"1.0\"; function f(items: Array<Int>) returns Void " + lbrace() + " " + loop_src + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "redefinition: let same name twice in same scope fires" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " let x: Int = 1; let x: Int = 2; " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "variable 'x' already defined in this scope");
}

test "redefinition: let same name in nested if block is ok (different scope)" {
    let if_src: String = "if true " + lbrace() + " let x: Int = 2; " + rbrace();
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " let x: Int = 1; " + if_src + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "undeclared: method body can use self without firing" {
    let method_src: String = "method get_x() returns Int " + lbrace() + " return self.x; " + rbrace();
    let src: String = "module m version \"1.0\"; entity Foo " + lbrace() + " field x: Int; " + method_src + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "undeclared: name used before let in same scope fires" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " let y: Int = x; let x: Int = 1; " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "undeclared variable 'x'");
}

// =============================================================================
// Arity tests (45.8)
// =============================================================================

// Helper: enclose a body in a function named f.
function fn_f_body(body: String) returns String {
    return "function f() returns Void " + lbrace() + " " + body + " " + rbrace();
}

test "arity: function with wrong arg count fires" {
    let src: String = "module m version \"1.0\"; function g(a: Int, b: Int) returns Int " + lbrace() + " return a; " + rbrace() + " " + fn_f_body("g(1);");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "function 'g' expects 2 arguments, got 1");
}

test "arity: function with correct arg count produces no diag" {
    let src: String = "module m version \"1.0\"; function g(a: Int, b: Int) returns Int " + lbrace() + " return a; " + rbrace() + " " + fn_f_body("g(1, 2);");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "arity: zero-param function called with an arg fires" {
    let src: String = "module m version \"1.0\"; function g() returns Void " + fn_body() + " " + fn_f_body("g(1);");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "function 'g' expects 0 arguments, got 1");
}

test "arity: variant with wrong field count fires" {
    let enum_src: String = "enum Maybe " + lbrace() + " Nothing, Just(x: Int), " + rbrace();
    let src: String = "module m version \"1.0\"; " + enum_src + " " + fn_f_body("let v: Maybe = Just();");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "variant 'Just' expects 1 arguments, got 0");
}

test "arity: variant with correct field count produces no diag" {
    let enum_src: String = "enum Maybe " + lbrace() + " Nothing, Just(x: Int), " + rbrace();
    let src: String = "module m version \"1.0\"; " + enum_src + " " + fn_f_body("let v: Maybe = Just(42);");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "arity: early return — wrong-arity call with undeclared arg emits only arity diag" {
    let src: String = "module m version \"1.0\"; function g(a: Int) returns Void " + fn_body() + " " + fn_f_body("g(nope, extra);");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "function 'g' expects 1 arguments, got 2");
}

test "builtin arity: a correctly-called builtin is clean (no false positive)" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " print(\"hi\"); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

// --- Phase 47: builtin-call arity -----------------------------------------

test "builtin arity: print expects 1 argument (expects shape, singular)" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " print(1, 2); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "print() expects 1 argument, got 2");
}

test "builtin arity: assert_eq expects 2 arguments (expects shape, plural)" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " assert_eq(1); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "assert_eq() expects 2 arguments, got 1");
}

test "builtin arity: len requires exactly 1 argument (requires shape)" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + lbrace() + " return len(); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "len() requires exactly 1 argument, got 0");
}

test "builtin arity: timestamp_ms takes no arguments (takes-no shape)" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + lbrace() + " return timestamp_ms(9); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "timestamp_ms() takes no arguments, got 1");
}

test "builtin arity: a wrong-arity builtin arg is not also reported undeclared (early return)" {
    // stage1 returns after the arity error, so `nope` is not also flagged.
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " print(nope, extra); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "print() expects 1 argument, got 2");
}

test "arity: variant check fires before function check (variants win on name collision)" {
    // If a variant and function share a name, variant arity fires first.
    let enum_src: String = "enum E " + lbrace() + " Wrap(x: Int), " + rbrace();
    let src: String = "module m version \"1.0\"; " + enum_src + " " + fn_f_body("let v: E = Wrap();");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "variant 'Wrap' expects 1 arguments, got 0");
}

// --- Phase 48j-c: builtin argument typing ---------------------------------
// A builtin whose args require one simple type flags a confidently-wrong arg at
// the call. Single-arg builtins omit the number; multi-arg builtins include it.

test "builtin arg type: assert requires a Bool argument" {
    let src: String = "module m version \"1.0\"; function f(n: Int) returns Void " + lbrace() + " assert(n); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "assert() argument must be Bool, got Int");
}

test "builtin arg type: assert with a Bool argument is clean (no false positive)" {
    let src: String = "module m version \"1.0\"; function f(n: Int) returns Void " + lbrace() + " assert(n > 0); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "builtin arg type: a single-arg String builtin omits the argument number" {
    let src: String = "module m version \"1.0\"; function f(n: Int) returns Void " + lbrace() + " let r: Result<String, String> = read_file(n); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "read_file() argument must be String, got Int");
}

test "builtin arg type: a multi-arg builtin numbers the offending argument" {
    let src: String = "module m version \"1.0\"; function f(n: Int) returns Void " + lbrace() + " let r: Result<String, String> = http_get(\"u\", n); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "http_get() argument 2 must be String, got Int");
}

test "builtin arg type: an Unknown arg (call result) is skipped soundly" {
    let h: String = "function h() returns Int " + lbrace() + " return 1; " + rbrace();
    let src: String = "module m version \"1.0\"; " + h + " function f() returns Void " + lbrace() + " assert(h()); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "builtin arg type: print rejects a non-printable type (Char)" {
    let src: String = "module m version \"1.0\"; function f(c: Char) returns Void " + lbrace() + " print(c); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "print() cannot print type Char (accepts Int, Float, Bool, String)");
}

test "builtin arg type: print accepts a String (no false positive)" {
    let src: String = "module m version \"1.0\"; function f(s: String) returns Void " + lbrace() + " print(s); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "builtin arg type: assert_close flags a non-Float arg with its label" {
    let src: String = "module m version \"1.0\"; function f(n: Int) returns Void " + lbrace() + " assert_close(1.0, n, 0.01); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "assert_close() argument 2 (expected) must be Float, got Int");
}

test "builtin arg type: assert_close with all Floats is clean (no false positive)" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " assert_close(1.0, 2.0, 0.01); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "builtin arg type: len rejects a non-String simple type (Int)" {
    let src: String = "module m version \"1.0\"; function f(n: Int) returns Void " + lbrace() + " let x: Int = len(n); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "len() requires Array, Map, or String argument, got Int");
}

test "builtin arg type: len accepts a String (no false positive)" {
    let src: String = "module m version \"1.0\"; function f(s: String) returns Void " + lbrace() + " let x: Int = len(s); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "builtin arg type: len accepts a generic Array (no false positive)" {
    let src: String = "module m version \"1.0\"; function f(a: Array<Int>) returns Void " + lbrace() + " let x: Int = len(a); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "builtin arg type: assert_panics rejects a non-function argument (Int)" {
    let src: String = "module m version \"1.0\"; function f(n: Int) returns Void " + lbrace() + " assert_panics(n); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "assert_panics() argument must be Fn() -> Void, got Int");
}

test "builtin arg type: assert_panics accepts a Fn() -> Void param (no false positive)" {
    let src: String = "module m version \"1.0\"; function f(cb: Fn() -> Void) returns Void " + lbrace() + " assert_panics(cb); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

// ---------------------------------------------------------------------------
// Phase 46.2: parse_type — structured Type tree from the AST's type strings.
// Mirrors the forms shared/parser.intent parse_type_name emits.
// ---------------------------------------------------------------------------

test "parse_type: primitive is a bare Type with no args" {
    let t: Type = checker.parse_type("Int");
    assert_eq(t.name, "Int");
    assert_eq(len(t.type_args), 0);
}

test "parse_type: an entity name is a bare Type with no args" {
    let t: Type = checker.parse_type("Widget");
    assert_eq(t.name, "Widget");
    assert_eq(len(t.type_args), 0);
}

test "parse_type: single generic Array<String>" {
    let t: Type = checker.parse_type("Array<String>");
    assert_eq(t.name, "Array");
    assert_eq(len(t.type_args), 1);
    assert_eq(t.type_args[0].name, "String");
    assert_eq(len(t.type_args[0].type_args), 0);
}

test "parse_type: two-arg generic Map<String, Int>" {
    let t: Type = checker.parse_type("Map<String, Int>");
    assert_eq(t.name, "Map");
    assert_eq(len(t.type_args), 2);
    assert_eq(t.type_args[0].name, "String");
    assert_eq(t.type_args[1].name, "Int");
}

test "parse_type: nested generic Array<Map<String, Int>>" {
    let t: Type = checker.parse_type("Array<Map<String, Int>>");
    assert_eq(t.name, "Array");
    assert_eq(len(t.type_args), 1);
    let inner: Type = t.type_args[0];
    assert_eq(inner.name, "Map");
    assert_eq(len(inner.type_args), 2);
    assert_eq(inner.type_args[0].name, "String");
    assert_eq(inner.type_args[1].name, "Int");
}

test "parse_type: function type Fn(Int, Int) -> Int" {
    let t: Type = checker.parse_type("Fn(Int, Int) -> Int");
    assert_eq(t.name, "Fn");
    // type_args = [param1, param2, return]; fn_param_count marks the split.
    assert_eq(len(t.type_args), 3);
    assert_eq(t.fn_param_count, 2);
    assert_eq(t.type_args[0].name, "Int");
    assert_eq(t.type_args[1].name, "Int");
    assert_eq(t.type_args[2].name, "Int");
}

test "parse_type: zero-param function type Fn() -> Bool" {
    let t: Type = checker.parse_type("Fn() -> Bool");
    assert_eq(t.name, "Fn");
    assert_eq(t.fn_param_count, 0);
    assert_eq(len(t.type_args), 1);
    assert_eq(t.type_args[0].name, "Bool");
}

test "parse_type: generic over an entity name Option<Widget>" {
    let t: Type = checker.parse_type("Option<Widget>");
    assert_eq(t.name, "Option");
    assert_eq(len(t.type_args), 1);
    assert_eq(t.type_args[0].name, "Widget");
}

// ---------------------------------------------------------------------------
// Phase 46.3: type_is_known — resolver mirroring stage1 ResolveType (nil ==
// unknown). Booleans below track exactly what checker.go's `unknown type` sites
// would fire on. no_names() returns an empty name list; passing it inline also
// exercises the rust backend's borrow of a call-result argument to an
// Array<T> (&Vec) param (fixed with BE-1).
// ---------------------------------------------------------------------------

// no_names — an empty entity/enum/type-param name list.
function no_names() returns Array<String> {
    let mutable a: Array<String> = [];
    return a;
}

test "type_is_known: primitive is always known" {
    let known: Bool = checker.type_is_known(checker.parse_type("Int"), no_names(), no_names(), no_names());
    assert_eq(known, true);
}

test "type_is_known: unknown bare name with no decls is not known" {
    let known: Bool = checker.type_is_known(checker.parse_type("Widget"), no_names(), no_names(), no_names());
    assert_eq(known, false);
}

test "type_is_known: an entity name in scope is known" {
    let ents: Array<String> = ["Widget"];
    let known: Bool = checker.type_is_known(checker.parse_type("Widget"), ents, no_names(), no_names());
    assert_eq(known, true);
}

test "type_is_known: an enum name in scope is known" {
    let enums: Array<String> = ["Color"];
    let known: Bool = checker.type_is_known(checker.parse_type("Color"), no_names(), enums, no_names());
    assert_eq(known, true);
}

test "type_is_known: a type parameter in scope is known" {
    let tps: Array<String> = ["T"];
    let known: Bool = checker.type_is_known(checker.parse_type("T"), no_names(), no_names(), tps);
    assert_eq(known, true);
    // ...and not known when the parameter is absent.
    let unknown: Bool = checker.type_is_known(checker.parse_type("T"), no_names(), no_names(), no_names());
    assert_eq(unknown, false);
}

test "type_is_known: Array<String> is known, Array<Widget> is not (nested unknown)" {
    let ok: Bool = checker.type_is_known(checker.parse_type("Array<String>"), no_names(), no_names(), no_names());
    assert_eq(ok, true);
    let nested_unknown: Bool = checker.type_is_known(checker.parse_type("Array<Widget>"), no_names(), no_names(), no_names());
    assert_eq(nested_unknown, false);
    // Declaring Widget makes the nested type resolve.
    let ents: Array<String> = ["Widget"];
    let now_ok: Bool = checker.type_is_known(checker.parse_type("Array<Widget>"), ents, no_names(), no_names());
    assert_eq(now_ok, true);
}

test "type_is_known: wrong builtin-generic arity is not known" {
    let arr2: Bool = checker.type_is_known(checker.parse_type("Array<Int, Int>"), no_names(), no_names(), no_names());
    assert_eq(arr2, false);
    let map1: Bool = checker.type_is_known(checker.parse_type("Map<Int>"), no_names(), no_names(), no_names());
    assert_eq(map1, false);
}

test "type_is_known: Map with a valid key is known, unhashable key is not" {
    let ok: Bool = checker.type_is_known(checker.parse_type("Map<String, Int>"), no_names(), no_names(), no_names());
    assert_eq(ok, true);
    let bad_key: Bool = checker.type_is_known(checker.parse_type("Map<Float, Int>"), no_names(), no_names(), no_names());
    assert_eq(bad_key, false);
}

test "type_is_known: Result<Int, String> known; Result arity enforced" {
    let ok: Bool = checker.type_is_known(checker.parse_type("Result<Int, String>"), no_names(), no_names(), no_names());
    assert_eq(ok, true);
    let one_arg: Bool = checker.type_is_known(checker.parse_type("Result<Int>"), no_names(), no_names(), no_names());
    assert_eq(one_arg, false);
}

test "type_is_known: Fn is known when every part resolves, else not" {
    let ok: Bool = checker.type_is_known(checker.parse_type("Fn(Int, Int) -> Int"), no_names(), no_names(), no_names());
    assert_eq(ok, true);
    let bad_param: Bool = checker.type_is_known(checker.parse_type("Fn(Widget) -> Int"), no_names(), no_names(), no_names());
    assert_eq(bad_param, false);
    let bad_ret: Bool = checker.type_is_known(checker.parse_type("Fn(Int) -> Widget"), no_names(), no_names(), no_names());
    assert_eq(bad_ret, false);
}

// ---------------------------------------------------------------------------
// Phase 46.4: `unknown type 'X'` wired into check_program over function/method
// param + return annotations (integrated, register-phase, stage1 order).
// ---------------------------------------------------------------------------

test "unknown type: function parameter with an undeclared type" {
    let src: String = "module m version \"1.0\"; function f(w: Widget) returns Void" + fn_body();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "unknown type 'Widget'");
}

test "unknown type: function return with an undeclared type" {
    let src: String = "module m version \"1.0\"; function make() returns Widget" + fn_body();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "unknown type 'Widget'");
}

test "unknown type: nested unknown reports the outer base name" {
    let src: String = "module m version \"1.0\"; function f(xs: Array<Widget>) returns Void" + fn_body();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "unknown type 'Array'");
}

test "unknown type: primitive + declared-entity params are clean (no false positive)" {
    let ent: String = "entity Widget " + lbrace() + " field x: Int; " + rbrace();
    let src: String = "module m version \"1.0\"; " + ent + " function f(a: Int, w: Widget) returns Array<String>" + fn_body();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "unknown type: a generic function's own type parameter resolves (threaded)" {
    let src: String = "module m version \"1.0\"; function id<T>(x: T) returns T " + lbrace() + " return x; " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

// --- Phase 46.4b: entity field + method signature types -------------------

test "unknown type: entity field with an undeclared type" {
    let src: String = "module m version \"1.0\"; entity E " + lbrace() + " field w: Widget; " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "unknown type 'Widget'");
}

test "unknown type: entity method parameter with an undeclared type" {
    let src: String = "module m version \"1.0\"; entity E " + lbrace() + " field x: Int; method use(w: Widget) returns Void " + fn_body() + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "unknown type 'Widget'");
}

test "unknown type: a generic entity's own type parameter resolves in a field (threaded)" {
    let src: String = "module m version \"1.0\"; entity Box<T> " + lbrace() + " field val: T; " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "unknown type: an entity field typed by another declared entity is clean" {
    let src: String = "module m version \"1.0\"; entity Inner " + lbrace() + " field x: Int; " + rbrace() + " entity Outer " + lbrace() + " field inner: Inner; " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

// --- Phase 46.4b: `let` statement types -----------------------------------

test "unknown type: let statement with an undeclared type" {
    let body: String = "let x: Widget = 0;";
    let src: String = "module m version \"1.0\"; " + fn_f_body(body);
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "unknown type 'Widget'");
}

test "unknown type: an unknown let type suppresses the RHS check (stage1 early return)" {
    // stage1 checkLetStmt returns right after the unknown-type diag, so the
    // undeclared RHS `nope` is NOT reported — exactly one diagnostic.
    let body: String = "let x: Widget = nope;";
    let src: String = "module m version \"1.0\"; " + fn_f_body(body);
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "unknown type 'Widget'");
}

test "unknown type: a let with a known type is clean (no false positive)" {
    let body: String = "let x: Int = 5;";
    let src: String = "module m version \"1.0\"; " + fn_f_body(body);
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

// --- Phase 46.4b: enum variant field types --------------------------------

test "unknown type: enum variant field with an undeclared type" {
    let src: String = "module m version \"1.0\"; enum E " + lbrace() + " V(x: Widget), " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "unknown type 'Widget'");
}

test "unknown type: enum variant field with a primitive is clean (no false positive)" {
    let src: String = "module m version \"1.0\"; enum E " + lbrace() + " V(x: Int), " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "unknown type: an entity-typed variant field STILL errors (registerEnums quirk)" {
    // stage1 registerEnums runs before entities are registered, so a variant
    // field typed by a declared entity does not resolve — matched byte-for-byte.
    let ent: String = "entity W " + lbrace() + " field a: Int; " + rbrace();
    let src: String = "module m version \"1.0\"; " + ent + " enum E " + lbrace() + " V(x: W), " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "unknown type 'W'");
}

// --- Phase 48: expression inference + condition-must-be-boolean -----------

test "condition boolean: an Int-literal if condition errors" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " if 5 " + fn_body() + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "if condition must be boolean, got Int");
}

test "condition boolean: a String-literal while condition errors" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " while \"x\" " + fn_body() + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "while condition must be boolean, got String");
}

test "condition boolean: an arithmetic if condition infers Int and errors" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " if 1 + 2 " + fn_body() + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "if condition must be boolean, got Int");
}

test "condition boolean: a comparison condition is Bool (no false positive)" {
    let src: String = "module m version \"1.0\"; function f(x: Int) returns Void " + lbrace() + " if x < 3 " + fn_body() + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "condition boolean: a bool literal condition is clean" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " if true " + fn_body() + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "condition boolean: a Bool param condition is clean (48d typed scope)" {
    // With the typed scope, `b` resolves to Bool → no error (no false positive).
    let src: String = "module m version \"1.0\"; function f(b: Bool) returns Void " + lbrace() + " if b " + fn_body() + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "condition boolean: an Int param condition errors (48d typed scope)" {
    let src: String = "module m version \"1.0\"; function f(n: Int) returns Void " + lbrace() + " if n " + fn_body() + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "if condition must be boolean, got Int");
}

// --- Phase 48c: let type mismatch -----------------------------------------

test "let mismatch: String RHS assigned to Int declared type" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " let a: Int = \"hi\"; " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "type mismatch: cannot assign String to Int");
}

test "let mismatch: Int RHS assigned to Bool (no implicit conversion)" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " let b: Bool = 5; " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "type mismatch: cannot assign Int to Bool");
}

test "let mismatch: matching literal type is clean" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " let n: Int = 1 + 2; " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "let mismatch: a typed param RHS is now caught (48d typed scope)" {
    // With the typed scope, `x` resolves to Int, so assigning it to a Bool `let`
    // is a mismatch (byte-equal with stage1).
    let src: String = "module m version \"1.0\"; function f(x: Int) returns Void " + lbrace() + " let y: Bool = x; " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "type mismatch: cannot assign Int to Bool");
}

test "let mismatch: a call-result RHS is still Unknown → skipped (documented gap)" {
    // Call-return inference is not implemented yet, so an unresolvable RHS is
    // skipped (sound: no false positive). stage1 would infer g()'s Int here;
    // this is a tracked incompleteness, not a divergence on any fixture/corpus.
    let g: String = "function g() returns Int " + lbrace() + " return 1; " + rbrace();
    let src: String = "module m version \"1.0\"; " + g + " function f() returns Void " + lbrace() + " let y: Bool = g(); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

// --- Phase 48/51: function argument-type mismatch -------------------------

test "arg type: a String literal passed where Int expected" {
    let g: String = "function g(x: Int) returns Void " + fn_body();
    let src: String = "module m version \"1.0\"; " + g + " function f() returns Void " + lbrace() + " g(\"hi\"); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "argument 1 to 'g': expected Int, got String");
}

test "arg type: a Bool param passed where Int expected (2nd arg position)" {
    let g: String = "function g(a: Int, b: Int) returns Void " + fn_body();
    let src: String = "module m version \"1.0\"; " + g + " function f(flag: Bool) returns Void " + lbrace() + " g(1, flag); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "argument 2 to 'g': expected Int, got Bool");
}

test "arg type: matching argument types are clean (no false positive)" {
    let g: String = "function g(x: Int) returns Void " + fn_body();
    let src: String = "module m version \"1.0\"; " + g + " function f(n: Int) returns Void " + lbrace() + " g(n); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "arg type: a generic function's args are not checked (sound skip)" {
    // id<T>(x: T) — the param type is a type parameter; stage1 substitutes, we
    // skip generics entirely to stay sound (no false positive).
    let id: String = "function id<T>(x: T) returns T " + lbrace() + " return x; " + rbrace();
    let src: String = "module m version \"1.0\"; " + id + " function f() returns Void " + lbrace() + " let r: Int = id(5); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

// --- Phase 48d+: let-bound variables resolve downstream -------------------

test "let-bound var: an Int let used as a condition errors downstream" {
    let body: String = "let n: Int = 5; if n " + fn_body();
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " " + body + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "if condition must be boolean, got Int");
}

test "let-bound var: a String let passed where Int expected errors downstream" {
    let g: String = "function g(x: Int) returns Void " + fn_body();
    let body: String = "let s: String = \"hi\"; g(s);";
    let src: String = "module m version \"1.0\"; " + g + " function f() returns Void " + lbrace() + " " + body + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "argument 1 to 'g': expected Int, got String");
}

test "let-bound var: correct downstream use is clean (no false positive)" {
    let g: String = "function g(x: Int) returns Void " + fn_body();
    let body: String = "let n: Int = 5; g(n);";
    let src: String = "module m version \"1.0\"; " + g + " function f() returns Void " + lbrace() + " " + body + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

// --- Phase 48g: variant-constructor argument-type mismatch ----------------

test "variant arg type: Int passed where a String field is expected" {
    let en: String = "enum Shape " + lbrace() + " Named(label: String), " + rbrace();
    let body: String = "return Named(42);";
    let src: String = "module m version \"1.0\"; " + en + " function f() returns Shape " + lbrace() + " " + body + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "variant 'Named' field 'label' expects String, got Int");
}

test "variant arg type: matching field type is clean (no false positive)" {
    let en: String = "enum Shape " + lbrace() + " Named(label: String), " + rbrace();
    let body: String = "return Named(\"hi\");";
    let src: String = "module m version \"1.0\"; " + en + " function f() returns Shape " + lbrace() + " " + body + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

// --- Phase 48h: assignment type-mismatch ----------------------------------

test "assign mismatch: assigning String to an Int variable" {
    let body: String = "let mutable n: Int = 0; n = \"hi\";";
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " " + body + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "type mismatch: cannot assign String to Int");
}

test "assign mismatch: assigning a matching type is clean (no false positive)" {
    let body: String = "let mutable n: Int = 0; n = 5;";
    let src: String = "module m version \"1.0\"; function f() returns Void " + lbrace() + " " + body + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

// --- Phase 48i: field-access type inference -------------------------------

test "field access: a param entity's Int field assigned to a Bool let errors" {
    let ent: String = "entity Point " + lbrace() + " field x: Int; constructor(x: Int) " + lbrace() + " self.x = x; " + rbrace() + " " + rbrace();
    let body: String = "let b: Bool = p.x;";
    let src: String = "module m version \"1.0\"; " + ent + " function f(p: Point) returns Void " + lbrace() + " " + body + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "type mismatch: cannot assign Int to Bool");
}

test "field access: a Bool field used as a condition is clean (no false positive)" {
    let ent: String = "entity Point " + lbrace() + " field active: Bool; constructor(active: Bool) " + lbrace() + " self.active = active; " + rbrace() + " " + rbrace();
    let body: String = "if p.active " + fn_body();
    let src: String = "module m version \"1.0\"; " + ent + " function f(p: Point) returns Void " + lbrace() + " " + body + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

// --- Phase 48i.2: method-call arity + argument types ----------------------

// Helper: the Counter entity used by the method-call tests below — a
// non-generic entity with a one-Int-param `bump` method.
function counter_entity() returns String {
    return "entity Counter " + lbrace() + " field n: Int; constructor(n: Int) " + lbrace() + " self.n = n; " + rbrace() + " method bump(amount: Int) returns Void " + lbrace() + " self.n = self.n + amount; " + rbrace() + " " + rbrace();
}

test "method arity: too few arguments fires" {
    let src: String = "module m version \"1.0\"; " + counter_entity() + " " + fn_f_body("let c: Counter = Counter(0); c.bump();");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "method 'bump' expects 1 arguments, got 0");
}

test "method arity: correct arg count is clean (no false positive)" {
    let src: String = "module m version \"1.0\"; " + counter_entity() + " " + fn_f_body("let c: Counter = Counter(0); c.bump(5);");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "method arg type: String passed where an Int param is expected" {
    let src: String = "module m version \"1.0\"; " + counter_entity() + " " + fn_f_body("let c: Counter = Counter(0); c.bump(\"hi\");");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "argument 1 to method 'bump': expected Int, got String");
}

test "method arg type: matching arg type is clean (no false positive)" {
    let src: String = "module m version \"1.0\"; " + counter_entity() + " " + fn_f_body("let c: Counter = Counter(0); c.bump(7);");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "method arity: early return — wrong-arity call with undeclared arg emits only arity diag" {
    let src: String = "module m version \"1.0\"; " + counter_entity() + " " + fn_f_body("let c: Counter = Counter(0); c.bump(nope, extra);");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "method 'bump' expects 1 arguments, got 2");
}

test "method arg type: a generic entity's type-param arg is skipped (no false positive)" {
    let ent: String = "entity Box<T> " + lbrace() + " field value: T; constructor(value: T) " + lbrace() + " self.value = value; " + rbrace() + " method replace(x: T) returns Void " + lbrace() + " self.value = x; " + rbrace() + " " + rbrace();
    let src: String = "module m version \"1.0\"; " + ent + " function f(b: Box<Int>) returns Void " + lbrace() + " b.replace(\"hi\"); " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "method arity: a trait-impl method resolves via the impl (arity fires)" {
    let ent: String = "entity Ctx " + lbrace() + " field v: Int; constructor(v: Int) " + lbrace() + " self.v = v; " + rbrace() + " " + rbrace();
    let tr: String = "trait Runnable " + lbrace() + " method run(x: Int) returns Int; " + rbrace();
    let im: String = "impl Runnable for Ctx " + lbrace() + " method run(x: Int) returns Int " + lbrace() + " return self.v + x; " + rbrace() + " " + rbrace();
    let src: String = "module m version \"1.0\"; " + ent + " " + tr + " " + im + " " + fn_f_body("let c: Ctx = Ctx(1); c.run();");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "method 'run' expects 1 arguments, got 0");
}

// --- Phase 48e: binary operator typing ------------------------------------
// stage1 renders the operator via `%s` on BinaryExpr.Op (a TokenType), so the
// message shows the token NAME (MINUS/STAR/EQ/LT/AND/...) — EXCEPT `+`, which is
// a literal in the format string. Reproduced verbatim for byte-equality.

// Helper: wrap a body in `f(a: Int, b: <bt>)` so operands are typed params.
function fn_ab_body(bt: String, body: String) returns String {
    return "function f(a: Int, b: " + bt + ") returns Void " + lbrace() + " " + body + " " + rbrace();
}

test "operator typing: arithmetic '-' shows the token name MINUS" {
    let src: String = "module m version \"1.0\"; " + fn_ab_body("String", "let c: Int = a - b;");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "operator 'MINUS' not defined for Int and String");
}

test "operator typing: '+' is a literal in the message (not PLUS)" {
    let src: String = "module m version \"1.0\"; " + fn_ab_body("String", "let c: Int = a + b;");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "operator '+' not defined for Int and String");
}

test "operator typing: logical 'and' uses the boolean-operands shape" {
    let src: String = "module m version \"1.0\"; " + fn_ab_body("Bool", "let c: Bool = a and b;");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "operator 'AND' requires boolean operands, got Int and Bool");
}

test "operator typing: comparison '<' shows LT" {
    let src: String = "module m version \"1.0\"; " + fn_ab_body("String", "let c: Bool = a < b;");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "operator 'LT' not defined for Int and String");
}

test "operator typing: equality on mismatched types shows EQ" {
    let src: String = "module m version \"1.0\"; " + fn_ab_body("Bool", "let c: Bool = a == b;");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "operator 'EQ' not defined for Int and Bool");
}

test "operator typing: a valid Int + Int is clean (no false positive)" {
    let src: String = "module m version \"1.0\"; " + fn_ab_body("Int", "let c: Int = a + b;");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "operator typing: an Unknown operand (call result) is skipped soundly" {
    let h: String = "function h() returns Int " + lbrace() + " return 1; " + rbrace();
    let src: String = "module m version \"1.0\"; " + h + " function f() returns Void " + lbrace() + " let c: Int = h() + 1; " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

// --- Phase 48j-b: contract well-typedness ---------------------------------
// Each requires/ensures/invariant clause must be boolean. Emit on a confident
// non-Bool clause; a clause using old()/result/quantifiers/calls infers Unknown
// and is skipped (stage1 guards on exprType != nil).

// Helper: the Widget entity used by the invariant/method-contract tests.
function widget_entity(invariant_src: String, method_src: String) returns String {
    return "entity Widget " + lbrace() + " field size: Int; " + invariant_src + " constructor(size: Int) " + lbrace() + " self.size = size; " + rbrace() + " " + method_src + " " + rbrace();
}

test "contract: a function requires clause must be boolean" {
    let src: String = "module m version \"1.0\"; function f(n: Int) returns Void requires n " + lbrace() + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "requires clause must be boolean, got Int");
}

test "contract: a function ensures clause must be boolean" {
    let src: String = "module m version \"1.0\"; function f(n: Int) returns Void ensures n " + lbrace() + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "ensures clause must be boolean, got Int");
}

test "contract: a valid boolean requires clause is clean (no false positive)" {
    let src: String = "module m version \"1.0\"; function f(n: Int) returns Void requires n > 0 " + lbrace() + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "contract: an entity invariant must be boolean" {
    let src: String = "module m version \"1.0\"; " + widget_entity("invariant self.size;", "");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "invariant must be boolean, got Int");
}

test "contract: a method requires clause must be boolean" {
    let meth: String = "method grow(by: Int) returns Void requires by " + lbrace() + " self.size = self.size + by; " + rbrace();
    let src: String = "module m version \"1.0\"; " + widget_entity("", meth);
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "requires clause must be boolean, got Int");
}

test "contract: an Unknown clause (call result) is skipped soundly" {
    let h: String = "function h() returns Int " + lbrace() + " return 1; " + rbrace();
    let src: String = "module m version \"1.0\"; " + h + " function f(n: Int) returns Void requires h() > 0 " + lbrace() + " " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "contract: a generic entity's invariant is not checked (stage1 skips generics)" {
    let ent: String = "entity Box<T> " + lbrace() + " field size: Int; invariant self.size; constructor(size: Int) " + lbrace() + " self.size = size; " + rbrace() + " " + rbrace();
    let src: String = "module m version \"1.0\"; " + ent;
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

// --- Phase 48j-a: match-arm structural checks -----------------------------
// For a scrutinee confidently typed as a known USER enum: variant-exists,
// duplicate, binding-count, unreachable-after-wildcard, exhaustiveness. Arm-type
// consistency + scrutinee-not-enum are deferred; Option/Result and other
// scrutinees take the fallback (arm-body name checking only).

function status_enum() returns String {
    return "enum Status " + lbrace() + " Pending, Running, Complete, " + rbrace();
}

// Helper: a Status-scrutinee function wrapping a match with the given arms.
function fn_match_status(arms: String) returns String {
    return "function f(s: Status) returns Void " + lbrace() + " let n: Int = match s " + lbrace() + " " + arms + " " + rbrace() + "; " + rbrace();
}

test "match: a non-exhaustive match on a user enum fires" {
    let src: String = "module m version \"1.0\"; " + status_enum() + " " + fn_match_status("Pending => 0,");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "non-exhaustive match on enum 'Status': missing variants: Running, Complete");
}

test "match: an exhaustive match is clean (no false positive)" {
    let src: String = "module m version \"1.0\"; " + status_enum() + " " + fn_match_status("Pending => 0, Running => 1, Complete => 2,");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "match: a wildcard arm makes the match exhaustive (no false positive)" {
    let src: String = "module m version \"1.0\"; " + status_enum() + " " + fn_match_status("Pending => 0, _ => 1,");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "match: a duplicate arm fires" {
    let src: String = "module m version \"1.0\"; " + status_enum() + " " + fn_match_status("Pending => 0, Pending => 1, Running => 2, Complete => 3,");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "duplicate match arm for variant 'Pending'");
}

test "match: an unknown variant fires" {
    let src: String = "module m version \"1.0\"; " + status_enum() + " " + fn_match_status("Pending => 0, Running => 1, Complete => 2, Bogus => 3,");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "variant 'Bogus' is not a variant of enum 'Status'");
}

test "match: a binding-count mismatch fires" {
    let en: String = "enum Shape " + lbrace() + " Circle(r: Int), Point, " + rbrace();
    let fn_src: String = "function f(sh: Shape) returns Void " + lbrace() + " let n: Int = match sh " + lbrace() + " Circle => 0, Point => 1, " + rbrace() + "; " + rbrace();
    let src: String = "module m version \"1.0\"; " + en + " " + fn_src;
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "variant 'Circle' has 1 fields but pattern has 0 bindings");
}

test "match: correct data-variant bindings are clean (no false positive)" {
    let en: String = "enum Shape " + lbrace() + " Circle(r: Int), Point, " + rbrace();
    let fn_src: String = "function f(sh: Shape) returns Void " + lbrace() + " let n: Int = match sh " + lbrace() + " Circle(r) => r, Point => 1, " + rbrace() + "; " + rbrace();
    let src: String = "module m version \"1.0\"; " + en + " " + fn_src;
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}

test "match: an arm after a wildcard is unreachable" {
    let src: String = "module m version \"1.0\"; " + status_enum() + " " + fn_match_status("_ => 0, Pending => 1,");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "unreachable pattern after wildcard '_'");
}

test "match: a primitive scrutinee must be an enum type" {
    let src: String = "module m version \"1.0\"; function f(n: Int) returns Void " + lbrace() + " let x: Int = match n " + lbrace() + " _ => 0, " + rbrace() + "; " + rbrace();
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "match scrutinee must be an enum type, got Int");
}

test "match: arms of different types are flagged (arm-type consistency)" {
    let src: String = "module m version \"1.0\"; " + status_enum() + " " + fn_match_status("Pending => 0, Running => \"hi\", Complete => 2,");
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "match arm type mismatch: expected Int, got String");
}

test "match: a typed pattern binding participates in arm-type inference" {
    let en: String = "enum E " + lbrace() + " A(x: Int), B(y: String), " + rbrace();
    let fn_src: String = "function f(e: E) returns Void " + lbrace() + " let n: Int = match e " + lbrace() + " A(x) => x, B(y) => y, " + rbrace() + "; " + rbrace();
    let src: String = "module m version \"1.0\"; " + en + " " + fn_src;
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 1);
    assert_eq(diags[0].message, "match arm type mismatch: expected Int, got String");
}

test "match: consistent typed-binding arms are clean (no false positive)" {
    let en: String = "enum E " + lbrace() + " A(x: Int), B(y: Int), " + rbrace();
    let fn_src: String = "function f(e: E) returns Void " + lbrace() + " let n: Int = match e " + lbrace() + " A(x) => x, B(y) => y, " + rbrace() + "; " + rbrace();
    let src: String = "module m version \"1.0\"; " + en + " " + fn_src;
    let diags: Array<CheckDiag> = parse_and_check(src);
    assert_eq(len(diags), 0);
}
