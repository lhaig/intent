// selfhost/checker/check.intent — Phase 45 / self-hosted checker scaffold.
//
// Semantic error model + two-phase check dispatch mirroring stage1
// internal/checker/checker.go Check() (lines 113-122):
//
//   Register phase  — registerEnums (+ variant dups) → registerEntities
//                     → registerTraits → registerFunctions
//   Check phase     — checkFunctions → checkEntities → checkImplBlockBodies
//                     → checkTests
//
// format_diags produces `error[file:line:col]: message` lines joined by "\n"
// with NO trailing newline — matching diagnostic.Format in stage1 exactly.
// (Contrast: the linter's format_diags appends "\n" after every line; the
// checker must not.)
module checker version "0.1.0";

import "../shared/parser.intent";
import "../shared/ast.intent";
import "../shared/lexer.intent";

// =============================================================================
// SCOPE STACK
//
// Flattened lexical scope — no recursive parent field (the Rust backend cannot
// represent infinitely-sized structs). Design follows stage1 scope.go semantics
// (Scope.Resolve walks current→parent) mapped onto two parallel String arrays:
//
//   local_names  — names defined in the CURRENT scope level.
//   outer_names  — ALL names visible from enclosing scopes (flattened).
//
// scope_enter(s) opens a child scope: outer = outer + local, local = [].
// scope_define(s, n) appends n to local_names, returning a new Scope.
// scope_resolve(s, n)  — true if n is in local or outer (mirrors Resolve).
// scope_resolve_local(s, n) — true if n is in local only (mirrors ResolveLocal).
// =============================================================================

// Phase 48d: the Scope carries a parallel type array for each name tier
// (local_types[i] ↔ local_names[i]) so expression inference can look up a
// variable's Type. Name behaviour is unchanged — scope_define still records a
// name; it just also records an Unknown type. scope_define_typed records a
// KNOWN type (used for params). Names default to Unknown so name-resolution
// (undeclared/redefinition) stays byte-identical to before.
public entity Scope {
    field local_names: Array<String>;
    field outer_names: Array<String>;
    field local_types: Array<Type>;
    field outer_types: Array<Type>;
    // Phase 48j-c2d: async context. True inside an async function/test body (and
    // every child scope it opens), mirroring stage1's c.inAsyncFunc, which the
    // await_*/timeout builtins and the `await` expression consult. Riding it on
    // the already-threaded Scope avoids adding a parameter to every checker
    // helper; scope_enter/scope_define_typed preserve it, scope_set_async flips
    // it once per function/test entry.
    field in_async: Bool;

    constructor(local_names: Array<String>, outer_names: Array<String>, local_types: Array<Type>, outer_types: Array<Type>, in_async: Bool) {
        self.local_names = local_names;
        self.outer_names = outer_names;
        self.local_types = local_types;
        self.outer_types = outer_types;
        self.in_async = in_async;
    }
}

// scope_empty — a fresh, empty scope with no names in any tier.

public function scope_empty() returns Scope {
    return Scope(shared_ast.empty_string_array(), shared_ast.empty_string_array(), empty_type_array(), empty_type_array(), false);
}

// scope_define — returns a new Scope with `name` added to local_names, typed
// Unknown (its value-type is not tracked). Caller checks scope_resolve_local
// first if redefinition detection is needed (45.7).

public function scope_define(s: Scope, name: String) returns Scope {
    return scope_define_typed(s, name, type_unknown());
}

// scope_define_typed — like scope_define but records a known Type for `name`
// (Phase 48d; used to seed function/method parameters from their annotations).

public function scope_define_typed(s: Scope, name: String, ty: Type) returns Scope {
    let mutable new_local: Array<String> = [];
    let mutable i: Int = 0;
    while i < len(s.local_names) {
        new_local.push(s.local_names[i]);
        i = i + 1;
    }
    new_local.push(name);
    let mutable new_local_t: Array<Type> = [];
    let mutable ti: Int = 0;
    while ti < len(s.local_types) {
        new_local_t.push(s.local_types[ti]);
        ti = ti + 1;
    }
    new_local_t.push(ty);
    return Scope(new_local, s.outer_names, new_local_t, s.outer_types, s.in_async);
}

// scope_set_async — a copy of `s` with its async-context flag set to `flag`.
// Called once per function/test entry to seed the body scope from the
// declaration's is_async (methods/constructors keep the inherited false, since
// stage1 does not set c.inAsyncFunc during entity/impl checking). Phase 48j-c2d.

public function scope_set_async(s: Scope, flag: Bool) returns Scope {
    return Scope(s.local_names, s.outer_names, s.local_types, s.outer_types, flag);
}

// scope_enter — open a child scope. Flattens local (names AND types) into the
// outer tier so parent bindings remain visible in the child.

public function scope_enter(s: Scope) returns Scope {
    let mutable new_outer: Array<String> = [];
    let mutable i: Int = 0;
    while i < len(s.outer_names) {
        new_outer.push(s.outer_names[i]);
        i = i + 1;
    }
    let mutable j: Int = 0;
    while j < len(s.local_names) {
        new_outer.push(s.local_names[j]);
        j = j + 1;
    }
    let mutable new_outer_t: Array<Type> = [];
    let mutable oi: Int = 0;
    while oi < len(s.outer_types) {
        new_outer_t.push(s.outer_types[oi]);
        oi = oi + 1;
    }
    let mutable oj: Int = 0;
    while oj < len(s.local_types) {
        new_outer_t.push(s.local_types[oj]);
        oj = oj + 1;
    }
    return Scope(shared_ast.empty_string_array(), new_outer, empty_type_array(), new_outer_t, s.in_async);
}

// scope_type_of — the inferred Type bound to `name`, or Unknown if not found or
// not typed. The current (local) tier shadows enclosing (outer); within a tier
// the innermost (last-defined) binding wins. Phase 48d.

public function scope_type_of(s: Scope, name: String) returns Type {
    let lt: Int = scope_last_index(s.local_names, name);
    if lt >= 0 {
        return s.local_types[lt];
    }
    let ot: Int = scope_last_index(s.outer_names, name);
    if ot >= 0 {
        return s.outer_types[ot];
    }
    return type_unknown();
}

// scope_last_index — index of the LAST occurrence of `name` in `names`, or -1.

function scope_last_index(names: Array<String>, name: String) returns Int {
    let mutable found_idx: Int = 0 - 1;
    let mutable i: Int = 0;
    while i < len(names) {
        if names[i] == name {
            found_idx = i;
        }
        i = i + 1;
    }
    return found_idx;
}

// scope_resolve — true if `name` is visible in the current or any enclosing
// scope (mirrors stage1 Scope.Resolve which walks the parent chain).

public function scope_resolve(s: Scope, name: String) returns Bool {
    if name_seen(s.local_names, name) {
        return true;
    }
    return name_seen(s.outer_names, name);
}

// scope_resolve_local — true if `name` is defined in the current scope only
// (mirrors stage1 Scope.ResolveLocal; used to detect redefinitions in 45.7).

public function scope_resolve_local(s: Scope, name: String) returns Bool {
    return name_seen(s.local_names, name);
}

// =============================================================================
// TYPE REPRESENTATION (Phase 46, ADR 0053)
//
// A structured type tree built from the flat type strings the AST already
// carries (Param.type_name, FieldDecl.type_name, FunctionDecl.return_type,
// `let` Stmt.type_name), per ADR 0053 D1 — NO parser/AST/formatter change.
// parse_type mirrors the exact forms shared/parser.intent parse_type_name emits:
//   - bare name:      `Int`, `Widget`
//   - generic:        `Array<String>`, `Map<String, Int>` (", " arg separators)
//   - nested generic: `Array<Map<String, Int>>`
//   - function type:  `Fn(Int, Int) -> Int`  ("Fn(" params ") -> " ret)
//
// Fn modelling (ADR 0053 open question, decided here): a Fn is name == "Fn" with
// type_args = [param1, .., paramN, return] and fn_param_count = N, so
// type_args[N] is the return type. fn_param_count is meaningful ONLY when
// name == "Fn" (it is 0 for every other type). Resolution (Phase 46.3) treats
// every type_arg uniformly, so it never needs to split params from the return;
// the count is retained for the expression-inference phases (47+).
// =============================================================================

public entity Type {
    field name: String;
    field type_args: Array<Type>;
    field fn_param_count: Int;

    constructor(name: String, type_args: Array<Type>, fn_param_count: Int) {
        self.name = name;
        self.type_args = type_args;
        self.fn_param_count = fn_param_count;
    }
}

// empty_type_array — a fresh, empty Array<Type> (leaf types carry no args).

public function empty_type_array() returns Array<Type> {
    let mutable a: Array<Type> = [];
    return a;
}

// type_is_ident_char — characters parse_type treats as part of a base name:
// alphanumerics plus '_', mirroring the lexer's identifier rule.

function type_is_ident_char(c: Char) returns Bool {
    return c.is_alphanumeric() or c == '_';
}

// TypeParser — a tiny recursive-descent scanner over a type string. Mutates
// self.pos in place across method calls, the same pattern as the shared Lexer.

entity TypeParser {
    field src: String;
    field pos: Int;

    constructor(src: String) {
        self.src = src;
        self.pos = 0;
    }

    method at_end() returns Bool {
        return self.pos >= len(self.src);
    }

    // Char at the current position, or '\0' at end (so callers can compare
    // against delimiters without a separate at_end guard).
    method peek() returns Char {
        if self.at_end() {
            return '\0';
        }
        return self.src[self.pos];
    }

    method skip_spaces() returns Void {
        while not self.at_end() and self.peek() == ' ' {
            self.pos = self.pos + 1;
        }
    }

    // Read a base identifier at the current position ([A-Za-z0-9_]+).
    method read_ident() returns String {
        let start: Int = self.pos;
        while not self.at_end() and type_is_ident_char(self.peek()) {
            self.pos = self.pos + 1;
        }
        return self.src[start..self.pos];
    }

    // Parse one full type at the current position.
    method parse() returns Type {
        self.skip_spaces();
        let base: String = self.read_ident();
        if base == "Fn" and self.peek() == '(' {
            return self.parse_fn();
        }
        if self.peek() == '<' {
            return self.parse_generic(base);
        }
        return Type(base, empty_type_array(), 0);
    }

    // Parse `<arg1, arg2, ...>` following an already-read base name.
    method parse_generic(base: String) returns Type {
        self.pos = self.pos + 1;
        let mutable args: Array<Type> = [];
        self.skip_spaces();
        while not self.at_end() and self.peek() != '>' {
            let arg: Type = self.parse();
            args.push(arg);
            self.skip_spaces();
            if self.peek() == ',' {
                self.pos = self.pos + 1;
                self.skip_spaces();
            }
        }
        if self.peek() == '>' {
            self.pos = self.pos + 1;
        }
        return Type(base, args, 0);
    }

    // Parse `(p1, p2, ...) -> R` following an already-read `Fn` base name.
    method parse_fn() returns Type {
        self.pos = self.pos + 1;
        let mutable args: Array<Type> = [];
        let mutable param_count: Int = 0;
        self.skip_spaces();
        while not self.at_end() and self.peek() != ')' {
            let p: Type = self.parse();
            args.push(p);
            param_count = param_count + 1;
            self.skip_spaces();
            if self.peek() == ',' {
                self.pos = self.pos + 1;
                self.skip_spaces();
            }
        }
        if self.peek() == ')' {
            self.pos = self.pos + 1;
        }
        self.skip_spaces();
        // consume the thin arrow `->`
        if self.peek() == '-' {
            self.pos = self.pos + 1;
            if self.peek() == '>' {
                self.pos = self.pos + 1;
            }
        }
        self.skip_spaces();
        let ret: Type = self.parse();
        args.push(ret);
        return Type("Fn", args, param_count);
    }
}

// parse_type — build a Type tree from one of the type strings the AST carries.
// Mirrors the forms shared/parser.intent parse_type_name emits (see banner).
// Unrecognised leading characters yield a bare Type with the scanned (possibly
// empty) base name.

public function parse_type(s: String) returns Type {
    let mutable p: TypeParser = TypeParser(s);
    return p.parse();
}

// type_is_known — true exactly when stage1 ResolveType (types.go:84) would
// resolve `t` to a non-nil Type. Every `unknown type '%s'` emit site in
// checker.go is `if ResolveType(...) == nil { emit }`, so this boolean IS the
// unknown-type predicate (the message base name — the OUTER ref name — is the
// caller's concern, Phase 46.4). Rules ported from ResolveTypeWithParams:
//   - primitives Int/Float/String/Bool/Void/Char             → known
//   - Array<T> (1 arg), Option<T> (1), Future<T> (1)         → arg known
//   - Result<T, E> (2 args), Map<K, V> (2 args)              → both known
//     Map additionally rejects unhashable keys Float/Array/Map (types.go:198)
//   - Fn(..) -> R                                            → all parts known
//     (no arity restriction; type_args = params ++ [return])
//   - a name in type_params / entity_names / enum_names, then every type arg
//     resolves too (generic entity instantiation, e.g. Box<Int>)
// Simplification vs stage1 (bounded by this phase's signature — no entity
// type-param counts are threaded): generic-entity arity is not checked and a
// non-generic entity's stray type args are still recursed rather than ignored.
// Neither case appears in the corpus or the 46.5 fixtures, so the gates hold.

public function type_is_known(t: Type, entity_names: Array<String>, enum_names: Array<String>, type_params: Array<String>) returns Bool {
    let n: String = t.name;
    if n == "Int" or n == "Float" or n == "String" or n == "Bool" or n == "Void" or n == "Char" {
        return true;
    }
    if n == "Array" or n == "Option" or n == "Future" {
        if len(t.type_args) != 1 {
            return false;
        }
        return type_is_known(t.type_args[0], entity_names, enum_names, type_params);
    }
    if n == "Result" {
        if len(t.type_args) != 2 {
            return false;
        }
        if not type_is_known(t.type_args[0], entity_names, enum_names, type_params) {
            return false;
        }
        return type_is_known(t.type_args[1], entity_names, enum_names, type_params);
    }
    if n == "Map" {
        if len(t.type_args) != 2 {
            return false;
        }
        let key: Type = t.type_args[0];
        if key.name == "Float" or key.name == "Array" or key.name == "Map" {
            return false;
        }
        if not type_is_known(key, entity_names, enum_names, type_params) {
            return false;
        }
        return type_is_known(t.type_args[1], entity_names, enum_names, type_params);
    }
    if n == "Fn" {
        let mutable i: Int = 0;
        while i < len(t.type_args) {
            if not type_is_known(t.type_args[i], entity_names, enum_names, type_params) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if not (name_seen(type_params, n) or name_seen(entity_names, n) or name_seen(enum_names, n)) {
        return false;
    }
    let mutable j: Int = 0;
    while j < len(t.type_args) {
        if not type_is_known(t.type_args[j], entity_names, enum_names, type_params) {
            return false;
        }
        j = j + 1;
    }
    return true;
}

// =============================================================================
// EXPRESSION TYPE INFERENCE (Phase 48, ADR 0056)
//
// infer_expr_type is SOUND but may be INCOMPLETE: it returns a concrete Type
// only when it is certain stage1 checkExpression would return the same, else
// the Unknown sentinel (a Type with name == ""). Type-rule checks fire ONLY on
// a confident (non-Unknown) result, so they never false-positive while
// inference grows. This first slice: literals + operator result types; no
// scope, so idents / calls / method calls / field / index / match / array /
// range / lambda all yield Unknown.
// =============================================================================

// type_unknown / is_unknown_type — the "could not infer" sentinel.

public function type_unknown() returns Type {
    return Type("", empty_type_array(), 0);
}

public function is_unknown_type(t: Type) returns Bool {
    return t.name == "";
}

// type_named — a leaf Type with the given name (no type args).

function type_named(name: String) returns Type {
    return Type(name, empty_type_array(), 0);
}

// Operator classes — op strings are the token text stored in ex_binop's name.

// is_eq_type / is_ord_type — the primitives stage1 checkBinaryExpr accepts for
// `==`/`!=` (adds Bool) and for `<`/`>`/`<=`/`>=` (no Bool). ADR 0041 adds Char.

function is_eq_type(name: String) returns Bool {
    return name == "Int" or name == "Float" or name == "String" or name == "Bool" or name == "Char";
}

function is_ord_type(name: String) returns Bool {
    return name == "Int" or name == "Float" or name == "String" or name == "Char";
}

// is_primitive_type — the built-in scalar types. These are definitively NOT
// enums, so a match scrutinee confidently inferred to one of them is a
// scrutinee-must-be-enum error (48j-a2). Entities/Option/Result/collections are
// excluded: stage2 cannot always tell them apart from enums, so they are not
// flagged (a sound false negative). Also `.String() == .name` for these, so the
// diagnostic renders byte-equally.

function is_primitive_type(name: String) returns Bool {
    return name == "Int" or name == "Float" or name == "String" or name == "Bool" or name == "Char";
}

// binop_result_type — the Type stage1 checkBinaryExpr returns for `op` applied
// to (already-known) operands `lt`/`rt`, or Unknown when the operator is NOT
// defined for them (stage1 returns nil and emits an operator error). Callers
// pass only confidently-inferred operands, so an Unknown result means "stage1
// would error here". Mirrors checker.go:1564-1621 exactly.

function binop_result_type(op: String, lt: Type, rt: Type) returns Type {
    if op == "+" {
        if lt.name == "Int" and rt.name == "Int" {
            return type_named("Int");
        }
        if lt.name == "Float" and rt.name == "Float" {
            return type_named("Float");
        }
        if lt.name == "String" and rt.name == "String" {
            return type_named("String");
        }
        return type_unknown();
    }
    if op == "-" or op == "*" or op == "/" or op == "%" {
        if lt.name == "Int" and rt.name == "Int" {
            return type_named("Int");
        }
        if lt.name == "Float" and rt.name == "Float" {
            return type_named("Float");
        }
        return type_unknown();
    }
    if op == "==" or op == "!=" {
        if lt.name == rt.name and is_eq_type(lt.name) {
            return type_named("Bool");
        }
        return type_unknown();
    }
    if op == "<" or op == ">" or op == "<=" or op == ">=" {
        if lt.name == rt.name and is_ord_type(lt.name) {
            return type_named("Bool");
        }
        return type_unknown();
    }
    if op == "and" or op == "or" or op == "implies" {
        if lt.name == "Bool" and rt.name == "Bool" {
            return type_named("Bool");
        }
        return type_unknown();
    }
    return type_unknown();
}

// operator_display — how stage1 renders the operator in checkBinaryExpr's error
// message. That code uses `%s` on the TokenType (BinaryExpr.Op), which prints
// the token NAME (MINUS/STAR/EQ/...) — EXCEPT `+`, a literal in the format
// string. Reproduced verbatim for byte-equality (checker.go:1576/1587/1597/...).

function operator_display(op: String) returns String {
    if op == "+" {
        return "+";
    }
    if op == "-" {
        return "MINUS";
    }
    if op == "*" {
        return "STAR";
    }
    if op == "/" {
        return "SLASH";
    }
    if op == "%" {
        return "PERCENT";
    }
    if op == "==" {
        return "EQ";
    }
    if op == "!=" {
        return "NEQ";
    }
    if op == "<" {
        return "LT";
    }
    if op == ">" {
        return "GT";
    }
    if op == "<=" {
        return "LEQ";
    }
    if op == ">=" {
        return "GEQ";
    }
    if op == "and" {
        return "AND";
    }
    if op == "or" {
        return "OR";
    }
    if op == "implies" {
        return "IMPLIES";
    }
    return op;
}

// operator_error_message — stage1's checkBinaryExpr diagnostic for an operator
// undefined on `lt`/`rt`. Logical ops read "requires boolean operands, got X and
// Y"; every other op reads "not defined for X and Y".

function operator_error_message(op: String, lt: Type, rt: Type) returns String {
    if op == "and" or op == "or" or op == "implies" {
        return "operator '" + operator_display(op) + "' requires boolean operands, got " + lt.name + " and " + rt.name;
    }
    return "operator '" + operator_display(op) + "' not defined for " + lt.name + " and " + rt.name;
}

public function infer_expr_type(e: Expr, scope: Scope, prog: Program) returns Type {
    if e.kind == shared_ast.ex_int() {
        return type_named("Int");
    }
    if e.kind == shared_ast.ex_float() {
        return type_named("Float");
    }
    if e.kind == shared_ast.ex_string() {
        return type_named("String");
    }
    if e.kind == shared_ast.ex_bool() {
        return type_named("Bool");
    }
    if e.kind == shared_ast.ex_char() {
        return type_named("Char");
    }
    if e.kind == shared_ast.ex_ident() {
        // Phase 48d: resolve the variable's type from the scope (params seeded
        // from their annotations; let bindings carry Unknown until later). A
        // name not in scope, or bound Unknown, yields Unknown → sound skip.
        return scope_type_of(scope, e.name);
    }
    if e.kind == shared_ast.ex_paren() {
        return infer_expr_type(e.children[0], scope, prog);
    }
    if e.kind == shared_ast.ex_unary() {
        // `not x` is Bool; unary `-x` has the operand's numeric type.
        if e.name == "not" {
            return type_named("Bool");
        }
        return infer_expr_type(e.children[0], scope, prog);
    }
    if e.kind == shared_ast.ex_binop() {
        // Result type mirrors stage1 checkBinaryExpr: known only when BOTH
        // operands are confidently inferred AND the operator is defined for them
        // (binop_result_type), else Unknown. Comparisons/logical yield Bool for
        // VALID operands but Unknown for invalid ones — never eagerly Bool, which
        // would misfire the let/condition/arg checks when the operator itself is
        // the error (that operator error is emitted by check_expr_names, 48e).
        // Assignment `=` and any other op fall through binop_result_type to
        // Unknown. Phase 48a refined by 48e, ADR 0056.
        let lt: Type = infer_expr_type(e.children[0], scope, prog);
        let rt: Type = infer_expr_type(e.children[1], scope, prog);
        if is_unknown_type(lt) or is_unknown_type(rt) {
            return type_unknown();
        }
        return binop_result_type(e.name, lt, rt);
    }
    if e.kind == shared_ast.ex_field() {
        // Phase 48i: `object.field`. Infer the object's type; if it is a known
        // entity, return the field's declared type. Anything else (primitive,
        // unknown object, missing field) → Unknown (sound skip).
        let obj_t: Type = infer_expr_type(e.children[0], scope, prog);
        if is_unknown_type(obj_t) {
            return type_unknown();
        }
        return entity_field_type(prog, obj_t.name, e.name);
    }
    // call / method / index / match / array / range / lambda / try / await /
    // spawn — deferred (need call-return / element inference). Unknown.
    return type_unknown();
}

// entity_field_type — the declared type of field `field_name` on entity
// `entity_name`, or Unknown if the entity or field is not found.

function entity_field_type(prog: Program, entity_name: String, field_name: String) returns Type {
    let mutable i: Int = 0;
    while i < len(prog.entities) {
        if prog.entities[i].name == entity_name {
            let ent: EntityDecl = prog.entities[i];
            let mutable fi: Int = 0;
            while fi < len(ent.fields) {
                if ent.fields[fi].name == field_name {
                    return parse_type(ent.fields[fi].type_name);
                }
                fi = fi + 1;
            }
        }
        i = i + 1;
    }
    return type_unknown();
}

// =============================================================================
// GLOBAL SCOPE BUILDER
//
// Populates a Scope with every top-level declaration name (entities, enums,
// functions, traits, plus extern names) and the full set of stage1 builtin
// function/variant names. This matches what stage1 seeds into c.scope during
// the register passes (checker.go:589, 722, 779, 841) plus the builtin
// function handling in checkCallExpr (checker.go:1659-2031).
//
// Seeded builtins (verified against internal/checker/checker.go:1659-2031):
//   Core:     print, len
//   Assert:   assert, assert_eq, assert_close, assert_panics
//   File I/O: read_file, write_file, create_dir, file_exists
//   Env/CLI:  env_get, args
//   HTTP/JSON: http_post, http_get, json_get, json_path, emit_event
//   Time/Async: timestamp_ms, sleep, await_all, await_any, timeout
//   Char:     char_from_codepoint
//   Result/Option constructors: Ok, Err, Some, None
// =============================================================================

public function build_global_scope(prog: Program) returns Scope {
    let mutable s: Scope = scope_empty();

    // Top-level declarations (mirrors register passes).
    let mutable ei: Int = 0;
    while ei < len(prog.entities) {
        s = scope_define(s, prog.entities[ei].name);
        ei = ei + 1;
    }
    let mutable eni: Int = 0;
    while eni < len(prog.enums) {
        s = scope_define(s, prog.enums[eni].name);
        // Seed all variant names too: unit variants appear as bare ex_ident
        // in expressions (e.g. `return Running;`) and must resolve in scope.
        // Data variants appear as ex_call callee and are also checked by the
        // arity registry, but seeding here prevents undeclared-variable false
        // positives if arity-check is bypassed or variant is used as a value.
        let mutable vni: Int = 0;
        while vni < len(prog.enums[eni].variants) {
            s = scope_define(s, prog.enums[eni].variants[vni].name);
            vni = vni + 1;
        }
        eni = eni + 1;
    }
    let mutable fi: Int = 0;
    while fi < len(prog.functions) {
        s = scope_define(s, prog.functions[fi].name);
        fi = fi + 1;
    }
    let mutable ti: Int = 0;
    while ti < len(prog.traits) {
        s = scope_define(s, prog.traits[ti].name);
        ti = ti + 1;
    }
    let mutable xi: Int = 0;
    while xi < len(prog.externs) {
        s = scope_define(s, prog.externs[xi].func_name);
        xi = xi + 1;
    }

    // Core builtins.
    s = scope_define(s, "print");
    s = scope_define(s, "len");

    // Assert builtins (phase 16 / ADR 0029).
    s = scope_define(s, "assert");
    s = scope_define(s, "assert_eq");
    s = scope_define(s, "assert_close");
    s = scope_define(s, "assert_panics");

    // File I/O builtins (phase 19 / ADR 0019).
    s = scope_define(s, "read_file");
    s = scope_define(s, "write_file");
    s = scope_define(s, "create_dir");
    s = scope_define(s, "file_exists");

    // Environment / CLI builtins.
    s = scope_define(s, "env_get");
    s = scope_define(s, "args");

    // HTTP / JSON / event builtins (phase 20 / ADR 0020).
    s = scope_define(s, "http_post");
    s = scope_define(s, "http_get");
    s = scope_define(s, "json_get");
    s = scope_define(s, "json_path");
    s = scope_define(s, "emit_event");

    // Time / async builtins.
    s = scope_define(s, "timestamp_ms");
    s = scope_define(s, "sleep");
    s = scope_define(s, "await_all");
    s = scope_define(s, "await_any");
    s = scope_define(s, "timeout");

    // Char builtin (phase 31 / ADR 0041).
    s = scope_define(s, "char_from_codepoint");

    // Result / Option constructors: Ok(v), Err(e), Some(v), None (identifier).
    s = scope_define(s, "Ok");
    s = scope_define(s, "Err");
    s = scope_define(s, "Some");
    s = scope_define(s, "None");

    return s;
}

// =============================================================================
// ARITY REGISTRIES
//
// Parallel-array registries for function and variant call-arity checking.
// Built once per check_program invocation (like build_global_scope) and
// threaded into check_expr_names. Mirrors stage1 c.functions and c.enumVariants
// maps (checker.go:2034-2040 variant check, 2167-2172 function check).
//
// build_fn_arity: name → param count from prog.functions.
// build_variant_arity: variant name → params count from all enums' variants.
// arity_lookup: linear scan returning count for `name`, or -1 if absent.
//
// Builtin arity (assert, len, etc.) and method arity are DEFERRED — builtins
// have ~20 bespoke messages (checker.go:1676-2028) and methods need receiver
// types. They are intentionally excluded from these registries.
// =============================================================================

public function build_fn_arity_names(prog: Program) returns Array<String> {
    let mutable names: Array<String> = [];
    let mutable i: Int = 0;
    while i < len(prog.functions) {
        names.push(prog.functions[i].name);
        i = i + 1;
    }
    return names;
}

public function build_fn_arity_counts(prog: Program) returns Array<Int> {
    let mutable counts: Array<Int> = [];
    let mutable i: Int = 0;
    while i < len(prog.functions) {
        counts.push(len(prog.functions[i].params));
        i = i + 1;
    }
    return counts;
}

public function build_variant_arity_names(prog: Program) returns Array<String> {
    let mutable names: Array<String> = [];
    let mutable ei: Int = 0;
    while ei < len(prog.enums) {
        let e: EnumDecl = prog.enums[ei];
        let mutable vi: Int = 0;
        while vi < len(e.variants) {
            names.push(e.variants[vi].name);
            vi = vi + 1;
        }
        ei = ei + 1;
    }
    return names;
}

public function build_variant_arity_counts(prog: Program) returns Array<Int> {
    let mutable counts: Array<Int> = [];
    let mutable ei: Int = 0;
    while ei < len(prog.enums) {
        let e: EnumDecl = prog.enums[ei];
        let mutable vi: Int = 0;
        while vi < len(e.variants) {
            counts.push(len(e.variants[vi].params));
            vi = vi + 1;
        }
        ei = ei + 1;
    }
    return counts;
}

// arity_lookup — returns the count for `name` in the parallel arrays, or -1.

function arity_lookup(names: Array<String>, counts: Array<Int>, name: String) returns Int {
    let mutable i: Int = 0;
    while i < len(names) {
        if names[i] == name {
            return counts[i];
        }
        i = i + 1;
    }
    return -1;
}

// lookup_function — index of the first top-level function named `name` in
// prog.functions, or -1. Used by the argument-type check to read param types.

function lookup_function(prog: Program, name: String) returns Int {
    let mutable i: Int = 0;
    while i < len(prog.functions) {
        if prog.functions[i].name == name {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// find_variant_params — the fields (as Params: name + type_name) of the enum
// variant named `name`, or an empty array if not found. Used by the variant
// argument-type check to read each field's declared type.

function find_variant_params(prog: Program, name: String) returns Array<Param> {
    let mutable ei: Int = 0;
    while ei < len(prog.enums) {
        let e: EnumDecl = prog.enums[ei];
        let mutable vi: Int = 0;
        while vi < len(e.variants) {
            if e.variants[vi].name == name {
                return e.variants[vi].params;
            }
            vi = vi + 1;
        }
        ei = ei + 1;
    }
    return shared_ast.empty_param_array();
}

// find_entity_index — index of the entity named `name` in prog.entities, or -1.
// Used to resolve a method-call receiver's declaring entity (and its generics).

function find_entity_index(prog: Program, name: String) returns Int {
    let mutable i: Int = 0;
    while i < len(prog.entities) {
        if prog.entities[i].name == name {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// find_enum_index — index of the USER enum named `name` in prog.enums, or -1.
// Builtin Option/Result are not in prog.enums, so a match on them resolves to
// -1 → the match checks skip them (a sound false negative). Used by the
// match-arm checks to resolve the scrutinee's enum + its variants.

function find_enum_index(prog: Program, name: String) returns Int {
    let mutable i: Int = 0;
    while i < len(prog.enums) {
        if prog.enums[i].name == name {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// enum_has_variant — whether enum `ed` declares a variant named `name`.

function enum_has_variant(ed: EnumDecl, name: String) returns Bool {
    let mutable i: Int = 0;
    while i < len(ed.variants) {
        if ed.variants[i].name == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// variant_field_count — the number of fields declared by variant `name` on enum
// `ed` (0 for a unit variant, or if the variant is absent).

function variant_field_count(ed: EnumDecl, name: String) returns Int {
    let mutable i: Int = 0;
    while i < len(ed.variants) {
        if ed.variants[i].name == name {
            return len(ed.variants[i].params);
        }
        i = i + 1;
    }
    return 0;
}

// variant_fields — the declared fields (Params) of variant `name` on enum `ed`,
// or empty. Used to TYPE match-arm bindings for arm-body inference (48j-a2).

function variant_fields(ed: EnumDecl, name: String) returns Array<Param> {
    let mutable i: Int = 0;
    while i < len(ed.variants) {
        if ed.variants[i].name == name {
            return ed.variants[i].params;
        }
        i = i + 1;
    }
    return shared_ast.empty_param_array();
}

// entity_method_decls — every method named `method_name` on entity
// `entity_name`, gathered from the entity BODY and from impl blocks for that
// entity (stage1 merges trait-impl methods into Entity.Methods, so a call may
// resolve to either). The method-call check acts only when EXACTLY ONE match
// exists, so a name collision across body/impls is a sound skip, not a wrong
// pick. Used by check_expr_names for method-call arity/arg-type checks.

function entity_method_decls(prog: Program, entity_name: String, method_name: String) returns Array<FunctionDecl> {
    let mutable out: Array<FunctionDecl> = [];
    let idx: Int = find_entity_index(prog, entity_name);
    if idx >= 0 {
        let ent: EntityDecl = prog.entities[idx];
        let mutable mi: Int = 0;
        while mi < len(ent.methods) {
            if ent.methods[mi].name == method_name {
                out.push(ent.methods[mi]);
            }
            mi = mi + 1;
        }
    }
    let mutable ii: Int = 0;
    while ii < len(prog.impls) {
        if prog.impls[ii].entity_name == entity_name {
            let ib: ImplDecl = prog.impls[ii];
            let mutable imi: Int = 0;
            while imi < len(ib.methods) {
                if ib.methods[imi].name == method_name {
                    out.push(ib.methods[imi]);
                }
                imi = imi + 1;
            }
        }
        ii = ii + 1;
    }
    return out;
}

// =============================================================================
// BUILTIN CALL ARITY (Phase 47, ADR 0055)
//
// stage1 checkCallExpr (checker.go:1655-2028) arity-checks ~23 builtins with
// bespoke messages in three shapes. Arity (arg count) needs no type inference;
// the per-argument TYPE + async-context checks are deferred to the inference
// phase. Ok/Err/Some/None are variant constructors (the existing variant path),
// not builtins here. Encoded as parallel name/count arrays (−1 = not a builtin;
// 0 is a valid count, so callers test >= 0).
// =============================================================================

function builtin_arity_names() returns Array<String> {
    let mutable a: Array<String> = ["print", "assert", "assert_eq", "assert_close", "assert_panics", "char_from_codepoint", "len", "read_file", "write_file", "create_dir", "file_exists", "env_get", "http_post", "http_get", "json_get", "json_path", "emit_event", "timestamp_ms", "args", "sleep", "await_all", "await_any", "timeout"];
    return a;
}

function builtin_arity_counts() returns Array<Int> {
    let mutable a: Array<Int> = [1, 1, 2, 3, 1, 1, 1, 1, 2, 1, 1, 1, 3, 2, 2, 2, 2, 0, 0, 1, 1, 1, 2];
    return a;
}

// builtin_arity — expected arg count for a builtin, or -1 if not arity-checked.

function builtin_arity(name: String) returns Int {
    return arity_lookup(builtin_arity_names(), builtin_arity_counts(), name);
}

// builtin_uses_expects_verb — the assert-family builtins read "expects N";
// every other arity-checked builtin reads "requires exactly N".

function builtin_uses_expects_verb(name: String) returns Bool {
    return name == "print" or name == "assert" or name == "assert_eq" or name == "assert_close" or name == "assert_panics";
}

// builtin_arity_message — the exact stage1 arity message for `name` given the
// actual arg count `got`. "argument" is singular for N == 1.

function builtin_arity_message(name: String, got: Int) returns String {
    let n: Int = builtin_arity(name);
    if n == 0 {
        return name + "() takes no arguments, got " + got.to_string();
    }
    let mutable noun: String = "arguments";
    if n == 1 {
        noun = "argument";
    }
    if builtin_uses_expects_verb(name) {
        return name + "() expects " + n.to_string() + " " + noun + ", got " + got.to_string();
    }
    return name + "() requires exactly " + n.to_string() + " " + noun + ", got " + got.to_string();
}

// builtin_arg_type — the single simple type EVERY argument of `name` must be
// (stage1 checkCallExpr, checker.go:1659-1919), or "" for builtins whose args
// are not one uniform simple type. Only builtins with a uniform String/Int/Bool
// arg + the "argument [N ]must be T, got X" message shape are listed; print
// (accepts-set message), assert_close (labeled Float), len (accepts-set:
// String/Array/Map), assert_panics (Fn() -> Void), assert_eq (cross-arg
// mismatch + comparable-set), the async await_*/timeout builtins (async-context
// check done; their Array<Future<T>> arg typing still deferred), and the
// zero-arg builtins are handled elsewhere or deferred. Phase 48j-c, ADR 0056.

function builtin_arg_type(name: String) returns String {
    if name == "assert" {
        return "Bool";
    }
    if name == "char_from_codepoint" or name == "sleep" {
        return "Int";
    }
    if name == "read_file" or name == "write_file" or name == "create_dir" or name == "file_exists" or name == "env_get" or name == "http_post" or name == "http_get" or name == "json_get" or name == "json_path" or name == "emit_event" {
        return "String";
    }
    return "";
}

// builtin_arg_type_message — stage1's per-argument type diagnostic for `name`.
// Multi-argument builtins number the argument ("argument N must be ..."); the
// single-argument ones omit the number ("argument must be ..."). The split is
// exactly arity > 1 (verified against checker.go).

function builtin_arg_type_message(name: String, argnum: Int, arity: Int, req: String, got: String) returns String {
    if arity > 1 {
        return name + "() argument " + argnum.to_string() + " must be " + req + ", got " + got;
    }
    return name + "() argument must be " + req + ", got " + got;
}

// is_printable_type — the types print() accepts (stage1 checkCallExpr:1666).
// Note Char is NOT accepted. The print() diagnostic uses the base .Name, so it
// renders byte-equally even for a generic/entity argument.

function is_printable_type(name: String) returns Bool {
    return name == "Int" or name == "Float" or name == "Bool" or name == "String";
}

// assert_close_label — the label stage1 gives each assert_close argument
// (checker.go:1720: labels[i] = actual/expected/epsilon for args 1/2/3).

function assert_close_label(argnum: Int) returns String {
    if argnum == 1 {
        return "actual";
    }
    if argnum == 2 {
        return "expected";
    }
    return "epsilon";
}

// is_async_only_builtin — the builtins that may appear only inside an async
// function/test (stage1 checker.go:1956/1983/2009). Each emits `<name> can only
// be used inside async functions` (no parens) when c.inAsyncFunc is false, after
// its arity check passes. Phase 48j-c2d.

function is_async_only_builtin(name: String) returns Bool {
    return name == "await_all" or name == "await_any" or name == "timeout";
}

// =============================================================================
// EXPRESSION NAME CHECKER
//
// check_expr_names walks an Expr in USE position and emits:
//   • `undeclared variable 'NAME'` for unresolved ex_ident (checker.go:2661).
//   • `variant 'N' expects F arguments, got A` for variant arity mismatch
//     (checker.go:2034-2040).
//   • `function 'N' expects P arguments, got A` for function arity mismatch
//     (checker.go:2167-2172).
// Arity is checked first (variant before function, matching stage1 order); on
// mismatch the args are NOT recursed (stage1 returns early — only one error
// per bad call). Builtin arity and method arity are deferred.
//
// USE-position rules (conservative — mirrors stage1, avoids false positives):
//   ex_ident     — check name; skip if scope_resolve returns true.
//   ex_binop     — recurse both children.
//   ex_unary     — recurse children[0].
//   ex_array     — recurse all children.
//   ex_index     — recurse children[0] (object) and children[1] (index).
//   ex_range     — recurse children[0] and children[1].
//   ex_paren     — recurse children[0].
//   ex_call      — callee is children[0]:
//                    • if callee is ex_ident:
//                        1. If variant name → check arity; return on mismatch.
//                        2. If function name → check arity; return on mismatch.
//                        3. Otherwise (builtin/unknown) → recurse args normally.
//                    • if callee is ex_field → recurse callee.children[0] (the
//                      receiver); args recursed normally.
//                    • otherwise → recurse callee; args recursed normally.
//                  Args recursed only when no arity error was emitted.
//   ex_field     — recurse children[0] (receiver). The field name is not a var.
//   ex_match     — recurse children[0] (scrutinee). For each arm: recurse the
//                  arm body in a child scope that has all arm bindings defined.
//   ex_lambda    — recurse body (children[0]) in a child scope with all
//                  lambda_params defined.
//   ex_forall/ex_exists — the bound variable is in name; recurse children[0]
//                  (domain) and children[1] (body) in a child scope with the
//                  bound var defined.
//   literals (ex_int, ex_float, ex_string, ex_bool, ex_char, ex_void) → skip.
// =============================================================================

// check_arm_body — name-checks a match arm's body in a child scope with the
// arm's pattern bindings defined (stage1 recurses each arm body in armScope).
// Shared by the match-arm check (48j-a) and the fallback path.

function check_arm_body(arm: MatchArm, scope: Scope, fn_names: Array<String>, fn_counts: Array<Int>, var_names: Array<String>, var_counts: Array<Int>, prog: Program) returns Array<CheckDiag> {
    let mutable arm_scope: Scope = scope_enter(scope);
    let mutable bi: Int = 0;
    while bi < len(arm.bindings) {
        arm_scope = scope_define(arm_scope, arm.bindings[bi]);
        bi = bi + 1;
    }
    return check_expr_names(arm.body, arm_scope, fn_names, fn_counts, var_names, var_counts, prog);
}

// arm_typed_scope — the child scope for a match arm's body with its pattern
// bindings TYPED from the variant's field types (stage1 checkMatchExpr:2979).
// Only bindings with a matching field (index < field count) are defined — exactly
// like stage1 — so extra bindings from a binding-count mismatch stay undefined.
// Used by the user-enum branch for both name checking and arm-body inference
// (arm-type consistency, 48j-a2). A wildcard arm has no bindings.

function arm_typed_scope(arm: MatchArm, ed: EnumDecl, scope: Scope) returns Scope {
    let mutable s: Scope = scope_enter(scope);
    if arm.is_wildcard {
        return s;
    }
    let vparams: Array<Param> = variant_fields(ed, arm.variant);
    let mutable bi: Int = 0;
    while bi < len(arm.bindings) {
        if bi < len(vparams) {
            s = scope_define_typed(s, arm.bindings[bi], parse_type(vparams[bi].type_name));
        }
        bi = bi + 1;
    }
    return s;
}

function check_expr_names(e: Expr, scope: Scope, fn_names: Array<String>, fn_counts: Array<Int>, var_names: Array<String>, var_counts: Array<Int>, prog: Program) returns Array<CheckDiag> {
    let mutable diags: Array<CheckDiag> = [];
    if e.kind == shared_ast.ex_ident() {
        if not scope_resolve(scope, e.name) {
            diags.push(CheckDiag(e.line, e.column, "undeclared variable '" + e.name + "'"));
        }
        return diags;
    }
    if e.kind == shared_ast.ex_binop() {
        let mutable ld: Array<CheckDiag> = check_expr_names(e.children[0], scope, fn_names, fn_counts, var_names, var_counts, prog);
        let mutable li: Int = 0;
        while li < len(ld) {
            diags.push(ld[li]);
            li = li + 1;
        }
        let mutable rd: Array<CheckDiag> = check_expr_names(e.children[1], scope, fn_names, fn_counts, var_names, var_counts, prog);
        let mutable ri: Int = 0;
        while ri < len(rd) {
            diags.push(rd[ri]);
            ri = ri + 1;
        }
        // Operator typing (stage1 checkBinaryExpr, checker.go:1564): after both
        // operands are name-checked, if BOTH are confidently inferred and the
        // operator is not defined for them (binop_result_type → Unknown), emit
        // the operator error at the operator token. An Unknown operand skips
        // (stage1 returns nil on a nil operand, emitting nothing — a sound false
        // negative). Assignment `=` is a statement (checkAssignStmt), never
        // routed through checkBinaryExpr, so it is not an operator-typing error.
        // Phase 48e, ADR 0056.
        if e.name != "=" {
            let olt: Type = infer_expr_type(e.children[0], scope, prog);
            let ort: Type = infer_expr_type(e.children[1], scope, prog);
            if not is_unknown_type(olt) and not is_unknown_type(ort) {
                if is_unknown_type(binop_result_type(e.name, olt, ort)) {
                    diags.push(CheckDiag(e.line, e.column, operator_error_message(e.name, olt, ort)));
                }
            }
        }
        return diags;
    }
    if e.kind == shared_ast.ex_unary() {
        let mutable ud: Array<CheckDiag> = check_expr_names(e.children[0], scope, fn_names, fn_counts, var_names, var_counts, prog);
        let mutable ui: Int = 0;
        while ui < len(ud) {
            diags.push(ud[ui]);
            ui = ui + 1;
        }
        return diags;
    }
    if e.kind == shared_ast.ex_paren() {
        let mutable pd: Array<CheckDiag> = check_expr_names(e.children[0], scope, fn_names, fn_counts, var_names, var_counts, prog);
        let mutable pi: Int = 0;
        while pi < len(pd) {
            diags.push(pd[pi]);
            pi = pi + 1;
        }
        return diags;
    }
    if e.kind == shared_ast.ex_await() {
        // `await` is valid only inside an async function/test (stage1
        // checkAwaitExpr:3161). Emit at the await keyword (ADR 0054 stamped
        // position) BEFORE recursing the operand, matching stage1's order; the
        // async flag rides the scope (ADR 0057). The operand's Future<T> type
        // check is deferred (needs generic inference). Phase 48j-c2e.
        if not scope.in_async {
            diags.push(CheckDiag(e.line, e.column, "await can only be used inside async functions"));
        }
        let mutable awd: Array<CheckDiag> = check_expr_names(e.children[0], scope, fn_names, fn_counts, var_names, var_counts, prog);
        let mutable awi: Int = 0;
        while awi < len(awd) {
            diags.push(awd[awi]);
            awi = awi + 1;
        }
        return diags;
    }
    if e.kind == shared_ast.ex_array() {
        let mutable ai: Int = 0;
        while ai < len(e.children) {
            let mutable ad: Array<CheckDiag> = check_expr_names(e.children[ai], scope, fn_names, fn_counts, var_names, var_counts, prog);
            let mutable adi: Int = 0;
            while adi < len(ad) {
                diags.push(ad[adi]);
                adi = adi + 1;
            }
            ai = ai + 1;
        }
        return diags;
    }
    if e.kind == shared_ast.ex_index() {
        let mutable od: Array<CheckDiag> = check_expr_names(e.children[0], scope, fn_names, fn_counts, var_names, var_counts, prog);
        let mutable oi: Int = 0;
        while oi < len(od) {
            diags.push(od[oi]);
            oi = oi + 1;
        }
        let mutable id: Array<CheckDiag> = check_expr_names(e.children[1], scope, fn_names, fn_counts, var_names, var_counts, prog);
        let mutable ii: Int = 0;
        while ii < len(id) {
            diags.push(id[ii]);
            ii = ii + 1;
        }
        return diags;
    }
    if e.kind == shared_ast.ex_range() {
        let mutable rd0: Array<CheckDiag> = check_expr_names(e.children[0], scope, fn_names, fn_counts, var_names, var_counts, prog);
        let mutable ri0: Int = 0;
        while ri0 < len(rd0) {
            diags.push(rd0[ri0]);
            ri0 = ri0 + 1;
        }
        let mutable rd1: Array<CheckDiag> = check_expr_names(e.children[1], scope, fn_names, fn_counts, var_names, var_counts, prog);
        let mutable ri1: Int = 0;
        while ri1 < len(rd1) {
            diags.push(rd1[ri1]);
            ri1 = ri1 + 1;
        }
        return diags;
    }
    if e.kind == shared_ast.ex_field() {
        // Recurse receiver (children[0]); the field name is not a variable.
        let mutable fd: Array<CheckDiag> = check_expr_names(e.children[0], scope, fn_names, fn_counts, var_names, var_counts, prog);
        let mutable fi: Int = 0;
        while fi < len(fd) {
            diags.push(fd[fi]);
            fi = fi + 1;
        }
        return diags;
    }
    if e.kind == shared_ast.ex_call() {
        // children[0] is the callee; children[1..] are the arguments.
        let callee: Expr = e.children[0];
        let arg_count: Int = len(e.children) - 1;
        if callee.kind == shared_ast.ex_ident() {
            // Builtin arity FIRST (stage1 checkCallExpr order: builtins at 1655
            // precede variant 2034 / function 2167). On mismatch emit the
            // bespoke message and return; on match recurse args and return
            // (builtins never fall through to variant/function). ADR 0055.
            let bexp: Int = builtin_arity(callee.name);
            if bexp >= 0 {
                if arg_count != bexp {
                    diags.push(CheckDiag(callee.line, callee.column, builtin_arity_message(callee.name, arg_count)));
                    return diags;
                }
                // await_all/await_any/timeout may appear only in an async
                // function/test. stage1 emits this AFTER the arity check passes
                // and BEFORE recursing the arguments (checker.go:1956/1983/2009),
                // and does NOT return — so it precedes any arg-recursion
                // diagnostics but the arg-type checks (Array<Future<T>>, deferred)
                // still follow. Phase 48j-c2d.
                if is_async_only_builtin(callee.name) and (not scope.in_async) {
                    diags.push(CheckDiag(callee.line, callee.column, callee.name + " can only be used inside async functions"));
                }
                let breq: String = builtin_arg_type(callee.name);
                let mutable bai: Int = 1;
                while bai < len(e.children) {
                    let mutable bad: Array<CheckDiag> = check_expr_names(e.children[bai], scope, fn_names, fn_counts, var_names, var_counts, prog);
                    let mutable badj: Int = 0;
                    while badj < len(bad) {
                        diags.push(bad[badj]);
                        badj = badj + 1;
                    }
                    // Phase 48j-c: builtin argument typing. For a builtin whose
                    // args all require one simple type, emit at the call
                    // `NAME() argument [N ]must be T, got X` when the arg is
                    // confidently a different simple type. Unknown or type_args
                    // args skip (sound; .String() == .name only for no-type-args
                    // types, keeping the message byte-equal). ADR 0056.
                    if breq != "" {
                        let bat: Type = infer_expr_type(e.children[bai], scope, prog);
                        if (not is_unknown_type(bat)) and len(bat.type_args) == 0 and bat.name != breq {
                            diags.push(CheckDiag(callee.line, callee.column, builtin_arg_type_message(callee.name, bai, bexp, breq, bat.name)));
                        }
                    }
                    // print() accepts only Int/Float/Bool/String; a confidently
                    // other-typed argument is `print() cannot print type X ...`.
                    // The message uses the base .name (not .String()), so it is
                    // byte-equal even for generic/entity args. Phase 48j-c.
                    if callee.name == "print" {
                        let pat: Type = infer_expr_type(e.children[bai], scope, prog);
                        if (not is_unknown_type(pat)) and (not is_printable_type(pat.name)) {
                            diags.push(CheckDiag(callee.line, callee.column, "print() cannot print type " + pat.name + " (accepts Int, Float, Bool, String)"));
                        }
                    }
                    // assert_close(actual, expected, epsilon): each arg must be
                    // Float, flagged with its label (stage1 checker.go:1717).
                    if callee.name == "assert_close" {
                        let cat: Type = infer_expr_type(e.children[bai], scope, prog);
                        if (not is_unknown_type(cat)) and len(cat.type_args) == 0 and cat.name != "Float" {
                            diags.push(CheckDiag(callee.line, callee.column, "assert_close() argument " + bai.to_string() + " (" + assert_close_label(bai) + ") must be Float, got " + cat.name));
                        }
                    }
                    // len() accepts String or a generic Array/Map (stage1
                    // checker.go:1759). A confidently-inferred simple type that is
                    // NOT String is rejected with `len() requires Array, Map, or
                    // String argument, got X`. Args with type_args skip (sound:
                    // generic Array/Map are accepted anyway, and a rejected
                    // generic like Option<Int> would need .String() rendering —
                    // deferred, a corpus-invisible false negative). Phase 48j-c2.
                    if callee.name == "len" {
                        let lat: Type = infer_expr_type(e.children[bai], scope, prog);
                        if (not is_unknown_type(lat)) and len(lat.type_args) == 0 and lat.name != "String" {
                            diags.push(CheckDiag(callee.line, callee.column, "len() requires Array, Map, or String argument, got " + lat.name));
                        }
                    }
                    // assert_panics() requires a `Fn() -> Void` argument (stage1
                    // checker.go:1728). A Fn type always carries type_args (at least
                    // its return), so a confidently-inferred no-type_args type is
                    // definitely a non-function that stage1 rejects → emit
                    // `assert_panics() argument must be Fn() -> Void, got X` at the
                    // call. Fn-typed args (correct or not) and lambdas skip soundly:
                    // a lambda infers Unknown, and a `Fn(...) -> ...` param has
                    // type_args (a wrong-shape one is a deferred false negative that
                    // would need Fn .String() rendering). Phase 48j-c2b.
                    if callee.name == "assert_panics" {
                        let pat2: Type = infer_expr_type(e.children[bai], scope, prog);
                        if (not is_unknown_type(pat2)) and len(pat2.type_args) == 0 {
                            diags.push(CheckDiag(callee.line, callee.column, "assert_panics() argument must be Fn() -> Void, got " + pat2.name));
                        }
                    }
                    bai = bai + 1;
                }
                // assert_eq(actual, expected): a cross-argument check (stage1
                // checker.go:1691), so it runs once after per-arg recursion.
                // When BOTH args are confidently inferred, no-type_args simple
                // types (Equal on those reduces to name equality; .String()==.name):
                //   - different names → `assert_eq() type mismatch: actual is X,
                //     expected is Y` (stage1 returns after this; we emit only it);
                //   - same name Float → `assert_eq does not support Float; ...`
                //     (the most common assertEqUnsupportedReason case).
                //   - same name, a user entity with no `eq` method →
                //     `entity 'X' used in assert_eq but has no eq method; ...`
                //     (stage1 assertEqUnsupportedReason:3265). The lookup uses
                //     entity_method_decls (entity body + trait-impl methods),
                //     which is exactly stage1's EntityInfo.Methods, so the
                //     presence test is byte-equal (no false positive).
                // The eq-method SIGNATURE sub-checks (wrong return/param count/param
                // type) and the Map/Future/generic-recursion rules need generic
                // .String() and are deferred — sound corpus-invisible false
                // negatives (an entity WITH any eq method is skipped). 48j-c2c/f.
                if callee.name == "assert_eq" and len(e.children) == 3 {
                    let aet: Type = infer_expr_type(e.children[1], scope, prog);
                    let eet: Type = infer_expr_type(e.children[2], scope, prog);
                    if (not is_unknown_type(aet)) and (not is_unknown_type(eet)) and len(aet.type_args) == 0 and len(eet.type_args) == 0 {
                        if aet.name != eet.name {
                            diags.push(CheckDiag(callee.line, callee.column, "assert_eq() type mismatch: actual is " + aet.name + ", expected is " + eet.name));
                        } else {
                            if aet.name == "Float" {
                                diags.push(CheckDiag(callee.line, callee.column, "assert_eq does not support Float; use assert_close(actual, expected, epsilon) for floating-point comparisons"));
                            } else {
                                if name_seen(collect_entity_names(prog), aet.name) and len(entity_method_decls(prog, aet.name, "eq")) == 0 {
                                    diags.push(CheckDiag(callee.line, callee.column, "entity '" + aet.name + "' used in assert_eq but has no eq method; define 'method eq(other: " + aet.name + ") returns Bool' to enable equality checks"));
                                }
                            }
                        }
                    }
                }
                return diags;
            }
            // Arity check: variants FIRST (stage1 order: 2034 before 2167),
            // then functions. On mismatch: emit error and SKIP arg recursion
            // (early return, matching stage1 behaviour).
            let var_arity: Int = arity_lookup(var_names, var_counts, callee.name);
            if var_arity >= 0 {
                if arg_count != var_arity {
                    diags.push(CheckDiag(callee.line, callee.column, "variant '" + callee.name + "' expects " + var_arity.to_string() + " arguments, got " + arg_count.to_string()));
                    return diags;
                }
                // Correct variant arity — per arg: recurse for undeclared, then
                // field-type check (stage1 checkCallExpr:2040-2048). Emit on a
                // confidently-inferred, positioned arg whose type differs from
                // the variant field's declared type; Unknown skips. Phase 48g.
                let vparams: Array<Param> = find_variant_params(prog, callee.name);
                let mutable vai: Int = 1;
                while vai < len(e.children) {
                    let varg: Expr = e.children[vai];
                    let mutable vad: Array<CheckDiag> = check_expr_names(varg, scope, fn_names, fn_counts, var_names, var_counts, prog);
                    let mutable vadj: Int = 0;
                    while vadj < len(vad) {
                        diags.push(vad[vadj]);
                        vadj = vadj + 1;
                    }
                    let vpidx: Int = vai - 1;
                    if vpidx < len(vparams) {
                        let vptype: Type = parse_type(vparams[vpidx].type_name);
                        let vatype: Type = infer_expr_type(varg, scope, prog);
                        if not is_unknown_type(vatype) and varg.line > 0 {
                            if vatype.name != vptype.name {
                                diags.push(CheckDiag(varg.line, varg.column, "variant '" + callee.name + "' field '" + vparams[vpidx].name + "' expects " + vptype.name + ", got " + vatype.name));
                            }
                        }
                    }
                    vai = vai + 1;
                }
                return diags;
            }
            let fn_arity: Int = arity_lookup(fn_names, fn_counts, callee.name);
            if fn_arity >= 0 {
                if arg_count != fn_arity {
                    diags.push(CheckDiag(callee.line, callee.column, "function '" + callee.name + "' expects " + fn_arity.to_string() + " arguments, got " + arg_count.to_string()));
                    return diags;
                }
                // Correct function arity — per arg: recurse for undeclared,
                // then argument-type check (stage1 checkCallExpr:2175-2181
                // order). Arg-type only for NON-generic functions (stage1 does
                // type-param substitution we skip → sound to skip generics) and
                // only on a confidently-inferred, positioned argument whose type
                // differs from the param's. Phase 48/51, ADR 0056.
                let fn_idx: Int = lookup_function(prog, callee.name);
                let mutable fai: Int = 1;
                while fai < len(e.children) {
                    let arg: Expr = e.children[fai];
                    let mutable fad: Array<CheckDiag> = check_expr_names(arg, scope, fn_names, fn_counts, var_names, var_counts, prog);
                    let mutable fadj: Int = 0;
                    while fadj < len(fad) {
                        diags.push(fad[fadj]);
                        fadj = fadj + 1;
                    }
                    if fn_idx >= 0 {
                        let f: FunctionDecl = prog.functions[fn_idx];
                        if len(f.type_params) == 0 {
                            let pidx: Int = fai - 1;
                            if pidx < len(f.params) {
                                let ptype: Type = parse_type(f.params[pidx].type_name);
                                let atype: Type = infer_expr_type(arg, scope, prog);
                                if not is_unknown_type(atype) and arg.line > 0 {
                                    if atype.name != ptype.name {
                                        diags.push(CheckDiag(arg.line, arg.column, "argument " + (pidx + 1).to_string() + " to '" + callee.name + "': expected " + ptype.name + ", got " + atype.name));
                                    }
                                }
                            }
                        }
                    }
                    fai = fai + 1;
                }
                return diags;
            }
            // Builtin, entity constructor, or unknown — no arity check here;
            // recurse args for undeclared-variable.
        } else {
            if callee.kind == shared_ast.ex_field() {
                // Method call `recv.method(args)`: recurse the receiver only
                // (callee.children[0]); the method name is not a variable.
                let recv: Expr = callee.children[0];
                let mutable mrd: Array<CheckDiag> = check_expr_names(recv, scope, fn_names, fn_counts, var_names, var_counts, prog);
                let mutable mri: Int = 0;
                while mri < len(mrd) {
                    diags.push(mrd[mri]);
                    mri = mri + 1;
                }
                // Phase 48i.2: when the receiver is confidently a known USER
                // entity and the method name resolves to exactly one declared
                // method (body or trait-impl), check arity + argument types like
                // stage1 checkMethodCallExpr (checker.go:2504-2542). Sound skips:
                // unknown/primitive/collection receivers (builtin Array/Map/
                // String/Char methods handled by stage1's earlier branches),
                // unresolved or ambiguous names ("no method" is NOT emitted —
                // trait methods live in impls that stage2 does not fully model),
                // and arg-types on a generic entity (its params may be type
                // params). Arity/name errors anchor at the ex_field method-name
                // position, matching stage1 MethodCallExpr.Pos().
                let recv_t: Type = infer_expr_type(recv, scope, prog);
                if not is_unknown_type(recv_t) {
                    let ent_idx: Int = find_entity_index(prog, recv_t.name);
                    if ent_idx >= 0 {
                        let methods: Array<FunctionDecl> = entity_method_decls(prog, recv_t.name, callee.name);
                        if len(methods) == 1 {
                            let m: FunctionDecl = methods[0];
                            let mparam_count: Int = len(m.params);
                            if arg_count != mparam_count {
                                diags.push(CheckDiag(callee.line, callee.column, "method '" + callee.name + "' expects " + mparam_count.to_string() + " arguments, got " + arg_count.to_string()));
                                return diags;
                            }
                            // Correct arity — per arg: recurse for undeclared,
                            // then arg-type (only for a NON-generic entity, whose
                            // method params carry no type params → sound skip for
                            // generics, mirroring the function path).
                            let is_generic: Bool = len(prog.entities[ent_idx].type_params) > 0;
                            let mutable mai: Int = 1;
                            while mai < len(e.children) {
                                let marg: Expr = e.children[mai];
                                let mutable mad: Array<CheckDiag> = check_expr_names(marg, scope, fn_names, fn_counts, var_names, var_counts, prog);
                                let mutable madj: Int = 0;
                                while madj < len(mad) {
                                    diags.push(mad[madj]);
                                    madj = madj + 1;
                                }
                                if not is_generic {
                                    let mpidx: Int = mai - 1;
                                    if mpidx < mparam_count {
                                        let mptype: Type = parse_type(m.params[mpidx].type_name);
                                        let matype: Type = infer_expr_type(marg, scope, prog);
                                        if not is_unknown_type(matype) and marg.line > 0 {
                                            if matype.name != mptype.name {
                                                diags.push(CheckDiag(marg.line, marg.column, "argument " + (mpidx + 1).to_string() + " to method '" + callee.name + "': expected " + mptype.name + ", got " + matype.name));
                                            }
                                        }
                                    }
                                }
                                mai = mai + 1;
                            }
                            return diags;
                        }
                    }
                }
            } else {
                // Closure-call or other callee form — recurse it.
                let mutable ccd: Array<CheckDiag> = check_expr_names(callee, scope, fn_names, fn_counts, var_names, var_counts, prog);
                let mutable cci: Int = 0;
                while cci < len(ccd) {
                    diags.push(ccd[cci]);
                    cci = cci + 1;
                }
            }
        }
        // Recurse arguments (children[1..]) — reached only when no arity error
        // was returned above (builtin/unknown/method/closure callee paths).
        let mutable cai: Int = 1;
        while cai < len(e.children) {
            let mutable cad: Array<CheckDiag> = check_expr_names(e.children[cai], scope, fn_names, fn_counts, var_names, var_counts, prog);
            let mutable cadj: Int = 0;
            while cadj < len(cad) {
                diags.push(cad[cadj]);
                cadj = cadj + 1;
            }
            cai = cai + 1;
        }
        // Generic entity constructor type-argument arity (stage1 checkCallExpr:
        // 2066). A generic constructor call parses as an ex_ident callee whose
        // type args are BAKED into the name (`Stack<Int>()` → callee.name ==
        // "Stack<Int>"); parse_type splits base + type_args. stage1 recurses the
        // args first (done above) THEN checks arity, using the BASE name in the
        // message and anchoring at the call (= the ident). Only when the base is
        // a generic entity WITH a constructor (stage1 emits "has no constructor"
        // first otherwise, and returns before this check — so we skip that case,
        // a sound false negative):
        //   - no type args  → `generic entity 'X' requires type arguments`;
        //   - wrong count   → `entity 'X' expects N type arguments, got M`.
        // The constructor's return type is NOT inferred here (stage2 returns
        // Unknown for ctor calls), so a `let`-bound wrong-arity call would MISS
        // stage1's second `type mismatch` diagnostic — fixtures use bare
        // constructor-call statements to stay byte-equal. Phase 53a.
        if callee.kind == shared_ast.ex_ident() {
            let cbase: Type = parse_type(callee.name);
            let ce_idx: Int = find_entity_index(prog, cbase.name);
            if ce_idx >= 0 {
                let ce: EntityDecl = prog.entities[ce_idx];
                if ce.has_constructor and len(ce.type_params) > 0 {
                    let ntargs: Int = len(cbase.type_args);
                    if ntargs == 0 {
                        diags.push(CheckDiag(callee.line, callee.column, "generic entity '" + cbase.name + "' requires type arguments"));
                    } else {
                        if ntargs != len(ce.type_params) {
                            diags.push(CheckDiag(callee.line, callee.column, "entity '" + cbase.name + "' expects " + len(ce.type_params).to_string() + " type arguments, got " + ntargs.to_string()));
                        }
                    }
                }
            }
        }
        return diags;
    }
    if e.kind == shared_ast.ex_match() {
        // children[0] is the scrutinee.
        let scrutinee: Expr = e.children[0];
        let mutable scd: Array<CheckDiag> = check_expr_names(scrutinee, scope, fn_names, fn_counts, var_names, var_counts, prog);
        let mutable sci: Int = 0;
        while sci < len(scd) {
            diags.push(scd[sci]);
            sci = sci + 1;
        }
        // Phase 48j-a: when the scrutinee is confidently a known USER enum, port
        // stage1 checkMatchExpr's structural checks (checker.go:2915) —
        // variant-exists, duplicate arm, binding-count, unreachable-after-
        // wildcard, and exhaustiveness. Arm-type consistency (needs arm-body
        // inference) and scrutinee-must-be-enum (needs enum-vs-nonenum certainty
        // that Option/Result would break) are deferred. Option/Result and any
        // non-user-enum / unknown scrutinee take the fallback (arm bodies only) —
        // a sound false negative. Per stage1: an unreachable or unknown-variant
        // arm does NOT recurse its body (early `continue`).
        let scrut_t: Type = infer_expr_type(scrutinee, scope, prog);
        let enum_idx: Int = find_enum_index(prog, scrut_t.name);
        if (not is_unknown_type(scrut_t)) and enum_idx >= 0 {
            let ed: EnumDecl = prog.enums[enum_idx];
            let mutable covered: Array<String> = [];
            let mutable has_wildcard: Bool = false;
            // Arm-type consistency baseline (stage1 `resultType`, set only at
            // i==0). An arm 0 that is skipped (unknown-variant) leaves it Unknown →
            // no comparisons anywhere; an Unknown arm-body type also suppresses
            // comparison (sound). Phase 48j-a2.
            let mutable result_t: Type = type_unknown();
            let mutable ami: Int = 0;
            while ami < len(e.match_arms) {
                let arm: MatchArm = e.match_arms[ami];
                if has_wildcard {
                    diags.push(CheckDiag(arm.line, arm.column, "unreachable pattern after wildcard '_'"));
                } else {
                    if arm.is_wildcard {
                        has_wildcard = true;
                        let wscope: Scope = arm_typed_scope(arm, ed, scope);
                        let mutable wbd: Array<CheckDiag> = check_expr_names(arm.body, wscope, fn_names, fn_counts, var_names, var_counts, prog);
                        let mutable wbi: Int = 0;
                        while wbi < len(wbd) {
                            diags.push(wbd[wbi]);
                            wbi = wbi + 1;
                        }
                        let warm_t: Type = infer_expr_type(arm.body, wscope, prog);
                        if ami == 0 {
                            result_t = warm_t;
                        } else {
                            if (not is_unknown_type(warm_t)) and (not is_unknown_type(result_t)) and len(warm_t.type_args) == 0 and len(result_t.type_args) == 0 {
                                if warm_t.name != result_t.name {
                                    diags.push(CheckDiag(arm.line, arm.column, "match arm type mismatch: expected " + result_t.name + ", got " + warm_t.name));
                                }
                            }
                        }
                    } else {
                        if not enum_has_variant(ed, arm.variant) {
                            diags.push(CheckDiag(arm.line, arm.column, "variant '" + arm.variant + "' is not a variant of enum '" + ed.name + "'"));
                        } else {
                            if name_seen(covered, arm.variant) {
                                diags.push(CheckDiag(arm.line, arm.column, "duplicate match arm for variant '" + arm.variant + "'"));
                            }
                            covered.push(arm.variant);
                            let vfc: Int = variant_field_count(ed, arm.variant);
                            if len(arm.bindings) != vfc {
                                diags.push(CheckDiag(arm.line, arm.column, "variant '" + arm.variant + "' has " + vfc.to_string() + " fields but pattern has " + len(arm.bindings).to_string() + " bindings"));
                            }
                            let vscope: Scope = arm_typed_scope(arm, ed, scope);
                            let mutable vbd: Array<CheckDiag> = check_expr_names(arm.body, vscope, fn_names, fn_counts, var_names, var_counts, prog);
                            let mutable vbi: Int = 0;
                            while vbi < len(vbd) {
                                diags.push(vbd[vbi]);
                                vbi = vbi + 1;
                            }
                            let varm_t: Type = infer_expr_type(arm.body, vscope, prog);
                            if ami == 0 {
                                result_t = varm_t;
                            } else {
                                if (not is_unknown_type(varm_t)) and (not is_unknown_type(result_t)) and len(varm_t.type_args) == 0 and len(result_t.type_args) == 0 {
                                    if varm_t.name != result_t.name {
                                        diags.push(CheckDiag(arm.line, arm.column, "match arm type mismatch: expected " + result_t.name + ", got " + varm_t.name));
                                    }
                                }
                            }
                        }
                    }
                }
                ami = ami + 1;
            }
            // Exhaustiveness (only when no wildcard): missing variants in enum
            // declaration order, comma-joined. stage1 checker.go:3006.
            if not has_wildcard {
                let mutable missing: String = "";
                let mutable mcount: Int = 0;
                let mutable vi: Int = 0;
                while vi < len(ed.variants) {
                    if not name_seen(covered, ed.variants[vi].name) {
                        if mcount > 0 {
                            missing = missing + ", ";
                        }
                        missing = missing + ed.variants[vi].name;
                        mcount = mcount + 1;
                    }
                    vi = vi + 1;
                }
                if mcount > 0 {
                    diags.push(CheckDiag(e.line, e.column, "non-exhaustive match on enum '" + ed.name + "': missing variants: " + missing));
                }
            }
            return diags;
        }
        // Scrutinee-must-be-enum (stage1 checkMatchExpr:2926): a scrutinee
        // confidently inferred to a PRIMITIVE is definitely not an enum → emit at
        // the match keyword and return WITHOUT processing arms (stage1 returns nil
        // there). Restricted to primitives so Option/Result/entity/collection
        // scrutinees (which stage2 can't confirm are non-enums) fall through to
        // the arm-body fallback. Phase 48j-a2.
        if (not is_unknown_type(scrut_t)) and is_primitive_type(scrut_t.name) {
            diags.push(CheckDiag(e.line, e.column, "match scrutinee must be an enum type, got " + scrut_t.name));
            return diags;
        }
        // Fallback: scrutinee not a confident user enum — recurse arm bodies for
        // name checking only (the pre-48j-a behavior).
        let mutable fmi: Int = 0;
        while fmi < len(e.match_arms) {
            let mutable fbd: Array<CheckDiag> = check_arm_body(e.match_arms[fmi], scope, fn_names, fn_counts, var_names, var_counts, prog);
            let mutable fbi: Int = 0;
            while fbi < len(fbd) {
                diags.push(fbd[fbi]);
                fbi = fbi + 1;
            }
            fmi = fmi + 1;
        }
        return diags;
    }
    if e.kind == shared_ast.ex_lambda() {
        // Recurse body (children[0]) in a child scope with lambda params defined.
        let mutable lam_scope: Scope = scope_enter(scope);
        let mutable lpi: Int = 0;
        while lpi < len(e.lambda_params) {
            lam_scope = scope_define(lam_scope, e.lambda_params[lpi].name);
            lpi = lpi + 1;
        }
        let mutable lamd: Array<CheckDiag> = check_expr_names(e.children[0], lam_scope, fn_names, fn_counts, var_names, var_counts, prog);
        let mutable lami: Int = 0;
        while lami < len(lamd) {
            diags.push(lamd[lami]);
            lami = lami + 1;
        }
        return diags;
    }
    if e.kind == shared_ast.ex_forall() {
        // Bound variable is e.name; domain = children[0], body = children[1].
        let mutable qd_scope: Scope = scope_enter(scope);
        qd_scope = scope_define(qd_scope, e.name);
        let mutable qdd: Array<CheckDiag> = check_expr_names(e.children[0], qd_scope, fn_names, fn_counts, var_names, var_counts, prog);
        let mutable qddi: Int = 0;
        while qddi < len(qdd) {
            diags.push(qdd[qddi]);
            qddi = qddi + 1;
        }
        let mutable qbd: Array<CheckDiag> = check_expr_names(e.children[1], qd_scope, fn_names, fn_counts, var_names, var_counts, prog);
        let mutable qbdi: Int = 0;
        while qbdi < len(qbd) {
            diags.push(qbd[qbdi]);
            qbdi = qbdi + 1;
        }
        return diags;
    }
    if e.kind == shared_ast.ex_exists() {
        // Same structure as ex_forall.
        let mutable eqs: Scope = scope_enter(scope);
        eqs = scope_define(eqs, e.name);
        let mutable eqdd: Array<CheckDiag> = check_expr_names(e.children[0], eqs, fn_names, fn_counts, var_names, var_counts, prog);
        let mutable eqddi: Int = 0;
        while eqddi < len(eqdd) {
            diags.push(eqdd[eqddi]);
            eqddi = eqddi + 1;
        }
        let mutable eqbd: Array<CheckDiag> = check_expr_names(e.children[1], eqs, fn_names, fn_counts, var_names, var_counts, prog);
        let mutable eqbdi: Int = 0;
        while eqbdi < len(eqbd) {
            diags.push(eqbd[eqbdi]);
            eqbdi = eqbdi + 1;
        }
        return diags;
    }
    // Literals (ex_void, ex_int, ex_float, ex_string, ex_bool, ex_char) and
    // any unrecognised kind — no names to check.
    return diags;
}

// --- Diagnostic entity -------------------------------------------------------

public entity CheckDiag {
    field line: Int;
    field column: Int;
    field message: String;

    constructor(line: Int, column: Int, message: String) {
        self.line = line;
        self.column = column;
        self.message = message;
    }
}

// --- Diagnostic formatter ----------------------------------------------------
// Produces one `error[<file>:<line>:<col>]: <message>` line per diag, joined
// by "\n". Empty diags array → empty string. NO trailing newline.

public function format_diags(diags: Array<CheckDiag>, file: String) returns String {
    if len(diags) == 0 {
        return "";
    }
    let mutable s: String = "";
    let mutable i: Int = 0;
    while i < len(diags) {
        if i > 0 {
            s = s + "\n";
        }
        let d: CheckDiag = diags[i];
        s = s + "error[" + file + ":" + d.line.to_string() + ":" + d.column.to_string() + "]: " + d.message;
        i = i + 1;
    }
    return s;
}

// --- Helpers -----------------------------------------------------------------
// Linear scan: returns true if `name` is already in `seen`.

function name_seen(seen: Array<String>, name: String) returns Bool {
    let mutable i: Int = 0;
    while i < len(seen) {
        if seen[i] == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// =============================================================================
// REGISTER PHASE
// Mirrors stage1 registerEnums → registerEntities → registerTraits →
// registerFunctions. Reports dup at the SECOND occurrence.
// =============================================================================

// check_dup_enums also checks duplicate variant names within each enum.
// Per-enum ordering: [enum-name dup check] then [variant dup checks for that
// enum] — mirroring registerEnums which does both in one loop (checker.go
// lines 662-728).

// check_dup_enums — enum duplicate-name + duplicate-variant detection AND
// variant-field `unknown type` checks. Mirrors stage1 registerEnums
// (checker.go:661-727): per enum (skip if dup name), per variant (dup-variant
// check, else resolve its field types). Variant fields resolve the way stage1
// does here — a QUIRK worth stating: registerEnums runs BEFORE registerEntities
// (dispatch order), so c.entities is EMPTY, and the current enum is added to
// c.enums only AFTER its variant loop, so its field types see only enums
// declared strictly earlier (`enums_so_far`), never itself. Plain ResolveType,
// no type params. Phase 46.4b.

function check_dup_enums(prog: Program) returns Array<CheckDiag> {
    let mutable diags: Array<CheckDiag> = [];
    let mutable seen_enums: Array<String> = [];
    let mutable enums_so_far: Array<String> = [];
    let no_entities: Array<String> = [];
    let no_tp: Array<String> = [];
    let mutable i: Int = 0;
    while i < len(prog.enums) {
        let e: EnumDecl = prog.enums[i];
        if name_seen(seen_enums, e.name) {
            diags.push(CheckDiag(e.line, e.column, "enum '" + e.name + "' already defined"));
        } else {
            seen_enums.push(e.name);
            let mutable seen_variants: Array<String> = [];
            let mutable vi: Int = 0;
            while vi < len(e.variants) {
                let v: EnumVariant = e.variants[vi];
                if name_seen(seen_variants, v.name) {
                    diags.push(CheckDiag(v.line, v.column, "duplicate variant name '" + v.name + "' in enum '" + e.name + "'"));
                } else {
                    seen_variants.push(v.name);
                    // Resolve this variant's field types (entities empty, enums
                    // = those declared before this one, no type params).
                    let mutable fj: Int = 0;
                    while fj < len(v.params) {
                        let vp: Param = v.params[fj];
                        let vt: Type = parse_type(vp.type_name);
                        if not type_is_known(vt, no_entities, enums_so_far, no_tp) {
                            diags.push(CheckDiag(vp.line, vp.column, "unknown type '" + vt.name + "'"));
                        }
                        fj = fj + 1;
                    }
                }
                vi = vi + 1;
            }
            // stage1 registers the enum only after its variant loop.
            enums_so_far.push(e.name);
        }
        i = i + 1;
    }
    return diags;
}

// check_dup_entities — entity duplicate-name detection AND field/method
// signature `unknown type` checks. Mirrors stage1 registerEntities' two passes
// (checker.go:562-657): pass 1 emits every `entity 'X' already defined` first,
// THEN pass 2 resolves each entity's field types (anchored at the `field`
// keyword) followed by its method signatures (params then return), threading
// the entity's own type params. The CONSTRUCTOR is intentionally excluded —
// stage1 resolves it only in checkConstructor, which does NOT emit `unknown
// type` (Phase 46.4b).

function check_dup_entities(prog: Program) returns Array<CheckDiag> {
    let mutable diags: Array<CheckDiag> = [];
    let mutable seen: Array<String> = [];
    let entity_names: Array<String> = collect_entity_names(prog);
    let enum_names: Array<String> = collect_enum_names(prog);
    // Pass 1: duplicate-name detection.
    let mutable i: Int = 0;
    while i < len(prog.entities) {
        let e: EntityDecl = prog.entities[i];
        if name_seen(seen, e.name) {
            diags.push(CheckDiag(e.line, e.column, "entity '" + e.name + "' already defined"));
        } else {
            seen.push(e.name);
        }
        i = i + 1;
    }
    // Pass 2: field then method signature-type resolution, per entity.
    let mutable j: Int = 0;
    while j < len(prog.entities) {
        let e2: EntityDecl = prog.entities[j];
        let tps: Array<String> = e2.type_params;
        let mutable fi: Int = 0;
        while fi < len(e2.fields) {
            let fld: FieldDecl = e2.fields[fi];
            let ft: Type = parse_type(fld.type_name);
            if not type_is_known(ft, entity_names, enum_names, tps) {
                diags.push(CheckDiag(fld.line, fld.column, "unknown type '" + ft.name + "'"));
            }
            fi = fi + 1;
        }
        let mutable mi: Int = 0;
        while mi < len(e2.methods) {
            let m: FunctionDecl = e2.methods[mi];
            let sig: Array<CheckDiag> = check_fn_signature_types(m, entity_names, enum_names, tps);
            let mutable si: Int = 0;
            while si < len(sig) {
                diags.push(sig[si]);
                si = si + 1;
            }
            mi = mi + 1;
        }
        j = j + 1;
    }
    return diags;
}

function check_dup_traits(prog: Program) returns Array<CheckDiag> {
    let mutable diags: Array<CheckDiag> = [];
    let mutable seen: Array<String> = [];
    let mutable i: Int = 0;
    while i < len(prog.traits) {
        let t: TraitDecl = prog.traits[i];
        if name_seen(seen, t.name) {
            diags.push(CheckDiag(t.line, t.column, "trait '" + t.name + "' already defined"));
        } else {
            seen.push(t.name);
        }
        i = i + 1;
    }
    return diags;
}

// collect_entity_names / collect_enum_names — the declared entity resp. enum
// names, as parse_type/type_is_known expect them. By registerFunctions time
// (dispatch order enums→entities→traits→functions) stage1's c.entities and
// c.enums hold ALL such names, so the full program lists are correct here.

function collect_entity_names(prog: Program) returns Array<String> {
    let mutable names: Array<String> = [];
    let mutable i: Int = 0;
    while i < len(prog.entities) {
        names.push(prog.entities[i].name);
        i = i + 1;
    }
    return names;
}

function collect_enum_names(prog: Program) returns Array<String> {
    let mutable names: Array<String> = [];
    let mutable i: Int = 0;
    while i < len(prog.enums) {
        names.push(prog.enums[i].name);
        i = i + 1;
    }
    return names;
}

// check_fn_signature_types — emit `unknown type 'BASE'` for any param or return
// annotation on `f` that does not resolve. Mirrors stage1 registerFunctions
// (checker.go:750-769) / registerEntities method resolution (627-656): params
// first (anchored at the param position), then the return type (anchored at the
// function position). BASE is the OUTER ref name (stage1's `ref.Name`) —
// parse_type(...).name. `type_params` is the enclosing declaration's generic
// type parameters (a function's own for a top-level function; the ENTITY's for
// a method, since methods carry none of their own). Phase 46.4.

function check_fn_signature_types(f: FunctionDecl, entity_names: Array<String>, enum_names: Array<String>, type_params: Array<String>) returns Array<CheckDiag> {
    let mutable diags: Array<CheckDiag> = [];
    let mutable i: Int = 0;
    while i < len(f.params) {
        let p: Param = f.params[i];
        let pt: Type = parse_type(p.type_name);
        if not type_is_known(pt, entity_names, enum_names, type_params) {
            diags.push(CheckDiag(p.line, p.column, "unknown type '" + pt.name + "'"));
        }
        i = i + 1;
    }
    if f.return_type != "" {
        let rt: Type = parse_type(f.return_type);
        if not type_is_known(rt, entity_names, enum_names, type_params) {
            diags.push(CheckDiag(f.line, f.column, "unknown type '" + rt.name + "'"));
        }
    }
    return diags;
}

function check_dup_functions(prog: Program) returns Array<CheckDiag> {
    let mutable diags: Array<CheckDiag> = [];
    let mutable seen: Array<String> = [];
    let entity_names: Array<String> = collect_entity_names(prog);
    let enum_names: Array<String> = collect_enum_names(prog);
    let mutable i: Int = 0;
    while i < len(prog.functions) {
        let f: FunctionDecl = prog.functions[i];
        if name_seen(seen, f.name) {
            // stage1 `continue`s on a duplicate — no signature-type resolution.
            diags.push(CheckDiag(f.line, f.column, "function '" + f.name + "' already defined"));
        } else {
            seen.push(f.name);
            let sig_diags: Array<CheckDiag> = check_fn_signature_types(f, entity_names, enum_names, f.type_params);
            let mutable j: Int = 0;
            while j < len(sig_diags) {
                diags.push(sig_diags[j]);
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return diags;
}

// =============================================================================
// CHECK PHASE
// Mirrors stage1 checkFunctions → checkEntities → checkImplBlockBodies →
// checkTests (checker.go lines 118-121). Runs AFTER the register phase so
// register errors always precede check errors.
// =============================================================================

// check_body_stmts walks statements in source order, threading a Scope for
// let-binding and undeclared-variable checks. Emits:
//   - break/continue outside loop (loop_depth == 0)
//   - return inside test body (in_test == true)
//   - undeclared variable (via check_expr_names)
//   - variable already defined in this scope (st_let redefinition)
// Scope threading (pass-by-value, functional reassignment):
//   - st_let: check RHS against current scope, then define name in scope.
//   - st_expr / st_return: check expr against current scope.
//   - st_if: recurse both branches in scope_enter(scope) child scopes.
//   - st_while: check condition, recurse body in scope_enter + loop_depth+1.
//   - st_for: check iterable, recurse body in scope_enter + loop var + depth+1.
// Mirrors stage1 checkStatement (checker.go:1221-1254).

function check_body_stmts(stmts: Array<Stmt>, loop_depth: Int, in_test: Bool, test_name: String, scope: Scope, fn_names: Array<String>, fn_counts: Array<Int>, var_names: Array<String>, var_counts: Array<Int>, entity_names: Array<String>, enum_names: Array<String>, prog: Program) returns Array<CheckDiag> {
    let mutable diags: Array<CheckDiag> = [];
    let mutable cur_scope: Scope = scope;
    let mutable i: Int = 0;
    while i < len(stmts) {
        let s: Stmt = stmts[i];
        if s.kind == shared_ast.st_break() {
            if loop_depth == 0 {
                diags.push(CheckDiag(s.line, s.column, "break statement outside loop"));
            }
        }
        if s.kind == shared_ast.st_continue() {
            if loop_depth == 0 {
                diags.push(CheckDiag(s.line, s.column, "continue statement outside loop"));
            }
        }
        if s.kind == shared_ast.st_return() {
            if in_test {
                diags.push(CheckDiag(s.line, s.column, "'return' is not allowed inside a test body; test \"" + test_name + "\" has implicit Void return"));
            }
            // Check the return value expression (if any — st_return with
            // ex_void has no names to check, but check_expr_names is safe).
            let mutable retd: Array<CheckDiag> = check_expr_names(s.expr, cur_scope, fn_names, fn_counts, var_names, var_counts, prog);
            let mutable reti: Int = 0;
            while reti < len(retd) {
                diags.push(retd[reti]);
                reti = reti + 1;
            }
        }
        if s.kind == shared_ast.st_let() {
            // Order mirrors stage1 checkLetStmt (checker.go:1248-1301), which
            // returns early at each step: redefinition first, then unknown-type,
            // then the RHS + scope bind. A redefinition or an unknown declared
            // type suppresses everything after it (incl. the scope define).
            if scope_resolve_local(cur_scope, s.name) {
                diags.push(CheckDiag(s.line, s.column, "variable '" + s.name + "' already defined in this scope"));
            } else {
                // Unknown declared type. stage1 resolves the `let` annotation
                // with PLAIN ResolveType — NO type params (checker.go:1259) — so
                // a bare generic type param in a `let` does not resolve. Match
                // that: pass an empty type-param list.
                let mutable is_unknown: Bool = false;
                if s.type_name != "" {
                    let no_tp: Array<String> = [];
                    let lt: Type = parse_type(s.type_name);
                    if not type_is_known(lt, entity_names, enum_names, no_tp) {
                        diags.push(CheckDiag(s.line, s.column, "unknown type '" + lt.name + "'"));
                        is_unknown = true;
                    }
                }
                if not is_unknown {
                    // Check RHS against the CURRENT scope (before the name is bound).
                    let mutable rhsd: Array<CheckDiag> = check_expr_names(s.expr, cur_scope, fn_names, fn_counts, var_names, var_counts, prog);
                    let mutable rhsi: Int = 0;
                    while rhsi < len(rhsd) {
                        diags.push(rhsd[rhsi]);
                        rhsi = rhsi + 1;
                    }
                    // Type mismatch (stage1 checkLetStmt:1279): a known declared
                    // type + a confidently-inferred RHS whose type differs →
                    // cannot assign. RHS Unknown → skip (stage1 guards on
                    // valueType != nil, so an undeclared/unknowable RHS is not
                    // also a mismatch). Phase 48c, ADR 0056.
                    if s.type_name != "" {
                        let decl_t: Type = parse_type(s.type_name);
                        let rhs_t: Type = infer_expr_type(s.expr, cur_scope, prog);
                        if not is_unknown_type(rhs_t) {
                            if rhs_t.name != decl_t.name {
                                diags.push(CheckDiag(s.line, s.column, "type mismatch: cannot assign " + rhs_t.name + " to " + decl_t.name));
                            }
                        }
                    }
                    // Bind with the variable's type so later uses resolve: the
                    // declared type when annotated (what stage1 uses, even on a
                    // mismatch), else the inferred RHS type (may be Unknown).
                    // Phase 48d+, ADR 0056.
                    let mutable bind_type: Type = type_unknown();
                    if s.type_name != "" {
                        bind_type = parse_type(s.type_name);
                    } else {
                        bind_type = infer_expr_type(s.expr, cur_scope, prog);
                    }
                    cur_scope = scope_define_typed(cur_scope, s.name, bind_type);
                }
            }
        }
        if s.kind == shared_ast.st_expr() {
            let mutable exprd: Array<CheckDiag> = check_expr_names(s.expr, cur_scope, fn_names, fn_counts, var_names, var_counts, prog);
            let mutable expri: Int = 0;
            while expri < len(exprd) {
                diags.push(exprd[expri]);
                expri = expri + 1;
            }
            // Assignment type-mismatch (stage1 checkAssignStmt:1336). An
            // assignment `target = value` parses as an ex_binop with op "="
            // (children[0]=target, children[1]=value). When both sides are
            // confidently inferred and differ, emit at the statement position
            // (stage1 anchors at the target's start). Phase 48h, ADR 0056.
            if s.expr.kind == shared_ast.ex_binop() {
                if s.expr.name == "=" {
                    let tt: Type = infer_expr_type(s.expr.children[0], cur_scope, prog);
                    let vt: Type = infer_expr_type(s.expr.children[1], cur_scope, prog);
                    if not is_unknown_type(tt) and not is_unknown_type(vt) {
                        if tt.name != vt.name {
                            diags.push(CheckDiag(s.line, s.column, "type mismatch: cannot assign " + vt.name + " to " + tt.name));
                        }
                    }
                }
            }
        }
        // Recurse into if bodies with the SAME loop depth (if does not add depth).
        // Each branch gets its OWN child scope (bindings in then don't leak to else).
        if s.kind == shared_ast.st_if() {
            let mutable cond_d: Array<CheckDiag> = check_expr_names(s.expr, cur_scope, fn_names, fn_counts, var_names, var_counts, prog);
            let mutable cond_i: Int = 0;
            while cond_i < len(cond_d) {
                diags.push(cond_d[cond_i]);
                cond_i = cond_i + 1;
            }
            // Condition must be boolean (stage1 checkIfStmt:1359). Emit only on
            // a confident non-Bool inference; Unknown → skip (stage1 skips when
            // condType == nil). Phase 48b, ADR 0056.
            let if_ct: Type = infer_expr_type(s.expr, cur_scope, prog);
            if not is_unknown_type(if_ct) {
                if if_ct.name != "Bool" {
                    diags.push(CheckDiag(s.line, s.column, "if condition must be boolean, got " + if_ct.name));
                }
            }
            let mutable ttmp: Array<CheckDiag> = check_body_stmts(s.then_block.stmts, loop_depth, in_test, test_name, scope_enter(cur_scope), fn_names, fn_counts, var_names, var_counts, entity_names, enum_names, prog);
            let mutable ti: Int = 0;
            while ti < len(ttmp) {
                diags.push(ttmp[ti]);
                ti = ti + 1;
            }
            if s.has_else {
                let mutable etmp: Array<CheckDiag> = check_body_stmts(s.else_block.stmts, loop_depth, in_test, test_name, scope_enter(cur_scope), fn_names, fn_counts, var_names, var_counts, entity_names, enum_names, prog);
                let mutable ei: Int = 0;
                while ei < len(etmp) {
                    diags.push(etmp[ei]);
                    ei = ei + 1;
                }
            }
        }
        // Recurse into while/for bodies with loop_depth + 1.
        if s.kind == shared_ast.st_while() {
            let mutable wcond_d: Array<CheckDiag> = check_expr_names(s.expr, cur_scope, fn_names, fn_counts, var_names, var_counts, prog);
            let mutable wcond_i: Int = 0;
            while wcond_i < len(wcond_d) {
                diags.push(wcond_d[wcond_i]);
                wcond_i = wcond_i + 1;
            }
            // Condition must be boolean (stage1 checkWhileStmt:1380). Phase 48b.
            let wh_ct: Type = infer_expr_type(s.expr, cur_scope, prog);
            if not is_unknown_type(wh_ct) {
                if wh_ct.name != "Bool" {
                    diags.push(CheckDiag(s.line, s.column, "while condition must be boolean, got " + wh_ct.name));
                }
            }
            let mutable wtmp: Array<CheckDiag> = check_body_stmts(s.then_block.stmts, loop_depth + 1, in_test, test_name, scope_enter(cur_scope), fn_names, fn_counts, var_names, var_counts, entity_names, enum_names, prog);
            let mutable wi: Int = 0;
            while wi < len(wtmp) {
                diags.push(wtmp[wi]);
                wi = wi + 1;
            }
        }
        if s.kind == shared_ast.st_for() {
            // Check the iterable expression against the current scope.
            let mutable iter_d: Array<CheckDiag> = check_expr_names(s.expr, cur_scope, fn_names, fn_counts, var_names, var_counts, prog);
            let mutable iter_i: Int = 0;
            while iter_i < len(iter_d) {
                diags.push(iter_d[iter_i]);
                iter_i = iter_i + 1;
            }
            // Body scope: child scope + loop variable defined (s.name holds
            // the loop var per parse_for_stmt, which sets st_for name=var_tok).
            let mutable for_scope: Scope = scope_define(scope_enter(cur_scope), s.name);
            let mutable ftmp: Array<CheckDiag> = check_body_stmts(s.then_block.stmts, loop_depth + 1, in_test, test_name, for_scope, fn_names, fn_counts, var_names, var_counts, entity_names, enum_names, prog);
            let mutable fti: Int = 0;
            while fti < len(ftmp) {
                diags.push(ftmp[fti]);
                fti = fti + 1;
            }
        }
        i = i + 1;
    }
    return diags;
}

// make_fn_scope — builds the initial scope for a function body: global scope
// entered + all params defined. Mirrors stage1 checkFunction (line 920-940).

function make_fn_scope(f: FunctionDecl, global: Scope) returns Scope {
    let mutable s: Scope = scope_enter(global);
    let mutable i: Int = 0;
    while i < len(f.params) {
        // Phase 48d: seed each param with its declared type so infer_expr_type
        // can resolve the variable when it is used.
        s = scope_define_typed(s, f.params[i].name, parse_type(f.params[i].type_name));
        i = i + 1;
    }
    return s;
}

// make_method_scope — builds the initial scope for a method/constructor body:
// global scope entered + "self" + all params defined. Mirrors stage1
// checkMethod/checkConstructor (lines 1112-1176).

function make_method_scope(f: FunctionDecl, global: Scope, self_type: String) returns Scope {
    let mutable s: Scope = scope_enter(global);
    // Phase 48i: `self` is typed as its enclosing entity so `self.field`
    // resolves through entity_field_type.
    s = scope_define_typed(s, "self", type_named(self_type));
    let mutable i: Int = 0;
    while i < len(f.params) {
        s = scope_define_typed(s, f.params[i].name, parse_type(f.params[i].type_name));
        i = i + 1;
    }
    return s;
}

// check_bool_contracts — contract well-typedness (stage1 checkFunction:945,
// checkMethod:1188, checkConstructor:1135, checkEntity invariants:1071). Each
// clause expression must be Bool; emit `<prefix><T>` at the clause when it is
// confidently inferred to a non-Bool type. Unknown → skip (stage1 guards on
// exprType != nil; a clause using old()/result/quantifiers/calls infers Unknown
// and is not flagged). Recursing the clause for undeclared/arg/operator errors
// is a separate, deferred concern. Phase 48j-b, ADR 0056.

function check_bool_contracts(clauses: Array<Expr>, prefix: String, scope: Scope, prog: Program) returns Array<CheckDiag> {
    let mutable diags: Array<CheckDiag> = [];
    let mutable i: Int = 0;
    while i < len(clauses) {
        let c: Expr = clauses[i];
        let t: Type = infer_expr_type(c, scope, prog);
        if not is_unknown_type(t) {
            if t.name != "Bool" {
                diags.push(CheckDiag(c.line, c.column, prefix + t.name));
            }
        }
        i = i + 1;
    }
    return diags;
}

// check_fn_contracts — requires-then-ensures well-typedness for a function /
// method / constructor decl, evaluated in `scope`. Order (requires before
// ensures) mirrors stage1; decreases clauses are a measure, not boolean, so
// they are not checked.

function check_fn_contracts(f: FunctionDecl, scope: Scope, prog: Program) returns Array<CheckDiag> {
    let mutable diags: Array<CheckDiag> = [];
    let mutable rq: Array<CheckDiag> = check_bool_contracts(f.requires_clauses, "requires clause must be boolean, got ", scope, prog);
    let mutable ri: Int = 0;
    while ri < len(rq) {
        diags.push(rq[ri]);
        ri = ri + 1;
    }
    let mutable en: Array<CheckDiag> = check_bool_contracts(f.ensures_clauses, "ensures clause must be boolean, got ", scope, prog);
    let mutable ei: Int = 0;
    while ei < len(en) {
        diags.push(en[ei]);
        ei = ei + 1;
    }
    return diags;
}

// check_functions walks each top-level function body, mirroring stage1
// checkFunctions (checker.go:907).

function check_functions(prog: Program, global: Scope, fn_names: Array<String>, fn_counts: Array<Int>, var_names: Array<String>, var_counts: Array<Int>) returns Array<CheckDiag> {
    let mutable diags: Array<CheckDiag> = [];
    let mutable i: Int = 0;
    while i < len(prog.functions) {
        let f: FunctionDecl = prog.functions[i];
        // Seed the body scope's async context from the declaration (stage1
        // checkFunction:927 c.inAsyncFunc = fn.IsAsync). Phase 48j-c2d.
        let fn_scope: Scope = scope_set_async(make_fn_scope(f, global), f.is_async);
        // Contracts (requires then ensures) before the body, matching stage1.
        let mutable fcd: Array<CheckDiag> = check_fn_contracts(f, fn_scope, prog);
        let mutable fci: Int = 0;
        while fci < len(fcd) {
            diags.push(fcd[fci]);
            fci = fci + 1;
        }
        let mutable fd: Array<CheckDiag> = check_body_stmts(f.body.stmts, 0, false, "", fn_scope, fn_names, fn_counts, var_names, var_counts, collect_entity_names(prog), collect_enum_names(prog), prog);
        let mutable fi: Int = 0;
        while fi < len(fd) {
            diags.push(fd[fi]);
            fi = fi + 1;
        }
        i = i + 1;
    }
    return diags;
}

// check_entities walks each entity's constructor and methods, mirroring
// stage1 checkEntities (checker.go:1054).

function check_entities(prog: Program, global: Scope, fn_names: Array<String>, fn_counts: Array<Int>, var_names: Array<String>, var_counts: Array<Int>) returns Array<CheckDiag> {
    let mutable diags: Array<CheckDiag> = [];
    let mutable i: Int = 0;
    while i < len(prog.entities) {
        let e: EntityDecl = prog.entities[i];
        // stage1 checkEntities SKIPS generic entities entirely (checker.go:1057):
        // their type params are placeholders, so invariants/contracts/bodies are
        // not checked. Match that (previously stage2 checked generic bodies, an
        // inert difference — they produce no diagnostics; the guard aligns us).
        if len(e.type_params) == 0 {
            // Invariants first (self-only scope, no params). stage1:1068-1086.
            let inv_scope: Scope = scope_define_typed(scope_enter(global), "self", type_named(e.name));
            let mutable invd: Array<CheckDiag> = check_bool_contracts(e.invariants, "invariant must be boolean, got ", inv_scope, prog);
            let mutable invi: Int = 0;
            while invi < len(invd) {
                diags.push(invd[invi]);
                invi = invi + 1;
            }
            // Constructor: contracts (requires/ensures) then body. stage1:1132.
            if e.has_constructor {
                let ctor_scope: Scope = make_method_scope(e.ctor, global, e.name);
                let mutable ccd: Array<CheckDiag> = check_fn_contracts(e.ctor, ctor_scope, prog);
                let mutable cci: Int = 0;
                while cci < len(ccd) {
                    diags.push(ccd[cci]);
                    cci = cci + 1;
                }
                let mutable cd: Array<CheckDiag> = check_body_stmts(e.ctor.body.stmts, 0, false, "", ctor_scope, fn_names, fn_counts, var_names, var_counts, collect_entity_names(prog), collect_enum_names(prog), prog);
                let mutable ci: Int = 0;
                while ci < len(cd) {
                    diags.push(cd[ci]);
                    ci = ci + 1;
                }
            }
            // Methods: each contracts then body. stage1:1185.
            let mutable mi: Int = 0;
            while mi < len(e.methods) {
                let m: FunctionDecl = e.methods[mi];
                let meth_scope: Scope = make_method_scope(m, global, e.name);
                let mutable mcd: Array<CheckDiag> = check_fn_contracts(m, meth_scope, prog);
                let mutable mci: Int = 0;
                while mci < len(mcd) {
                    diags.push(mcd[mci]);
                    mci = mci + 1;
                }
                let mutable md: Array<CheckDiag> = check_body_stmts(m.body.stmts, 0, false, "", meth_scope, fn_names, fn_counts, var_names, var_counts, collect_entity_names(prog), collect_enum_names(prog), prog);
                let mutable mdi: Int = 0;
                while mdi < len(md) {
                    diags.push(md[mdi]);
                    mdi = mdi + 1;
                }
                mi = mi + 1;
            }
        }
        i = i + 1;
    }
    return diags;
}

// check_impl_bodies walks each impl block's method bodies, mirroring stage1
// checkImplBlockBodies (traits.go:206).

function check_impl_bodies(prog: Program, global: Scope, fn_names: Array<String>, fn_counts: Array<Int>, var_names: Array<String>, var_counts: Array<Int>) returns Array<CheckDiag> {
    let mutable diags: Array<CheckDiag> = [];
    let mutable i: Int = 0;
    while i < len(prog.impls) {
        let ib: ImplDecl = prog.impls[i];
        let mutable mi: Int = 0;
        while mi < len(ib.methods) {
            let m: FunctionDecl = ib.methods[mi];
            let meth_scope: Scope = make_method_scope(m, global, ib.entity_name);
            let mutable md: Array<CheckDiag> = check_body_stmts(m.body.stmts, 0, false, "", meth_scope, fn_names, fn_counts, var_names, var_counts, collect_entity_names(prog), collect_enum_names(prog), prog);
            let mutable mdi: Int = 0;
            while mdi < len(md) {
                diags.push(md[mdi]);
                mdi = mdi + 1;
            }
            mi = mi + 1;
        }
        i = i + 1;
    }
    return diags;
}

// check_tests walks each test body, mirroring stage1 checkTests
// (checker.go:975). Return-in-test, break/continue-outside-loop, and
// undeclared-variable all fire here if triggered.

function check_tests(prog: Program, global: Scope, fn_names: Array<String>, fn_counts: Array<Int>, var_names: Array<String>, var_counts: Array<Int>) returns Array<CheckDiag> {
    let mutable diags: Array<CheckDiag> = [];
    let mutable i: Int = 0;
    while i < len(prog.tests) {
        let t: TestDecl = prog.tests[i];
        // Async tests set the context too (stage1 checkTest:1002
        // c.inAsyncFunc = t.IsAsync). Phase 48j-c2d.
        let test_scope: Scope = scope_set_async(scope_enter(global), t.is_async);
        let mutable td: Array<CheckDiag> = check_body_stmts(t.body.stmts, 0, true, t.name, test_scope, fn_names, fn_counts, var_names, var_counts, collect_entity_names(prog), collect_enum_names(prog), prog);
        let mutable tdi: Int = 0;
        while tdi < len(td) {
            diags.push(td[tdi]);
            tdi = tdi + 1;
        }
        i = i + 1;
    }
    return diags;
}

// =============================================================================
// MAIN DISPATCH
// Two-phase: register then check — matching stage1 Check() emit order.
// =============================================================================

public function check_program(prog: Program) returns Array<CheckDiag> {
    let mutable diags: Array<CheckDiag> = [];

    // --- Register phase -------------------------------------------------------
    let mutable enums_d: Array<CheckDiag> = check_dup_enums(prog);
    let mutable ei: Int = 0;
    while ei < len(enums_d) {
        diags.push(enums_d[ei]);
        ei = ei + 1;
    }
    let mutable ents_d: Array<CheckDiag> = check_dup_entities(prog);
    let mutable enti: Int = 0;
    while enti < len(ents_d) {
        diags.push(ents_d[enti]);
        enti = enti + 1;
    }
    let mutable traits_d: Array<CheckDiag> = check_dup_traits(prog);
    let mutable ti: Int = 0;
    while ti < len(traits_d) {
        diags.push(traits_d[ti]);
        ti = ti + 1;
    }
    let mutable fns_d: Array<CheckDiag> = check_dup_functions(prog);
    let mutable fi: Int = 0;
    while fi < len(fns_d) {
        diags.push(fns_d[fi]);
        fi = fi + 1;
    }

    // --- Check phase ----------------------------------------------------------
    // Build the global scope and arity registries once; all body walkers share.
    // Builtin arity (assert/len/etc.) and method arity are deferred.
    // Order mirrors stage1: checkFunctions → checkEntities →
    // checkImplBlockBodies → checkTests (checker.go lines 118-121).
    let global: Scope = build_global_scope(prog);
    let fn_names: Array<String> = build_fn_arity_names(prog);
    let fn_counts: Array<Int> = build_fn_arity_counts(prog);
    let var_names: Array<String> = build_variant_arity_names(prog);
    let var_counts: Array<Int> = build_variant_arity_counts(prog);
    let mutable fn_d: Array<CheckDiag> = check_functions(prog, global, fn_names, fn_counts, var_names, var_counts);
    let mutable fni: Int = 0;
    while fni < len(fn_d) {
        diags.push(fn_d[fni]);
        fni = fni + 1;
    }
    let mutable ent_d: Array<CheckDiag> = check_entities(prog, global, fn_names, fn_counts, var_names, var_counts);
    let mutable enti2: Int = 0;
    while enti2 < len(ent_d) {
        diags.push(ent_d[enti2]);
        enti2 = enti2 + 1;
    }
    let mutable impl_d: Array<CheckDiag> = check_impl_bodies(prog, global, fn_names, fn_counts, var_names, var_counts);
    let mutable impli: Int = 0;
    while impli < len(impl_d) {
        diags.push(impl_d[impli]);
        impli = impli + 1;
    }
    let mutable tests_d: Array<CheckDiag> = check_tests(prog, global, fn_names, fn_counts, var_names, var_counts);
    let mutable tdi: Int = 0;
    while tdi < len(tests_d) {
        diags.push(tests_d[tdi]);
        tdi = tdi + 1;
    }

    return diags;
}
