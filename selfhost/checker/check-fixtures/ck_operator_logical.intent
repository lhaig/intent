// check-fixtures/ck_operator_logical.intent — Phase 48e / binary operator typing.
// Logical ops use the "requires boolean operands" shape.
// stage1: operator 'AND' requires boolean operands, got Int and Bool
module ck_operator_logical version "0.1.0";

function f(a: Int, b: Bool) returns Void {
    let c: Bool = a and b;
}
