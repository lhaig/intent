// check-fixtures/ck_builtin_assert_eq_float.intent — Phase 48j-c2c.
// Matching-type args that are Float fall into the assert_eq comparable-set
// rejection (Float is not comparable; use assert_close).
// stage1: assert_eq does not support Float; use assert_close(actual, expected, epsilon) for floating-point comparisons
module ck_builtin_assert_eq_float version "0.1.0";

function f() returns Void {
    assert_eq(1.0, 2.0);
}
