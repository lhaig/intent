// selfhost/formatter/ast.intent — Phase 36 / ADR 0040 stage2.
//
// AST entity declarations + kind constants + AST-side helpers, split out
// from parser.intent at the start of Phase 36. The split is motivated by
// parser.intent growing past 1400 LOC; adding 7 more declaration entities
// in this phase would push that to ~2000 LOC and make the file hard to
// navigate. Keeping AST types here, parsing logic in parser.intent.
//
// Design notes (apply to every entity defined below):
//   - Each AST node is one entity with an Int `kind` discriminator + the
//     fields used by all kinds it represents. Mirrors how Token uses
//     `kind: Int` in the lexer. Intent enums with payloads would force
//     every field access through a match arm (each arm being a single
//     expression), so a sum-typed Stmt/Expr would be awkward to consume.
//   - Mutually-recursive sizing is safe because nested children are
//     reached via Array<...> (heap-allocated). Stmt/Block, Expr/Expr,
//     and EntityDecl/FunctionDecl/Block all participate.
//   - Unused fields per kind are populated with defaults ("" / false /
//     empty_block() / empty_expr()). Wasteful but uniform; same trade
//     Token already makes.
module shared_ast version "0.1.0";

// --- Statement kind constants -----------------------------------------------
public function st_let() returns Int {
    return 1;
}

public function st_return() returns Int {
    return 2;
}

public function st_if() returns Int {
    return 3;
}

public function st_while() returns Int {
    return 4;
}

public function st_expr() returns Int {
    return 5;
}

public function st_for() returns Int {
    return 6;
} // Phase 41.3: name=loop var, expr=iterable, then_block=body

// --- Expression kind constants ----------------------------------------------
public function ex_void() returns Int {
    return 0;
} // placeholder for absent expr (e.g. `return;`)

public function ex_int() returns Int {
    return 1;
}

public function ex_string() returns Int {
    return 2;
}

public function ex_bool() returns Int {
    return 3;
}

public function ex_ident() returns Int {
    return 4;
}

public function ex_unary() returns Int {
    return 5;
} // children=[operand], name=op

public function ex_binop() returns Int {
    return 6;
} // children=[lhs, rhs], name=op

public function ex_call() returns Int {
    return 7;
} // children=[callee, arg1..argN]

public function ex_index() returns Int {
    return 8;
} // children=[object, index]

public function ex_field() returns Int {
    return 9;
} // children=[object], name=field

public function ex_array() returns Int {
    return 10;
} // children=[elem1..elemN]

public function ex_range() returns Int {
    return 11;
} // children=[start, end]

public function ex_paren() returns Int {
    return 12;
} // children=[inner]

public function ex_float() returns Int {
    return 13;
} // str_value = raw lexeme (e.g. "3.14", "1.5e-3")

public function ex_char() returns Int {
    return 14;
} // str_value = raw lexeme including quotes (e.g. "'a'", "'\\n'")

public function ex_match() returns Int {
    return 15;
} // children=[scrutinee], match_arms=[...] (Phase 41.2)

public function ex_try() returns Int {
    return 16;
} // children=[inner]; the try operator `inner?` (Phase 41.4)

public function ex_await() returns Int {
    return 17;
} // children=[inner]; prefix `await <inner>` (Phase 42)

public function ex_spawn() returns Int {
    return 18;
} // children=[inner]; prefix `spawn <inner>` (Phase 42)

public function ex_forall() returns Int {
    return 19;
} // name=var, children=[domain, body]; `forall var in domain: body` (Phase 43)

public function ex_exists() returns Int {
    return 20;
} // name=var, children=[domain, body]; `exists var in domain: body` (Phase 43)

public function ex_lambda() returns Int {
    return 21;
} // lambda_params=params, str_value=return type, children=[body]; `|p: T| -> R => body` (Phase 44)

// --- Shared AST entities ----------------------------------------------------
public entity Param {
    field name: String;
    field type_name: String;
    field line: Int;
    field column: Int;

    constructor(name: String, type_name: String) {
        self.name = name;
        self.type_name = type_name;
        self.line = 0;
        self.column = 0;
    }
}

// Expression node. Field usage by kind:
//   ex_void    — no fields set
//   ex_int     — int_value
//   ex_string  — str_value (unquoted, escapes still raw)
//   ex_bool    — bool_value
//   ex_ident   — name
//   ex_unary   — name (op), children=[operand]
//   ex_binop   — name (op), children=[lhs, rhs]
//   ex_call    — children=[callee, arg1..argN]
//   ex_index   — children=[object, index]
//   ex_field   — name (field), children=[object]
//   ex_array   — children=[elem1..elemN]
//   ex_range   — children=[start, end]
//   ex_paren   — children=[inner]
//   ex_float   — str_value (raw lexeme; formatter round-trips as-is)
//   ex_char    — str_value (raw lexeme with quotes; formatter round-trips as-is)
public entity Expr {
    field kind: Int;
    field int_value: Int;
    field str_value: String;
    field bool_value: Bool;
    field name: String;
    field children: Array<Expr>;
    // Phase 41.2: arms of an `ex_match` expression (children[0] is the
    // scrutinee). Empty for every other kind; defaulted in the constructor
    // body so the existing Expr(...) call sites don't change.
    field match_arms: Array<MatchArm>;
    // Phase 44: parameters of an `ex_lambda` expression. Empty for every other
    // kind; defaulted in the constructor body so existing call sites don't change.
    field lambda_params: Array<Param>;

    constructor(kind: Int, int_value: Int, str_value: String, bool_value: Bool, name: String, children: Array<Expr>) {
        self.kind = kind;
        self.int_value = int_value;
        self.str_value = str_value;
        self.bool_value = bool_value;
        self.name = name;
        self.children = children;
        self.match_arms = empty_matcharm_array();
        self.lambda_params = empty_param_array();
    }
}

// One arm of a match expression: `<pattern> => <body>`. The pattern is either
// the wildcard `_` (is_wildcard), a bare variant (`Ok` / `None`), or a variant
// with bindings (`Ok(value)`, `Pair(a, b)`).
public entity MatchArm {
    field variant: String;
    field bindings: Array<String>;
    field is_wildcard: Bool;
    field body: Expr;

    constructor(variant: String, bindings: Array<String>, is_wildcard: Bool, body: Expr) {
        self.variant = variant;
        self.bindings = bindings;
        self.is_wildcard = is_wildcard;
        self.body = body;
    }
}

// Statement node. Field usage by kind:
//   st_let    — name, type_name, is_mutable, expr (rhs)
//   st_return — expr (may be ex_void for `return;`)
//   st_expr   — expr
//   st_if     — expr (condition), then_block, else_block, has_else
//   st_while  — expr (condition), then_block (body)
public entity Stmt {
    field kind: Int;
    field expr: Expr;
    field name: String;
    field type_name: String;
    field is_mutable: Bool;
    field then_block: Block;
    field else_block: Block;
    field has_else: Bool;
    // ADR 0044: leading comments captured by the lexer at the statement's
    // first token. Populated by parse_block from Token.comments_before.
    // The formatter emits these on their own lines before each statement.
    field comments_before: Array<String>;
    // ADR 0044 (Phase 40A.2): inline comment after this statement's `;`
    // (same line). Empty = none.
    field comment_after: String;
    field line: Int;
    field column: Int;

    constructor(kind: Int, expr: Expr, name: String, type_name: String, is_mutable: Bool, then_block: Block, else_block: Block, has_else: Bool) {
        self.kind = kind;
        self.expr = expr;
        self.name = name;
        self.type_name = type_name;
        self.is_mutable = is_mutable;
        self.then_block = then_block;
        self.else_block = else_block;
        self.has_else = has_else;
        self.comments_before = empty_string_array();
        self.comment_after = "";
        self.line = 0;
        self.column = 0;
    }
}

public entity Block {
    field stmts: Array<Stmt>;
    // ADR 0044 (Phase 40A.3): comments at the end of the block, before the
    // closing `}` (they attach to the rbrace token). Defaulted; parse_block
    // assigns from the rbrace token's comments_before.
    field trailing_comments: Array<String>;
    // ADR 0044 (Phase 40A.3): an inline comment on the same line as the
    // closing `}` (the rbrace token's comment_after), e.g. a one-liner
    // `function f() { return 1; } // note`. Empty = none.
    field brace_comment_after: String;

    constructor(stmts: Array<Stmt>) {
        self.stmts = stmts;
        self.trailing_comments = empty_string_array();
        self.brace_comment_after = "";
    }
}

// FunctionDecl is reused for top-level functions, entity methods, entity
// constructors, and impl methods. The `is_constructor` flag distinguishes
// constructor bodies (no return type) from methods.
//
// `line` is populated by the parser from the leading keyword's source line
// (1-based). It's used by the formatter to merge declarations across kinds
// in source order — ADR 0042. For methods / constructors / impl methods,
// `line` is still populated for consistency but isn't used by the
// top-level merge (those are emitted as part of their enclosing decl).
public entity FunctionDecl {
    field name: String;
    field is_public: Bool;
    field is_entry: Bool;
    field is_async: Bool;
    field is_constructor: Bool;
    field params: Array<Param>;
    field return_type: String;
    field body: Block;
    field line: Int;
    field column: Int;
    // ADR 0044: leading comments captured by the lexer at the decl's first
    // token. Populated by the parser from `Token.comments_before`. The
    // formatter emits these on their own lines before each decl.
    field comments_before: Array<String>;
    // Phase 41.1: contract clauses on functions / methods. Each is the
    // predicate Expr of a `requires` / `ensures` / `decreases` clause.
    // Defaulted empty; the parser assigns them after construction. The
    // formatter emits them between the signature and the opening `{`.
    field requires_clauses: Array<Expr>;
    field ensures_clauses: Array<Expr>;
    field decreases_clauses: Array<Expr>;
    // Phase 44: generic type parameters on the declaration, e.g. `<T>` in
    // `function id<T>(x: T) returns T`. Defaulted empty; the parser assigns
    // them after the name token when a `<` follows. Methods do NOT carry type
    // params (only top-level functions and entity decls do).
    field type_params: Array<String>;
    // Phase 43.9: source positions of each type parameter (parallel arrays).
    // type_params[i] ↔ type_param_lines[i] ↔ type_param_columns[i].
    // Defaulted empty; the parser assigns them alongside type_params.
    field type_param_lines: Array<Int>;
    field type_param_columns: Array<Int>;

    constructor(name: String, is_public: Bool, is_entry: Bool, is_async: Bool, is_constructor: Bool, params: Array<Param>, return_type: String, body: Block, line: Int, comments_before: Array<String>) {
        self.name = name;
        self.is_public = is_public;
        self.is_entry = is_entry;
        self.is_async = is_async;
        self.is_constructor = is_constructor;
        self.params = params;
        self.return_type = return_type;
        self.body = body;
        self.line = line;
        self.comments_before = comments_before;
        self.requires_clauses = empty_expr_array();
        self.ensures_clauses = empty_expr_array();
        self.decreases_clauses = empty_expr_array();
        self.type_params = empty_string_array();
        self.type_param_lines = empty_int_array();
        self.type_param_columns = empty_int_array();
        self.column = 0;
    }
}

public entity ImportDecl {
    field is_package: Bool;
    field path: String;
    field line: Int;
    field column: Int;
    field comments_before: Array<String>;

    constructor(is_package: Bool, path: String, line: Int, comments_before: Array<String>) {
        self.is_package = is_package;
        self.path = path;
        self.line = line;
        self.comments_before = comments_before;
        self.column = 0;
    }
}

public entity ModuleDecl {
    field name: String;
    field module_version: String;
    // ADR 0044 (Phase 40A.3): file-header comments before the `module`
    // keyword. Defaulted empty; parse_module_decl assigns from the module
    // token's comments_before. Emitted before the module line by the formatter.
    field comments_before: Array<String>;

    constructor(name: String, module_version: String) {
        self.name = name;
        self.module_version = module_version;
        self.comments_before = empty_string_array();
    }
}

// --- Declaration entities added in Phase 36 ---------------------------------
public entity FieldDecl {
    field name: String;
    field type_name: String;
    // ADR 0044 (Phase 40A.3): leading comments before this field, and an
    // inline comment after its `;`. Defaulted; the parser assigns them.
    field comments_before: Array<String>;
    field comment_after: String;

    constructor(name: String, type_name: String) {
        self.name = name;
        self.type_name = type_name;
        self.comments_before = empty_string_array();
        self.comment_after = "";
    }
}

// Entity declaration. Constructors and methods are both stored as
// FunctionDecl (the constructor with is_constructor=true). Invariants
// are the boolean Exprs found inside `invariant { ... }` blocks.
public entity EntityDecl {
    field name: String;
    field is_public: Bool;
    field fields: Array<FieldDecl>;
    field methods: Array<FunctionDecl>;
    field has_constructor: Bool;
    field ctor: FunctionDecl;
    field invariants: Array<Expr>;
    field line: Int;
    field column: Int;
    field comments_before: Array<String>;
    // Phase 44: generic type parameters on the entity declaration, e.g. `<T>`
    // in `entity Stack<T> { ... }`. Defaulted empty; the parser assigns them
    // after the name token when a `<` follows.
    field type_params: Array<String>;
    // Phase 43.9: source positions of each type parameter (parallel arrays).
    // type_params[i] ↔ type_param_lines[i] ↔ type_param_columns[i].
    // Defaulted empty; the parser assigns them alongside type_params.
    field type_param_lines: Array<Int>;
    field type_param_columns: Array<Int>;

    constructor(name: String, is_public: Bool, fields: Array<FieldDecl>, methods: Array<FunctionDecl>, has_constructor: Bool, ctor: FunctionDecl, invariants: Array<Expr>, line: Int, comments_before: Array<String>) {
        self.name = name;
        self.is_public = is_public;
        self.fields = fields;
        self.methods = methods;
        self.has_constructor = has_constructor;
        self.ctor = ctor;
        self.invariants = invariants;
        self.line = line;
        self.comments_before = comments_before;
        self.type_params = empty_string_array();
        self.type_param_lines = empty_int_array();
        self.type_param_columns = empty_int_array();
        self.column = 0;
    }
}

public entity EnumVariant {
    field name: String;
    field params: Array<Param>; // empty for unit variants
    field line: Int;
    field column: Int;

    constructor(name: String, params: Array<Param>) {
        self.name = name;
        self.params = params;
        self.line = 0;
        self.column = 0;
    }
}

public entity EnumDecl {
    field name: String;
    field is_public: Bool;
    field variants: Array<EnumVariant>;
    field line: Int;
    field column: Int;
    field comments_before: Array<String>;

    constructor(name: String, is_public: Bool, variants: Array<EnumVariant>, line: Int, comments_before: Array<String>) {
        self.name = name;
        self.is_public = is_public;
        self.variants = variants;
        self.line = line;
        self.comments_before = comments_before;
        self.column = 0;
    }
}

// Trait method signature: same shape as FunctionDecl minus the body and
// the modifier flags that don't apply.
public entity TraitMethodSig {
    field name: String;
    field params: Array<Param>;
    field return_type: String;
    field line: Int;
    field column: Int;

    constructor(name: String, params: Array<Param>, return_type: String) {
        self.name = name;
        self.params = params;
        self.return_type = return_type;
        self.line = 0;
        self.column = 0;
    }
}

public entity TraitDecl {
    field name: String;
    field is_public: Bool;
    field methods: Array<TraitMethodSig>;
    field line: Int;
    field column: Int;
    field comments_before: Array<String>;

    constructor(name: String, is_public: Bool, methods: Array<TraitMethodSig>, line: Int, comments_before: Array<String>) {
        self.name = name;
        self.is_public = is_public;
        self.methods = methods;
        self.line = line;
        self.comments_before = comments_before;
        self.column = 0;
    }
}

public entity ImplDecl {
    field trait_name: String;
    field entity_name: String;
    field methods: Array<FunctionDecl>;
    field line: Int;
    field column: Int;
    field comments_before: Array<String>;

    constructor(trait_name: String, entity_name: String, methods: Array<FunctionDecl>, line: Int, comments_before: Array<String>) {
        self.trait_name = trait_name;
        self.entity_name = entity_name;
        self.methods = methods;
        self.line = line;
        self.comments_before = comments_before;
        self.column = 0;
    }
}

public entity IntentBlock {
    // `goal` / `verified_by` are Intent reserved words inside the surface
    // grammar's `intent { ... }` block; renamed here to avoid collision
    // when this file is itself parsed.
    field description: String;
    field goals: Array<String>;
    field constraints: Array<String>;
    field guarantees: Array<String>;
    field verifications: Array<String>;
    field line: Int;
    field column: Int;
    field comments_before: Array<String>;

    constructor(description: String, goals: Array<String>, constraints: Array<String>, guarantees: Array<String>, verifications: Array<String>, line: Int, comments_before: Array<String>) {
        self.description = description;
        self.goals = goals;
        self.constraints = constraints;
        self.guarantees = guarantees;
        self.verifications = verifications;
        self.line = line;
        self.comments_before = comments_before;
        self.column = 0;
    }
}

public entity TestDecl {
    field name: String;
    field body: Block;
    field line: Int;
    field column: Int;
    field comments_before: Array<String>;
    // Phase 42: `async test "..." { ... }` — the async modifier.
    field is_async: Bool;
    // Phase 44: `@name("arg", ...)` annotations before the test keyword.
    // Each element is the full canonical annotation string, e.g. `@target_specific("rust", "js")`.
    field annotations: Array<String>;

    constructor(name: String, body: Block, line: Int, comments_before: Array<String>) {
        self.name = name;
        self.body = body;
        self.line = line;
        self.comments_before = comments_before;
        self.is_async = false;
        self.annotations = empty_string_array();
        self.column = 0;
    }
}

public entity ExternDecl {
    field target: String; // unquoted: "rust", "js", etc.
    field func_name: String;
    field params: Array<Param>;
    field return_type: String;
    field line: Int;
    field column: Int;
    field comments_before: Array<String>;

    constructor(target: String, func_name: String, params: Array<Param>, return_type: String, line: Int, comments_before: Array<String>) {
        self.target = target;
        self.func_name = func_name;
        self.params = params;
        self.return_type = return_type;
        self.line = line;
        self.comments_before = comments_before;
        self.column = 0;
    }
}

// Program now holds parallel arrays per top-level declaration kind. Source
// order across kinds is not preserved at this layer — Phase 37 (formatter)
// will need either to attach line/column to each decl or move to a single
// Array<TopLevelDecl> sequence. Per-kind arrays match Phase 33's pattern
// for `imports` / `functions` and keep this phase's diff narrow.
public entity Program {
    field module_decl: ModuleDecl;
    field imports: Array<ImportDecl>;
    field functions: Array<FunctionDecl>;
    field entities: Array<EntityDecl>;
    field enums: Array<EnumDecl>;
    field traits: Array<TraitDecl>;
    field impls: Array<ImplDecl>;
    field intent_blocks: Array<IntentBlock>;
    field tests: Array<TestDecl>;
    field externs: Array<ExternDecl>;
    // ADR 0044 (Phase 40A.2): comments that follow the last declaration,
    // before end-of-file. The lexer attaches these to the synthetic EOF
    // token's `comments_before`; the parser drains them here. The formatter
    // emits them after the k-way merge so a file that ends in a comment
    // round-trips.
    field trailing_comments: Array<String>;
    field error: String;

    constructor(module_decl: ModuleDecl, imports: Array<ImportDecl>, functions: Array<FunctionDecl>, entities: Array<EntityDecl>, enums: Array<EnumDecl>, traits: Array<TraitDecl>, impls: Array<ImplDecl>, intent_blocks: Array<IntentBlock>, tests: Array<TestDecl>, externs: Array<ExternDecl>, trailing_comments: Array<String>, error: String) {
        self.module_decl = module_decl;
        self.imports = imports;
        self.functions = functions;
        self.entities = entities;
        self.enums = enums;
        self.traits = traits;
        self.impls = impls;
        self.intent_blocks = intent_blocks;
        self.tests = tests;
        self.externs = externs;
        self.trailing_comments = trailing_comments;
        self.error = error;
    }
}

// --- Helpers ----------------------------------------------------------------
// Helper to initialise an empty Array<String>. Used by Stmt.comments_before
// — mirrors the same function in shared_lexer so that Stmt's constructor
// body can initialise the field without a module prefix.
public function empty_string_array() returns Array<String> {
    let mutable a: Array<String> = [];
    return a;
}

// Empty Array<Expr> — used to default FunctionDecl's contract-clause fields
// (Phase 41.1) without a bare `[]` literal whose element type can't be
// inferred at the assignment site.
public function empty_expr_array() returns Array<Expr> {
    let mutable a: Array<Expr> = [];
    return a;
}

// Empty Array<MatchArm> — defaults Expr.match_arms (Phase 41.2).
public function empty_matcharm_array() returns Array<MatchArm> {
    let mutable a: Array<MatchArm> = [];
    return a;
}

// Empty Array<Param> — defaults Expr.lambda_params (Phase 44).
public function empty_param_array() returns Array<Param> {
    let mutable a: Array<Param> = [];
    return a;
}

// Empty Array<Int> — defaults FunctionDecl/EntityDecl type_param_lines and
// type_param_columns (Phase 43.9).
public function empty_int_array() returns Array<Int> {
    let mutable a: Array<Int> = [];
    return a;
}

// Empty Block constructor (avoids a bare `Block([])` literal where the
// element type cannot be inferred at the call site).
public function empty_block() returns Block {
    let mutable s: Array<Stmt> = [];
    return Block(s);
}

// Placeholder Expr for absent expressions (e.g. `return;`). kind == ex_void.
public function empty_expr() returns Expr {
    let mutable c: Array<Expr> = [];
    return Expr(ex_void(), 0, "", false, "", c);
}

// Placeholder FunctionDecl for the `ctor` field on entities that don't
// have a constructor.
public function empty_function_decl() returns FunctionDecl {
    let mutable params: Array<Param> = [];
    let mutable empty_cmts: Array<String> = [];
    return FunctionDecl("", false, false, false, false, params, "", empty_block(), 0, empty_cmts);
}

// Parses a decimal integer-literal token's text into an Int. The stage2
// lexer only emits tk_int for runs of digit characters, so input is
// assumed well-formed. Negative numbers reach this via unary minus in
// the expression parser, not via a sign in the token text.
public function parse_int(text: String) returns Int {
    let mutable n: Int = 0;
    let mutable i: Int = 0;
    let zero_cp: Int = '0'.to_codepoint();
    while i < len(text) {
        let c: Char = text[i];
        if c.is_digit() {
            n = n * 10 + (c.to_codepoint() - zero_cp);
        }
        i = i + 1;
    }
    return n;
}

// Builds an empty Program with the given module declaration. Useful for
// parsers that want to accumulate decls into a starter Program.
public function empty_program(module_decl: ModuleDecl) returns Program {
    let mutable imps: Array<ImportDecl> = [];
    let mutable fns: Array<FunctionDecl> = [];
    let mutable ents: Array<EntityDecl> = [];
    let mutable enums_a: Array<EnumDecl> = [];
    let mutable traits_a: Array<TraitDecl> = [];
    let mutable impls_a: Array<ImplDecl> = [];
    let mutable ibs: Array<IntentBlock> = [];
    let mutable tsts: Array<TestDecl> = [];
    let mutable exts: Array<ExternDecl> = [];
    let mutable trailing: Array<String> = [];
    return Program(module_decl, imps, fns, ents, enums_a, traits_a, impls_a, ibs, tsts, exts, trailing, "");
}

// No entry function here — when this file is itself the entry of
// `intentc test`, the runner synthesises one. When imported by
// parser.intent, the entry lives there (same pattern as lexer.intent).
