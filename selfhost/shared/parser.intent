module shared_parser version "0.1.0";

import "../shared/lexer.intent";

import "../shared/ast.intent";

public entity Parser {
    field tokens: Array<Token>;
    field position: Int;
    field error: String;
    // Phase 43.9: scratch arrays populated by parse_type_param_list; assigned
    // to type_param_lines / type_param_columns on FunctionDecl and EntityDecl.
    field tp_lines: Array<Int>;
    field tp_columns: Array<Int>;

    constructor(source: String) {
        self.tokens = shared_lexer.lex(source);
        self.position = 0;
        self.error = "";
        self.tp_lines = shared_ast.empty_int_array();
        self.tp_columns = shared_ast.empty_int_array();
    }

    method at_end() returns Bool {
        return self.peek_kind() == shared_lexer.tk_eof();
    }

    method peek_kind() returns Int {
        return self.tokens[self.position].kind;
    }

    method peek_text() returns String {
        return self.tokens[self.position].text;
    }

    method peek_n(n: Int) returns Int {
        let idx: Int = self.position + n;
        if idx >= len(self.tokens) {
            return shared_lexer.tk_eof();
        }
        return self.tokens[idx].kind;
    }

    method advance() returns Token {
        let tok: Token = self.tokens[self.position];
        if self.position < len(self.tokens) - 1 {
            self.position = self.position + 1;
        }
        return tok;
    }

    method check(kind: Int) returns Bool {
        return self.peek_kind() == kind;
    }

    method check_consume(kind: Int) returns Bool {
        if self.check(kind) {
            self.advance();
            return true;
        }
        return false;
    }

    method fail(message: String) returns String {
        if self.error == "" {
            let tok: Token = self.tokens[self.position];
            self.error = "line " + tok.line.to_string() + " col " + tok.column.to_string() + ": " + message;
        }
        if not self.at_end() {
            self.advance();
        }
        return "";
    }

    method expect(kind: Int, what: String) returns Token {
        if self.check(kind) {
            return self.advance();
        }
        self.fail("expected " + what);
        return self.tokens[self.position];
    }

    method unquote(text: String) returns String {
        let n: Int = len(text);
        if n < 2 {
            return text;
        }
        return text[1..n - 1];
    }

    method parse_module_decl() returns ModuleDecl {
        let module_tok: Token = self.expect(shared_lexer.kw_module(), "'module' keyword");
        let name_tok: Token = self.expect(shared_lexer.tk_ident(), "module name");
        self.expect(shared_lexer.kw_version(), "'version' keyword");
        let ver_tok: Token = self.expect(shared_lexer.tk_string(), "version string literal");
        self.expect(shared_lexer.tk_semicolon(), "';' after module declaration");
        let mutable md: ModuleDecl = ModuleDecl(name_tok.text, self.unquote(ver_tok.text));
        md.comments_before = module_tok.comments_before;
        return md;
    }

    method parse_import_decl(leading_comments: Array<String>) returns ImportDecl {
        let import_tok: Token = self.expect(shared_lexer.kw_import_marker(), "'import' keyword");
        let line: Int = import_tok.line;
        let cmts: Array<String> = leading_comments;
        if self.check(shared_lexer.tk_string()) {
            let path_tok: Token = self.advance();
            self.expect(shared_lexer.tk_semicolon(), "';' after import");
            let mutable imp: ImportDecl = ImportDecl(false, self.unquote(path_tok.text), line, cmts);
            imp.column = import_tok.column;
            return imp;
        }
        if self.check(shared_lexer.tk_ident()) {
            let pkg_tok: Token = self.advance();
            let mutable path: String = pkg_tok.text;
            while self.check_consume(shared_lexer.tk_dot()) {
                if self.check(shared_lexer.tk_ident()) {
                    let seg: Token = self.advance();
                    path = path + "." + seg.text;
                } else {
                    self.fail("expected identifier after '.' in import");
                    let mutable imp_err: ImportDecl = ImportDecl(true, path, line, cmts);
                    imp_err.column = import_tok.column;
                    return imp_err;
                }
            }
            self.expect(shared_lexer.tk_semicolon(), "';' after import");
            let mutable imp_pkg: ImportDecl = ImportDecl(true, path, line, cmts);
            imp_pkg.column = import_tok.column;
            return imp_pkg;
        }
        self.fail("expected string or identifier after 'import'");
        let mutable imp_fail: ImportDecl = ImportDecl(false, "", line, cmts);
        imp_fail.column = import_tok.column;
        return imp_fail;
    }

    method parse_param() returns Param {
        let name_tok: Token = self.expect(shared_lexer.tk_ident(), "parameter name");
        self.expect(shared_lexer.tk_colon(), "':' after parameter name");
        let type_name: String = self.parse_type_name();
        let mutable p: Param = Param(name_tok.text, type_name);
        p.line = name_tok.line;
        p.column = name_tok.column;
        return p;
    }

    method parse_type_param_list() returns Array<String> {
        let mutable params: Array<String> = [];
        self.tp_lines = shared_ast.empty_int_array();
        self.tp_columns = shared_ast.empty_int_array();
        if not self.check(shared_lexer.tk_lt()) {
            return params;
        }
        self.advance();
        if self.check(shared_lexer.tk_ident()) {
            let first: Token = self.advance();
            params.push(first.text);
            self.tp_lines.push(first.line);
            self.tp_columns.push(first.column);
            while self.check_consume(shared_lexer.tk_comma()) {
                if self.check(shared_lexer.tk_ident()) {
                    let next: Token = self.advance();
                    params.push(next.text);
                    self.tp_lines.push(next.line);
                    self.tp_columns.push(next.column);
                } else {
                    self.fail("expected type parameter name after ','");
                    return params;
                }
            }
        }
        self.expect(shared_lexer.tk_gt(), "'>' to close type parameter list");
        return params;
    }

    method lookahead_is_generic_call() returns Bool {
        let start: Int = self.position + 1;
        let mutable depth: Int = 1;
        let mutable i: Int = start;
        while depth > 0 and i < len(self.tokens) {
            let k: Int = self.tokens[i].kind;
            if k == shared_lexer.tk_lt() {
                depth = depth + 1;
            } else {
                if k == shared_lexer.tk_gt() {
                    depth = depth - 1;
                } else {
                    if k == shared_lexer.tk_eof() {
                        return false;
                    }
                }
            }
            i = i + 1;
        }
        if depth != 0 {
            return false;
        }
        if i >= len(self.tokens) {
            return false;
        }
        return self.tokens[i].kind == shared_lexer.tk_lparen();
    }

    method consume_generic_type_args() returns String {
        self.advance();
        let mutable s: String = "<";
        let mutable depth: Int = 1;
        while depth > 0 and not self.at_end() {
            if self.check(shared_lexer.tk_lt()) {
                self.advance();
                s = s + "<";
                depth = depth + 1;
            } else {
                if self.check(shared_lexer.tk_gt()) {
                    self.advance();
                    depth = depth - 1;
                    if depth > 0 {
                        s = s + ">";
                    }
                } else {
                    if self.check(shared_lexer.tk_comma()) {
                        self.advance();
                        s = s + ", ";
                    } else {
                        let inner: Token = self.advance();
                        s = s + inner.text;
                    }
                }
            }
        }
        s = s + ">";
        return s;
    }

    method parse_type_name() returns String {
        let tok: Token = self.advance();
        let mutable name: String = tok.text;
        // Phase 44: `Fn(T1, T2) -> R` function type.
        if name == "Fn" and self.check(shared_lexer.tk_lparen()) {
            self.advance();
            name = "Fn(";
            let mutable first_param: Bool = true;
            while not self.check(shared_lexer.tk_rparen()) and not self.at_end() and self.error == "" {
                if not first_param {
                    self.expect(shared_lexer.tk_comma(), "',' between Fn param types");
                    name = name + ", ";
                }
                name = name + self.parse_type_name();
                first_param = false;
            }
            self.expect(shared_lexer.tk_rparen(), "')' to close Fn param types");
            name = name + ")";
            self.expect(shared_lexer.tk_thin_arrow(), "'->' in Fn type");
            let ret: String = self.parse_type_name();
            name = name + " -> " + ret;
            return name;
        }
        if self.check_consume(shared_lexer.tk_lt()) {
            name = name + "<";
            let mutable depth: Int = 1;
            while depth > 0 and not self.at_end() {
                if self.check(shared_lexer.tk_lt()) {
                    self.advance();
                    name = name + "<";
                    depth = depth + 1;
                } else {
                    if self.check(shared_lexer.tk_gt()) {
                        self.advance();
                        depth = depth - 1;
                        if depth > 0 {
                            name = name + ">";
                        }
                    } else {
                        if self.check(shared_lexer.tk_comma()) {
                            self.advance();
                            name = name + ", ";
                        } else {
                            let inner: Token = self.advance();
                            name = name + inner.text;
                        }
                    }
                }
            }
            name = name + ">";
        }
        return name;
    }

    method parse_function_decl(leading_comments: Array<String>) returns FunctionDecl {
        let first_tok: Token = self.tokens[self.position];
        let line: Int = first_tok.line;
        let cmts: Array<String> = leading_comments;
        let mutable is_public: Bool = false;
        let mutable is_async: Bool = false;
        let mutable is_entry: Bool = false;
        let mutable scanning_modifiers: Bool = true;
        while scanning_modifiers {
            if self.check(shared_lexer.kw_public_marker()) {
                self.advance();
                is_public = true;
            } else {
                if self.check(shared_lexer.kw_async_marker()) {
                    self.advance();
                    is_async = true;
                } else {
                    if self.check(shared_lexer.kw_entry()) {
                        self.advance();
                        is_entry = true;
                    } else {
                        scanning_modifiers = false;
                    }
                }
            }
        }
        self.expect(shared_lexer.kw_function(), "'function' keyword");
        let name_tok: Token = self.expect(shared_lexer.tk_ident(), "function name");
        let type_params: Array<String> = self.parse_type_param_list();
        self.expect(shared_lexer.tk_lparen(), "'(' after function name");
        let mutable params: Array<Param> = [];
        if not self.check(shared_lexer.tk_rparen()) {
            params.push(self.parse_param());
            while self.check_consume(shared_lexer.tk_comma()) {
                params.push(self.parse_param());
            }
        }
        self.expect(shared_lexer.tk_rparen(), "')' to close parameter list");
        self.expect(shared_lexer.kw_returns(), "'returns' after parameter list");
        let return_type: String = self.parse_type_name();
        let mutable reqs: Array<Expr> = [];
        let mutable enss: Array<Expr> = [];
        let mutable decs: Array<Expr> = [];
        while self.is_contract_kw() and self.error == "" {
            let kw_tok: Token = self.advance();
            let kw: String = kw_tok.text;
            // Stamp the clause with the keyword position so the checker's
            // contract-typing diagnostics anchor at requires/ensures (matching
            // stage1 RequiresClause/EnsuresClause.Pos(), the keyword). Inert to
            // the formatter (ADR 0054).
            let mutable pred: Expr = self.parse_expr();
            pred.line = kw_tok.line;
            pred.column = kw_tok.column;
            if kw == "requires" {
                reqs.push(pred);
            } else {
                if kw == "ensures" {
                    enss.push(pred);
                } else {
                    decs.push(pred);
                }
            }
        }
        let body: Block = self.parse_block();
        let mutable fd: FunctionDecl = FunctionDecl(name_tok.text, is_public, is_entry, is_async, false, params, return_type, body, line, cmts);
        fd.requires_clauses = reqs;
        fd.ensures_clauses = enss;
        fd.decreases_clauses = decs;
        fd.type_params = type_params;
        fd.type_param_lines = self.tp_lines;
        fd.type_param_columns = self.tp_columns;
        fd.column = first_tok.column;
        return fd;
    }

    method is_contract_kw() returns Bool {
        if not self.check(shared_lexer.tk_ident()) {
            return false;
        }
        let t: String = self.peek_text();
        return t == "requires" or t == "ensures" or t == "decreases";
    }

    method parse_block() returns Block {
        self.expect(shared_lexer.tk_lbrace(), "'" + '{'.to_string() + "' to start block");
        let mutable stmts: Array<Stmt> = [];
        while not self.at_end() and not self.check(shared_lexer.tk_rbrace()) and self.error == "" {
            let cmts: Array<String> = self.tokens[self.position].comments_before;
            let mutable st: Stmt = self.parse_statement();
            st.comments_before = cmts;
            stmts.push(st);
        }
        let rbrace: Token = self.expect(shared_lexer.tk_rbrace(), "'" + '}'.to_string() + "' to close block");
        let mutable blk: Block = Block(stmts);
        blk.trailing_comments = rbrace.comments_before;
        blk.brace_comment_after = rbrace.comment_after;
        return blk;
    }

    method parse_statement() returns Stmt {
        if self.check(shared_lexer.kw_let()) {
            return self.parse_let_stmt();
        }
        if self.check(shared_lexer.kw_return()) {
            return self.parse_return_stmt();
        }
        if self.check(shared_lexer.kw_if()) {
            return self.parse_if_stmt();
        }
        if self.check(shared_lexer.kw_while()) {
            return self.parse_while_stmt();
        }
        if self.check(shared_lexer.kw_for_marker()) {
            return self.parse_for_stmt();
        }
        if self.check(shared_lexer.kw_break()) {
            return self.parse_break_stmt();
        }
        if self.check(shared_lexer.kw_continue()) {
            return self.parse_continue_stmt();
        }
        return self.parse_expr_stmt();
    }

    method parse_for_stmt() returns Stmt {
        let for_tok: Token = self.expect(shared_lexer.kw_for_marker(), "'for'");
        let var_tok: Token = self.expect(shared_lexer.tk_ident(), "loop variable");
        self.expect(shared_lexer.tk_ident(), "'in' in for loop");
        let iter: Expr = self.parse_expr();
        let body: Block = self.parse_block();
        let mutable st: Stmt = Stmt(shared_ast.st_for(), iter, var_tok.text, "", false, body, shared_ast.empty_block(), false);
        st.line = for_tok.line;
        st.column = for_tok.column;
        return st;
    }

    // Phase 45.4: break and continue carry no operands.
    method parse_break_stmt() returns Stmt {
        let brk_tok: Token = self.expect(shared_lexer.kw_break(), "'break'");
        let semi: Token = self.expect(shared_lexer.tk_semicolon(), "';' to end break statement");
        let mutable st: Stmt = Stmt(shared_ast.st_break(), shared_ast.empty_expr(), "", "", false, shared_ast.empty_block(), shared_ast.empty_block(), false);
        st.comment_after = semi.comment_after;
        st.line = brk_tok.line;
        st.column = brk_tok.column;
        return st;
    }

    method parse_continue_stmt() returns Stmt {
        let cont_tok: Token = self.expect(shared_lexer.kw_continue(), "'continue'");
        let semi: Token = self.expect(shared_lexer.tk_semicolon(), "';' to end continue statement");
        let mutable st: Stmt = Stmt(shared_ast.st_continue(), shared_ast.empty_expr(), "", "", false, shared_ast.empty_block(), shared_ast.empty_block(), false);
        st.comment_after = semi.comment_after;
        st.line = cont_tok.line;
        st.column = cont_tok.column;
        return st;
    }

    method parse_let_stmt() returns Stmt {
        let let_tok: Token = self.expect(shared_lexer.kw_let(), "'let'");
        let mutable is_mut: Bool = false;
        if self.check_consume(shared_lexer.kw_mutable()) {
            is_mut = true;
        }
        let name_tok: Token = self.expect(shared_lexer.tk_ident(), "binding name");
        let mutable type_name: String = "";
        if self.check_consume(shared_lexer.tk_colon()) {
            type_name = self.parse_type_name();
        }
        self.expect(shared_lexer.tk_assign(), "'=' in let binding");
        let rhs: Expr = self.parse_expr();
        let semi: Token = self.expect(shared_lexer.tk_semicolon(), "';' to end let statement");
        let mutable st: Stmt = Stmt(shared_ast.st_let(), rhs, name_tok.text, type_name, is_mut, shared_ast.empty_block(), shared_ast.empty_block(), false);
        st.comment_after = semi.comment_after;
        st.line = let_tok.line;
        st.column = let_tok.column;
        return st;
    }

    method parse_return_stmt() returns Stmt {
        let ret_tok: Token = self.expect(shared_lexer.kw_return(), "'return'");
        let mutable rhs: Expr = shared_ast.empty_expr();
        if not self.check(shared_lexer.tk_semicolon()) {
            rhs = self.parse_expr();
        }
        let semi: Token = self.expect(shared_lexer.tk_semicolon(), "';' to end return statement");
        let mutable st: Stmt = Stmt(shared_ast.st_return(), rhs, "", "", false, shared_ast.empty_block(), shared_ast.empty_block(), false);
        st.comment_after = semi.comment_after;
        st.line = ret_tok.line;
        st.column = ret_tok.column;
        return st;
    }

    method parse_if_stmt() returns Stmt {
        let if_tok: Token = self.expect(shared_lexer.kw_if(), "'if'");
        let cond: Expr = self.parse_expr();
        let then_blk: Block = self.parse_block();
        let mutable else_blk: Block = shared_ast.empty_block();
        let mutable has_else: Bool = false;
        if self.check_consume(shared_lexer.kw_else()) {
            has_else = true;
            if self.check(shared_lexer.kw_if()) {
                let mutable inner: Array<Stmt> = [];
                inner.push(self.parse_if_stmt());
                else_blk = Block(inner);
            } else {
                else_blk = self.parse_block();
            }
        }
        let mutable st: Stmt = Stmt(shared_ast.st_if(), cond, "", "", false, then_blk, else_blk, has_else);
        st.line = if_tok.line;
        st.column = if_tok.column;
        return st;
    }

    method parse_while_stmt() returns Stmt {
        let while_tok: Token = self.expect(shared_lexer.kw_while(), "'while'");
        let cond: Expr = self.parse_expr();
        let body: Block = self.parse_block();
        let mutable st: Stmt = Stmt(shared_ast.st_while(), cond, "", "", false, body, shared_ast.empty_block(), false);
        st.line = while_tok.line;
        st.column = while_tok.column;
        return st;
    }

    method parse_expr_stmt() returns Stmt {
        let first_tok: Token = self.tokens[self.position];
        let e: Expr = self.parse_expr();
        let semi: Token = self.expect(shared_lexer.tk_semicolon(), "';' to end expression statement");
        let mutable st: Stmt = Stmt(shared_ast.st_expr(), e, "", "", false, shared_ast.empty_block(), shared_ast.empty_block(), false);
        st.comment_after = semi.comment_after;
        st.line = first_tok.line;
        st.column = first_tok.column;
        return st;
    }

    method parse_expr() returns Expr {
        return self.parse_assign();
    }

    // make_binop — builds an ex_binop for `op_tok` with `lhs`/`rhs` children,
    // positioned at the operator token. Matches stage1 BinaryExpr.Pos() (the
    // operator token) so the checker's operator-typing diagnostics anchor at the
    // operator. Additive/inert to the formatter (ADR 0054).
    method make_binop(op_tok: Token, lhs: Expr, rhs: Expr) returns Expr {
        let mutable children: Array<Expr> = [];
        children.push(lhs);
        children.push(rhs);
        let mutable e: Expr = Expr(shared_ast.ex_binop(), 0, "", false, op_tok.text, children);
        e.line = op_tok.line;
        e.column = op_tok.column;
        return e;
    }

    method parse_assign() returns Expr {
        let lhs: Expr = self.parse_or();
        if self.check(shared_lexer.kw_implies_marker()) {
            let op_tok: Token = self.advance();
            let rhs: Expr = self.parse_assign();
            return self.make_binop(op_tok, lhs, rhs);
        }
        if self.check(shared_lexer.tk_assign()) {
            let op_tok: Token = self.advance();
            let rhs: Expr = self.parse_assign();
            return self.make_binop(op_tok, lhs, rhs);
        }
        return lhs;
    }

    method parse_or() returns Expr {
        let mutable lhs: Expr = self.parse_and();
        while self.check(shared_lexer.kw_or()) {
            let op_tok: Token = self.advance();
            let rhs: Expr = self.parse_and();
            lhs = self.make_binop(op_tok, lhs, rhs);
        }
        return lhs;
    }

    method parse_and() returns Expr {
        let mutable lhs: Expr = self.parse_eq();
        while self.check(shared_lexer.kw_and()) {
            let op_tok: Token = self.advance();
            let rhs: Expr = self.parse_eq();
            lhs = self.make_binop(op_tok, lhs, rhs);
        }
        return lhs;
    }

    method parse_eq() returns Expr {
        let mutable lhs: Expr = self.parse_cmp();
        while self.check(shared_lexer.tk_eq()) or self.check(shared_lexer.tk_neq()) {
            let op_tok: Token = self.advance();
            let rhs: Expr = self.parse_cmp();
            lhs = self.make_binop(op_tok, lhs, rhs);
        }
        return lhs;
    }

    method parse_cmp() returns Expr {
        let mutable lhs: Expr = self.parse_range();
        while self.is_cmp_op() {
            let op_tok: Token = self.advance();
            let rhs: Expr = self.parse_range();
            lhs = self.make_binop(op_tok, lhs, rhs);
        }
        return lhs;
    }

    method is_cmp_op() returns Bool {
        if self.check(shared_lexer.tk_lt()) {
            return true;
        }
        if self.check(shared_lexer.tk_gt()) {
            return true;
        }
        if self.check(shared_lexer.tk_leq()) {
            return true;
        }
        if self.check(shared_lexer.tk_geq()) {
            return true;
        }
        return false;
    }

    method parse_range() returns Expr {
        let lhs: Expr = self.parse_add();
        if self.check_consume(shared_lexer.tk_dotdot()) {
            let rhs: Expr = self.parse_add();
            let mutable children: Array<Expr> = [];
            children.push(lhs);
            children.push(rhs);
            return Expr(shared_ast.ex_range(), 0, "", false, "", children);
        }
        return lhs;
    }

    method parse_add() returns Expr {
        let mutable lhs: Expr = self.parse_mul();
        while self.check(shared_lexer.tk_plus()) or self.check(shared_lexer.tk_minus()) {
            let op_tok: Token = self.advance();
            let rhs: Expr = self.parse_mul();
            lhs = self.make_binop(op_tok, lhs, rhs);
        }
        return lhs;
    }

    method parse_mul() returns Expr {
        let mutable lhs: Expr = self.parse_unary();
        while self.is_mul_op() {
            let op_tok: Token = self.advance();
            let rhs: Expr = self.parse_unary();
            lhs = self.make_binop(op_tok, lhs, rhs);
        }
        return lhs;
    }

    method is_mul_op() returns Bool {
        if self.check(shared_lexer.tk_star()) {
            return true;
        }
        if self.check(shared_lexer.tk_slash()) {
            return true;
        }
        if self.check(shared_lexer.tk_percent()) {
            return true;
        }
        return false;
    }

    method parse_unary() returns Expr {
        if self.check(shared_lexer.tk_minus()) {
            self.advance();
            let operand: Expr = self.parse_unary();
            let mutable children: Array<Expr> = [];
            children.push(operand);
            return Expr(shared_ast.ex_unary(), 0, "", false, "-", children);
        }
        if self.check(shared_lexer.kw_not()) {
            self.advance();
            let operand: Expr = self.parse_unary();
            let mutable children: Array<Expr> = [];
            children.push(operand);
            return Expr(shared_ast.ex_unary(), 0, "", false, "not", children);
        }
        if self.check(shared_lexer.kw_await_marker()) {
            self.advance();
            let operand: Expr = self.parse_unary();
            let mutable children: Array<Expr> = [];
            children.push(operand);
            return Expr(shared_ast.ex_await(), 0, "", false, "", children);
        }
        if self.check(shared_lexer.kw_spawn_marker()) {
            self.advance();
            let operand: Expr = self.parse_unary();
            let mutable children: Array<Expr> = [];
            children.push(operand);
            return Expr(shared_ast.ex_spawn(), 0, "", false, "", children);
        }
        return self.parse_postfix();
    }

    method parse_postfix() returns Expr {
        let mutable e: Expr = self.parse_primary();
        while true {
            if self.check_consume(shared_lexer.tk_lparen()) {
                let mutable children: Array<Expr> = [];
                children.push(e);
                if not self.check(shared_lexer.tk_rparen()) {
                    children.push(self.parse_expr());
                    while self.check_consume(shared_lexer.tk_comma()) {
                        children.push(self.parse_expr());
                    }
                }
                self.expect(shared_lexer.tk_rparen(), "')' to close call");
                e = Expr(shared_ast.ex_call(), 0, "", false, "", children);
            } else {
                if self.check_consume(shared_lexer.tk_lbracket()) {
                    let idx: Expr = self.parse_expr();
                    self.expect(shared_lexer.tk_rbracket(), "']' to close index");
                    let mutable children: Array<Expr> = [];
                    children.push(e);
                    children.push(idx);
                    e = Expr(shared_ast.ex_index(), 0, "", false, "", children);
                } else {
                    if self.check_consume(shared_lexer.tk_dot()) {
                        let fld: Token = self.expect(shared_lexer.tk_ident(), "field name after '.'");
                        let mutable children: Array<Expr> = [];
                        children.push(e);
                        // ADR 0054: anchor the field/method-name position (matches
                        // stage1 FieldAccessExpr/MethodCallExpr.Pos() = the name
                        // token). Enables method-call arity/arg-type diagnostics
                        // (48i.2) to land on the method name. Additive/inert.
                        let mutable e_fld: Expr = Expr(shared_ast.ex_field(), 0, "", false, fld.text, children);
                        e_fld.line = fld.line;
                        e_fld.column = fld.column;
                        e = e_fld;
                    } else {
                        if self.check_consume(shared_lexer.tk_question()) {
                            let mutable children: Array<Expr> = [];
                            children.push(e);
                            e = Expr(shared_ast.ex_try(), 0, "", false, "", children);
                        } else {
                            return e;
                        }
                    }
                }
            }
        }
        return e;
    }

    method parse_primary() returns Expr {
        let kind: Int = self.peek_kind();
        if kind == shared_lexer.kw_match_marker() {
            return self.parse_match_expr();
        }
        if kind == shared_lexer.kw_forall_marker() {
            return self.parse_quantifier(shared_ast.ex_forall());
        }
        if kind == shared_lexer.kw_exists_marker() {
            return self.parse_quantifier(shared_ast.ex_exists());
        }
        if kind == shared_lexer.tk_int() {
            let tok: Token = self.advance();
            let mutable children: Array<Expr> = [];
            // ADR 0054: literal positions (for arg-type / condition anchoring).
            let mutable e_int: Expr = Expr(shared_ast.ex_int(), shared_ast.parse_int(tok.text), "", false, "", children);
            e_int.line = tok.line;
            e_int.column = tok.column;
            return e_int;
        }
        if kind == shared_lexer.tk_string() {
            let tok: Token = self.advance();
            let mutable children: Array<Expr> = [];
            let mutable e_str: Expr = Expr(shared_ast.ex_string(), 0, self.unquote(tok.text), false, "", children);
            e_str.line = tok.line;
            e_str.column = tok.column;
            return e_str;
        }
        if kind == shared_lexer.tk_float() {
            let tok: Token = self.advance();
            let mutable children: Array<Expr> = [];
            let mutable e_flt: Expr = Expr(shared_ast.ex_float(), 0, tok.text, false, "", children);
            e_flt.line = tok.line;
            e_flt.column = tok.column;
            return e_flt;
        }
        if kind == shared_lexer.tk_char() {
            let tok: Token = self.advance();
            let mutable children: Array<Expr> = [];
            let mutable e_chr: Expr = Expr(shared_ast.ex_char(), 0, tok.text, false, "", children);
            e_chr.line = tok.line;
            e_chr.column = tok.column;
            return e_chr;
        }
        if kind == shared_lexer.kw_true() {
            let tok: Token = self.advance();
            let mutable children: Array<Expr> = [];
            let mutable e_t: Expr = Expr(shared_ast.ex_bool(), 0, "", true, "", children);
            e_t.line = tok.line;
            e_t.column = tok.column;
            return e_t;
        }
        if kind == shared_lexer.kw_false() {
            let tok: Token = self.advance();
            let mutable children: Array<Expr> = [];
            let mutable e_f: Expr = Expr(shared_ast.ex_bool(), 0, "", false, "", children);
            e_f.line = tok.line;
            e_f.column = tok.column;
            return e_f;
        }
        if kind == shared_lexer.tk_ident() {
            let tok: Token = self.advance();
            if self.check(shared_lexer.tk_lt()) and self.lookahead_is_generic_call() {
                let type_args: String = self.consume_generic_type_args();
                let mutable children: Array<Expr> = [];
                let mutable e_g: Expr = Expr(shared_ast.ex_ident(), 0, "", false, tok.text + type_args, children);
                e_g.line = tok.line;
                e_g.column = tok.column;
                return e_g;
            }
            let mutable children: Array<Expr> = [];
            let mutable e_i: Expr = Expr(shared_ast.ex_ident(), 0, "", false, tok.text, children);
            e_i.line = tok.line;
            e_i.column = tok.column;
            return e_i;
        }
        if kind == shared_lexer.tk_lparen() {
            self.advance();
            let inner: Expr = self.parse_expr();
            self.expect(shared_lexer.tk_rparen(), "')' to close parenthesised expression");
            let mutable children: Array<Expr> = [];
            children.push(inner);
            return Expr(shared_ast.ex_paren(), 0, "", false, "", children);
        }
        if kind == shared_lexer.tk_lbracket() {
            self.advance();
            let mutable elems: Array<Expr> = [];
            if not self.check(shared_lexer.tk_rbracket()) {
                elems.push(self.parse_expr());
                while self.check_consume(shared_lexer.tk_comma()) {
                    elems.push(self.parse_expr());
                }
            }
            self.expect(shared_lexer.tk_rbracket(), "']' to close array literal");
            return Expr(shared_ast.ex_array(), 0, "", false, "", elems);
        }
        // Phase 44: lambda expression `|p: T, ...| -> R => body`.
        if kind == shared_lexer.tk_pipe() {
            return self.parse_lambda();
        }
        self.fail("expected expression");
        return shared_ast.empty_expr();
    }

    method parse_lambda() returns Expr {
        self.expect(shared_lexer.tk_pipe(), "'|' to start lambda params");
        let mutable params: Array<Param> = [];
        while not self.check(shared_lexer.tk_pipe()) and not self.at_end() and self.error == "" {
            let name_tok: Token = self.expect(shared_lexer.tk_ident(), "lambda parameter name");
            self.expect(shared_lexer.tk_colon(), "':' after lambda parameter name");
            let ptype: String = self.parse_type_name();
            params.push(Param(name_tok.text, ptype));
            if not self.check(shared_lexer.tk_pipe()) {
                self.expect(shared_lexer.tk_comma(), "',' between lambda parameters");
            }
        }
        self.expect(shared_lexer.tk_pipe(), "'|' to close lambda params");
        let mutable ret: String = "";
        if self.check(shared_lexer.tk_thin_arrow()) {
            self.advance();
            ret = self.parse_type_name();
        }
        self.expect(shared_lexer.tk_arrow(), "'=>' in lambda");
        let body: Expr = self.parse_expr();
        let mutable children: Array<Expr> = [];
        children.push(body);
        let mutable e: Expr = Expr(shared_ast.ex_lambda(), 0, ret, false, "", children);
        e.lambda_params = params;
        return e;
    }

    method parse_match_expr() returns Expr {
        let match_tok: Token = self.expect(shared_lexer.kw_match_marker(), "'match'");
        let scrutinee: Expr = self.parse_expr();
        self.expect(shared_lexer.tk_lbrace(), "'" + '{'.to_string() + "' to start match arms");
        let mutable arms: Array<MatchArm> = [];
        while not self.at_end() and not self.check(shared_lexer.tk_rbrace()) and self.error == "" {
            arms.push(self.parse_match_arm());
        }
        self.expect(shared_lexer.tk_rbrace(), "'" + '}'.to_string() + "' to close match");
        let mutable children: Array<Expr> = [];
        children.push(scrutinee);
        // ADR 0054: anchor the match expression at the `match` keyword (stage1
        // MatchExpr.Pos()) so the checker's non-exhaustive-match diagnostic lands
        // there. Additive/inert.
        let mutable e: Expr = Expr(shared_ast.ex_match(), 0, "", false, "", children);
        e.match_arms = arms;
        e.line = match_tok.line;
        e.column = match_tok.column;
        return e;
    }

    method parse_match_arm() returns MatchArm {
        let mutable is_wild: Bool = false;
        let mutable variant: String = "";
        let mutable bindings: Array<String> = [];
        let name_tok: Token = self.expect(shared_lexer.tk_ident(), "match pattern");
        if name_tok.text == "_" {
            is_wild = true;
        } else {
            variant = name_tok.text;
            if self.check_consume(shared_lexer.tk_lparen()) {
                if not self.check(shared_lexer.tk_rparen()) {
                    let b0: Token = self.expect(shared_lexer.tk_ident(), "pattern binding");
                    bindings.push(b0.text);
                    while self.check_consume(shared_lexer.tk_comma()) {
                        let bn: Token = self.expect(shared_lexer.tk_ident(), "pattern binding");
                        bindings.push(bn.text);
                    }
                }
                self.expect(shared_lexer.tk_rparen(), "')' to close pattern bindings");
            }
        }
        self.expect(shared_lexer.tk_arrow(), "'=>' in match arm");
        let body: Expr = self.parse_expr();
        self.check_consume(shared_lexer.tk_comma());
        // ADR 0054: anchor the arm at the pattern's first token (variant name or
        // `_`), matching stage1 MatchArm.Pos(), so per-arm match diagnostics land
        // on the pattern. Additive/inert.
        let mutable ma: MatchArm = MatchArm(variant, bindings, is_wild, body);
        ma.line = name_tok.line;
        ma.column = name_tok.column;
        return ma;
    }

    method parse_quantifier(kind: Int) returns Expr {
        self.advance();
        let var_tok: Token = self.expect(shared_lexer.tk_ident(), "quantifier variable");
        self.expect(shared_lexer.tk_ident(), "'in' in quantifier");
        let domain: Expr = self.parse_range();
        self.expect(shared_lexer.tk_colon(), "':' in quantifier");
        let body: Expr = self.parse_expr();
        let mutable children: Array<Expr> = [];
        children.push(domain);
        children.push(body);
        return Expr(kind, 0, "", false, var_tok.text, children);
    }

    method parse_program() returns Program {
        let module_decl: ModuleDecl = self.parse_module_decl();
        let mutable prog: Program = shared_ast.empty_program(module_decl);
        while not self.at_end() and self.error == "" {
            let cmts: Array<String> = self.tokens[self.position].comments_before;
            if self.check(shared_lexer.kw_import_marker()) {
                prog.imports.push(self.parse_import_decl(cmts));
            } else {
                if self.check(shared_lexer.kw_entity_marker()) {
                    prog.entities.push(self.parse_entity_decl(false, cmts));
                } else {
                    if self.check(shared_lexer.kw_enum_marker()) {
                        prog.enums.push(self.parse_enum_decl(false, cmts));
                    } else {
                        if self.check(shared_lexer.kw_trait_marker()) {
                            prog.traits.push(self.parse_trait_decl(false, cmts));
                        } else {
                            if self.check(shared_lexer.kw_impl_marker()) {
                                prog.impls.push(self.parse_impl_decl(cmts));
                            } else {
                                if self.check(shared_lexer.kw_test_marker()) {
                                    prog.tests.push(self.parse_test_decl(cmts));
                                } else {
                                    if self.check(shared_lexer.kw_extern_marker()) {
                                        prog.externs.push(self.parse_extern_decl(cmts));
                                    } else {
                                        if self.check(shared_lexer.kw_intent_marker()) {
                                            prog.intent_blocks.push(self.parse_intent_block(cmts));
                                        } else {
                                            if self.check(shared_lexer.kw_public_marker()) {
                                                self.advance();
                                                if self.check(shared_lexer.kw_entity_marker()) {
                                                    prog.entities.push(self.parse_entity_decl(true, cmts));
                                                } else {
                                                    if self.check(shared_lexer.kw_enum_marker()) {
                                                        prog.enums.push(self.parse_enum_decl(true, cmts));
                                                    } else {
                                                        if self.check(shared_lexer.kw_trait_marker()) {
                                                            prog.traits.push(self.parse_trait_decl(true, cmts));
                                                        } else {
                                                            let mutable fd: FunctionDecl = self.parse_function_decl(cmts);
                                                            fd.is_public = true;
                                                            prog.functions.push(fd);
                                                        }
                                                    }
                                                }
                                            } else {
                                                if self.check(shared_lexer.tk_at()) {
                                                    prog.tests.push(self.parse_annotated_test_decl(cmts));
                                                } else {
                                                    if self.check(shared_lexer.kw_async_marker()) and self.peek_n(1) == shared_lexer.kw_test_marker() {
                                                        self.advance();
                                                        let mutable td: TestDecl = self.parse_test_decl(cmts);
                                                        td.is_async = true;
                                                        prog.tests.push(td);
                                                    } else {
                                                        if self.is_at_function_start() {
                                                            prog.functions.push(self.parse_function_decl(cmts));
                                                        } else {
                                                            self.fail("expected a top-level declaration (module / import / function / entity / enum / trait / impl / test / extern / intent)");
                                                            prog.error = self.error;
                                                            return prog;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if self.at_end() {
            prog.trailing_comments = self.tokens[self.position].comments_before;
        }
        prog.error = self.error;
        return prog;
    }

    method is_at_function_start() returns Bool {
        if self.check(shared_lexer.kw_function()) {
            return true;
        }
        if self.check(shared_lexer.kw_entry()) {
            return true;
        }
        if self.check(shared_lexer.kw_async_marker()) {
            return true;
        }
        return false;
    }

    method parse_entity_decl(is_public: Bool, leading_comments: Array<String>) returns EntityDecl {
        let entity_tok: Token = self.expect(shared_lexer.kw_entity_marker(), "'entity'");
        let line: Int = entity_tok.line;
        let cmts: Array<String> = leading_comments;
        let name_tok: Token = self.expect(shared_lexer.tk_ident(), "entity name");
        let ent_type_params: Array<String> = self.parse_type_param_list();
        self.expect(shared_lexer.tk_lbrace(), "'" + '{'.to_string() + "' to start entity body");
        let mutable fields: Array<FieldDecl> = [];
        let mutable methods: Array<FunctionDecl> = [];
        let mutable has_ctor: Bool = false;
        let mutable ctor: FunctionDecl = shared_ast.empty_function_decl();
        let mutable invariants: Array<Expr> = [];
        while not self.at_end() and not self.check(shared_lexer.tk_rbrace()) and self.error == "" {
            if self.check(shared_lexer.kw_field_marker()) {
                let fcmts: Array<String> = self.tokens[self.position].comments_before;
                let mutable fd: FieldDecl = self.parse_field_decl();
                fd.comments_before = fcmts;
                fields.push(fd);
            } else {
                if self.check(shared_lexer.kw_constructor_marker()) {
                    let ccmts: Array<String> = self.tokens[self.position].comments_before;
                    let mutable cd: FunctionDecl = self.parse_constructor_decl();
                    cd.comments_before = ccmts;
                    ctor = cd;
                    has_ctor = true;
                } else {
                    if self.check(shared_lexer.kw_method_marker()) {
                        let mcmts: Array<String> = self.tokens[self.position].comments_before;
                        let mutable md: FunctionDecl = self.parse_method_decl();
                        md.comments_before = mcmts;
                        methods.push(md);
                    } else {
                        if self.check(shared_lexer.kw_invariant_marker()) {
                            invariants.push(self.parse_invariant_decl());
                        } else {
                            self.fail("expected 'field', 'constructor', 'method', or 'invariant' in entity body");
                            let mutable ed_err: EntityDecl = EntityDecl(name_tok.text, is_public, fields, methods, has_ctor, ctor, invariants, line, cmts);
                            ed_err.type_params = ent_type_params;
                            ed_err.type_param_lines = self.tp_lines;
                            ed_err.type_param_columns = self.tp_columns;
                            ed_err.column = entity_tok.column;
                            return ed_err;
                        }
                    }
                }
            }
        }
        self.expect(shared_lexer.tk_rbrace(), "'" + '}'.to_string() + "' to close entity body");
        let mutable ed: EntityDecl = EntityDecl(name_tok.text, is_public, fields, methods, has_ctor, ctor, invariants, line, cmts);
        ed.type_params = ent_type_params;
        ed.type_param_lines = self.tp_lines;
        ed.type_param_columns = self.tp_columns;
        ed.column = entity_tok.column;
        return ed;
    }

    method parse_field_decl() returns FieldDecl {
        // ADR 0054: anchor the field at its `field` keyword, matching stage1
        // FieldDecl.Pos() so the checker's `unknown type` diagnostic aligns.
        let field_tok: Token = self.expect(shared_lexer.kw_field_marker(), "'field'");
        let name_tok: Token = self.expect(shared_lexer.tk_ident(), "field name");
        self.expect(shared_lexer.tk_colon(), "':' after field name");
        let type_name: String = self.parse_type_name();
        let semi: Token = self.expect(shared_lexer.tk_semicolon(), "';' after field declaration");
        let mutable fd: FieldDecl = FieldDecl(name_tok.text, type_name);
        fd.comment_after = semi.comment_after;
        fd.line = field_tok.line;
        fd.column = field_tok.column;
        return fd;
    }

    method parse_constructor_decl() returns FunctionDecl {
        let ctor_tok: Token = self.expect(shared_lexer.kw_constructor_marker(), "'constructor'");
        let line: Int = ctor_tok.line;
        let mutable no_cmts: Array<String> = [];
        self.expect(shared_lexer.tk_lparen(), "'(' after 'constructor'");
        let mutable params: Array<Param> = [];
        if not self.check(shared_lexer.tk_rparen()) {
            params.push(self.parse_param());
            while self.check_consume(shared_lexer.tk_comma()) {
                params.push(self.parse_param());
            }
        }
        self.expect(shared_lexer.tk_rparen(), "')' to close constructor params");
        let mutable reqs: Array<Expr> = [];
        let mutable enss: Array<Expr> = [];
        let mutable decs: Array<Expr> = [];
        while self.is_contract_kw() and self.error == "" {
            let kw_tok: Token = self.advance();
            let kw: String = kw_tok.text;
            // Stamp the clause with the keyword position so the checker's
            // contract-typing diagnostics anchor at requires/ensures (matching
            // stage1 RequiresClause/EnsuresClause.Pos(), the keyword). Inert to
            // the formatter (ADR 0054).
            let mutable pred: Expr = self.parse_expr();
            pred.line = kw_tok.line;
            pred.column = kw_tok.column;
            if kw == "requires" {
                reqs.push(pred);
            } else {
                if kw == "ensures" {
                    enss.push(pred);
                } else {
                    decs.push(pred);
                }
            }
        }
        let body: Block = self.parse_block();
        let mutable fd: FunctionDecl = FunctionDecl("constructor", false, false, false, true, params, "", body, line, no_cmts);
        fd.requires_clauses = reqs;
        fd.ensures_clauses = enss;
        fd.decreases_clauses = decs;
        fd.column = ctor_tok.column;
        return fd;
    }

    method parse_method_decl() returns FunctionDecl {
        let method_tok: Token = self.expect(shared_lexer.kw_method_marker(), "'method'");
        let line: Int = method_tok.line;
        let mutable no_cmts: Array<String> = [];
        let name_tok: Token = self.expect(shared_lexer.tk_ident(), "method name");
        self.expect(shared_lexer.tk_lparen(), "'(' after method name");
        let mutable params: Array<Param> = [];
        if not self.check(shared_lexer.tk_rparen()) {
            params.push(self.parse_param());
            while self.check_consume(shared_lexer.tk_comma()) {
                params.push(self.parse_param());
            }
        }
        self.expect(shared_lexer.tk_rparen(), "')' to close method params");
        self.expect(shared_lexer.kw_returns(), "'returns' after method params");
        let ret: String = self.parse_type_name();
        let mutable reqs: Array<Expr> = [];
        let mutable enss: Array<Expr> = [];
        let mutable decs: Array<Expr> = [];
        while self.is_contract_kw() and self.error == "" {
            let kw_tok: Token = self.advance();
            let kw: String = kw_tok.text;
            // Stamp the clause with the keyword position so the checker's
            // contract-typing diagnostics anchor at requires/ensures (matching
            // stage1 RequiresClause/EnsuresClause.Pos(), the keyword). Inert to
            // the formatter (ADR 0054).
            let mutable pred: Expr = self.parse_expr();
            pred.line = kw_tok.line;
            pred.column = kw_tok.column;
            if kw == "requires" {
                reqs.push(pred);
            } else {
                if kw == "ensures" {
                    enss.push(pred);
                } else {
                    decs.push(pred);
                }
            }
        }
        let body: Block = self.parse_block();
        let mutable md: FunctionDecl = FunctionDecl(name_tok.text, false, false, false, false, params, ret, body, line, no_cmts);
        md.requires_clauses = reqs;
        md.ensures_clauses = enss;
        md.decreases_clauses = decs;
        md.column = method_tok.column;
        return md;
    }

    method parse_invariant_decl() returns Expr {
        let inv_tok: Token = self.expect(shared_lexer.kw_invariant_marker(), "'invariant'");
        // Stamp the invariant keyword position so the checker's `invariant must
        // be boolean` diagnostic anchors at `invariant` (stage1 Invariant.Pos()).
        let mutable e: Expr = self.parse_expr();
        e.line = inv_tok.line;
        e.column = inv_tok.column;
        self.expect(shared_lexer.tk_semicolon(), "';' after invariant expression");
        return e;
    }

    method parse_enum_decl(is_public: Bool, leading_comments: Array<String>) returns EnumDecl {
        let enum_tok: Token = self.expect(shared_lexer.kw_enum_marker(), "'enum'");
        let line: Int = enum_tok.line;
        let cmts: Array<String> = leading_comments;
        let name_tok: Token = self.expect(shared_lexer.tk_ident(), "enum name");
        self.expect(shared_lexer.tk_lbrace(), "'" + '{'.to_string() + "' to start enum body");
        let mutable variants: Array<EnumVariant> = [];
        if not self.check(shared_lexer.tk_rbrace()) {
            variants.push(self.parse_enum_variant());
            while self.check_consume(shared_lexer.tk_comma()) {
                if self.check(shared_lexer.tk_rbrace()) {
                    self.fail_off();
                } else {
                    variants.push(self.parse_enum_variant());
                }
            }
        }
        self.expect(shared_lexer.tk_rbrace(), "'" + '}'.to_string() + "' to close enum body");
        let mutable en: EnumDecl = EnumDecl(name_tok.text, is_public, variants, line, cmts);
        en.column = enum_tok.column;
        return en;
    }

    method fail_off() returns Void {
        return;
    }

    method parse_enum_variant() returns EnumVariant {
        let name_tok: Token = self.expect(shared_lexer.tk_ident(), "enum variant name");
        let mutable params: Array<Param> = [];
        if self.check_consume(shared_lexer.tk_lparen()) {
            if not self.check(shared_lexer.tk_rparen()) {
                params.push(self.parse_param());
                while self.check_consume(shared_lexer.tk_comma()) {
                    params.push(self.parse_param());
                }
            }
            self.expect(shared_lexer.tk_rparen(), "')' to close variant params");
        }
        let mutable ev: EnumVariant = EnumVariant(name_tok.text, params);
        ev.line = name_tok.line;
        ev.column = name_tok.column;
        return ev;
    }

    method parse_trait_decl(is_public: Bool, leading_comments: Array<String>) returns TraitDecl {
        let trait_tok: Token = self.expect(shared_lexer.kw_trait_marker(), "'trait'");
        let line: Int = trait_tok.line;
        let cmts: Array<String> = leading_comments;
        let name_tok: Token = self.expect(shared_lexer.tk_ident(), "trait name");
        self.expect(shared_lexer.tk_lbrace(), "'" + '{'.to_string() + "' to start trait body");
        let mutable methods: Array<TraitMethodSig> = [];
        while not self.at_end() and not self.check(shared_lexer.tk_rbrace()) and self.error == "" {
            methods.push(self.parse_trait_method_sig());
        }
        self.expect(shared_lexer.tk_rbrace(), "'" + '}'.to_string() + "' to close trait body");
        let mutable td: TraitDecl = TraitDecl(name_tok.text, is_public, methods, line, cmts);
        td.column = trait_tok.column;
        return td;
    }

    method parse_trait_method_sig() returns TraitMethodSig {
        let method_kw_tok: Token = self.expect(shared_lexer.kw_method_marker(), "'method' in trait body");
        let name_tok: Token = self.expect(shared_lexer.tk_ident(), "method name");
        self.expect(shared_lexer.tk_lparen(), "'(' after method name");
        let mutable params: Array<Param> = [];
        if not self.check(shared_lexer.tk_rparen()) {
            params.push(self.parse_param());
            while self.check_consume(shared_lexer.tk_comma()) {
                params.push(self.parse_param());
            }
        }
        self.expect(shared_lexer.tk_rparen(), "')' to close method params");
        self.expect(shared_lexer.kw_returns(), "'returns' after method params");
        let ret: String = self.parse_type_name();
        self.expect(shared_lexer.tk_semicolon(), "';' to end trait method signature");
        let mutable tms: TraitMethodSig = TraitMethodSig(name_tok.text, params, ret);
        tms.line = method_kw_tok.line;
        tms.column = method_kw_tok.column;
        return tms;
    }

    method parse_impl_decl(leading_comments: Array<String>) returns ImplDecl {
        let impl_tok: Token = self.expect(shared_lexer.kw_impl_marker(), "'impl'");
        let line: Int = impl_tok.line;
        let cmts: Array<String> = leading_comments;
        let trait_tok: Token = self.expect(shared_lexer.tk_ident(), "trait name");
        self.expect(shared_lexer.kw_for_marker(), "'for' in impl declaration");
        let entity_tok: Token = self.expect(shared_lexer.tk_ident(), "entity name");
        self.expect(shared_lexer.tk_lbrace(), "'" + '{'.to_string() + "' to start impl body");
        let mutable methods: Array<FunctionDecl> = [];
        while not self.at_end() and not self.check(shared_lexer.tk_rbrace()) and self.error == "" {
            let mcmts: Array<String> = self.tokens[self.position].comments_before;
            let mutable md: FunctionDecl = self.parse_method_decl();
            md.comments_before = mcmts;
            methods.push(md);
        }
        self.expect(shared_lexer.tk_rbrace(), "'" + '}'.to_string() + "' to close impl body");
        let mutable impl_decl: ImplDecl = ImplDecl(trait_tok.text, entity_tok.text, methods, line, cmts);
        impl_decl.column = impl_tok.column;
        return impl_decl;
    }

    method parse_test_decl(leading_comments: Array<String>) returns TestDecl {
        let test_tok: Token = self.expect(shared_lexer.kw_test_marker(), "'test'");
        let line: Int = test_tok.line;
        let cmts: Array<String> = leading_comments;
        let name_tok: Token = self.expect(shared_lexer.tk_string(), "test name (string literal)");
        let body: Block = self.parse_block();
        let mutable tdecl: TestDecl = TestDecl(self.unquote(name_tok.text), body, line, cmts);
        tdecl.column = test_tok.column;
        return tdecl;
    }

    // parse_test_annotations parses one or more `@name("arg", ...)` annotations
    // that precede a test declaration. Returns a list of canonical annotation strings,
    // e.g. `@target_specific("rust", "js")`. Each arg is stored with double quotes.
    method parse_test_annotations() returns Array<String> {
        let mutable anns: Array<String> = [];
        while self.check(shared_lexer.tk_at()) {
            self.advance();
            let name_tok: Token = self.expect(shared_lexer.tk_ident(), "annotation name after '@'");
            self.expect(shared_lexer.tk_lparen(), "'(' after annotation name");
            let mutable args: Array<String> = [];
            if not self.check(shared_lexer.tk_rparen()) {
                let arg0: Token = self.expect(shared_lexer.tk_string(), "annotation argument (string literal)");
                args.push("\"" + self.unquote(arg0.text) + "\"");
                while self.check_consume(shared_lexer.tk_comma()) {
                    let argn: Token = self.expect(shared_lexer.tk_string(), "annotation argument (string literal)");
                    args.push("\"" + self.unquote(argn.text) + "\"");
                }
            }
            self.expect(shared_lexer.tk_rparen(), "')' to close annotation");
            let mutable ann: String = "@" + name_tok.text + "(";
            let mutable argi: Int = 0;
            while argi < len(args) {
                if argi > 0 {
                    ann = ann + ", ";
                }
                ann = ann + args[argi];
                argi = argi + 1;
            }
            ann = ann + ")";
            anns.push(ann);
        }
        return anns;
    }

    // parse_annotated_test_decl parses one or more `@name(...)` annotations followed
    // by an optional `async` modifier and a test declaration. Annotations are attached
    // to the resulting TestDecl. Called when the current token is `@`.
    method parse_annotated_test_decl(leading_comments: Array<String>) returns TestDecl {
        let mutable anns: Array<String> = self.parse_test_annotations();
        let mutable is_async: Bool = false;
        if self.check(shared_lexer.kw_async_marker()) and self.peek_n(1) == shared_lexer.kw_test_marker() {
            self.advance();
            is_async = true;
        }
        let mutable td: TestDecl = self.parse_test_decl(leading_comments);
        td.is_async = is_async;
        td.annotations = anns;
        return td;
    }

    method parse_extern_decl(leading_comments: Array<String>) returns ExternDecl {
        let extern_tok: Token = self.expect(shared_lexer.kw_extern_marker(), "'extern'");
        let line: Int = extern_tok.line;
        let cmts: Array<String> = leading_comments;
        let target_tok: Token = self.expect(shared_lexer.tk_string(), "target string literal");
        self.expect(shared_lexer.kw_function(), "'function' after extern target");
        let name_tok: Token = self.expect(shared_lexer.tk_ident(), "extern function name");
        self.expect(shared_lexer.tk_lparen(), "'(' after extern function name");
        let mutable params: Array<Param> = [];
        if not self.check(shared_lexer.tk_rparen()) {
            params.push(self.parse_param());
            while self.check_consume(shared_lexer.tk_comma()) {
                params.push(self.parse_param());
            }
        }
        self.expect(shared_lexer.tk_rparen(), "')' to close extern params");
        self.expect(shared_lexer.kw_returns(), "'returns' after extern params");
        let ret: String = self.parse_type_name();
        self.expect(shared_lexer.tk_semicolon(), "';' to end extern declaration");
        let mutable ext: ExternDecl = ExternDecl(self.unquote(target_tok.text), name_tok.text, params, ret, line, cmts);
        ext.column = extern_tok.column;
        return ext;
    }

    method parse_intent_ref() returns String {
        let mutable ref_s: String = "";
        let first: Token = self.advance();
        ref_s = ref_s + first.text;
        while self.check_consume(shared_lexer.tk_dot()) {
            let part: Token = self.advance();
            ref_s = ref_s + "." + part.text;
        }
        return ref_s;
    }

    method parse_intent_block(leading_comments: Array<String>) returns IntentBlock {
        let intent_tok: Token = self.expect(shared_lexer.kw_intent_marker(), "'intent'");
        let line: Int = intent_tok.line;
        let cmts: Array<String> = leading_comments;
        let desc_tok: Token = self.expect(shared_lexer.tk_string(), "intent description (string literal)");
        self.expect(shared_lexer.tk_lbrace(), "'" + '{'.to_string() + "' to start intent block");
        let mutable goals: Array<String> = [];
        let mutable constraints: Array<String> = [];
        let mutable guarantees: Array<String> = [];
        let mutable verifs: Array<String> = [];
        while not self.at_end() and not self.check(shared_lexer.tk_rbrace()) and self.error == "" {
            if self.check(shared_lexer.tk_ident()) {
                let kw: String = self.peek_text();
                if kw == "goal" {
                    self.advance();
                    self.check_consume(shared_lexer.tk_colon());
                    let s: Token = self.expect(shared_lexer.tk_string(), "string after 'goal'");
                    self.expect(shared_lexer.tk_semicolon(), "';' after goal clause");
                    goals.push(self.unquote(s.text));
                } else {
                    if kw == "constraint" {
                        self.advance();
                        self.check_consume(shared_lexer.tk_colon());
                        let s: Token = self.expect(shared_lexer.tk_string(), "string after 'constraint'");
                        self.expect(shared_lexer.tk_semicolon(), "';' after constraint clause");
                        constraints.push(self.unquote(s.text));
                    } else {
                        if kw == "guarantee" {
                            self.advance();
                            self.check_consume(shared_lexer.tk_colon());
                            let s: Token = self.expect(shared_lexer.tk_string(), "string after 'guarantee'");
                            self.expect(shared_lexer.tk_semicolon(), "';' after guarantee clause");
                            guarantees.push(self.unquote(s.text));
                        } else {
                            if kw == "verified_by" {
                                self.advance();
                                self.check_consume(shared_lexer.tk_colon());
                                if self.check_consume(shared_lexer.tk_lbracket()) {
                                    if not self.check(shared_lexer.tk_rbracket()) {
                                        verifs.push(self.parse_intent_ref());
                                        while self.check_consume(shared_lexer.tk_comma()) {
                                            if not self.check(shared_lexer.tk_rbracket()) {
                                                verifs.push(self.parse_intent_ref());
                                            }
                                        }
                                    }
                                    self.expect(shared_lexer.tk_rbracket(), "']' to close verified_by list");
                                } else {
                                    verifs.push(self.parse_intent_ref());
                                }
                                self.expect(shared_lexer.tk_semicolon(), "';' after verified_by clause");
                            } else {
                                self.fail("unexpected identifier '" + kw + "' in intent block");
                                let mutable ib_err1: IntentBlock = IntentBlock(self.unquote(desc_tok.text), goals, constraints, guarantees, verifs, line, cmts);
                                ib_err1.column = intent_tok.column;
                                return ib_err1;
                            }
                        }
                    }
                }
            } else {
                self.fail("expected clause keyword in intent block");
                let mutable ib_err2: IntentBlock = IntentBlock(self.unquote(desc_tok.text), goals, constraints, guarantees, verifs, line, cmts);
                ib_err2.column = intent_tok.column;
                return ib_err2;
            }
        }
        self.expect(shared_lexer.tk_rbrace(), "'" + '}'.to_string() + "' to close intent block");
        let mutable ib: IntentBlock = IntentBlock(self.unquote(desc_tok.text), goals, constraints, guarantees, verifs, line, cmts);
        ib.column = intent_tok.column;
        return ib;
    }
}

public function parse(source: String) returns Program {
    let mutable p: Parser = Parser(source);
    return p.parse_program();
}

entry function main() returns Int {
    return 0;
}

public function single_let_rhs(prog: Program) returns Expr {
    return prog.functions[0].body.stmts[0].expr;
}

public function wrap_in_let(rhs_text: String) returns String {
    return "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " let x: Int = " + rhs_text + "; return x; " + '}'.to_string();
}

test "parse minimal module declaration" {
    let prog: Program = parse("module foo version \"1.0\";");
    assert_eq(prog.error, "");
    assert_eq(prog.module_decl.name, "foo");
    assert_eq(prog.module_decl.module_version, "1.0");
    assert_eq(len(prog.imports), 0);
    assert_eq(len(prog.functions), 0);
}

test "parse module with file imports" {
    let prog: Program = parse("module app version \"0.1\"; import \"helpers.intent\"; import \"types.intent\";");
    assert_eq(prog.error, "");
    assert_eq(len(prog.imports), 2);
    assert_eq(prog.imports[0].is_package, false);
    assert_eq(prog.imports[0].path, "helpers.intent");
    assert_eq(prog.imports[1].path, "types.intent");
}

test "parse module with package import" {
    let prog: Program = parse("module app version \"0.1\"; import graph_types;");
    assert_eq(prog.error, "");
    assert_eq(len(prog.imports), 1);
    assert_eq(prog.imports[0].is_package, true);
    assert_eq(prog.imports[0].path, "graph_types");
}

test "parse module with dotted package import" {
    let prog: Program = parse("module app version \"0.1\"; import graph_types.validation;");
    assert_eq(prog.error, "");
    assert_eq(prog.imports[0].is_package, true);
    assert_eq(prog.imports[0].path, "graph_types.validation");
}

test "parse function signature with no params" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions), 1);
    assert_eq(prog.functions[0].name, "f");
    assert_eq(prog.functions[0].is_public, false);
    assert_eq(prog.functions[0].is_entry, false);
    assert_eq(prog.functions[0].is_async, false);
    assert_eq(len(prog.functions[0].params), 0);
    assert_eq(prog.functions[0].return_type, "Int");
}

test "parse function with parameters" {
    let src: String = "module m version \"1.0\"; function add(a: Int, b: Int) returns Int " + '{'.to_string() + " return a + b; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions[0].params), 2);
    assert_eq(prog.functions[0].params[0].name, "a");
    assert_eq(prog.functions[0].params[0].type_name, "Int");
    assert_eq(prog.functions[0].params[1].name, "b");
}

test "parse entry function" {
    let src: String = "module m version \"1.0\"; entry function main() returns Int " + '{'.to_string() + " return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(prog.functions[0].is_entry, true);
    assert_eq(prog.functions[0].name, "main");
}

test "parse public function" {
    let src: String = "module m version \"1.0\"; public function helper() returns Void " + '{'.to_string() + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(prog.functions[0].is_public, true);
}

test "parse multiple functions" {
    let src: String = "module m version \"1.0\"; function a() returns Int " + '{'.to_string() + " return 1; " + '}'.to_string() + " function b() returns Int " + '{'.to_string() + " return 2; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions), 2);
    assert_eq(prog.functions[0].name, "a");
    assert_eq(prog.functions[1].name, "b");
}

test "function with generic return type round-trips generic args" {
    let src: String = "module m version \"1.0\"; function get_items() returns Array<Int> " + '{'.to_string() + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(prog.functions[0].return_type, "Array<Int>");
}

test "parser reconstructs nested + multi-arg generics" {
    let src: String = "module m version \"1.0\"; function f() returns Map<String, Array<Int>> " + '{'.to_string() + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(prog.functions[0].return_type, "Map<String, Array<Int>>");
}

test "parser reports unexpected token at top level" {
    let prog: Program = parse("module m version \"1.0\"; 42;");
    assert(prog.error != "");
}

test "missing semicolon after module records error" {
    let prog: Program = parse("module foo version \"1.0\"");
    assert(prog.error != "");
}

test "empty function body produces empty block" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + '{'.to_string() + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions[0].body.stmts), 0);
}

test "single return parses as one st_return statement" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions[0].body.stmts), 1);
    let s: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(s.kind, shared_ast.st_return());
    assert_eq(s.expr.kind, shared_ast.ex_int());
    assert_eq(s.expr.int_value, 0);
}

test "return without value records ex_void" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + '{'.to_string() + " return; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let s: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(s.kind, shared_ast.st_return());
    assert_eq(s.expr.kind, shared_ast.ex_void());
}

test "let with type annotation" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " let x: Int = 7; return x; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions[0].body.stmts), 2);
    let l: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(l.kind, shared_ast.st_let());
    assert_eq(l.name, "x");
    assert_eq(l.type_name, "Int");
    assert_eq(l.is_mutable, false);
    assert_eq(l.expr.kind, shared_ast.ex_int());
    assert_eq(l.expr.int_value, 7);
    let r: Stmt = prog.functions[0].body.stmts[1];
    assert_eq(r.kind, shared_ast.st_return());
    assert_eq(r.expr.kind, shared_ast.ex_ident());
    assert_eq(r.expr.name, "x");
}

test "let mutable without annotation" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " let mutable y = 0; return y; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let l: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(l.kind, shared_ast.st_let());
    assert_eq(l.name, "y");
    assert_eq(l.type_name, "");
    assert_eq(l.is_mutable, true);
    assert_eq(l.expr.kind, shared_ast.ex_int());
    assert_eq(l.expr.int_value, 0);
}

test "expression statement is parsed as assignment binop" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " let mutable y = 0; y = y + 1; return y; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions[0].body.stmts), 3);
    let s: Stmt = prog.functions[0].body.stmts[1];
    assert_eq(s.kind, shared_ast.st_expr());
    assert_eq(s.expr.kind, shared_ast.ex_binop());
    assert_eq(s.expr.name, "=");
    assert_eq(s.expr.children[0].kind, shared_ast.ex_ident());
    assert_eq(s.expr.children[0].name, "y");
    let rhs: Expr = s.expr.children[1];
    assert_eq(rhs.kind, shared_ast.ex_binop());
    assert_eq(rhs.name, "+");
    assert_eq(rhs.children[0].name, "y");
    assert_eq(rhs.children[1].kind, shared_ast.ex_int());
    assert_eq(rhs.children[1].int_value, 1);
}

test "if statement without else" {
    let src: String = "module m version \"1.0\"; function f(x: Int) returns Int " + '{'.to_string() + " if x > 0 " + '{'.to_string() + " return 1; " + '}'.to_string() + " return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions[0].body.stmts), 2);
    let iff: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(iff.kind, shared_ast.st_if());
    assert_eq(iff.expr.kind, shared_ast.ex_binop());
    assert_eq(iff.expr.name, ">");
    assert_eq(iff.expr.children[0].name, "x");
    assert_eq(iff.expr.children[1].int_value, 0);
    assert_eq(iff.has_else, false);
    assert_eq(len(iff.then_block.stmts), 1);
    let inner: Stmt = iff.then_block.stmts[0];
    assert_eq(inner.kind, shared_ast.st_return());
    assert_eq(inner.expr.kind, shared_ast.ex_int());
    assert_eq(inner.expr.int_value, 1);
}

test "if-else statement" {
    let src: String = "module m version \"1.0\"; function f(x: Int) returns Int " + '{'.to_string() + " if x > 0 " + '{'.to_string() + " return 1; " + '}'.to_string() + " else " + '{'.to_string() + " return 0; " + '}'.to_string() + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let iff: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(iff.kind, shared_ast.st_if());
    assert_eq(iff.has_else, true);
    assert_eq(len(iff.else_block.stmts), 1);
    let else_ret: Stmt = iff.else_block.stmts[0];
    assert_eq(else_ret.expr.kind, shared_ast.ex_int());
    assert_eq(else_ret.expr.int_value, 0);
}

test "else if chains into nested if in else_block" {
    let src: String = "module m version \"1.0\"; function f(x: Int) returns Int " + '{'.to_string() + " if x > 0 " + '{'.to_string() + " return 1; " + '}'.to_string() + " else if x < 0 " + '{'.to_string() + " return 0 - 1; " + '}'.to_string() + " else " + '{'.to_string() + " return 0; " + '}'.to_string() + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let outer: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(outer.kind, shared_ast.st_if());
    assert_eq(outer.has_else, true);
    assert_eq(len(outer.else_block.stmts), 1);
    let inner: Stmt = outer.else_block.stmts[0];
    assert_eq(inner.kind, shared_ast.st_if());
    assert_eq(inner.expr.kind, shared_ast.ex_binop());
    assert_eq(inner.expr.name, "<");
    assert_eq(inner.has_else, true);
    assert_eq(inner.else_block.stmts[0].expr.int_value, 0);
}

test "while statement" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " let mutable i: Int = 0; while i < 10 " + '{'.to_string() + " i = i + 1; " + '}'.to_string() + " return i; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let w: Stmt = prog.functions[0].body.stmts[1];
    assert_eq(w.kind, shared_ast.st_while());
    assert_eq(w.expr.kind, shared_ast.ex_binop());
    assert_eq(w.expr.name, "<");
    assert_eq(w.expr.children[0].name, "i");
    assert_eq(w.expr.children[1].int_value, 10);
    assert_eq(len(w.then_block.stmts), 1);
    let inc: Stmt = w.then_block.stmts[0];
    assert_eq(inc.kind, shared_ast.st_expr());
    assert_eq(inc.expr.kind, shared_ast.ex_binop());
    assert_eq(inc.expr.name, "=");
}

test "call expression with arguments parses as ex_call" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " let x: Int = add(1, 2); return x; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let l: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(l.expr.kind, shared_ast.ex_call());
    assert_eq(len(l.expr.children), 3);
    assert_eq(l.expr.children[0].kind, shared_ast.ex_ident());
    assert_eq(l.expr.children[0].name, "add");
    assert_eq(l.expr.children[1].int_value, 1);
    assert_eq(l.expr.children[2].int_value, 2);
}

test "nested if inside if then-block" {
    let src: String = "module m version \"1.0\"; function f(x: Int, y: Int) returns Int " + '{'.to_string() + " if x > 0 " + '{'.to_string() + " if y > 0 " + '{'.to_string() + " return 1; " + '}'.to_string() + " " + '}'.to_string() + " return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let outer: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(outer.kind, shared_ast.st_if());
    let inner: Stmt = outer.then_block.stmts[0];
    assert_eq(inner.kind, shared_ast.st_if());
    assert_eq(inner.expr.kind, shared_ast.ex_binop());
    assert_eq(inner.expr.name, ">");
    assert_eq(inner.expr.children[0].name, "y");
}

test "missing semicolon after return is reported" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " return 0 " + '}'.to_string();
    let prog: Program = parse(src);
    assert(prog.error != "");
}

test "parse_int converts decimal token text" {
    assert_eq(shared_ast.parse_int("0"), 0);
    assert_eq(shared_ast.parse_int("7"), 7);
    assert_eq(shared_ast.parse_int("42"), 42);
    assert_eq(shared_ast.parse_int("12345"), 12345);
}

test "integer literal expression" {
    let prog: Program = parse(wrap_in_let("99"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, shared_ast.ex_int());
    assert_eq(e.int_value, 99);
}

test "bool literals parse as ex_bool" {
    let prog_t: Program = parse(wrap_in_let("true"));
    let e_t: Expr = single_let_rhs(prog_t);
    assert_eq(e_t.kind, shared_ast.ex_bool());
    assert_eq(e_t.bool_value, true);
    let prog_f: Program = parse(wrap_in_let("false"));
    let e_f: Expr = single_let_rhs(prog_f);
    assert_eq(e_f.kind, shared_ast.ex_bool());
    assert_eq(e_f.bool_value, false);
}

test "float literal expression" {
    let prog: Program = parse(wrap_in_let("3.14"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, shared_ast.ex_float());
    assert_eq(e.str_value, "3.14");
}

test "float literal with exponent expression" {
    let prog: Program = parse(wrap_in_let("1.5e-3"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, shared_ast.ex_float());
    assert_eq(e.str_value, "1.5e-3");
}

test "char literal expression" {
    let prog: Program = parse(wrap_in_let("'a'"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, shared_ast.ex_char());
    assert_eq(e.str_value, "'a'");
}

test "char escape literal expression" {
    let prog: Program = parse(wrap_in_let("'\\n'"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, shared_ast.ex_char());
    assert_eq(e.str_value, "'\\n'");
}

test "string literal preserves quotes-stripped value" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " let s: String = \"hello\"; return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, shared_ast.ex_string());
    assert_eq(e.str_value, "hello");
}

test "unary minus on int literal" {
    let prog: Program = parse(wrap_in_let("-5"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, shared_ast.ex_unary());
    assert_eq(e.name, "-");
    assert_eq(e.children[0].kind, shared_ast.ex_int());
    assert_eq(e.children[0].int_value, 5);
}

test "unary not on bool" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " let b: Bool = not true; return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, shared_ast.ex_unary());
    assert_eq(e.name, "not");
    assert_eq(e.children[0].kind, shared_ast.ex_bool());
    assert_eq(e.children[0].bool_value, true);
}

test "operator precedence: 1 + 2 * 3 binds * tighter" {
    let prog: Program = parse(wrap_in_let("1 + 2 * 3"));
    assert_eq(prog.error, "");
    let root: Expr = single_let_rhs(prog);
    assert_eq(root.kind, shared_ast.ex_binop());
    assert_eq(root.name, "+");
    assert_eq(root.children[0].int_value, 1);
    let rhs: Expr = root.children[1];
    assert_eq(rhs.kind, shared_ast.ex_binop());
    assert_eq(rhs.name, "*");
    assert_eq(rhs.children[0].int_value, 2);
    assert_eq(rhs.children[1].int_value, 3);
}

test "operator precedence: comparison binds tighter than and" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " let b: Bool = 1 < 2 and 3 > 4; return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let root: Expr = single_let_rhs(prog);
    assert_eq(root.kind, shared_ast.ex_binop());
    assert_eq(root.name, "and");
    assert_eq(root.children[0].name, "<");
    assert_eq(root.children[1].name, ">");
}

test "parens override precedence" {
    let prog: Program = parse(wrap_in_let("(1 + 2) * 3"));
    assert_eq(prog.error, "");
    let root: Expr = single_let_rhs(prog);
    assert_eq(root.kind, shared_ast.ex_binop());
    assert_eq(root.name, "*");
    assert_eq(root.children[0].kind, shared_ast.ex_paren());
    let inner: Expr = root.children[0].children[0];
    assert_eq(inner.kind, shared_ast.ex_binop());
    assert_eq(inner.name, "+");
}

test "assignment is right-associative" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " a = b = c; return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let s: Stmt = prog.functions[0].body.stmts[0];
    assert_eq(s.expr.kind, shared_ast.ex_binop());
    assert_eq(s.expr.name, "=");
    assert_eq(s.expr.children[0].name, "a");
    let rhs: Expr = s.expr.children[1];
    assert_eq(rhs.kind, shared_ast.ex_binop());
    assert_eq(rhs.name, "=");
    assert_eq(rhs.children[0].name, "b");
    assert_eq(rhs.children[1].name, "c");
}

test "field access via dot" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " let n: Int = self.position; return n; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, shared_ast.ex_field());
    assert_eq(e.name, "position");
    assert_eq(e.children[0].kind, shared_ast.ex_ident());
    assert_eq(e.children[0].name, "self");
}

test "method call: x.to_string()" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " let s: String = x.to_string(); return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, shared_ast.ex_call());
    let callee: Expr = e.children[0];
    assert_eq(callee.kind, shared_ast.ex_field());
    assert_eq(callee.name, "to_string");
    assert_eq(callee.children[0].name, "x");
}

test "indexing: arr[0]" {
    let prog: Program = parse(wrap_in_let("arr[0]"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, shared_ast.ex_index());
    assert_eq(e.children[0].name, "arr");
    assert_eq(e.children[1].int_value, 0);
}

test "slice: s[i..j] parses as index of range" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " let sub: String = s[1..5]; return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, shared_ast.ex_index());
    let idx: Expr = e.children[1];
    assert_eq(idx.kind, shared_ast.ex_range());
    assert_eq(idx.children[0].int_value, 1);
    assert_eq(idx.children[1].int_value, 5);
}

test "array literal parses as ex_array" {
    let prog: Program = parse(wrap_in_let("[10, 20, 30]"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, shared_ast.ex_array());
    assert_eq(len(e.children), 3);
    assert_eq(e.children[0].int_value, 10);
    assert_eq(e.children[1].int_value, 20);
    assert_eq(e.children[2].int_value, 30);
}

test "empty array literal" {
    let prog: Program = parse(wrap_in_let("[]"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, shared_ast.ex_array());
    assert_eq(len(e.children), 0);
}

test "no-arg call: f()" {
    let prog: Program = parse(wrap_in_let("f()"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, shared_ast.ex_call());
    assert_eq(len(e.children), 1);
    assert_eq(e.children[0].name, "f");
}

test "nested call f(g(x))" {
    let prog: Program = parse(wrap_in_let("f(g(x))"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, shared_ast.ex_call());
    assert_eq(e.children[0].name, "f");
    let arg: Expr = e.children[1];
    assert_eq(arg.kind, shared_ast.ex_call());
    assert_eq(arg.children[0].name, "g");
    assert_eq(arg.children[1].name, "x");
}

test "method chain a.b().c() left-associates" {
    let prog: Program = parse(wrap_in_let("a.b().c()"));
    assert_eq(prog.error, "");
    let outer: Expr = single_let_rhs(prog);
    assert_eq(outer.kind, shared_ast.ex_call());
    let callee_c: Expr = outer.children[0];
    assert_eq(callee_c.kind, shared_ast.ex_field());
    assert_eq(callee_c.name, "c");
    let inner_call: Expr = callee_c.children[0];
    assert_eq(inner_call.kind, shared_ast.ex_call());
    let callee_b: Expr = inner_call.children[0];
    assert_eq(callee_b.kind, shared_ast.ex_field());
    assert_eq(callee_b.name, "b");
    assert_eq(callee_b.children[0].name, "a");
}

test "qualified call via module path: mod.func(arg)" {
    let prog: Program = parse(wrap_in_let("shared_lexer.tk_eof()"));
    assert_eq(prog.error, "");
    let e: Expr = single_let_rhs(prog);
    assert_eq(e.kind, shared_ast.ex_call());
    let callee: Expr = e.children[0];
    assert_eq(callee.kind, shared_ast.ex_field());
    assert_eq(callee.name, "tk_eof");
    assert_eq(callee.children[0].name, "shared_lexer");
}

test "equality and comparison both parse" {
    let prog_eq: Program = parse(wrap_in_let("a == b"));
    let e_eq: Expr = single_let_rhs(prog_eq);
    assert_eq(e_eq.name, "==");
    let prog_neq: Program = parse(wrap_in_let("a != b"));
    let e_neq: Expr = single_let_rhs(prog_neq);
    assert_eq(e_neq.name, "!=");
    let prog_leq: Program = parse(wrap_in_let("a <= b"));
    let e_leq: Expr = single_let_rhs(prog_leq);
    assert_eq(e_leq.name, "<=");
}

test "missing expression after = reports error" {
    let src: String = "module m version \"1.0\"; function f() returns Int " + '{'.to_string() + " let x: Int = ; return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert(prog.error != "");
}

test "entity with two fields and no methods" {
    let src: String = "module m version \"1.0\"; entity Point " + '{'.to_string() + " field x: Int; field y: Int; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.entities), 1);
    let e: EntityDecl = prog.entities[0];
    assert_eq(e.name, "Point");
    assert_eq(e.is_public, false);
    assert_eq(len(e.fields), 2);
    assert_eq(e.fields[0].name, "x");
    assert_eq(e.fields[0].type_name, "Int");
    assert_eq(e.fields[1].name, "y");
    assert_eq(e.has_constructor, false);
}

test "public entity is marked public" {
    let src: String = "module m version \"1.0\"; public entity Token " + '{'.to_string() + " field kind: Int; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.entities), 1);
    assert_eq(prog.entities[0].is_public, true);
    assert_eq(prog.entities[0].name, "Token");
}

test "entity with constructor" {
    let src: String = "module m version \"1.0\"; entity Pair " + '{'.to_string() + " field a: Int; field b: Int; " + " constructor(a: Int, b: Int) " + '{'.to_string() + " self.a = a; self.b = b; " + '}'.to_string() + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let e: EntityDecl = prog.entities[0];
    assert_eq(e.has_constructor, true);
    assert_eq(e.ctor.is_constructor, true);
    assert_eq(len(e.ctor.params), 2);
    assert_eq(e.ctor.params[0].name, "a");
    assert_eq(len(e.ctor.body.stmts), 2);
}

test "entity with method" {
    let src: String = "module m version \"1.0\"; entity Counter " + '{'.to_string() + " field n: Int; " + " method get() returns Int " + '{'.to_string() + " return self.n; " + '}'.to_string() + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let e: EntityDecl = prog.entities[0];
    assert_eq(len(e.methods), 1);
    assert_eq(e.methods[0].name, "get");
    assert_eq(e.methods[0].return_type, "Int");
    assert_eq(e.methods[0].is_constructor, false);
}

test "entity with invariant clauses" {
    let src: String = "module m version \"1.0\"; entity Bounded " + '{'.to_string() + " field n: Int; invariant self.n >= 0; invariant self.n < 100; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let e: EntityDecl = prog.entities[0];
    assert_eq(len(e.invariants), 2);
    assert_eq(e.invariants[0].kind, shared_ast.ex_binop());
    assert_eq(e.invariants[0].name, ">=");
}

test "enum with unit variants" {
    let src: String = "module m version \"1.0\"; enum Status " + '{'.to_string() + " Pending, Running, Complete " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.enums), 1);
    let e: EnumDecl = prog.enums[0];
    assert_eq(e.name, "Status");
    assert_eq(len(e.variants), 3);
    assert_eq(e.variants[0].name, "Pending");
    assert_eq(len(e.variants[0].params), 0);
}

test "enum with data-carrying variants" {
    let src: String = "module m version \"1.0\"; enum Shape " + '{'.to_string() + " Circle(radius: Int), Square(side: Int), Point " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let e: EnumDecl = prog.enums[0];
    assert_eq(len(e.variants), 3);
    assert_eq(e.variants[0].name, "Circle");
    assert_eq(len(e.variants[0].params), 1);
    assert_eq(e.variants[0].params[0].name, "radius");
    assert_eq(e.variants[1].name, "Square");
    assert_eq(len(e.variants[1].params), 1);
    assert_eq(e.variants[2].name, "Point");
    assert_eq(len(e.variants[2].params), 0);
}

test "trait with method signatures" {
    let src: String = "module m version \"1.0\"; trait Drawable " + '{'.to_string() + " method draw() returns Void; method area() returns Int; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.traits), 1);
    let t: TraitDecl = prog.traits[0];
    assert_eq(t.name, "Drawable");
    assert_eq(len(t.methods), 2);
    assert_eq(t.methods[0].name, "draw");
    assert_eq(t.methods[0].return_type, "Void");
    assert_eq(t.methods[1].name, "area");
}

test "impl Trait for Entity with methods" {
    let src: String = "module m version \"1.0\"; impl Drawable for Circle " + '{'.to_string() + " method draw() returns Void " + '{'.to_string() + " " + '}'.to_string() + " method area() returns Int " + '{'.to_string() + " return 0; " + '}'.to_string() + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.impls), 1);
    let i: ImplDecl = prog.impls[0];
    assert_eq(i.trait_name, "Drawable");
    assert_eq(i.entity_name, "Circle");
    assert_eq(len(i.methods), 2);
}

test "test declaration captures name and body" {
    let src: String = "module m version \"1.0\"; test \"sanity\" " + '{'.to_string() + " let x: Int = 1; assert_eq(x, 1); " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.tests), 1);
    let t: TestDecl = prog.tests[0];
    assert_eq(t.name, "sanity");
    assert_eq(len(t.body.stmts), 2);
}

test "extern declaration captures target + signature" {
    let src: String = "module m version \"1.0\"; extern \"rust\" function panic(msg: String) returns Void;";
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.externs), 1);
    let e: ExternDecl = prog.externs[0];
    assert_eq(e.target, "rust");
    assert_eq(e.func_name, "panic");
    assert_eq(len(e.params), 1);
    assert_eq(e.params[0].name, "msg");
    assert_eq(e.return_type, "Void");
}

test "intent block captures description, goal, guarantee, and verified_by refs" {
    let src: String = "module m version \"1.0\"; intent \"non-negative balance\" " + '{'.to_string() + " goal: \"balance is always >= 0\"; guarantee: \"no overdraft possible\"; verified_by: [ensures_positive, no_overdraft]; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.intent_blocks), 1);
    let ib: IntentBlock = prog.intent_blocks[0];
    assert_eq(ib.description, "non-negative balance");
    assert_eq(len(ib.goals), 1);
    assert_eq(ib.goals[0], "balance is always >= 0");
    assert_eq(len(ib.guarantees), 1);
    assert_eq(ib.guarantees[0], "no overdraft possible");
    assert_eq(len(ib.verifications), 2);
    assert_eq(ib.verifications[0], "ensures_positive");
    assert_eq(ib.verifications[1], "no_overdraft");
}

test "mixed declarations parse in any order" {
    let src: String = "module m version \"1.0\"; " + "entity E " + '{'.to_string() + " field a: Int; " + '}'.to_string() + " function f() returns Int " + '{'.to_string() + " return 0; " + '}'.to_string() + " test \"t\" " + '{'.to_string() + " " + '}'.to_string() + " enum K " + '{'.to_string() + " A " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.entities), 1);
    assert_eq(len(prog.functions), 1);
    assert_eq(len(prog.tests), 1);
    assert_eq(len(prog.enums), 1);
}

test "phase 37 dogfood: float + char literals + block comments parse end-to-end" {
    let src: String = "module sample version \"0.1\"; " + "/* block comment with /* nested */ inside */ " + "function f() returns Int " + '{'.to_string() + " let pi: Float = 3.14; " + " let exp: Float = 1.5e-3; " + " let nl: Char = '\\n'; " + " return 0; " + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions), 1);
    let fn_decl: FunctionDecl = prog.functions[0];
    assert_eq(fn_decl.name, "f");
    let stmts: Array<Stmt> = fn_decl.body.stmts;
    assert_eq(len(stmts), 4);
    assert_eq(stmts[0].expr.kind, shared_ast.ex_float());
    assert_eq(stmts[0].expr.str_value, "3.14");
    assert_eq(stmts[1].expr.kind, shared_ast.ex_float());
    assert_eq(stmts[1].expr.str_value, "1.5e-3");
    assert_eq(stmts[2].expr.kind, shared_ast.ex_char());
    assert_eq(stmts[2].expr.str_value, "'\\n'");
}

test "generics: entity with type param stores name in type_params" {
    let src: String = "module m version \"1.0.0\"; entity Box<T> " + '{'.to_string() + " field val: T; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.entities), 1);
    let e: EntityDecl = prog.entities[0];
    assert_eq(e.name, "Box");
    assert_eq(len(e.type_params), 1);
    assert_eq(e.type_params[0], "T");
}

test "generics: entity with two type params" {
    let src: String = "module m version \"1.0.0\"; entity Pair<A, B> " + '{'.to_string() + " field first: A; field second: B; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let e: EntityDecl = prog.entities[0];
    assert_eq(len(e.type_params), 2);
    assert_eq(e.type_params[0], "A");
    assert_eq(e.type_params[1], "B");
}

test "generics: entity without type params has empty type_params" {
    let src: String = "module m version \"1.0.0\"; entity Point " + '{'.to_string() + " field x: Int; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.entities[0].type_params), 0);
}

test "generics: function with single type param" {
    let src: String = "module m version \"1.0.0\"; function id<T>(x: T) returns T " + '{'.to_string() + " return x; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions), 1);
    assert_eq(len(prog.functions[0].type_params), 1);
    assert_eq(prog.functions[0].type_params[0], "T");
}

test "generics: generic constructor call is ex_call with ident name including type args" {
    let src: String = "module m version \"1.0.0\"; function f() returns Int " + '{'.to_string() + " let s: Stack<Int> = Stack<Int>(); return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let rhs: Expr = prog.functions[0].body.stmts[0].expr;
    assert_eq(rhs.kind, shared_ast.ex_call());
    let callee: Expr = rhs.children[0];
    assert_eq(callee.kind, shared_ast.ex_ident());
    assert_eq(callee.name, "Stack<Int>");
}

test "generics: generic call with args" {
    let src: String = "module m version \"1.0.0\"; function f() returns Int " + '{'.to_string() + " let v: Vec<String> = Vec<String>(10, 20); return 0; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let rhs: Expr = prog.functions[0].body.stmts[0].expr;
    assert_eq(rhs.kind, shared_ast.ex_call());
    assert_eq(rhs.children[0].name, "Vec<String>");
    assert_eq(len(rhs.children), 3);
}

test "synthetic dogfood: parse a small entity with methods and tests" {
    let src: String = "module sample version \"0.1\"; " + "public entity Counter " + '{'.to_string() + " field n: Int; " + " constructor(initial: Int) " + '{'.to_string() + " self.n = initial; " + '}'.to_string() + " method increment() returns Int " + '{'.to_string() + " self.n = self.n + 1; return self.n; " + '}'.to_string() + " " + '}'.to_string() + " test \"counter increments\" " + '{'.to_string() + " let c: Counter = Counter(0); let n: Int = c.increment(); assert_eq(n, 1); " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.entities), 1);
    let counter: EntityDecl = prog.entities[0];
    assert_eq(counter.name, "Counter");
    assert_eq(counter.is_public, true);
    assert_eq(counter.has_constructor, true);
    assert_eq(len(counter.methods), 1);
    assert_eq(len(prog.tests), 1);
    assert_eq(prog.tests[0].name, "counter increments");
}

test "position: FunctionDecl records line and column of leading keyword" {
    let nl: String = '\n'.to_string();
    let src: String = "module m version \"1.0\";" + nl + "function f() returns Int " + '{'.to_string() + nl + "    return 0;" + nl + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions), 1);
    assert_eq(prog.functions[0].line, 2);
    assert_eq(prog.functions[0].column, 1);
}

test "position: EntityDecl records line and column of entity keyword" {
    let nl: String = '\n'.to_string();
    let src: String = "module m version \"1.0\";" + nl + "entity E " + '{'.to_string() + " field n: Int; " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.entities), 1);
    assert_eq(prog.entities[0].line, 2);
    assert_eq(prog.entities[0].column, 1);
}

test "position: Stmt records line and column of first keyword" {
    let nl: String = '\n'.to_string();
    let src: String = "module m version \"1.0\";" + nl + "function f() returns Int " + '{'.to_string() + nl + "    let x: Int = 1;" + nl + "    return x;" + nl + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let stmts: Array<Stmt> = prog.functions[0].body.stmts;
    assert_eq(stmts[0].line, 3);
    assert_eq(stmts[0].column, 5);
    assert_eq(stmts[1].line, 4);
    assert_eq(stmts[1].column, 5);
}

test "position: Param records line and column of name token" {
    let nl: String = '\n'.to_string();
    let src: String = "module m version \"1.0\";" + nl + "function f(a: Int) returns Int " + '{'.to_string() + nl + "    return a;" + nl + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    assert_eq(len(prog.functions[0].params), 1);
    assert_eq(prog.functions[0].params[0].line, 2);
    assert_eq(prog.functions[0].params[0].column, 12);
}

test "break parses as st_break, not st_expr" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + '{'.to_string() + " while true " + '{'.to_string() + " break; " + '}'.to_string() + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let body: Block = prog.functions[0].body;
    assert_eq(len(body.stmts), 1);
    let loop_stmt: Stmt = body.stmts[0];
    assert_eq(loop_stmt.kind, shared_ast.st_while());
    let inner: Stmt = loop_stmt.then_block.stmts[0];
    assert_eq(inner.kind, shared_ast.st_break());
}

test "continue parses as st_continue, not st_expr" {
    let src: String = "module m version \"1.0\"; function f() returns Void " + '{'.to_string() + " while true " + '{'.to_string() + " continue; " + '}'.to_string() + " " + '}'.to_string();
    let prog: Program = parse(src);
    assert_eq(prog.error, "");
    let body: Block = prog.functions[0].body;
    let loop_stmt: Stmt = body.stmts[0];
    assert_eq(loop_stmt.kind, shared_ast.st_while());
    let inner: Stmt = loop_stmt.then_block.stmts[0];
    assert_eq(inner.kind, shared_ast.st_continue());
}

