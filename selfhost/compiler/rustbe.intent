// selfhost/compiler/rustbe.intent — Phase 55 / ADR 0059 stage2 self-hosted compiler.
//
// IR -> Rust source, reimplemented in Intent. Slice 55c: emits Rust byte-equal
// with stage1 `intentc build --emit` for the trivial subset examples/hello.intent
// uses (entry function returning an int literal + a test running `assert(bool)`).
// Mirrors internal/rustbe/rustbe.go's Generate / generateFunction / generateTest
// / generateStmt / generateExpr / generateBuiltinCall / sanitiseTestName for
// exactly those cases; more emit lands per construct slice, each grown into the
// `make diff-emit` corpus once byte-equal.
//
// Unlike the checker (sound-but-incomplete, ADR 0056), the emitter must be
// COMPLETE for every construct it claims — so unsupported constructs emit a
// `// unsupported: ...` marker that fails the byte-equal gate LOUDLY rather than
// silently producing wrong Rust. They are unreachable for the current corpus.
//
// The call-site borrow (Array/Map args -> `&arg`) needs the callee's param
// types, so the module's function table (`funcs`) is threaded through the emit
// functions to generate_call — mirroring g.functions in rustbe.go. It is a free
// parameter rather than generator-entity state because stage1's method-receiver
// inference (&self vs &mut self) is shallow: a method returning a bare
// `self.foo()` is marked &mut self while one burying it in a string concat stays
// &self, and a &self method may not call a &mut self one. Free functions have no
// receiver, sidestepping that entirely (the working style of the earlier slices).
//
// Note: a literal `{`/`}` in an Intent string literal lexes as string
// interpolation, so every brace in the emitted Rust is injected via lbrace()/
// rbrace() (char-to-string), the same technique check_test.intent uses.
module compiler_rustbe version "0.1.0";

import "ir.intent";

// generate — an IR Module to Rust source. Mirrors Generate for the trivial
// subset: header, then functions, then tests (each followed by a blank line).
// The module's function table is threaded down as the call-site borrow registry.
// Entities/enums/traits/impls/intents and the use-statement post-processing
// (HashMap/reqwest/tokio) land with their construct slices.
public function generate(m: IrModule) returns String {
    let funcs: Array<IrFunction> = m.functions;
    let mutable out: String = "// Generated Rust code from Intent\n";
    out = out + "#![allow(unused_parens, unused_variables, unused_mut, dead_code, private_interfaces)]\n";
    out = out + "\n";
    // Decl emission order mirrors stage1 Generate: entities, enums, traits, impls,
    // functions, intents, tests (traits/impls land with their slices). Each decl is
    // followed by a blank line.
    let mutable eei: Int = 0;
    while eei < len(m.entities) {
        out = out + generate_entity(m.entities[eei], funcs);
        out = out + "\n";
        eei = eei + 1;
    }
    let mutable eni: Int = 0;
    while eni < len(m.enums) {
        out = out + generate_enum(m.enums[eni]);
        out = out + "\n";
        eni = eni + 1;
    }
    let mutable fi: Int = 0;
    while fi < len(m.functions) {
        out = out + generate_function(m.functions[fi], funcs);
        out = out + "\n";
        fi = fi + 1;
    }
    let mutable ii: Int = 0;
    while ii < len(m.intents) {
        out = out + generate_intent(m.intents[ii]);
        out = out + "\n";
        ii = ii + 1;
    }
    let mutable ti: Int = 0;
    while ti < len(m.tests) {
        out = out + generate_test(m.tests[ti], funcs);
        out = out + "\n";
        ti = ti + 1;
    }
    return out;
}

// param_is_arrayref — is param `idx` of function `fn_name` an Array/Map (emitted
// `&Vec`/`&HashMap`, so its call-site arg must be borrowed)? Mirrors the
// g.functions[...].Params[i].Type check in generateCallExpr. Linear scan
// (function counts are small); a missing function / out-of-range idx => false.
public function param_is_arrayref(funcs: Array<IrFunction>, fn_name: String, idx: Int) returns Bool {
    let mutable fi: Int = 0;
    while fi < len(funcs) {
        let f: IrFunction = funcs[fi];
        if f.name == fn_name {
            if idx < len(f.params) {
                let tn: String = f.params[idx].param_type.name;
                return tn == "Array" or tn == "Map";
            }
            return false;
        }
        fi = fi + 1;
    }
    return false;
}

// generate_enum — mirrors generateEnumDecl: `#[derive(Clone, Debug)] enum Name {
// Variant, Variant { field: type }, ... }`. Unit variants are bare; data variants
// use struct syntax with the declared field names. Braces via lbrace()/rbrace().
public function generate_enum(en: IrEnum) returns String {
    let mutable out: String = "#[derive(Clone, Debug)]\n";
    out = out + "enum " + en.name + " " + lbrace() + "\n";
    let mutable i: Int = 0;
    while i < len(en.variants) {
        let v: IrEnumVariant = en.variants[i];
        if len(v.fields) == 0 {
            out = out + "    " + v.name + ",\n";
        } else {
            out = out + "    " + v.name + " " + lbrace() + " ";
            let mutable j: Int = 0;
            while j < len(v.fields) {
                if j > 0 {
                    out = out + ", ";
                }
                out = out + v.fields[j].name + ": " + map_type(v.fields[j].param_type);
                j = j + 1;
            }
            out = out + " " + rbrace() + ",\n";
        }
        i = i + 1;
    }
    out = out + rbrace() + "\n";
    return out;
}

// generate_entity — mirrors generateEntity: a `#[derive(Clone, Debug)] struct` plus
// an `impl` block holding `__check_invariants` (if any invariants), the constructor
// (if any), and the methods, each member followed by a blank line. Braces via
// lbrace()/rbrace().
public function generate_entity(e: IrEntity, funcs: Array<IrFunction>) returns String {
    let mutable out: String = "#[derive(Clone, Debug)]\n";
    out = out + "struct " + e.name + " " + lbrace() + "\n";
    let mutable fi: Int = 0;
    while fi < len(e.fields) {
        out = out + "    " + e.fields[fi].name + ": " + map_type(e.fields[fi].param_type) + ",\n";
        fi = fi + 1;
    }
    out = out + rbrace() + "\n";
    out = out + "\n";
    out = out + "impl " + e.name + " " + lbrace() + "\n";
    let has_inv: Bool = len(e.invariants) > 0;
    if has_inv {
        out = out + "    fn __check_invariants(&self) " + lbrace() + "\n";
        let mutable ivi: Int = 0;
        while ivi < len(e.invariants) {
            out = out + "        assert!(" + generate_expr(e.invariants[ivi].expr, funcs) + ", \"Invariant failed: " + e.invariants[ivi].raw_text + "\");\n";
            ivi = ivi + 1;
        }
        out = out + "    " + rbrace() + "\n";
        out = out + "\n";
    }
    if e.has_constructor {
        out = out + generate_constructor(e, funcs);
        out = out + "\n";
    }
    let mutable mi: Int = 0;
    while mi < len(e.methods) {
        out = out + generate_method(e, e.methods[mi], funcs);
        out = out + "\n";
        mi = mi + 1;
    }
    out = out + rbrace() + "\n";
    return out;
}

// generate_constructor — mirrors generateConstructor: `fn new(params) -> Name`,
// requires asserts, a struct literal (direct `__self.field = expr` inits hoisted,
// other fields defaulted), the non-init body statements, ensures asserts (self is
// __self here — set during lowering), the invariant check, and `__self`.
public function generate_constructor(e: IrEntity, funcs: Array<IrFunction>) returns String {
    let c: IrFunction = e.constructor_fn;
    let mutated: Array<String> = collect_mutated_vars(c.body);
    let mutable out: String = "    fn new(";
    let mutable pi: Int = 0;
    while pi < len(c.params) {
        if pi > 0 {
            out = out + ", ";
        }
        out = out + c.params[pi].name + ": " + map_type(c.params[pi].param_type);
        pi = pi + 1;
    }
    out = out + ") -> " + e.name + " " + lbrace() + "\n";
    let mutable ri: Int = 0;
    while ri < len(c.requires_clauses) {
        out = out + "        assert!(" + generate_expr(c.requires_clauses[ri].expr, funcs) + ", \"Precondition failed: " + c.requires_clauses[ri].raw_text + "\");\n";
        ri = ri + 1;
    }
    out = out + "        let mut __self = " + e.name + " " + lbrace() + "\n";
    let mutable fi: Int = 0;
    while fi < len(e.fields) {
        let fname: String = e.fields[fi].name;
        if ctor_has_direct_init(c.body, fname) {
            out = out + "            " + fname + ": " + generate_expr(ctor_direct_init(c.body, fname), funcs) + ",\n";
        } else {
            out = out + "            " + fname + ": " + default_value(e.fields[fi].param_type) + ",\n";
        }
        fi = fi + 1;
    }
    out = out + "        " + rbrace() + ";\n";
    out = out + generate_ctor_body_rest(c.body, funcs, mutated);
    let mutable ei: Int = 0;
    while ei < len(c.ensures_clauses) {
        out = out + "        assert!(" + generate_expr(c.ensures_clauses[ei].expr, funcs) + ", \"Postcondition failed: " + c.ensures_clauses[ei].raw_text + "\");\n";
        ei = ei + 1;
    }
    if len(e.invariants) > 0 {
        out = out + "        __self.__check_invariants();\n";
    }
    out = out + "        __self\n";
    out = out + "    " + rbrace() + "\n";
    return out;
}

// is_self_field_target — is `t` a `__self.<field>` place (a constructor direct init)?
function is_self_field_target(t: IrExpr) returns Bool {
    if t.kind == compiler_ir.irex_field() {
        if t.children[0].kind == compiler_ir.irex_var() {
            return t.children[0].name == "__self";
        }
    }
    return false;
}

// ctor_has_direct_init / ctor_direct_init — the FIRST `__self.<fname> = expr;`
// assignment in the constructor body (mirrors splitConstructorInits' first-wins).
function ctor_has_direct_init(body: Array<IrStmt>, fname: String) returns Bool {
    let mutable i: Int = 0;
    while i < len(body) {
        let s: IrStmt = body[i];
        if s.kind == compiler_ir.irst_assign() {
            if is_self_field_target(s.target) {
                if s.target.name == fname {
                    return true;
                }
            }
        }
        i = i + 1;
    }
    return false;
}

function ctor_direct_init(body: Array<IrStmt>, fname: String) returns IrExpr {
    let mutable i: Int = 0;
    while i < len(body) {
        let s: IrStmt = body[i];
        if s.kind == compiler_ir.irst_assign() {
            if is_self_field_target(s.target) {
                if s.target.name == fname {
                    return s.expr;
                }
            }
        }
        i = i + 1;
    }
    return compiler_ir.ir_void_expr();
}

// generate_ctor_body_rest — emit constructor body statements that were NOT hoisted
// into the struct literal (i.e. not the first `__self.field = ...` per field), at
// level 2. Mirrors splitConstructorInits' bodyRest.
function generate_ctor_body_rest(body: Array<IrStmt>, funcs: Array<IrFunction>, mutated: Array<String>) returns String {
    let mutable out: String = "";
    let mutable seen: Array<String> = [];
    let mutable i: Int = 0;
    while i < len(body) {
        let s: IrStmt = body[i];
        let mutable consumed: Bool = false;
        if s.kind == compiler_ir.irst_assign() {
            if is_self_field_target(s.target) {
                if not name_in_array(seen, s.target.name) {
                    seen.push(s.target.name);
                    consumed = true;
                }
            }
        }
        if not consumed {
            out = out + generate_stmt(s, 2, false, funcs, mutated);
        }
        i = i + 1;
    }
    return out;
}

// default_value — mirrors defaultValue for the primitive/collection field types the
// corpus needs; entity/enum/char defaults (rare — the corpus always direct-inits
// its fields) hit a loud marker until their slice.
public function default_value(t: IrType) returns String {
    if t.name == "Int" {
        return "0i64";
    }
    if t.name == "Float" {
        return "0.0";
    }
    if t.name == "String" {
        return "String::new()";
    }
    if t.name == "Bool" {
        return "false";
    }
    if t.name == "Array" {
        return "Vec::new()";
    }
    return "/* unsupported default: " + t.name + " */";
}

// generate_method — mirrors generateMethod: `&self`/`&mut self` per method_mutates_self,
// old captures, requires, a labeled `'body:` block (non-Void with ensures/invariants)
// or plain body, ensures, and the invariant check. Braces via lbrace()/rbrace().
public function generate_method(e: IrEntity, m: IrFunction, funcs: Array<IrFunction>) returns String {
    let mutated: Array<String> = collect_mutated_vars(m.body);
    let mutable receiver: String = "&mut self";
    if not method_mutates_self(m.body) {
        receiver = "&self";
    }
    let ret_void: Bool = m.return_type.name == "Void";
    let mutable out: String = "    fn " + m.name + "(" + receiver;
    let mutable pi: Int = 0;
    while pi < len(m.params) {
        out = out + ", " + m.params[pi].name + ": " + map_type(m.params[pi].param_type);
        pi = pi + 1;
    }
    if ret_void {
        out = out + ") " + lbrace() + "\n";
    } else {
        out = out + ") -> " + map_type(m.return_type) + " " + lbrace() + "\n";
    }
    let mutable oi: Int = 0;
    while oi < len(m.old_captures) {
        out = out + "        let " + m.old_captures[oi].name + " = " + generate_expr(m.old_captures[oi].expr, funcs) + ";\n";
        oi = oi + 1;
    }
    let mutable ri: Int = 0;
    while ri < len(m.requires_clauses) {
        out = out + "        assert!(" + generate_expr(m.requires_clauses[ri].expr, funcs) + ", \"Precondition failed: " + m.requires_clauses[ri].raw_text + "\");\n";
        ri = ri + 1;
    }
    let has_inv: Bool = len(e.invariants) > 0;
    let needs_labeled: Bool = not ret_void and (len(m.ensures_clauses) > 0 or has_inv);
    if needs_labeled {
        out = out + "        let __result: " + map_type(m.return_type) + " = 'body: " + lbrace() + "\n";
        out = out + generate_stmts(m.body, 3, true, funcs, mutated);
        out = out + "        " + rbrace() + ";\n";
        out = out + generate_method_ensures(m, funcs);
        if has_inv {
            out = out + "        self.__check_invariants();\n";
        }
        out = out + "        __result\n";
    } else {
        out = out + generate_stmts(m.body, 2, false, funcs, mutated);
        out = out + generate_method_ensures(m, funcs);
        if has_inv {
            out = out + "        self.__check_invariants();\n";
        }
    }
    out = out + "    " + rbrace() + "\n";
    return out;
}

// generate_method_ensures — the ensures asserts at level 2 (shared by the labeled
// and plain method paths).
function generate_method_ensures(m: IrFunction, funcs: Array<IrFunction>) returns String {
    let mutable out: String = "";
    let mutable ei: Int = 0;
    while ei < len(m.ensures_clauses) {
        out = out + "        assert!(" + generate_expr(m.ensures_clauses[ei].expr, funcs) + ", \"Postcondition failed: " + m.ensures_clauses[ei].raw_text + "\");\n";
        ei = ei + 1;
    }
    return out;
}

// method_mutates_self — mirrors methodMutatesSelf: true if the body assigns a self
// field or calls a (possibly mutating) method on self, recursing into blocks.
public function method_mutates_self(stmts: Array<IrStmt>) returns Bool {
    let mutable i: Int = 0;
    while i < len(stmts) {
        if stmt_mutates_self(stmts[i]) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

function stmt_mutates_self(s: IrStmt) returns Bool {
    if s.kind == compiler_ir.irst_assign() {
        if targets_mut_self(s.target) {
            return true;
        }
        return expr_mutates_self(s.expr);
    }
    if s.kind == compiler_ir.irst_expr() or s.kind == compiler_ir.irst_let() or s.kind == compiler_ir.irst_return() {
        return expr_mutates_self(s.expr);
    }
    if s.kind == compiler_ir.irst_if() {
        if method_mutates_self(s.then_body) {
            return true;
        }
        return method_mutates_self(s.else_body);
    }
    if s.kind == compiler_ir.irst_while() or s.kind == compiler_ir.irst_for() {
        return method_mutates_self(s.then_body);
    }
    return false;
}

function targets_mut_self(t: IrExpr) returns Bool {
    if t.kind == compiler_ir.irex_field() {
        if t.children[0].kind == compiler_ir.irex_var() {
            if t.children[0].name == "self" {
                return true;
            }
        }
        return targets_mut_self(t.children[0]);
    }
    if t.kind == compiler_ir.irex_index() {
        return targets_mut_self(t.children[0]);
    }
    return false;
}

function expr_mutates_self(e: IrExpr) returns Bool {
    if e.kind == compiler_ir.irex_method() {
        if e.children[0].kind == compiler_ir.irex_var() {
            if e.children[0].name == "self" {
                return true;
            }
        }
        if is_self_or_self_field(e.children[0]) {
            return is_mutating_method(e.name);
        }
    }
    return false;
}

function is_self_or_self_field(e: IrExpr) returns Bool {
    if e.kind == compiler_ir.irex_var() {
        return e.name == "self";
    }
    if e.kind == compiler_ir.irex_field() {
        return is_self_or_self_field(e.children[0]);
    }
    if e.kind == compiler_ir.irex_index() {
        return is_self_or_self_field(e.children[0]);
    }
    return false;
}

function is_mutating_method(name: String) returns Bool {
    return name == "push" or name == "pop" or name == "insert" or name == "remove" or name == "set" or name == "clear" or name == "sort" or name == "reverse";
}

// generate_intent — mirrors generateIntent: doc-comment lines for the description /
// goals / constraints / guarantees / verified_by refs, then a compile-time-verified
// module `mod __intent_<sanitised> { ... }`.
public function generate_intent(it: IrIntent) returns String {
    let mutable out: String = "// Intent: " + it.description + "\n";
    let mutable gi: Int = 0;
    while gi < len(it.goals) {
        out = out + "// Goal: " + it.goals[gi] + "\n";
        gi = gi + 1;
    }
    let mutable ci: Int = 0;
    while ci < len(it.constraints) {
        out = out + "// Constraint: " + it.constraints[ci] + "\n";
        ci = ci + 1;
    }
    let mutable gui: Int = 0;
    while gui < len(it.guarantees) {
        out = out + "// Guarantee: " + it.guarantees[gui] + "\n";
        gui = gui + 1;
    }
    let mutable vi: Int = 0;
    while vi < len(it.verifications) {
        out = out + "// Verified by: " + it.verifications[vi] + "\n";
        vi = vi + 1;
    }
    out = out + "\n";
    out = out + "#[cfg(test)]\n";
    out = out + "mod " + mangle_intent_name(it.description) + " " + lbrace() + "\n";
    out = out + "    // Intent verification completed at compile time.\n";
    out = out + rbrace() + "\n";
    return out;
}

// mangle_intent_name — mirrors mangleIntentName: lowercase, collapse non-[a-z0-9]
// runs to `_`, trim both ends, prefix a leading digit with `_`, empty -> "__intent";
// prefixed with "__intent_".
public function mangle_intent_name(desc: String) returns String {
    let mutable b: String = "";
    let mutable prev_us: Bool = false;
    let mutable i: Int = 0;
    while i < len(desc) {
        let c: Char = desc[i];
        let cp: Int = c.to_codepoint();
        if cp >= 97 and cp <= 122 {
            b = b + c.to_string();
            prev_us = false;
        } else {
            if cp >= 65 and cp <= 90 {
                b = b + c.to_string().to_lowercase();
                prev_us = false;
            } else {
                if cp >= 48 and cp <= 57 {
                    b = b + c.to_string();
                    prev_us = false;
                } else {
                    if not prev_us {
                        b = b + "_";
                        prev_us = true;
                    }
                }
            }
        }
        i = i + 1;
    }
    let mutable out: String = trim_both_underscores(b);
    if len(out) > 0 {
        let d: Int = out[0].to_codepoint();
        if d >= 48 and d <= 57 {
            out = "_" + out;
        }
    }
    if out == "" {
        out = "__intent";
    }
    return "__intent_" + out;
}

// trim_both_underscores — s without leading/trailing '_' (codepoint 95).
function trim_both_underscores(s: String) returns String {
    let n: Int = len(s);
    let mutable first: Int = 0 - 1;
    let mutable last: Int = 0 - 1;
    let mutable i: Int = 0;
    while i < n {
        if s[i].to_codepoint() != 95 {
            if first < 0 {
                first = i;
            }
            last = i;
        }
        i = i + 1;
    }
    if first < 0 {
        return "";
    }
    let mutable out: String = "";
    let mutable j: Int = first;
    while j <= last {
        out = out + s[j].to_string();
        j = j + 1;
    }
    return out;
}

// generate_function — mirrors generateFunction. A single-file ENTRY function
// becomes `fn __intent_main() -> i64` plus a `fn main` wrapper (stage1's entry
// path ignores contracts). A non-entry function emits its signature, requires
// asserts, then either an ensures `'body:` labeled block (when it has ensures and
// a non-Void return) or the plain body followed by any ensures asserts. Array/Map
// params are emitted by reference (`&Vec`/`&HashMap`), matching the call-site
// borrow. Deferred: async (tokio); old() in ensures; --strip-contracts.
public function generate_function(f: IrFunction, funcs: Array<IrFunction>) returns String {
    if f.is_async {
        return "// unsupported: async function " + f.name + "\n";
    }
    let mutated: Array<String> = collect_mutated_vars(f.body);
    if f.is_entry {
        let mutable out: String = "fn __intent_main() -> i64 " + lbrace() + "\n";
        out = out + generate_stmts(f.body, 1, false, funcs, mutated);
        out = out + rbrace() + "\n";
        out = out + "\n";
        out = out + "fn main() " + lbrace() + "\n";
        out = out + "    let __exit_code = __intent_main();\n";
        out = out + "    std::process::exit(__exit_code as i32);\n";
        out = out + rbrace() + "\n";
        return out;
    }
    let ret_ty: String = map_type(f.return_type);
    let mutable sig: String = "fn " + f.name + "(";
    let mutable i: Int = 0;
    while i < len(f.params) {
        if i > 0 {
            sig = sig + ", ";
        }
        let mutable pty: String = map_type(f.params[i].param_type);
        if f.params[i].param_type.name == "Array" or f.params[i].param_type.name == "Map" {
            pty = "&" + pty;
        }
        sig = sig + f.params[i].name + ": " + pty;
        i = i + 1;
    }
    sig = sig + ") -> " + ret_ty + " " + lbrace() + "\n";
    sig = sig + generate_contracts(f.requires_clauses, "Precondition failed: ", funcs);
    let needs_labeled: Bool = len(f.ensures_clauses) > 0 and f.return_type.name != "Void";
    if needs_labeled {
        sig = sig + "    let __result: " + ret_ty + " = 'body: " + lbrace() + "\n";
        sig = sig + generate_stmts(f.body, 2, true, funcs, mutated);
        sig = sig + "    " + rbrace() + ";\n";
        sig = sig + generate_contracts(f.ensures_clauses, "Postcondition failed: ", funcs);
        sig = sig + "    __result\n";
    } else {
        sig = sig + generate_stmts(f.body, 1, false, funcs, mutated);
        sig = sig + generate_contracts(f.ensures_clauses, "Postcondition failed: ", funcs);
    }
    sig = sig + rbrace() + "\n";
    return sig;
}

// generate_contracts — one `assert!(PRED, "PREFIX<raw>");` per clause at the
// function-body indent (level 1). Mirrors the requires / ensures assert emission.
// Uses assert! (not debug_assert!); --strip-contracts parity is a later concern.
public function generate_contracts(clauses: Array<IrContract>, prefix: String, funcs: Array<IrFunction>) returns String {
    let mutable out: String = "";
    let mutable i: Int = 0;
    while i < len(clauses) {
        out = out + "    assert!(" + generate_expr(clauses[i].expr, funcs) + ", \"" + prefix + clauses[i].raw_text + "\");\n";
        i = i + 1;
    }
    return out;
}

// generate_test — mirrors generateTest. Test name is sanitised to a Rust-legal
// identifier. Async tests (#[tokio::test]) land with the async slice.
public function generate_test(t: IrTest, funcs: Array<IrFunction>) returns String {
    if t.is_async {
        return "// unsupported: async test " + t.name + "\n";
    }
    let fn_name: String = "__test_" + sanitise_test_name(t.name);
    let mutated: Array<String> = collect_mutated_vars(t.body);
    let mutable out: String = "#[test]\n";
    out = out + "fn " + fn_name + "() " + lbrace() + "\n";
    out = out + generate_stmts(t.body, 1, false, funcs, mutated);
    out = out + rbrace() + "\n";
    return out;
}

// name_in_array — linear membership test (small arrays), mirrors a Go map lookup.
public function name_in_array(names: Array<String>, name: String) returns Bool {
    let mutable i: Int = 0;
    while i < len(names) {
        if names[i] == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// collect_mutated_vars — mirrors internal/rustbe collectMutatedVars: the names
// that are assigned to, or are the receiver of a top-level method call, anywhere
// in `stmts` (recursing into if/while/for bodies). A `let` whose name is in this
// set is emitted `let mut` even without the source `mutable` keyword (Rust needs
// `mut` for later reassignment / a `&mut self` method). The method-receiver rule
// is conservative (stage1 cannot cheaply tell &self from &mut self), so ANY `x` in
// an `x.method(...)` statement-value position is marked.
//
// Written FUNCTIONALLY (each call returns a fresh array, merged into a LOCAL owned
// array) because an Array parameter lowers to an immutable `&Vec` that cannot be
// pushed to — the same reason the checker's scope helpers copy-and-return.
// Duplicates are harmless: name_in_array is a membership test at the `let` site.
public function collect_mutated_vars(stmts: Array<IrStmt>) returns Array<String> {
    let mutable out: Array<String> = [];
    let mutable i: Int = 0;
    while i < len(stmts) {
        let s: IrStmt = stmts[i];
        if s.kind == compiler_ir.irst_assign() {
            // Assignment target root -> mutated (a VarRef directly, or the object
            // of an index assignment `x[i] = …`). Field targets land with entities.
            if s.target.kind == compiler_ir.irex_var() {
                out.push(s.target.name);
            } else {
                if s.target.kind == compiler_ir.irex_index() {
                    if s.target.children[0].kind == compiler_ir.irex_var() {
                        out.push(s.target.children[0].name);
                    }
                }
            }
        } else {
            if s.kind == compiler_ir.irst_expr() or s.kind == compiler_ir.irst_let() or s.kind == compiler_ir.irst_return() {
                // Top-level method call on a plain variable -> mark the receiver
                // (only the top level, exactly like collectMethodReceivers).
                if s.expr.kind == compiler_ir.irex_method() {
                    if s.expr.children[0].kind == compiler_ir.irex_var() {
                        out.push(s.expr.children[0].name);
                    }
                }
            } else {
                if s.kind == compiler_ir.irst_if() {
                    out = append_names(out, collect_mutated_vars(s.then_body));
                    out = append_names(out, collect_mutated_vars(s.else_body));
                } else {
                    if s.kind == compiler_ir.irst_while() or s.kind == compiler_ir.irst_for() {
                        out = append_names(out, collect_mutated_vars(s.then_body));
                    }
                }
            }
        }
        i = i + 1;
    }
    return out;
}

// append_names — a fresh array holding all of `a` then all of `b` (functional
// concatenation; the arguments are immutable `&Vec` so a new owned array is built).
function append_names(a: Array<String>, b: Array<String>) returns Array<String> {
    let mutable out: Array<String> = [];
    let mutable i: Int = 0;
    while i < len(a) {
        out.push(a[i]);
        i = i + 1;
    }
    let mutable j: Int = 0;
    while j < len(b) {
        out.push(b[j]);
        j = j + 1;
    }
    return out;
}

// generate_stmts — emit each statement at the given indent level, in order.
// in_labeled propagates the ensures `'body:` context so a `return` inside it (at
// any nesting depth) becomes `break 'body`. `mutated` is the function/test's
// mutated-var set (see collect_mutated_vars), consulted by the `let` emit.
public function generate_stmts(stmts: Array<IrStmt>, level: Int, in_labeled: Bool, funcs: Array<IrFunction>, mutated: Array<String>) returns String {
    let mutable out: String = "";
    let mutable i: Int = 0;
    while i < len(stmts) {
        out = out + generate_stmt(stmts[i], level, in_labeled, funcs, mutated);
        i = i + 1;
    }
    return out;
}

// generate_stmt — mirrors generateStmt. Inside an ensures labeled block
// (in_labeled), `return X` becomes `break 'body X` and bare `return` becomes
// `break 'body`. Unsupported kinds fail the gate loudly.
public function generate_stmt(s: IrStmt, level: Int, in_labeled: Bool, funcs: Array<IrFunction>, mutated: Array<String>) returns String {
    let ind: String = indent_str(level);
    if s.kind == compiler_ir.irst_return() {
        if s.expr.kind == compiler_ir.irex_void() {
            if in_labeled {
                return ind + "break 'body;\n";
            }
            return ind + "return;\n";
        }
        let rv: String = gen_stmt_value(s.expr, funcs, level);
        if in_labeled {
            return ind + "break 'body " + rv + ";\n";
        }
        return ind + "return " + rv + ";\n";
    }
    if s.kind == compiler_ir.irst_expr() {
        return ind + gen_stmt_value(s.expr, funcs, level) + ";\n";
    }
    if s.kind == compiler_ir.irst_let() {
        let val: String = gen_stmt_value(s.expr, funcs, level);
        // A `let` is emitted `mut` if the source said so OR the mutatedVars scan
        // saw it later assigned / used as a method receiver (mirrors stage1's
        // `stmt.Mutable || g.mutatedVars[stmt.Name]`).
        let is_mut: Bool = s.is_mutable or name_in_array(mutated, s.name);
        // Fn-typed lets use type inference (`impl Fn` is not allowed in variable
        // position), so the annotation is dropped — mirrors stage1's LetStmt path.
        if s.let_type.name == "Fn" {
            if is_mut {
                return ind + "let mut " + s.name + " = " + val + ";\n";
            }
            return ind + "let " + s.name + " = " + val + ";\n";
        }
        let ty: String = map_type(s.let_type);
        if is_mut {
            return ind + "let mut " + s.name + ": " + ty + " = " + val + ";\n";
        }
        return ind + "let " + s.name + ": " + ty + " = " + val + ";\n";
    }
    if s.kind == compiler_ir.irst_assign() {
        return ind + generate_expr(s.target, funcs) + " = " + gen_stmt_value(s.expr, funcs, level) + ";\n";
    }
    if s.kind == compiler_ir.irst_break() {
        return ind + "break;\n";
    }
    if s.kind == compiler_ir.irst_continue() {
        return ind + "continue;\n";
    }
    if s.kind == compiler_ir.irst_if() {
        return generate_if(s, level, in_labeled, funcs, mutated);
    }
    if s.kind == compiler_ir.irst_while() {
        return generate_while(s, level, in_labeled, funcs, mutated);
    }
    if s.kind == compiler_ir.irst_for() {
        return generate_for(s, level, in_labeled, funcs, mutated);
    }
    return ind + "// unsupported stmt\n";
}

// generate_if — mirrors generateIfStmt exactly, including its whitespace quirks:
// the then-block's closing `}` is emitted WITHOUT a trailing newline, so ` else `
// (or the terminating `\n`) continues on the same line. else-if is flattened one
// level (`} else if COND {`); a deeper chain nests as `else { if ... }`, matching
// stage1. Bodies indent one level deeper than the `if`.
// Braces in the emitted Rust go through lbrace()/rbrace() — a literal `{`/`}` in
// an Intent string lexes as string interpolation.
public function generate_if(s: IrStmt, level: Int, in_labeled: Bool, funcs: Array<IrFunction>, mutated: Array<String>) returns String {
    let ind: String = indent_str(level);
    let mutable out: String = ind + "if " + generate_expr(s.expr, funcs) + " " + lbrace() + "\n";
    out = out + generate_stmts(s.then_body, level + 1, in_labeled, funcs, mutated);
    out = out + ind + rbrace();
    if s.has_else {
        let mutable is_else_if: Bool = false;
        if len(s.else_body) == 1 {
            if s.else_body[0].kind == compiler_ir.irst_if() {
                is_else_if = true;
            }
        }
        if is_else_if {
            let ei: IrStmt = s.else_body[0];
            out = out + " else if " + generate_expr(ei.expr, funcs) + " " + lbrace() + "\n";
            out = out + generate_stmts(ei.then_body, level + 1, in_labeled, funcs, mutated);
            out = out + ind + rbrace();
            if ei.has_else {
                out = out + " else " + lbrace() + "\n";
                out = out + generate_stmts(ei.else_body, level + 1, in_labeled, funcs, mutated);
                out = out + ind + rbrace() + "\n";
            } else {
                out = out + "\n";
            }
            return out;
        }
        out = out + " else " + lbrace() + "\n";
        out = out + generate_stmts(s.else_body, level + 1, in_labeled, funcs, mutated);
        out = out + ind + rbrace() + "\n";
        return out;
    }
    out = out + "\n";
    return out;
}

// generate_while — mirrors generateWhileStmt's no-contract path: `while COND {`
// ... `}`. Loop invariants / decreases (the contract path) land with contracts.
public function generate_while(s: IrStmt, level: Int, in_labeled: Bool, funcs: Array<IrFunction>, mutated: Array<String>) returns String {
    let ind: String = indent_str(level);
    let mutable out: String = ind + "while " + generate_expr(s.expr, funcs) + " " + lbrace() + "\n";
    out = out + generate_stmts(s.then_body, level + 1, in_labeled, funcs, mutated);
    out = out + ind + rbrace() + "\n";
    return out;
}

// generate_for — mirrors generateForInStmt: `for VAR in (START..END) {` for a
// range iterable, else `for VAR in EXPR.iter() {`.
public function generate_for(s: IrStmt, level: Int, in_labeled: Bool, funcs: Array<IrFunction>, mutated: Array<String>) returns String {
    let ind: String = indent_str(level);
    let mutable out: String = ind + "for " + s.name + " in ";
    if s.expr.kind == compiler_ir.irex_range() {
        out = out + "(" + generate_expr(s.expr.children[0], funcs) + ".." + generate_expr(s.expr.children[1], funcs) + ")";
    } else {
        out = out + generate_expr(s.expr, funcs) + ".iter()";
    }
    out = out + " " + lbrace() + "\n";
    out = out + generate_stmts(s.then_body, level + 1, in_labeled, funcs, mutated);
    out = out + ind + rbrace() + "\n";
    return out;
}

// generate_expr — mirrors generateExpr for the supported subset. Int literals get
// the i64 suffix; string literals (the quoted lexeme) get .to_string(); bools
// map to true/false; calls dispatch on call_kind; method calls emit
// receiver.method(args). Unsupported kinds fail loudly.
public function generate_expr(e: IrExpr, funcs: Array<IrFunction>) returns String {
    if e.kind == compiler_ir.irex_int() {
        return e.int_value.to_string() + "i64";
    }
    if e.kind == compiler_ir.irex_float() {
        // The raw float lexeme, emitted verbatim (stage1 FloatLit -> expr.Value).
        return e.str_value;
    }
    if e.kind == compiler_ir.irex_bool() {
        if e.bool_value {
            return "true";
        }
        return "false";
    }
    if e.kind == compiler_ir.irex_string() {
        return e.str_value + ".to_string()";
    }
    if e.kind == compiler_ir.irex_var() {
        return e.name;
    }
    if e.kind == compiler_ir.irex_binary() {
        return generate_binary(e, funcs);
    }
    if e.kind == compiler_ir.irex_string_concat() {
        // format!("{}{}", left, right) — mirrors stage1's StringConcat emit. The
        // "{}{}" braces go through lbrace()/rbrace().
        let l: String = generate_expr(e.children[0], funcs);
        let r: String = generate_expr(e.children[1], funcs);
        return "format!(\"" + lbrace() + rbrace() + lbrace() + rbrace() + "\", " + l + ", " + r + ")";
    }
    if e.kind == compiler_ir.irex_unary() {
        return generate_unary(e, funcs);
    }
    if e.kind == compiler_ir.irex_forall() {
        return generate_forall(e, funcs);
    }
    if e.kind == compiler_ir.irex_exists() {
        return generate_exists(e, funcs);
    }
    if e.kind == compiler_ir.irex_lambda() {
        return generate_lambda(e, funcs);
    }
    if e.kind == compiler_ir.irex_range() {
        return "(" + generate_expr(e.children[0], funcs) + ".." + generate_expr(e.children[1], funcs) + ")";
    }
    if e.kind == compiler_ir.irex_array() {
        if len(e.children) == 0 {
            return "Vec::new()";
        }
        return "vec![" + generate_args(e.children, funcs) + "]";
    }
    if e.kind == compiler_ir.irex_index() {
        // Non-String indexing: obj[idx as usize]. String indexing (.chars()) and
        // Map indexing land with their slices; the corpus indexes only Vecs.
        return generate_expr(e.children[0], funcs) + "[" + generate_expr(e.children[1], funcs) + " as usize]";
    }
    if e.kind == compiler_ir.irex_field() {
        // object.field. A field read off an indexed Vec element clones (mirrors
        // stage1's FieldAccessExpr .clone() when the object is an IndexExpr).
        let obj: String = generate_expr(e.children[0], funcs);
        if e.children[0].kind == compiler_ir.irex_index() {
            return obj + "." + e.name + ".clone()";
        }
        return obj + "." + e.name;
    }
    if e.kind == compiler_ir.irex_method() {
        return generate_method_call(e, funcs);
    }
    if e.kind == compiler_ir.irex_call() {
        return generate_call(e, funcs);
    }
    if e.kind == compiler_ir.irex_try() {
        // `operand?` — mirrors stage1's TryExpr emit.
        return generate_expr(e.children[0], funcs) + "?";
    }
    if e.kind == compiler_ir.irex_match() {
        // A match's multi-line layout is indent-relative (see gen_stmt_value), so it
        // is emitted only from a statement-direct position. A match nested elsewhere
        // (e.g. inside a binary) is unsupported for now — a loud marker, not silently
        // wrong Rust. Unreachable in the corpus.
        return "/* unsupported: match in nested expression position */";
    }
    return "/* unsupported expr */";
}

// gen_stmt_value — emit a statement-direct value expression (a let RHS, return /
// break value, assignment value, or expr-statement). A match is the one expression
// whose multi-line layout depends on the enclosing statement indent (stage1 uses
// g.indent), so it routes to the level-aware generate_match; every other expression
// is single-line and indent-independent, handled by generate_expr.
function gen_stmt_value(e: IrExpr, funcs: Array<IrFunction>, level: Int) returns String {
    if e.kind == compiler_ir.irex_match() {
        return generate_match(e, funcs, level);
    }
    return generate_expr(e, funcs);
}

// generate_match — mirrors generateMatchExpr: `match scrutinee { pattern => body, … }`.
// The scrutinee is `.clone()`d when it is a plain variable of Result/Option type;
// that type is inferred from whether any arm is a builtin (Ok/Err/Some/None) pattern
// (those match only Result/Option), so no checker types are needed. Arms indent one
// level deeper than the match's statement (level+1); the closing brace at `level`.
public function generate_match(e: IrExpr, funcs: Array<IrFunction>, level: Int) returns String {
    let scrutinee: IrExpr = e.children[0];
    let mutable scrutinee_str: String = generate_expr(scrutinee, funcs);
    if match_is_result_option(e) {
        if scrutinee.kind == compiler_ir.irex_var() {
            scrutinee_str = scrutinee_str + ".clone()";
        }
    }
    let mutable out: String = "match " + scrutinee_str + " " + lbrace() + "\n";
    let mutable i: Int = 0;
    while i < len(e.match_arms) {
        let arm: IrMatchArm = e.match_arms[i];
        out = out + indent_str(level + 1) + generate_match_pattern(arm) + " => " + generate_expr(arm.body, funcs) + ",\n";
        i = i + 1;
    }
    out = out + indent_str(level) + rbrace();
    return out;
}

// match_is_result_option — a match whose scrutinee is a Result/Option: detected by
// any arm being a builtin (Ok/Err/Some/None) pattern (which only match Result/Option;
// enum-variant patterns never do). Byte-equal with stage1's type-based check without
// threading the checker's inferred types.
function match_is_result_option(e: IrExpr) returns Bool {
    let mutable i: Int = 0;
    while i < len(e.match_arms) {
        if e.match_arms[i].is_builtin {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// generate_match_pattern — mirrors generateMatchPattern for the builtin (Ok/Err/
// Some/None) and wildcard cases: `_`, `None`, or `Variant(binding)`. Enum-variant
// patterns (EnumName mangling + field-name struct patterns) land with the enums
// slice; unreachable for the Result/Option corpus.
public function generate_match_pattern(arm: IrMatchArm) returns String {
    if arm.is_wildcard {
        return "_";
    }
    if arm.is_builtin {
        if arm.variant == "None" {
            return "None";
        }
        if len(arm.bindings) == 1 {
            return arm.variant + "(" + arm.bindings[0] + ")";
        }
        return arm.variant;
    }
    // Enum-variant pattern. A unit variant (no bindings) is `EnumName::Variant`; a
    // data variant is `EnumName::Variant { field: binding, … }`, pairing the resolved
    // field_names with the pattern bindings (each an identifier or `_`) by position.
    if len(arm.bindings) == 0 {
        return arm.enum_name + "::" + arm.variant;
    }
    let mutable out: String = arm.enum_name + "::" + arm.variant + " " + lbrace() + " ";
    let mutable i: Int = 0;
    while i < len(arm.bindings) {
        if i > 0 {
            out = out + ", ";
        }
        out = out + arm.field_names[i] + ": " + arm.bindings[i];
        i = i + 1;
    }
    out = out + " " + rbrace();
    return out;
}

// generate_method_call — mirrors generateMethodCallExpr's general path
// (receiver.method(args)). children[0] is the receiver; children[1..] the args.
// Receiver-type-specific rewrites (String/Map/Char methods, is_ok/…, the
// module-qualified path) and arg cloning land with their slices; the corpus uses
// only `Vec::push`, which takes this general path.
public function generate_method_call(e: IrExpr, funcs: Array<IrFunction>) returns String {
    let obj: String = generate_expr(e.children[0], funcs);
    let mutable out: String = obj + "." + e.name + "(";
    let mutable i: Int = 1;
    while i < len(e.children) {
        if i > 1 {
            out = out + ", ";
        }
        out = out + generate_expr(e.children[i], funcs);
        i = i + 1;
    }
    out = out + ")";
    return out;
}

// generate_binary — mirrors generateExpr's BinaryExpr case: fully parenthesised
// `(left op right)`, with `implies` lowered to `(!left || right)`. String
// concatenation (a StringConcat node, or the PLUS-on-string-literal fallback)
// lands with the strings slice; here every `+` is a numeric add.
public function generate_binary(e: IrExpr, funcs: Array<IrFunction>) returns String {
    let left: String = generate_expr(e.children[0], funcs);
    let right: String = generate_expr(e.children[1], funcs);
    // Fallback string-concat detection (mirrors stage1's generateExpr BinaryExpr
    // case): a `+` where either operand is a string LITERAL emits format!, even if
    // lowering did not build a StringConcat node (it does when both operand types
    // are reconstructable). Typechecking guarantees a StringLit's partner is also
    // String, so this and the irex_string_concat path agree.
    if e.name == "+" {
        if e.children[0].kind == compiler_ir.irex_string() or e.children[1].kind == compiler_ir.irex_string() {
            return "format!(\"" + lbrace() + rbrace() + lbrace() + rbrace() + "\", " + left + ", " + right + ")";
        }
    }
    if e.name == "implies" {
        return "(!" + left + " || " + right + ")";
    }
    return "(" + left + " " + map_op(e.name) + " " + right + ")";
}

// generate_unary — mirrors generateExpr's UnaryExpr case: `not X` -> `!X`, `- X`
// -> `-X`, with no added parens (the operand parenthesises itself when it is a
// binary expression).
public function generate_unary(e: IrExpr, funcs: Array<IrFunction>) returns String {
    let operand: String = generate_expr(e.children[0], funcs);
    if e.name == "not" {
        return "!" + operand;
    }
    return "-" + operand;
}

// generate_lambda — mirrors generateLambdaExpr: `|p: T, …| -> R { body }`. Params
// come from lambda_params (each type via map_type), the return type from expr_type,
// and the body from children[0]. Braces via lbrace()/rbrace().
public function generate_lambda(e: IrExpr, funcs: Array<IrFunction>) returns String {
    let mutable out: String = "|";
    let mutable i: Int = 0;
    while i < len(e.lambda_params) {
        if i > 0 {
            out = out + ", ";
        }
        out = out + e.lambda_params[i].name + ": " + map_type(e.lambda_params[i].param_type);
        i = i + 1;
    }
    out = out + "| -> " + map_type(e.expr_type) + " " + lbrace() + " " + generate_expr(e.children[0], funcs) + " " + rbrace();
    return out;
}

// generate_forall — mirrors generateForallExpr: expand `forall var in a..b: body`
// to a `{ let mut __forall_holds = true; for var in (a..b) { if !(body) { … } }
// __forall_holds }` block. The indentation is a FIXED template (4/8/12 spaces),
// not relative to the surrounding statement — faithfully matching stage1 (quantifiers
// appear only in contract asserts at body level in the corpus). children[0] is the
// irex_range (its own children are start/end), children[1] the body. Braces via
// lbrace()/rbrace().
public function generate_forall(e: IrExpr, funcs: Array<IrFunction>) returns String {
    let range_expr: IrExpr = e.children[0];
    let range_start: String = generate_expr(range_expr.children[0], funcs);
    let range_end: String = generate_expr(range_expr.children[1], funcs);
    let body: String = generate_expr(e.children[1], funcs);
    let mutable out: String = lbrace() + "\n";
    out = out + "    let mut __forall_holds = true;\n";
    out = out + "    for " + e.name + " in (" + range_start + ".." + range_end + ") " + lbrace() + "\n";
    out = out + "        if !(" + body + ") " + lbrace() + "\n";
    out = out + "            __forall_holds = false;\n";
    out = out + "            break;\n";
    out = out + "        " + rbrace() + "\n";
    out = out + "    " + rbrace() + "\n";
    out = out + "    __forall_holds\n";
    out = out + rbrace();
    return out;
}

// generate_exists — mirrors generateExistsExpr: the exists counterpart of
// generate_forall (__exists_found, `if body` sets it true and breaks).
public function generate_exists(e: IrExpr, funcs: Array<IrFunction>) returns String {
    let range_expr: IrExpr = e.children[0];
    let range_start: String = generate_expr(range_expr.children[0], funcs);
    let range_end: String = generate_expr(range_expr.children[1], funcs);
    let body: String = generate_expr(e.children[1], funcs);
    let mutable out: String = lbrace() + "\n";
    out = out + "    let mut __exists_found = false;\n";
    out = out + "    for " + e.name + " in (" + range_start + ".." + range_end + ") " + lbrace() + "\n";
    out = out + "        if " + body + " " + lbrace() + "\n";
    out = out + "            __exists_found = true;\n";
    out = out + "            break;\n";
    out = out + "        " + rbrace() + "\n";
    out = out + "    " + rbrace() + "\n";
    out = out + "    __exists_found\n";
    out = out + rbrace();
    return out;
}

// map_op — mirrors mapOperator: operator source text to its Rust spelling
// (and/or become &&/||). `implies` is handled in generate_binary, not here.
public function map_op(op: String) returns String {
    if op == "+" {
        return "+";
    }
    if op == "-" {
        return "-";
    }
    if op == "*" {
        return "*";
    }
    if op == "/" {
        return "/";
    }
    if op == "%" {
        return "%";
    }
    if op == "==" {
        return "==";
    }
    if op == "!=" {
        return "!=";
    }
    if op == "<" {
        return "<";
    }
    if op == ">" {
        return ">";
    }
    if op == "<=" {
        return "<=";
    }
    if op == ">=" {
        return ">=";
    }
    if op == "and" {
        return "&&";
    }
    if op == "or" {
        return "||";
    }
    return "?";
}

// map_type — mirrors mapType for the primitives and the std-prelude generics
// (Array/Result/Option, recursing through type_args). Map (needs a HashMap use
// statement), Future, Fn, and entity/enum name mangling land with their slices;
// an empty name (un-annotated / uninferred type) and everything else fail loudly.
public function map_type(t: IrType) returns String {
    if t.name == "Int" {
        return "i64";
    }
    if t.name == "Float" {
        return "f64";
    }
    if t.name == "String" {
        return "String";
    }
    if t.name == "Bool" {
        return "bool";
    }
    if t.name == "Void" {
        return "()";
    }
    if t.name == "Char" {
        return "char";
    }
    if t.name == "Array" {
        if len(t.type_args) == 1 {
            return "Vec<" + map_type(t.type_args[0]) + ">";
        }
        return "Vec<_>";
    }
    if t.name == "Result" {
        if len(t.type_args) == 2 {
            return "Result<" + map_type(t.type_args[0]) + ", " + map_type(t.type_args[1]) + ">";
        }
        return "Result<_, _>";
    }
    if t.name == "Option" {
        if len(t.type_args) == 1 {
            return "Option<" + map_type(t.type_args[0]) + ">";
        }
        return "Option<_>";
    }
    if t.name == "Fn" {
        // ir_parse_type stores a Fn's type_args as [param0..paramN-1, return],
        // with fn_param_count = N. Mirrors mapType's `impl Fn(params) -> ret`
        // (`impl Fn()` collapses to `impl Fn() -> ret` for a zero-param Fn).
        let mutable params: String = "";
        let mutable i: Int = 0;
        while i < t.fn_param_count {
            if i > 0 {
                params = params + ", ";
            }
            params = params + map_type(t.type_args[i]);
            i = i + 1;
        }
        return "impl Fn(" + params + ") -> " + map_type(t.type_args[t.fn_param_count]);
    }
    // Default: a user-defined type name (enum / entity) maps to its bare name in
    // single-file emit (stage1 mapType's default -> mangled name, no prefix here).
    // An empty name is the uninferred sentinel -> a loud marker (a lowering gap,
    // unreachable for the annotated corpus), never silently-wrong Rust.
    if t.name == "" {
        return "/* unsupported type: <empty> */";
    }
    return t.name;
}

// generate_call — mirrors generateCallExpr. Builtins dispatch to
// generate_builtin_call; constructor/variant emission lands with the
// entities/enums slices. For a plain function call, each arg whose callee param is
// Array/Map is borrowed (`&arg`) unless already a reference, matching the
// `&Vec`/`&HashMap` param signatures (stage1 g.functions lookup).
public function generate_call(e: IrExpr, funcs: Array<IrFunction>) returns String {
    if e.call_kind == compiler_ir.callkind_builtin() {
        return generate_builtin_call(e, funcs);
    }
    if e.call_kind == compiler_ir.callkind_variant() {
        return generate_variant_constructor(e, funcs);
    }
    if e.call_kind == compiler_ir.callkind_constructor() {
        // Entity constructor call: `Name::new(args)`, each arg cloned if a non-Copy
        // place (mirrors stage1's CallConstructor cloneIfNeeded on each arg).
        let mutable out: String = e.name + "::new(";
        let mutable ci: Int = 0;
        while ci < len(e.children) {
            if ci > 0 {
                out = out + ", ";
            }
            out = out + clone_if_needed(generate_expr(e.children[ci], funcs), e.children[ci]);
            ci = ci + 1;
        }
        out = out + ")";
        return out;
    }
    let mutable out: String = e.name + "(";
    let mutable i: Int = 0;
    while i < len(e.children) {
        if i > 0 {
            out = out + ", ";
        }
        let mutable a: String = generate_expr(e.children[i], funcs);
        if param_is_arrayref(funcs, e.name, i) {
            if not starts_with_amp(a) {
                a = "&" + a;
            }
        }
        // Clone non-Copy place args (String/Array/entity variables) so they are
        // not moved out of their owner. Runs AFTER the &-borrow so a borrowed
        // Array arg (`&arr`) is left alone (starts_with_amp guard).
        a = clone_if_needed(a, e.children[i]);
        out = out + a;
        i = i + 1;
    }
    out = out + ")";
    return out;
}

// generate_variant_constructor — mirrors generateVariantConstructor: a unit variant
// (no field names) is `EnumName::Variant`; a data variant is `EnumName::Variant {
// field: arg, … }`, pairing the resolved field_names with the args (children) by
// position. Variant args are NOT cloned (mirrors stage1's plain generateExpr).
public function generate_variant_constructor(e: IrExpr, funcs: Array<IrFunction>) returns String {
    if len(e.field_names) == 0 {
        return e.enum_name + "::" + e.name;
    }
    let mutable out: String = e.enum_name + "::" + e.name + " " + lbrace() + " ";
    let mutable i: Int = 0;
    while i < len(e.field_names) {
        if i > 0 {
            out = out + ", ";
        }
        out = out + e.field_names[i] + ": " + generate_expr(e.children[i], funcs);
        i = i + 1;
    }
    out = out + " " + rbrace();
    return out;
}

// generate_builtin_call — mirrors generateBuiltinCall. Args that are calls to
// Array/Map-param functions borrow via the recursive generate_expr, so
// assert_eq(sum_array(arr), …) emits sum_array(&arr). Non-Copy-arg cloning and the
// entity-eq special case land with the arrays/entities slices; other builtins
// fail loudly until their emit slice.
public function generate_builtin_call(e: IrExpr, funcs: Array<IrFunction>) returns String {
    if e.name == "assert" {
        return "assert!(" + generate_expr(e.children[0], funcs) + ", \"assertion failed\")";
    }
    if e.name == "assert_eq" {
        // Clone non-Copy actual/expected args (mirrors stage1's cloneIfNeeded on
        // both assert_eq operands). The entity-eq special case lands with entities.
        let actual: String = clone_if_needed(generate_expr(e.children[0], funcs), e.children[0]);
        let expected: String = clone_if_needed(generate_expr(e.children[1], funcs), e.children[1]);
        return "assert_eq!(" + actual + ", " + expected + ", \"assertion failed\")";
    }
    if e.name == "assert_close" {
        // assert!(((A) - (B)).abs() <= (C), "...") — the three float args are not
        // cloned (mirrors stage1; any inner call clones its own receiver/args).
        let a: String = generate_expr(e.children[0], funcs);
        let b: String = generate_expr(e.children[1], funcs);
        let c: String = generate_expr(e.children[2], funcs);
        return "assert!(((" + a + ") - (" + b + ")).abs() <= (" + c + "), \"assertion failed: floats not within epsilon\")";
    }
    if e.name == "print" {
        // println!("{}", ARG) — the "{}" braces go through lbrace()/rbrace().
        return "println!(\"" + lbrace() + rbrace() + "\", " + generate_expr(e.children[0], funcs) + ")";
    }
    if e.name == "len" {
        // Non-String len: (ARG.len() as i64). String len (.chars().count()) is
        // deferred; the corpus calls len only on Vecs.
        return "(" + generate_expr(e.children[0], funcs) + ".len() as i64)";
    }
    if e.name == "Ok" or e.name == "Err" or e.name == "Some" {
        // Result/Option constructors: Ok(x) / Err(x) / Some(x). A non-Copy place
        // arg (a String/entity/Array variable) is cloned so it is not moved into
        // the constructor (mirrors stage1's cloneIfNeeded on the single arg).
        let arg: String = clone_if_needed(generate_expr(e.children[0], funcs), e.children[0]);
        return e.name + "(" + arg + ")";
    }
    if e.name == "None" {
        return "None";
    }
    if e.name == "read_file" {
        let arg: String = clone_if_needed(generate_expr(e.children[0], funcs), e.children[0]);
        return "std::fs::read_to_string(" + arg + ").map_err(|e| e.to_string())";
    }
    if e.name == "write_file" {
        let path: String = clone_if_needed(generate_expr(e.children[0], funcs), e.children[0]);
        let content: String = clone_if_needed(generate_expr(e.children[1], funcs), e.children[1]);
        return "std::fs::write(" + path + ", " + content + ").map_err(|e| e.to_string())";
    }
    if e.name == "create_dir" {
        let arg: String = clone_if_needed(generate_expr(e.children[0], funcs), e.children[0]);
        return "std::fs::create_dir_all(" + arg + ").map_err(|e| e.to_string())";
    }
    if e.name == "file_exists" {
        let arg: String = clone_if_needed(generate_expr(e.children[0], funcs), e.children[0]);
        return "std::path::Path::new(&" + arg + ").exists()";
    }
    if e.name == "env_get" {
        let arg: String = clone_if_needed(generate_expr(e.children[0], funcs), e.children[0]);
        return "std::env::var(" + arg + ").ok()";
    }
    return "/* unsupported builtin: " + e.name + " */";
}

// generate_args — comma-separated argument expressions (no borrow/clone). Used by
// array literals and other no-borrow arg lists; the call-site borrow lives in
// generate_call, which knows the callee's param types.
public function generate_args(args: Array<IrExpr>, funcs: Array<IrFunction>) returns String {
    let mutable out: String = "";
    let mutable i: Int = 0;
    while i < len(args) {
        if i > 0 {
            out = out + ", ";
        }
        out = out + generate_expr(args[i], funcs);
        i = i + 1;
    }
    return out;
}

// starts_with_amp — does s begin with '&' (already a reference)? Guards the
// call-site borrow from producing `&&x`.
public function starts_with_amp(s: String) returns Bool {
    if len(s) == 0 {
        return false;
    }
    return s[0] == '&';
}

// is_literal_expr — mirrors internal/rustbe isLiteralExpr: a literal never needs
// cloning (it is an owned temporary, not a place). Int/String/Bool/Array literals
// for the current IR; Float literals and string interpolation join as those kinds
// land (they are already excluded — an unsupported kind never reaches an arg here).
public function is_literal_expr(e: IrExpr) returns Bool {
    return e.kind == compiler_ir.irex_int() or e.kind == compiler_ir.irex_float() or e.kind == compiler_ir.irex_string() or e.kind == compiler_ir.irex_bool() or e.kind == compiler_ir.irex_array();
}

// ends_with_clone — does arg_str already end with ".clone()"? Guards against
// double-cloning (mirrors stage1's strings.HasSuffix(argStr, ".clone()")).
public function ends_with_clone(s: String) returns Bool {
    let suffix: String = ".clone()";
    let n: Int = len(s);
    let m: Int = len(suffix);
    if n < m {
        return false;
    }
    return s[n - m..n] == suffix;
}

// clone_if_needed — mirrors internal/rustbe (*generator).cloneIfNeeded: append
// `.clone()` to an argument whose expression is a non-Copy place (a variable or
// index reference) that Rust would otherwise MOVE out of its owner. Skips literals
// (owned temporaries), already-borrowed args (`&x`), and already-cloned args. The
// ADR 0059 D3 type bridge stamps VarRef.expr_type in lowering; an unstamped
// (empty) type is treated Copy by ir_is_copy_type, so this never over-clones.
// FieldAccess joins the kind check when entities land (they carry a stamped type).
public function clone_if_needed(arg_str: String, arg: IrExpr) returns String {
    if is_literal_expr(arg) {
        return arg_str;
    }
    if starts_with_amp(arg_str) {
        return arg_str;
    }
    if ends_with_clone(arg_str) {
        return arg_str;
    }
    if arg.kind == compiler_ir.irex_var() or arg.kind == compiler_ir.irex_index() {
        if not compiler_ir.ir_is_copy_type(arg.expr_type) {
            return arg_str + ".clone()";
        }
    }
    return arg_str;
}

// sanitise_test_name — mirrors sanitiseTestName exactly (ASCII rules, NOT the
// Unicode is_alpha helpers): lowercase ASCII letters/digits kept, uppercase
// lowercased, a leading digit prefixed with '_', every other run of characters
// collapsed to a single '_', leading '_' suppressed, trailing '_' trimmed,
// empty -> "unnamed". Codepoint comparisons avoid any reliance on Char ordering.
public function sanitise_test_name(name: String) returns String {
    let mutable b: String = "";
    let mutable prev_underscore: Bool = true;
    let mutable i: Int = 0;
    while i < len(name) {
        let c: Char = name[i];
        let cp: Int = c.to_codepoint();
        if cp >= 97 and cp <= 122 {
            b = b + c.to_string();
            prev_underscore = false;
        } else {
            if cp >= 65 and cp <= 90 {
                b = b + c.to_string().to_lowercase();
                prev_underscore = false;
            } else {
                if cp >= 48 and cp <= 57 {
                    if len(b) == 0 {
                        b = b + "_";
                    }
                    b = b + c.to_string();
                    prev_underscore = false;
                } else {
                    if not prev_underscore {
                        b = b + "_";
                        prev_underscore = true;
                    }
                }
            }
        }
        i = i + 1;
    }
    let trimmed: String = trim_trailing_underscores(b);
    if trimmed == "" {
        return "unnamed";
    }
    return trimmed;
}

// trim_trailing_underscores — return s without any trailing '_' (codepoint 95).
// Built char-by-char (no slicing / short-circuit assumptions).
public function trim_trailing_underscores(s: String) returns String {
    let n: Int = len(s);
    let mutable last: Int = -1;
    let mutable i: Int = 0;
    while i < n {
        if s[i].to_codepoint() != 95 {
            last = i;
        }
        i = i + 1;
    }
    let mutable out: String = "";
    let mutable j: Int = 0;
    while j <= last {
        out = out + s[j].to_string();
        j = j + 1;
    }
    return out;
}

// indent_str — `level` copies of four spaces (mirrors indentStr).
public function indent_str(level: Int) returns String {
    let mutable s: String = "";
    let mutable i: Int = 0;
    while i < level {
        s = s + "    ";
        i = i + 1;
    }
    return s;
}

// lbrace / rbrace — literal `{` / `}` via char-to-string; a bare `{`/`}` in a
// string literal would lex as string interpolation (see check_test.intent).
public function lbrace() returns String {
    return '{'.to_string();
}

public function rbrace() returns String {
    return '}'.to_string();
}

// No entry function here — a library module imported by compile_main.intent.
