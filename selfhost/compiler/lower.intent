// selfhost/compiler/lower.intent — Phase 55 / ADR 0059 stage2 self-hosted compiler.
//
// AST -> IR lowering, reimplemented in Intent. Slice 55b: lowers the trivial
// subset examples/hello.intent uses — one entry function with a `return <int>`,
// and a test whose body is a single `assert(<bool>)` expr-stmt. Mirrors
// internal/ir/lower.go's Lower / lowerFunction / lowerTest / lowerBlock /
// lowerStmt / lowerExpr / resolveCallKind for exactly those cases; more cases
// land per construct slice (each byte-equal-gated by `make diff-emit` in 55c).
//
// Type handling (ADR 0059 D3): the trivial subset's literal types are inferred
// STRUCTURALLY (0 -> Int, "..." -> String, true -> Bool) via the ir_*_lit
// helpers, so no checker CheckResult is threaded. Constructs whose types come
// from inference (variable/field/method types, generics) will introduce a
// checker.Type -> IrType bridge in the slice that needs it.
module compiler_lower version "0.1.0";

import "ir.intent";

import "../shared/ast.intent";

// =============================================================================
// LowerScope — local var-name -> IrType map for the type bridge (ADR 0059 D3).
//
// Stage1 lowering reads every node's type from the checker's precomputed
// exprTypes map (see typeOf in lower.go). Stage2 carries no such map, so lowering
// reconstructs the types it actually needs — currently just enough to stamp each
// VarRef's expr_type so the Rust backend's cloneIfNeeded can tell a non-Copy
// argument (String/Array/entity/…) that must be `.clone()`d from a Copy one.
//
// The scope is FUNCTIONAL/immutable, mirroring the checker's Scope: each
// lower_scope_define copies the arrays and returns a NEW scope (never mutating in
// place). This also sidesteps gotcha (c): a function's `Array` param lowers to
// `&Vec` which cannot be moved into an owned entity field — but the copied
// new_names/new_types arrays are LOCAL owned arrays at the constructor call site,
// so they move in cleanly.
//
// It is seeded from a function's params (name -> param_type) and grows as
// lower_block walks let-bindings (name -> let_type). Nested blocks (if/while/for
// bodies) inherit the enclosing scope by value, so their own lets stay local —
// no leak back out. For-loop / lambda / match-arm bindings are left unstamped for
// now (their VarRefs get the empty/unknown type -> treated Copy -> never cloned,
// which is conservative and corpus-safe); each lands with its construct's slice.
// =============================================================================
entity LowerScope {
    field names: Array<String>;
    field types: Array<IrType>;
    // enums / entities — the program's declarations, carried CONSTANT on the scope
    // so the deep lower_expr chain can resolve variant constructors, unit-variant
    // refs, match-pattern field names, and entity constructor calls without threading
    // extra parameters. Preserved by lower_scope_define, seeded once by _empty.
    field enums: Array<EnumDecl>;
    field entities: Array<EntityDecl>;
    // self_name — what a `self` identifier lowers to: "self" (methods) or "__self"
    // (constructors, where stage1 emits the struct being built). in_old — true while
    // lowering an ensures clause, so an `old(expr)` call lowers to its captured var.
    // self_entity_name — the entity currently being lowered (for stamping `self.field`
    // access types, needed by receiver-type method dispatch like Map/String/Char).
    field self_name: String;
    field in_old: Bool;
    field self_entity_name: String;
    // join_handle_vars — names bound to a `spawn` result (a Future/JoinHandle), so
    // `await <name>` emits the JoinHandle unwrap (`.expect(...)`). Accumulated in
    // lower_block (like let types), mirroring stage1's joinHandleVars.
    field join_handle_vars: Array<String>;
    // module_names / module_prefixes — parallel arrays mapping an imported-module
    // qualifier (the file-base or `module` decl name a user writes before `.`) to
    // its Rust name prefix (file-base + "_"). Carried CONSTANT on the scope (like
    // enums/entities) so lower_expr can turn `mod.fn(args)` into a mangled free-fn
    // call `mod_fn(args)` (multi-file emit, ADR 0059). EMPTY in single-file, so the
    // detection never fires and single-file emit is byte-unchanged. Threaded through
    // the copy helpers as constructor args (like enums/entities), set per module in
    // lower_module.
    field module_names: Array<String>;
    field module_prefixes: Array<String>;
    // type_names / type_prefixes — the GLOBAL type-origins map (entity/enum name ->
    // defining module's struct prefix). Carried CONSTANT like the module map so
    // lower_stmt (let type) and lower_expr (constructor call, variant construction) can
    // mangle cross-module type references. EMPTY in single-file. Set via _apply_ctx.
    field type_names: Array<String>;
    field type_prefixes: Array<String>;
    // name_prefix — the CURRENT module's function prefix (`ir_` for a non-entry module
    // named ir.intent, "" for the entry module). A plain (same-module) function call is
    // emitted `<name_prefix><fn>` because every non-entry function DEFINITION is prefixed
    // (mirrors stage1's `g.namePrefix + expr.Function`). EMPTY in single-file / entry.
    field name_prefix: String;
    // func_names / func_returns — the GLOBAL free-function return-type registry, carried
    // constant so lower_expr can stamp a call's result type. EMPTY in single-file.
    field func_names: Array<String>;
    field func_returns: Array<IrType>;
    // extern_names / extern_paths — extern (FFI) fn name -> its Rust path (`from "..."`).
    // An extern CALL emits the path directly (blake3_hash_hex -> blake3_intent::hash_hex);
    // the extern decl itself emits nothing. Carried constant on the scope. EMPTY normally.
    field extern_names: Array<String>;
    field extern_paths: Array<String>;

    constructor(names: Array<String>, types: Array<IrType>, enums: Array<EnumDecl>, entities: Array<EntityDecl>, self_name: String, in_old: Bool, self_entity_name: String, join_handle_vars: Array<String>, module_names: Array<String>, module_prefixes: Array<String>, type_names: Array<String>, type_prefixes: Array<String>, name_prefix: String, func_names: Array<String>, func_returns: Array<IrType>, extern_names: Array<String>, extern_paths: Array<String>) {
        self.names = names;
        self.types = types;
        self.enums = enums;
        self.entities = entities;
        self.self_name = self_name;
        self.in_old = in_old;
        self.self_entity_name = self_entity_name;
        self.join_handle_vars = join_handle_vars;
        self.module_names = module_names;
        self.module_prefixes = module_prefixes;
        self.type_names = type_names;
        self.type_prefixes = type_prefixes;
        self.name_prefix = name_prefix;
        self.func_names = func_names;
        self.func_returns = func_returns;
        self.extern_names = extern_names;
        self.extern_paths = extern_paths;
    }
}

// lower_scope_empty — a fresh scope with no bindings, seeded with the program's enum
// and entity decls. The `&Vec` params are copied into LOCAL owned arrays before being
// moved into the fields (gotcha (c)). self_name defaults "self", in_old false.
function lower_scope_empty(enums: Array<EnumDecl>, entities: Array<EntityDecl>) returns LowerScope {
    let mutable e: Array<EnumDecl> = [];
    let mutable ei: Int = 0;
    while ei < len(enums) {
        e.push(enums[ei]);
        ei = ei + 1;
    }
    let mutable ent: Array<EntityDecl> = [];
    let mutable enti: Int = 0;
    while enti < len(entities) {
        ent.push(entities[enti]);
        enti = enti + 1;
    }
    return LowerScope(shared_ast.empty_string_array(), compiler_ir.empty_ir_type_array(), e, ent, "self", false, "", shared_ast.empty_string_array(), shared_ast.empty_string_array(), shared_ast.empty_string_array(), shared_ast.empty_string_array(), shared_ast.empty_string_array(), "", shared_ast.empty_string_array(), compiler_ir.empty_ir_type_array(), shared_ast.empty_string_array(), shared_ast.empty_string_array());
}

// lower_scope_apply_ctx — a copy of `s` with the module-qualifier map AND the type-
// origins map set from the module's LowerCtx. Called once per member/function; the maps
// then ride through lower_scope_define/with_self/... to lower_stmt/lower_expr, where
// `mod.fn(args)` becomes `mod_fn(args)` and a cross-module type `Point` becomes
// `TypesPoint`. Both maps are EMPTY in single-file, so nothing mangles.
function lower_scope_apply_ctx(s: LowerScope, ctx: LowerCtx) returns LowerScope {
    return LowerScope(s.names, s.types, s.enums, s.entities, s.self_name, s.in_old, s.self_entity_name, s.join_handle_vars, ctx.module_names, ctx.module_prefixes, ctx.type_names, ctx.type_prefixes, ctx.name_prefix, ctx.func_names, ctx.func_returns, ctx.extern_names, ctx.extern_paths);
}

// path_module_name — the module name for a source path: the file base with the
// directory and the `.intent` suffix stripped (mirrors stage1's
// strings.TrimSuffix(filepath.Base(path), ".intent")). ASCII paths only.
public function path_module_name(path: String) returns String {
    let n: Int = len(path);
    let mutable last_slash: Int = -1;
    let mutable i: Int = 0;
    while i < n {
        if path[i] == '/' {
            last_slash = i;
        }
        i = i + 1;
    }
    let mutable base: String = path;
    if last_slash >= 0 {
        base = base[last_slash + 1..n];
    }
    let bn: Int = len(base);
    if bn > 7 {
        if base[bn - 7..bn] == ".intent" {
            base = base[0..bn - 7];
        }
    }
    return base;
}

// path_parent_dir — the name of the directory containing `path` (its last component).
// A cross-package import qualifier is the dependency name, which by convention equals the
// package directory name (stage1 gets it from intent.toml via packageDirs; the stage2
// lowering only has paths, so it derives it here). "" if the path has no directory.
public function path_parent_dir(path: String) returns String {
    let n: Int = len(path);
    let mutable last_slash: Int = 0 - 1;
    let mutable i: Int = 0;
    while i < n {
        if path[i] == '/' {
            last_slash = i;
        }
        i = i + 1;
    }
    if last_slash <= 0 {
        return "";
    }
    let mutable prev_slash: Int = 0 - 1;
    let mutable j: Int = 0;
    while j < last_slash {
        if path[j] == '/' {
            prev_slash = j;
        }
        j = j + 1;
    }
    return path[prev_slash + 1..last_slash];
}

// LowerCtx — per-module lowering context. name_prefix is "" for the entry module (its
// functions keep their names; an `entry` function becomes `fn main`) and "<file-base>_"
// for imported modules (every function is prefixed and demoted from entry).
// module_names/module_prefixes are the GLOBAL module-qualifier map (`mod` -> `mod_`).
// type_names/type_prefixes are the GLOBAL type-origins map: every entity/enum name ->
// its defining module's struct prefix (Capitalised file base, "" for the entry module),
// so a cross-module type reference `Point` emits as `TypesPoint`. Both global maps are
// the same for every module (any module may reference any other's types/functions).
public entity LowerCtx {
    field name_prefix: String;
    field module_names: Array<String>;
    field module_prefixes: Array<String>;
    field type_names: Array<String>;
    field type_prefixes: Array<String>;
    // func_names / func_returns — the GLOBAL free-function return-type registry (every
    // module's free functions, by ORIGINAL name -> return IrType). Lets lower_expr stamp
    // a call's result type so string-concat detection (`a + str_call()` -> format!) and
    // receiver dispatch on a call result fire. Mirrors stage1 reading the checker's
    // exprTypes. EMPTY in single-file.
    field func_names: Array<String>;
    field func_returns: Array<IrType>;
    field extern_names: Array<String>;
    field extern_paths: Array<String>;

    constructor(name_prefix: String, module_names: Array<String>, module_prefixes: Array<String>, type_names: Array<String>, type_prefixes: Array<String>, func_names: Array<String>, func_returns: Array<IrType>, extern_names: Array<String>, extern_paths: Array<String>) {
        self.name_prefix = name_prefix;
        self.module_names = module_names;
        self.module_prefixes = module_prefixes;
        self.type_names = type_names;
        self.type_prefixes = type_prefixes;
        self.func_names = func_names;
        self.func_returns = func_returns;
        self.extern_names = extern_names;
        self.extern_paths = extern_paths;
    }
}

// empty_lower_ctx — the single-file context: no name prefix, no module/type/func maps.
// Keeps the single-file `lower` path byte-identical (no mangling / stamping fires).
public function empty_lower_ctx() returns LowerCtx {
    return LowerCtx("", shared_ast.empty_string_array(), shared_ast.empty_string_array(), shared_ast.empty_string_array(), shared_ast.empty_string_array(), shared_ast.empty_string_array(), compiler_ir.empty_ir_type_array(), shared_ast.empty_string_array(), shared_ast.empty_string_array());
}

// capitalize — first ASCII letter uppercased (mirrors stage1's structPrefix =
// strings.ToUpper(name[:1]) + name[1:]). ASCII only.
public function capitalize(s: String) returns String {
    if len(s) == 0 {
        return s;
    }
    let cp: Int = s[0].to_codepoint();
    let mutable first: String = s[0].to_string();
    if cp >= 97 and cp <= 122 {
        // cp-32 is always a valid ASCII uppercase letter; char_from_codepoint returns
        // Result<Char, String>, so unwrap via match (Err is unreachable here).
        first = match char_from_codepoint(cp - 32) {
    Ok(c) => c.to_string(),
    Err(_) => s[0].to_string(),
};
    }
    let rest: String = s[1..len(s)];
    return first + rest;
}

// mangle_type_name — a user entity/enum name mapped through the type-origins arrays:
// prefix + name when found (the defining module's struct prefix), else the name
// unchanged (builtin types and same-name-not-found leave it alone). Mirrors stage1's
// mangledEntityName/mangledEnumName (typeOrigins lookup).
public function mangle_type_name(name: String, type_names: Array<String>, type_prefixes: Array<String>) returns String {
    let mutable i: Int = 0;
    while i < len(type_names) {
        if type_names[i] == name {
            return type_prefixes[i] + name;
        }
        i = i + 1;
    }
    return name;
}

// is_user_type_name — true when name is a known user entity/enum (present in the
// type-origins arrays). Used to distinguish a generic instantiation of a user type
// (which monomorphizes to a global name) from a builtin generic like Array<T>.
function is_user_type_name(name: String, type_names: Array<String>) returns Bool {
    let mutable i: Int = 0;
    while i < len(type_names) {
        if type_names[i] == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// mangle_ir_type — an IrType with every user entity/enum name (its own and nested
// type_args) mangled through the type-origins map. Builtins (Int, Array, Map, Fn, …)
// keep their names; their type_args are recursed so e.g. Array<Point> -> Array<TypesPoint>.
public function mangle_ir_type(t: IrType, type_names: Array<String>, type_prefixes: Array<String>) returns IrType {
    // A generic instantiation of a user entity/enum (type_args present and the base
    // is a known user type) monomorphizes to a single global type (Pair<Int> ->
    // Pair__Int) shared across every module — its base must NOT take a module prefix,
    // and its args stay bare so map_type's __<args> suffix matches stage1 (which
    // mangles from the unprefixed arg names). Prefixing produced dangling references
    // like LibPair__Int with no matching struct.
    if len(t.type_args) > 0 {
        if is_user_type_name(t.name, type_names) {
            return IrType(t.name, t.type_args, t.fn_param_count);
        }
    }
    let mutable margs: Array<IrType> = compiler_ir.empty_ir_type_array();
    let mutable i: Int = 0;
    while i < len(t.type_args) {
        margs.push(mangle_ir_type(t.type_args[i], type_names, type_prefixes));
        i = i + 1;
    }
    return IrType(mangle_type_name(t.name, type_names, type_prefixes), margs, t.fn_param_count);
}

// lower_scope_define — a NEW scope with `name: ty` appended (copies names/types,
// mirroring the checker's scope_define_typed). The registries + self_name + in_old
// carry over (field reads clone them into the new scope).
function lower_scope_define(s: LowerScope, name: String, ty: IrType) returns LowerScope {
    let mutable new_names: Array<String> = shared_ast.empty_string_array();
    let mutable i: Int = 0;
    while i < len(s.names) {
        new_names.push(s.names[i]);
        i = i + 1;
    }
    new_names.push(name);
    let mutable new_types: Array<IrType> = compiler_ir.empty_ir_type_array();
    let mutable ti: Int = 0;
    while ti < len(s.types) {
        new_types.push(s.types[ti]);
        ti = ti + 1;
    }
    new_types.push(ty);
    return LowerScope(new_names, new_types, s.enums, s.entities, s.self_name, s.in_old, s.self_entity_name, s.join_handle_vars, s.module_names, s.module_prefixes, s.type_names, s.type_prefixes, s.name_prefix, s.func_names, s.func_returns, s.extern_names, s.extern_paths);
}

// lower_scope_with_self — a copy of `s` with self_name + self_entity_name set (for
// entity members: methods use "self", constructors "__self").
function lower_scope_with_self(s: LowerScope, name: String, entity_name: String) returns LowerScope {
    return LowerScope(s.names, s.types, s.enums, s.entities, name, s.in_old, entity_name, s.join_handle_vars, s.module_names, s.module_prefixes, s.type_names, s.type_prefixes, s.name_prefix, s.func_names, s.func_returns, s.extern_names, s.extern_paths);
}

// lower_scope_with_old — a copy of `s` with in_old set (for ensures clauses, where
// `old(expr)` lowers to its captured variable).
function lower_scope_with_old(s: LowerScope, flag: Bool) returns LowerScope {
    return LowerScope(s.names, s.types, s.enums, s.entities, s.self_name, flag, s.self_entity_name, s.join_handle_vars, s.module_names, s.module_prefixes, s.type_names, s.type_prefixes, s.name_prefix, s.func_names, s.func_returns, s.extern_names, s.extern_paths);
}

// lower_scope_add_joinhandle — a copy of `s` with `name` recorded as a spawn-bound
// (JoinHandle) variable, so a later `await name` emits the JoinHandle unwrap.
function lower_scope_add_joinhandle(s: LowerScope, name: String) returns LowerScope {
    let mutable jh: Array<String> = shared_ast.empty_string_array();
    let mutable i: Int = 0;
    while i < len(s.join_handle_vars) {
        jh.push(s.join_handle_vars[i]);
        i = i + 1;
    }
    jh.push(name);
    return LowerScope(s.names, s.types, s.enums, s.entities, s.self_name, s.in_old, s.self_entity_name, jh, s.module_names, s.module_prefixes, s.type_names, s.type_prefixes, s.name_prefix, s.func_names, s.func_returns, s.extern_names, s.extern_paths);
}

// lookup_entity_field_type — the declared type of `field_name` in entity `ent_name`,
// or the unknown type if not found. Used to stamp `self.field` / `obj.field` access
// types for receiver-type method dispatch.
function lookup_entity_field_type(entities: Array<EntityDecl>, ent_name: String, field_name: String) returns IrType {
    let mutable i: Int = 0;
    while i < len(entities) {
        let e: EntityDecl = entities[i];
        if e.name == ent_name {
            let mutable j: Int = 0;
            while j < len(e.fields) {
                if e.fields[j].name == field_name {
                    return compiler_ir.ir_parse_type(e.fields[j].type_name);
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return compiler_ir.ir_type_named("");
}

// lookup_func_return — a free function's declared return type by name, or the unknown
// type if not found (builtins / unknown names leave the call's result untyped). Stamps a
// call's expr_type so string-concat detection and result-receiver dispatch can fire.
function lookup_func_return(func_names: Array<String>, func_returns: Array<IrType>, name: String) returns IrType {
    let mutable i: Int = 0;
    while i < len(func_names) {
        if func_names[i] == name {
            return func_returns[i];
        }
        i = i + 1;
    }
    return compiler_ir.ir_type_named("");
}

// lookup_extern_path — the Rust path (`from "..."`) of extern fn `name`, or "" if `name`
// is not an extern. An extern call emits the path directly (blake3_hash_hex ->
// blake3_intent::hash_hex); the extern decl itself emits nothing.
function lookup_extern_path(extern_names: Array<String>, extern_paths: Array<String>, name: String) returns String {
    let mutable i: Int = 0;
    while i < len(extern_names) {
        if extern_names[i] == name {
            return extern_paths[i];
        }
        i = i + 1;
    }
    return "";
}

// lookup_method_return — the declared return type of `method_name` on entity `ent_name`,
// or the unknown type if not found. Stamps a method call's result type so a chained call
// (`self.peek().is_digit()`, peek returns Char) dispatches on the right receiver type.
function lookup_method_return(entities: Array<EntityDecl>, ent_name: String, method_name: String) returns IrType {
    let mutable i: Int = 0;
    while i < len(entities) {
        let e: EntityDecl = entities[i];
        if e.name == ent_name {
            let mutable j: Int = 0;
            while j < len(e.methods) {
                if e.methods[j].name == method_name {
                    return compiler_ir.ir_parse_type(e.methods[j].return_type);
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return compiler_ir.ir_type_named("");
}

// is_known_entity — is `name` a declared entity? (Used to classify constructor calls.)
function is_known_entity(entities: Array<EntityDecl>, name: String) returns Bool {
    let mutable i: Int = 0;
    while i < len(entities) {
        if entities[i].name == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// expr_to_text / mangle_old — mirror stage1 exprToText + mangleOldExpr: a stable
// name for an `old(expr)` capture. self / identifier / field access are supported
// (the corpus's old() targets); anything else falls back to "expr".
function expr_to_text(e: Expr) returns String {
    if e.kind == shared_ast.ex_ident() {
        return e.name;
    }
    if e.kind == shared_ast.ex_field() {
        return expr_to_text(e.children[0]) + "." + e.name;
    }
    return "expr";
}

function mangle_old(inner: Expr) returns String {
    let text: String = expr_to_text(inner);
    // Replace '.' with '_' (the only separator the corpus's old() targets produce).
    let mutable out: String = "__old_";
    let mutable i: Int = 0;
    while i < len(text) {
        if text[i] == '.' {
            out = out + "_";
        } else {
            out = out + text[i].to_string();
        }
        i = i + 1;
    }
    return out;
}

// lower_scope_type_of — the IrType bound to `name`, or the empty/unknown type if
// unbound. The LAST-defined binding wins (mirrors the checker's scope_last_index),
// so an inner shadow overrides an outer name.
function lower_scope_type_of(s: LowerScope, name: String) returns IrType {
    let mutable found: Int = 0 - 1;
    let mutable i: Int = 0;
    while i < len(s.names) {
        if s.names[i] == name {
            found = i;
        }
        i = i + 1;
    }
    if found >= 0 {
        return s.types[found];
    }
    return compiler_ir.ir_type_named("");
}

// =============================================================================
// Generics: monomorphization (mirrors collectInstantiations + monomorphizeEntity).
// A generic entity `Stack<T>` is never emitted; instead each instantiation used in
// the program (Stack<Int>, Stack<String>) becomes a concrete entity `Stack__Int` /
// `Stack__String` with T substituted throughout. Type refs and constructor calls to
// `Stack<Int>` mangle to the concrete name (map_type / the ex_call ctor path).
// =============================================================================
// entity_is_generic — is `name` a declared entity with type parameters?
function entity_is_generic(entities: Array<EntityDecl>, name: String) returns Bool {
    let mutable i: Int = 0;
    while i < len(entities) {
        if entities[i].name == name {
            return len(entities[i].type_params) > 0;
        }
        i = i + 1;
    }
    return false;
}

// find_entity_decl — the entity decl named `name`, or an empty one (name "") if absent.
function find_entity_decl(entities: Array<EntityDecl>, name: String) returns EntityDecl {
    let mutable i: Int = 0;
    while i < len(entities) {
        if entities[i].name == name {
            return entities[i];
        }
        i = i + 1;
    }
    let mutable fields: Array<FieldDecl> = [];
    let mutable methods: Array<FunctionDecl> = [];
    let mutable invs: Array<Expr> = [];
    let mutable cmts: Array<String> = [];
    return EntityDecl("", false, fields, methods, false, shared_ast.empty_function_decl(), invs, 0, cmts);
}

// append_types — functional concat of two Array<IrType> (immutable-param safe).
function append_types(a: Array<IrType>, b: Array<IrType>) returns Array<IrType> {
    let mutable out: Array<IrType> = compiler_ir.empty_ir_type_array();
    let mutable i: Int = 0;
    while i < len(a) {
        out.push(a[i]);
        i = i + 1;
    }
    let mutable j: Int = 0;
    while j < len(b) {
        out.push(b[j]);
        j = j + 1;
    }
    return out;
}

// insts_from_irtype — the generic-entity instantiations referenced by `t` (itself if
// it is one, plus any in its type args).
function insts_from_irtype(entities: Array<EntityDecl>, t: IrType) returns Array<IrType> {
    let mutable out: Array<IrType> = compiler_ir.empty_ir_type_array();
    if entity_is_generic(entities, t.name) {
        if len(t.type_args) > 0 {
            out.push(t);
        }
    }
    let mutable i: Int = 0;
    while i < len(t.type_args) {
        out = append_types(out, insts_from_irtype(entities, t.type_args[i]));
        i = i + 1;
    }
    return out;
}

// insts_from_type_string — instantiations in an AST type annotation string.
function insts_from_type_string(entities: Array<EntityDecl>, s: String) returns Array<IrType> {
    return insts_from_irtype(entities, compiler_ir.ir_parse_type(s));
}

// insts_from_expr — instantiations referenced in an expression (a generic ctor call
// `Stack<Int>()` bakes the args into the callee ident name), recursing children/arms.
function insts_from_expr(entities: Array<EntityDecl>, e: Expr) returns Array<IrType> {
    let mutable out: Array<IrType> = compiler_ir.empty_ir_type_array();
    if e.kind == shared_ast.ex_call() {
        if len(e.children) > 0 {
            let callee: Expr = e.children[0];
            // Both a bare generic ctor `Pair<Int>()` (ex_ident callee) and a
            // module-qualified one `pkg.Pair<Int>()` (ex_field callee) bake the type
            // args into the callee name, so record either form's instantiation.
            if callee.kind == shared_ast.ex_ident() {
                out = append_types(out, insts_from_type_string(entities, callee.name));
            } else {
                if callee.kind == shared_ast.ex_field() {
                    out = append_types(out, insts_from_type_string(entities, callee.name));
                }
            }
        }
    }
    let mutable i: Int = 0;
    while i < len(e.children) {
        out = append_types(out, insts_from_expr(entities, e.children[i]));
        i = i + 1;
    }
    let mutable ai: Int = 0;
    while ai < len(e.match_arms) {
        out = append_types(out, insts_from_expr(entities, e.match_arms[ai].body));
        ai = ai + 1;
    }
    return out;
}

// insts_from_block — instantiations in a block (let type annotations + expressions,
// recursing nested blocks).
function insts_from_block(entities: Array<EntityDecl>, b: Block) returns Array<IrType> {
    let mutable out: Array<IrType> = compiler_ir.empty_ir_type_array();
    let mutable i: Int = 0;
    while i < len(b.stmts) {
        let s: Stmt = b.stmts[i];
        if s.kind == shared_ast.st_let() {
            out = append_types(out, insts_from_type_string(entities, s.type_name));
        }
        out = append_types(out, insts_from_expr(entities, s.expr));
        if s.kind == shared_ast.st_if() {
            out = append_types(out, insts_from_block(entities, s.then_block));
            if s.has_else {
                out = append_types(out, insts_from_block(entities, s.else_block));
            }
        }
        if s.kind == shared_ast.st_while() or s.kind == shared_ast.st_for() {
            out = append_types(out, insts_from_block(entities, s.then_block));
        }
        i = i + 1;
    }
    return out;
}

// insts_from_func — instantiations in a function/method/ctor signature + body.
function insts_from_func(entities: Array<EntityDecl>, f: FunctionDecl) returns Array<IrType> {
    let mutable out: Array<IrType> = compiler_ir.empty_ir_type_array();
    let mutable i: Int = 0;
    while i < len(f.params) {
        out = append_types(out, insts_from_type_string(entities, f.params[i].type_name));
        i = i + 1;
    }
    out = append_types(out, insts_from_type_string(entities, f.return_type));
    out = append_types(out, insts_from_block(entities, f.body));
    return out;
}

// collect_instantiations — the deduped (by mangled name) list of generic-entity
// instantiations used across the whole program (mirrors collectInstantiations).
function collect_instantiations(prog: Program, gen_entities: Array<EntityDecl>) returns Array<IrType> {
    let mutable all: Array<IrType> = compiler_ir.empty_ir_type_array();
    let mutable fi: Int = 0;
    while fi < len(prog.functions) {
        all = append_types(all, insts_from_func(gen_entities, prog.functions[fi]));
        fi = fi + 1;
    }
    let mutable ti: Int = 0;
    while ti < len(prog.tests) {
        all = append_types(all, insts_from_block(gen_entities, prog.tests[ti].body));
        ti = ti + 1;
    }
    let mutable ei: Int = 0;
    while ei < len(prog.entities) {
        let e: EntityDecl = prog.entities[ei];
        if len(e.type_params) == 0 {
            let mutable fdi: Int = 0;
            while fdi < len(e.fields) {
                all = append_types(all, insts_from_type_string(gen_entities, e.fields[fdi].type_name));
                fdi = fdi + 1;
            }
            if e.has_constructor {
                all = append_types(all, insts_from_func(gen_entities, e.ctor));
            }
            let mutable mi: Int = 0;
            while mi < len(e.methods) {
                all = append_types(all, insts_from_func(gen_entities, e.methods[mi]));
                mi = mi + 1;
            }
        }
        ei = ei + 1;
    }
    let mutable ii: Int = 0;
    while ii < len(prog.impls) {
        let mutable mi2: Int = 0;
        while mi2 < len(prog.impls[ii].methods) {
            all = append_types(all, insts_from_func(gen_entities, prog.impls[ii].methods[mi2]));
            mi2 = mi2 + 1;
        }
        ii = ii + 1;
    }
    // Dedup by mangled name, preserving first-seen order.
    let mutable out: Array<IrType> = compiler_ir.empty_ir_type_array();
    let mutable seen: Array<String> = shared_ast.empty_string_array();
    let mutable k: Int = 0;
    while k < len(all) {
        let mangled: String = compiler_ir.ir_mangle_generic_name(all[k].name, all[k].type_args);
        if not string_in(seen, mangled) {
            seen.push(mangled);
            out.push(all[k]);
        }
        k = k + 1;
    }
    return out;
}

// monomorphize_entity — a concrete entity for a generic decl + type args: substitute
// the type params through fields / ctor / methods and mangle the name. Mirrors
// monomorphizeEntity + monomorphizeConstructor + monomorphizeMethod.
function monomorphize_entity(decl: EntityDecl, type_args: Array<IrType>, enums: Array<EnumDecl>, entities: Array<EntityDecl>) returns IrEntity {
    let mangled: String = compiler_ir.ir_mangle_generic_name(decl.name, type_args);
    let mutable fields: Array<IrParam> = compiler_ir.empty_ir_param_array();
    let mutable fi: Int = 0;
    while fi < len(decl.fields) {
        let f: FieldDecl = decl.fields[fi];
        fields.push(IrParam(f.name, compiler_ir.ir_substitute_type(compiler_ir.ir_parse_type(f.type_name), decl.type_params, type_args)));
        fi = fi + 1;
    }
    // Invariants (self stays `self`), paired with raw text.
    let inv_scope: LowerScope = lower_scope_with_self(lower_scope_empty(enums, entities), "self", mangled);
    let mutable invs: Array<IrContract> = compiler_ir.empty_ir_contract_array();
    let mutable ivi: Int = 0;
    while ivi < len(decl.invariants) {
        let iv: Expr = decl.invariants[ivi];
        invs.push(IrContract(lower_expr(iv, inv_scope), decl.invariants_raw[ivi], iv.line, iv.column));
        ivi = ivi + 1;
    }
    let mutable ctor: IrFunction = compiler_ir.empty_ir_function();
    if decl.has_constructor {
        ctor = monomorphize_member(decl.ctor, "__self", mangled, decl.type_params, type_args, enums, entities);
    }
    let mutable methods: Array<IrFunction> = compiler_ir.empty_ir_function_array();
    let mutable mi: Int = 0;
    while mi < len(decl.methods) {
        methods.push(monomorphize_member(decl.methods[mi], "self", mangled, decl.type_params, type_args, enums, entities));
        mi = mi + 1;
    }
    return IrEntity(mangled, decl.is_public, fields, invs, decl.has_constructor, ctor, methods);
}

// monomorphize_member — a constructor/method with its signature types substituted, but
// its BODY lowered with UNSTAMPED params: the generic body's type-param-typed exprs
// have no concrete type in stage1 (typeOf -> nil -> Copy), so their args are NOT
// cloned. Seeding the body scope without params reproduces that (a `T` param stamped
// concrete would wrongly clone). Non-type-param params are rare in generic members and
// unused-as-receivers in the corpus, so omitting all param stamps is corpus-faithful.
function monomorphize_member(f: FunctionDecl, self_name: String, entity_name: String, param_names: Array<String>, param_types: Array<IrType>, enums: Array<EnumDecl>, entities: Array<EntityDecl>) returns IrFunction {
    let base: LowerScope = lower_scope_with_self(lower_scope_empty(enums, entities), self_name, entity_name);
    let mutable params: Array<IrParam> = compiler_ir.empty_ir_param_array();
    let mutable i: Int = 0;
    while i < len(f.params) {
        let p: Param = f.params[i];
        params.push(IrParam(p.name, compiler_ir.ir_substitute_type(compiler_ir.ir_parse_type(p.type_name), param_names, param_types)));
        i = i + 1;
    }
    let reqs: Array<IrContract> = lower_contracts(f.requires_clauses, f.requires_raw, base);
    let old_caps: Array<IrOldCapture> = collect_old_captures(f.ensures_clauses, base);
    let ens_scope: LowerScope = lower_scope_with_old(base, true);
    let enss: Array<IrContract> = lower_contracts(f.ensures_clauses, f.ensures_raw, ens_scope);
    let body: Array<IrStmt> = lower_block(f.body, base);
    let ret: IrType = compiler_ir.ir_substitute_type(compiler_ir.ir_parse_type(f.return_type), param_names, param_types);
    let mutable func: IrFunction = IrFunction(f.name, f.is_entry, f.is_public, f.is_async, params, ret, reqs, enss, body);
    func.old_captures = old_caps;
    return func;
}

// lower — an AST Program to a single IR Module (the entry module: its `entry`
// function becomes the program main in the backend). Mirrors Lower in lower.go
// for the trivial subset (functions + tests; other decl kinds land per slice).
public function lower(prog: Program, path: String) returns IrModule {
    // Build this file's own function-return registry so single-file emit stamps call
    // result types too (string-concat `a + str_call()` -> format!, chained dispatch).
    // Module/type maps stay empty (single-file has no cross-module mangling).
    let mutable func_names: Array<String> = shared_ast.empty_string_array();
    let mutable func_returns: Array<IrType> = compiler_ir.empty_ir_type_array();
    let mutable fi: Int = 0;
    while fi < len(prog.functions) {
        func_names.push(prog.functions[fi].name);
        func_returns.push(compiler_ir.ir_parse_type(prog.functions[fi].return_type));
        fi = fi + 1;
    }
    // Extern (FFI) registry: fn name -> Rust path, so calls emit the path.
    let mutable extern_names: Array<String> = shared_ast.empty_string_array();
    let mutable extern_paths: Array<String> = shared_ast.empty_string_array();
    let mutable exi: Int = 0;
    while exi < len(prog.externs) {
        extern_names.push(prog.externs[exi].func_name);
        extern_paths.push(prog.externs[exi].target);
        exi = exi + 1;
    }
    // Single-file: every generic instantiation is emitted by the one module.
    let single_monos: Array<IrType> = collect_instantiations(prog, prog.entities);
    return lower_module(prog, path, true, shared_ast.empty_string_array(), shared_ast.empty_string_array(), shared_ast.empty_string_array(), shared_ast.empty_string_array(), prog.enums, prog.entities, func_names, func_returns, extern_names, extern_paths, single_monos);
}

// lower_module — lower one Program of a (possibly multi-file) build. is_entry marks
// the program entry (its `entry` function becomes `fn main`); non-entry modules get a
// `<file-base>_` name prefix on every function. module_names/module_prefixes are the
// GLOBAL qualifier map so `mod.fn(args)` calls resolve to mangled free-fn calls. The
// single-file `lower` above delegates here with is_entry=true and an empty map, so its
// emit is byte-unchanged.
// all_enums / all_entities are the GLOBAL registry (every module's enums/entities), used
// for lookups/classification (is_known_entity for cross-module constructors, variant
// resolution, self-field types) — mirroring stage1's global lowerer.entities. The per-
// module prog.enums/prog.entities still drive which decls this module EMITS.
public function lower_module(prog: Program, path: String, is_entry: Bool, module_names: Array<String>, module_prefixes: Array<String>, type_names: Array<String>, type_prefixes: Array<String>, all_enums: Array<EnumDecl>, all_entities: Array<EntityDecl>, func_names: Array<String>, func_returns: Array<IrType>, extern_names: Array<String>, extern_paths: Array<String>, emit_monos: Array<IrType>) returns IrModule {
    let mod_name: String = path_module_name(path);
    let mutable name_prefix: String = "";
    if not is_entry {
        name_prefix = mod_name + "_";
    }
    let ctx: LowerCtx = LowerCtx(name_prefix, module_names, module_prefixes, type_names, type_prefixes, func_names, func_returns, extern_names, extern_paths);
    let mutable fns: Array<IrFunction> = compiler_ir.empty_ir_function_array();
    let mutable fi: Int = 0;
    while fi < len(prog.functions) {
        // Generic functions (type params) are NOT emitted directly — stage1 emits only
        // their monomorphizations (an uninstantiated generic fn emits nothing). Mirrors
        // the generic-entity skip below. (Called generic free functions -> monomorphized
        // funcs is a later slice; none in the corpus today.)
        if len(prog.functions[fi].type_params) == 0 {
            fns.push(lower_function(prog.functions[fi], all_enums, all_entities, ctx));
        }
        fi = fi + 1;
    }
    let mutable tsts: Array<IrTest> = compiler_ir.empty_ir_test_array();
    let mutable ti: Int = 0;
    while ti < len(prog.tests) {
        tsts.push(lower_test(prog.tests[ti], all_enums, all_entities, ctx));
        ti = ti + 1;
    }
    // Lower the enum declarations (their struct-style variants + field types), and
    // assign to the module post-construction (enums is an ADR 0054 additive field).
    let mutable ens: Array<IrEnum> = compiler_ir.empty_ir_enum_array();
    let mutable eni: Int = 0;
    while eni < len(prog.enums) {
        ens.push(lower_enum(prog.enums[eni], ctx));
        eni = eni + 1;
    }
    let mutable ents: Array<IrEntity> = compiler_ir.empty_ir_entity_array();
    let mutable eei: Int = 0;
    while eei < len(prog.entities) {
        // Generic entities (type params) are NOT emitted directly — only their
        // monomorphizations (below). Mirrors stage1's Lower first pass.
        if len(prog.entities[eei].type_params) == 0 {
            ents.push(lower_entity(prog.entities[eei], all_enums, all_entities, ctx));
        }
        eei = eei + 1;
    }
    // Emit a monomorphized entity for each generic instantiation ASSIGNED to this
    // module. lower_all assigns each instantiation to the first module (topological
    // order) that uses it, so a generic instantiated in several modules is emitted
    // once (mirrors stage1's collectInstantiations per-module + emit-time dedup). The
    // decl is looked up in the GLOBAL entity registry so the entry module can
    // monomorphize a generic defined in a dependency.
    let mutable insi: Int = 0;
    while insi < len(emit_monos) {
        let inst: IrType = emit_monos[insi];
        let decl: EntityDecl = find_entity_decl(all_entities, inst.name);
        if decl.name != "" {
            ents.push(monomorphize_entity(decl, inst.type_args, all_enums, all_entities));
        }
        insi = insi + 1;
    }
    let mutable ints: Array<IrIntent> = compiler_ir.empty_ir_intent_array();
    let mutable ii: Int = 0;
    while ii < len(prog.intent_blocks) {
        ints.push(lower_intent(prog.intent_blocks[ii]));
        ii = ii + 1;
    }
    let mutable trs: Array<IrTrait> = compiler_ir.empty_ir_trait_array();
    let mutable tri: Int = 0;
    while tri < len(prog.traits) {
        trs.push(lower_trait(prog.traits[tri], all_enums, all_entities, ctx));
        tri = tri + 1;
    }
    let mutable imps: Array<IrImplBlock> = compiler_ir.empty_ir_impl_array();
    let mutable imi: Int = 0;
    while imi < len(prog.impls) {
        imps.push(lower_impl(prog.impls[imi], all_enums, all_entities, ctx));
        imi = imi + 1;
    }
    let decl_name: String = prog.module_decl.name;
    let mutable m: IrModule = IrModule(mod_name, decl_name, "", is_entry, path, fns, tsts);
    m.enums = ens;
    m.entities = ents;
    m.intents = ints;
    m.traits = trs;
    m.impls = imps;
    return m;
}

// lower_all — lower a multi-file program (mirrors ir.LowerAll). `paths` is the import
// closure in TOPOLOGICAL order (dependencies first, entry LAST); `progs` is parallel.
// Builds the GLOBAL qualifier map from the non-entry modules (each qualifier a user
// may write — the file base and, if different, the `module` decl name — mapping to the
// file-base name prefix), then lowers each module with is_entry = (it is the last).
public function lower_all(progs: Array<Program>, paths: Array<String>) returns IrProgram {
    let n: Int = len(paths);
    let mutable mod_names: Array<String> = shared_ast.empty_string_array();
    let mutable mod_prefixes: Array<String> = shared_ast.empty_string_array();
    let mutable i: Int = 0;
    while i < n - 1 {
        let base: String = path_module_name(paths[i]);
        let prefix: String = base + "_";
        mod_names.push(base);
        mod_prefixes.push(prefix);
        let decl: String = progs[i].module_decl.name;
        if decl != "" and decl != base {
            mod_names.push(decl);
            mod_prefixes.push(prefix);
        }
        // The package-name qualifier for a cross-package import (its directory name; stage1
        // uses intent.toml's PackageName). Only matched when written as `pkg.foo()`, so it
        // is inert for same-package modules whose dir is never used as a qualifier.
        let dir: String = path_parent_dir(paths[i]);
        if dir != "" and dir != base and dir != decl {
            mod_names.push(dir);
            mod_prefixes.push(prefix);
        }
        i = i + 1;
    }
    // Type-origins map: every entity/enum name across ALL modules -> its module's struct
    // prefix (Capitalised file base; "" for the entry module -> unchanged). A cross-
    // module type reference `Point` then emits as `TypesPoint` (mirrors typeOrigins).
    let mutable type_names: Array<String> = shared_ast.empty_string_array();
    let mutable type_prefixes: Array<String> = shared_ast.empty_string_array();
    let mutable k: Int = 0;
    while k < n {
        let mutable pfx: String = "";
        if k < n - 1 {
            pfx = capitalize(path_module_name(paths[k]));
        }
        let mutable ei: Int = 0;
        while ei < len(progs[k].entities) {
            type_names.push(progs[k].entities[ei].name);
            type_prefixes.push(pfx);
            ei = ei + 1;
        }
        let mutable eni: Int = 0;
        while eni < len(progs[k].enums) {
            type_names.push(progs[k].enums[eni].name);
            type_prefixes.push(pfx);
            eni = eni + 1;
        }
        k = k + 1;
    }
    // Global entity/enum registry: every module's decls, so cross-module constructor
    // classification, variant resolution, and field lookups resolve (stage1's global
    // lowerer.entities). The per-module prog.* still drives which decls each module emits.
    let mutable all_enums: Array<EnumDecl> = [];
    let mutable all_entities: Array<EntityDecl> = [];
    // Free-function return-type registry (every module's functions, by name -> return
    // type) so a call's result type can be stamped during lowering.
    let mutable func_names: Array<String> = shared_ast.empty_string_array();
    let mutable func_returns: Array<IrType> = compiler_ir.empty_ir_type_array();
    let mutable extern_names: Array<String> = shared_ast.empty_string_array();
    let mutable extern_paths: Array<String> = shared_ast.empty_string_array();
    let mutable g: Int = 0;
    while g < n {
        let mutable gei: Int = 0;
        while gei < len(progs[g].enums) {
            all_enums.push(progs[g].enums[gei]);
            gei = gei + 1;
        }
        let mutable gni: Int = 0;
        while gni < len(progs[g].entities) {
            all_entities.push(progs[g].entities[gni]);
            gni = gni + 1;
        }
        let mutable gfi: Int = 0;
        while gfi < len(progs[g].functions) {
            func_names.push(progs[g].functions[gfi].name);
            func_returns.push(compiler_ir.ir_parse_type(progs[g].functions[gfi].return_type));
            gfi = gfi + 1;
        }
        let mutable gxi: Int = 0;
        while gxi < len(progs[g].externs) {
            extern_names.push(progs[g].externs[gxi].func_name);
            extern_paths.push(progs[g].externs[gxi].target);
            gxi = gxi + 1;
        }
        g = g + 1;
    }
    // Assign each generic-entity instantiation to the FIRST module (topological order)
    // that uses it, so a generic instantiated in several modules is monomorphized once.
    // The instantiation may be defined in one module (e.g. a dependency) and used only
    // in another (e.g. the entry module); collecting per module and deduping globally
    // here — rather than each module monomorphizing its own — matches stage1's
    // per-module collection plus emit-time dedup, and covers entry-only instantiations.
    let mutable seen_monos: Array<String> = shared_ast.empty_string_array();
    let mutable mods: Array<IrModule> = compiler_ir.empty_ir_module_array();
    let mutable j: Int = 0;
    while j < n {
        let is_entry: Bool = j == n - 1;
        let these: Array<IrType> = collect_instantiations(progs[j], all_entities);
        let mutable emit_monos: Array<IrType> = compiler_ir.empty_ir_type_array();
        let mutable ti: Int = 0;
        while ti < len(these) {
            let mn: String = compiler_ir.ir_mangle_generic_name(these[ti].name, these[ti].type_args);
            if not string_in(seen_monos, mn) {
                seen_monos.push(mn);
                emit_monos.push(these[ti]);
            }
            ti = ti + 1;
        }
        mods.push(lower_module(progs[j], paths[j], is_entry, mod_names, mod_prefixes, type_names, type_prefixes, all_enums, all_entities, func_names, func_returns, extern_names, extern_paths, emit_monos));
        j = j + 1;
    }
    return IrProgram(mods);
}

// lower_trait — mirrors lowerTrait: each method signature (TraitMethodSig) becomes an
// IrFunction (name/params/return, empty body). Enum/entity registries seed param types.
public function lower_trait(t: TraitDecl, enums: Array<EnumDecl>, entities: Array<EntityDecl>, ctx: LowerCtx) returns IrTrait {
    let mutable methods: Array<IrFunction> = compiler_ir.empty_ir_function_array();
    let mutable mi: Int = 0;
    while mi < len(t.methods) {
        let tm: TraitMethodSig = t.methods[mi];
        let mutable params: Array<IrParam> = compiler_ir.empty_ir_param_array();
        let mutable pi: Int = 0;
        while pi < len(tm.params) {
            let p: Param = tm.params[pi];
            // Trait-method-sig param/return types are mangled for emission (cross-module
            // NodeAttr -> TypesNodeAttr). The trait name itself is not mangled (traits
            // are not in the type-origins map — mirrors stage1's generateTrait).
            params.push(IrParam(p.name, mangle_ir_type(compiler_ir.ir_parse_type(p.type_name), ctx.type_names, ctx.type_prefixes)));
            pi = pi + 1;
        }
        methods.push(IrFunction(tm.name, false, false, false, params, mangle_ir_type(compiler_ir.ir_parse_type(tm.return_type), ctx.type_names, ctx.type_prefixes), compiler_ir.empty_ir_contract_array(), compiler_ir.empty_ir_contract_array(), compiler_ir.empty_ir_stmt_array()));
        mi = mi + 1;
    }
    return IrTrait(t.name, t.is_public, methods);
}

// lower_impl — mirrors lowerImplBlock: each method is lowered like an entity method
// (self stays "self"; self.field access types resolve against the impl's entity).
public function lower_impl(ib: ImplDecl, enums: Array<EnumDecl>, entities: Array<EntityDecl>, ctx: LowerCtx) returns IrImplBlock {
    let mutable methods: Array<IrFunction> = compiler_ir.empty_ir_function_array();
    let mutable mi: Int = 0;
    while mi < len(ib.methods) {
        // Original entity_name for member self-scope; only the emitted target is mangled.
        methods.push(lower_member(ib.methods[mi], "self", ib.entity_name, enums, entities, ctx));
        mi = mi + 1;
    }
    // `impl Trait for <MangledEntity>` — trait name is not mangled (traits are not in
    // the type-origins map); only the entity target is (mirrors stage1's impl emit).
    return IrImplBlock(ib.trait_name, mangle_type_name(ib.entity_name, ctx.type_names, ctx.type_prefixes), methods);
}

// lower_entity — mirrors lowerEntity: fields (parsed types), invariants (with raw
// text -> IrContract), the constructor (self -> __self), and methods (self -> self).
// The enum/entity registries seed each member's scope.
public function lower_entity(e: EntityDecl, enums: Array<EnumDecl>, entities: Array<EntityDecl>, ctx: LowerCtx) returns IrEntity {
    let mutable fields: Array<IrParam> = compiler_ir.empty_ir_param_array();
    let mutable fi: Int = 0;
    while fi < len(e.fields) {
        let f: FieldDecl = e.fields[fi];
        // Field types are mangled for emission (a Point field -> `TypesPoint`).
        fields.push(IrParam(f.name, mangle_ir_type(compiler_ir.ir_parse_type(f.type_name), ctx.type_names, ctx.type_prefixes)));
        fi = fi + 1;
    }
    // Invariants: lowered in a self-scope (self -> self), paired with raw text.
    let inv_scope: LowerScope = lower_scope_apply_ctx(lower_scope_empty(enums, entities), ctx);
    let mutable invs: Array<IrContract> = compiler_ir.empty_ir_contract_array();
    let mutable ivi: Int = 0;
    while ivi < len(e.invariants) {
        let iv: Expr = e.invariants[ivi];
        invs.push(IrContract(lower_expr(iv, inv_scope), e.invariants_raw[ivi], iv.line, iv.column));
        ivi = ivi + 1;
    }
    // Members lower with the ORIGINAL entity name as self_entity_name so self.field
    // lookups (keyed by the declared name) resolve; only the emitted struct name is
    // mangled (below), matching stage1's mangledEntityName in generateEntity.
    let mutable ctor: IrFunction = compiler_ir.empty_ir_function();
    if e.has_constructor {
        ctor = lower_member(e.ctor, "__self", e.name, enums, entities, ctx);
    }
    let mutable methods: Array<IrFunction> = compiler_ir.empty_ir_function_array();
    let mutable mi: Int = 0;
    while mi < len(e.methods) {
        methods.push(lower_member(e.methods[mi], "self", e.name, enums, entities, ctx));
        mi = mi + 1;
    }
    return IrEntity(mangle_type_name(e.name, ctx.type_names, ctx.type_prefixes), e.is_public, fields, invs, e.has_constructor, ctor, methods);
}

// lower_member — lower a constructor or method (both FunctionDecl). self_name is
// "__self" for a constructor, "self" for a method. Ensures are lowered in an
// in_old scope so `old(expr)` becomes its captured variable; old captures are
// scanned from the ensures ASTs (mirrors lowerConstructor / lowerMethod).
public function lower_member(f: FunctionDecl, self_name: String, entity_name: String, enums: Array<EnumDecl>, entities: Array<EntityDecl>, ctx: LowerCtx) returns IrFunction {
    let base: LowerScope = lower_scope_apply_ctx(lower_scope_with_self(lower_scope_empty(enums, entities), self_name, entity_name), ctx);
    let mutable scope: LowerScope = base;
    let mutable params: Array<IrParam> = compiler_ir.empty_ir_param_array();
    let mutable i: Int = 0;
    while i < len(f.params) {
        let p: Param = f.params[i];
        // Emitted param type mangled; scope-stored type unmangled (lookups/dispatch).
        params.push(IrParam(p.name, mangle_ir_type(compiler_ir.ir_parse_type(p.type_name), ctx.type_names, ctx.type_prefixes)));
        scope = lower_scope_define(scope, p.name, compiler_ir.ir_parse_type(p.type_name));
        i = i + 1;
    }
    let reqs: Array<IrContract> = lower_contracts(f.requires_clauses, f.requires_raw, scope);
    // Old captures: scan ensures ASTs for old(expr), collect unique (mangled name +
    // lowered inner). The inner is lowered in the non-old scope (self stays as-is).
    let old_caps: Array<IrOldCapture> = collect_old_captures(f.ensures_clauses, scope);
    // Ensures lowered with in_old=true so old(expr) -> the captured var.
    let ens_scope: LowerScope = lower_scope_with_old(scope, true);
    let enss: Array<IrContract> = lower_contracts(f.ensures_clauses, f.ensures_raw, ens_scope);
    let body: Array<IrStmt> = lower_block(f.body, scope);
    let mutable func: IrFunction = IrFunction(f.name, f.is_entry, f.is_public, f.is_async, params, mangle_ir_type(compiler_ir.ir_parse_type(f.return_type), ctx.type_names, ctx.type_prefixes), reqs, enss, body);
    func.old_captures = old_caps;
    return func;
}

// collect_old_captures — scan each ensures AST for `old(expr)` calls, returning one
// IrOldCapture (mangled name + lowered inner) per UNIQUE mangled name, in first-seen
// order (mirrors the lowerer's oldCaptures dedup).
function collect_old_captures(ens_preds: Array<Expr>, scope: LowerScope) returns Array<IrOldCapture> {
    let mutable caps: Array<IrOldCapture> = compiler_ir.empty_ir_old_capture_array();
    let mutable seen: Array<String> = shared_ast.empty_string_array();
    let mutable i: Int = 0;
    while i < len(ens_preds) {
        caps = scan_old_into(ens_preds[i], scope, caps, seen);
        seen = old_capture_names(caps);
        i = i + 1;
    }
    return caps;
}

// old_capture_names — the mangled names already captured (for dedup).
function old_capture_names(caps: Array<IrOldCapture>) returns Array<String> {
    let mutable out: Array<String> = shared_ast.empty_string_array();
    let mutable i: Int = 0;
    while i < len(caps) {
        out.push(caps[i].name);
        i = i + 1;
    }
    return out;
}

// scan_old_into — walk an AST expr; for each `old(inner)` call whose mangled name is
// not in `seen`, append an IrOldCapture. Returns the (possibly extended) captures.
// Functional accumulation (arrays are immutable params), recursing children.
function scan_old_into(e: Expr, scope: LowerScope, caps: Array<IrOldCapture>, seen: Array<String>) returns Array<IrOldCapture> {
    let mutable out: Array<IrOldCapture> = caps;
    if e.kind == shared_ast.ex_call() {
        let callee: Expr = e.children[0];
        if callee.kind == shared_ast.ex_ident() {
            if callee.name == "old" {
                if len(e.children) == 2 {
                    let inner: Expr = e.children[1];
                    let name: String = mangle_old(inner);
                    if not string_in(seen, name) and not old_has(out, name) {
                        out.push(IrOldCapture(name, lower_expr(inner, scope)));
                    }
                    return out;
                }
            }
        }
    }
    let mutable i: Int = 0;
    while i < len(e.children) {
        out = scan_old_into(e.children[i], scope, out, seen);
        i = i + 1;
    }
    return out;
}

function old_has(caps: Array<IrOldCapture>, name: String) returns Bool {
    let mutable i: Int = 0;
    while i < len(caps) {
        if caps[i].name == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

function string_in(arr: Array<String>, name: String) returns Bool {
    let mutable i: Int = 0;
    while i < len(arr) {
        if arr[i] == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// lower_intent — mirrors lowerIntent: copy the description/goals/constraints/
// guarantees and the already-dotted verification reference strings.
public function lower_intent(i: IntentBlock) returns IrIntent {
    return IrIntent(i.description, i.goals, i.constraints, i.guarantees, i.verifications);
}

// lower_enum — mirrors lowerEnum: each variant's fields (name + parsed type) become
// IrParams (empty for a unit variant). Field types are parsed structurally.
public function lower_enum(e: EnumDecl, ctx: LowerCtx) returns IrEnum {
    let mutable variants: Array<IrEnumVariant> = compiler_ir.empty_ir_enum_variant_array();
    let mutable vi: Int = 0;
    while vi < len(e.variants) {
        let v: EnumVariant = e.variants[vi];
        let mutable fields: Array<IrParam> = compiler_ir.empty_ir_param_array();
        let mutable fj: Int = 0;
        while fj < len(v.params) {
            let p: Param = v.params[fj];
            // Variant data-field types are mangled for emission (cross-module refs).
            fields.push(IrParam(p.name, mangle_ir_type(compiler_ir.ir_parse_type(p.type_name), ctx.type_names, ctx.type_prefixes)));
            fj = fj + 1;
        }
        variants.push(IrEnumVariant(v.name, fields));
        vi = vi + 1;
    }
    return IrEnum(mangle_type_name(e.name, ctx.type_names, ctx.type_prefixes), e.is_public, variants);
}

// resolve_enum_for_variant — the enum that declares `variant_name`, or "" if none
// (mirrors resolveEnumForVariant). Variant names are unique across enums (checker-
// enforced), so the first match is authoritative.
function resolve_enum_for_variant(enums: Array<EnumDecl>, variant_name: String) returns String {
    let mutable i: Int = 0;
    while i < len(enums) {
        let e: EnumDecl = enums[i];
        let mutable j: Int = 0;
        while j < len(e.variants) {
            if e.variants[j].name == variant_name {
                return e.name;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return "";
}

// extend_scope_for_arm — a scope with a builtin (Ok/Err/Some) pattern's binding typed
// from the scrutinee's Result/Option type args (Ok/Some -> arg 0, Err -> arg 1), so a
// binding used as a method receiver dispatches on its real type. Wildcard / non-builtin
// arms (enum-variant binding types) are returned unchanged for now.
function extend_scope_for_arm(scope: LowerScope, scrutinee: IrExpr, a: MatchArm, is_builtin: Bool) returns LowerScope {
    if a.is_wildcard {
        return scope;
    }
    if not is_builtin {
        return scope;
    }
    if len(a.bindings) != 1 {
        return scope;
    }
    let st: IrType = scrutinee.expr_type;
    if a.variant == "Err" {
        if len(st.type_args) >= 2 {
            return lower_scope_define(scope, a.bindings[0], st.type_args[1]);
        }
        return scope;
    }
    if len(st.type_args) >= 1 {
        return lower_scope_define(scope, a.bindings[0], st.type_args[0]);
    }
    return scope;
}

// is_known_enum — is `name` the name of a declared enum? (Used to decide a match
// scrutinee's enum, mirroring stage1's scrutType.IsEnum check.)
function is_known_enum(enums: Array<EnumDecl>, name: String) returns Bool {
    let mutable i: Int = 0;
    while i < len(enums) {
        if enums[i].name == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// resolve_variant_field_names — the declared field names of `variant_name` in
// `enum_name` (mirrors resolveVariantFieldNames), as a LOCAL owned array so it moves
// into the IR node's owned field. Empty if the enum/variant is unknown or a unit.
function resolve_variant_field_names(enums: Array<EnumDecl>, enum_name: String, variant_name: String) returns Array<String> {
    let mutable out: Array<String> = shared_ast.empty_string_array();
    let mutable i: Int = 0;
    while i < len(enums) {
        let e: EnumDecl = enums[i];
        if e.name == enum_name {
            let mutable j: Int = 0;
            while j < len(e.variants) {
                let v: EnumVariant = e.variants[j];
                if v.name == variant_name {
                    let mutable k: Int = 0;
                    while k < len(v.params) {
                        out.push(v.params[k].name);
                        k = k + 1;
                    }
                    return out;
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return out;
}

// lower_function — mirrors lowerFunction: params (types parsed structurally),
// requires/ensures contracts (via lower_contracts), and the lowered body. `enums`
// seeds the scope's enum registry (variant / match resolution).
public function lower_function(f: FunctionDecl, enums: Array<EnumDecl>, entities: Array<EntityDecl>, ctx: LowerCtx) returns IrFunction {
    let mutable params: Array<IrParam> = compiler_ir.empty_ir_param_array();
    let mutable scope: LowerScope = lower_scope_apply_ctx(lower_scope_empty(enums, entities), ctx);
    let mutable i: Int = 0;
    while i < len(f.params) {
        let p: Param = f.params[i];
        // Emitted param type is mangled (cross-module `Point` -> `TypesPoint`).
        let pty: IrType = mangle_ir_type(compiler_ir.ir_parse_type(p.type_name), ctx.type_names, ctx.type_prefixes);
        params.push(IrParam(p.name, pty));
        // Seed the scope with each param so VarRefs to it carry its type (the
        // checker's exprTypes equivalent). Copy pty via a fresh parse: a param's
        // Array type lowered to `&Vec` cannot be shared into two owned fields. The
        // scope-stored type stays UNMANGLED so self/field lookups + dispatch resolve.
        scope = lower_scope_define(scope, p.name, compiler_ir.ir_parse_type(p.type_name));
        i = i + 1;
    }
    let reqs: Array<IrContract> = lower_contracts(f.requires_clauses, f.requires_raw, scope);
    let enss: Array<IrContract> = lower_contracts(f.ensures_clauses, f.ensures_raw, scope);
    let body: Array<IrStmt> = lower_block(f.body, scope);
    // Imported (non-entry) modules prefix every function name (`add` -> `math_add`)
    // and drop the entry flag so no duplicate `fn main` is emitted; the entry module
    // (empty prefix) keeps names and its `entry` function verbatim. Mirrors stage1's
    // GenerateAll namePrefix + the `f.IsEntry && g.isEntryFile` guard.
    let mutable fn_name: String = f.name;
    let mutable is_e: Bool = f.is_entry;
    if ctx.name_prefix != "" {
        fn_name = ctx.name_prefix + f.name;
        is_e = false;
    }
    return IrFunction(fn_name, is_e, f.is_public, f.is_async, params, mangle_ir_type(compiler_ir.ir_parse_type(f.return_type), ctx.type_names, ctx.type_prefixes), reqs, enss, body);
}

// lower_contracts — pair each contract predicate Expr with its captured raw text
// (Phase 55 shared-AST enrichment, ADR 0059) into IrContracts. The predicate is
// lowered like any expr, so `result` in an ensures clause becomes __result. old()
// captures in ensures are deferred to a later sub-slice (no corpus entry uses
// them yet). requires_raw / ensures_raw are parallel to the clause arrays.
public function lower_contracts(preds: Array<Expr>, raws: Array<String>, scope: LowerScope) returns Array<IrContract> {
    let mutable out: Array<IrContract> = compiler_ir.empty_ir_contract_array();
    let mutable i: Int = 0;
    while i < len(preds) {
        let p: Expr = preds[i];
        out.push(IrContract(lower_expr(p, scope), raws[i], p.line, p.column));
        i = i + 1;
    }
    return out;
}

// lower_test — mirrors lowerTest. The AST already stores annotations as their
// canonical strings, which is exactly the IrTest.annotations shape.
public function lower_test(t: TestDecl, enums: Array<EnumDecl>, entities: Array<EntityDecl>, ctx: LowerCtx) returns IrTest {
    // A test has no params; its body opens a fresh scope (seeded with the enum +
    // entity registries + the module ctx, so same-module calls in the test body carry
    // the module prefix and cross-module type refs mangle).
    let body: Array<IrStmt> = lower_block(t.body, lower_scope_apply_ctx(lower_scope_empty(enums, entities), ctx));
    return IrTest(t.name, t.is_async, t.annotations, body);
}

// lower_block — mirrors lowerBlock: lower each statement in order, threading the
// scope and accumulating each let-binding so a later statement's VarRefs carry
// the binding's type. The accumulation is local to this block (the passed scope
// is copied on each define), so a nested block's lets never leak back out.
public function lower_block(b: Block, scope: LowerScope) returns Array<IrStmt> {
    let mutable stmts: Array<IrStmt> = compiler_ir.empty_ir_stmt_array();
    let mutable s: LowerScope = scope;
    let mutable i: Int = 0;
    while i < len(b.stmts) {
        let st: IrStmt = lower_stmt(b.stmts[i], s);
        stmts.push(st);
        // Extend the scope AFTER lowering the let (its initializer is checked
        // before the name is bound), so subsequent statements see `name: let_type`.
        if st.kind == compiler_ir.irst_let() {
            s = lower_scope_define(s, st.name, st.let_type);
            // Track a `let f = spawn ...` binding so `await f` unwraps the JoinHandle.
            if st.expr.kind == compiler_ir.irex_spawn() {
                s = lower_scope_add_joinhandle(s, st.name);
            }
        }
        i = i + 1;
    }
    return stmts;
}

// lower_stmt — mirrors lowerStmt for the supported subset (return, expr-stmt,
// let-binding). A bare `return;` is st_return whose AST expr is ex_void; it
// lowers to an irst_return carrying the ir_void_expr placeholder (the IR has no
// nil). st_let carries name / is_mutable / type_name from the AST. Other
// statement kinds land per slice; the fallback mirrors lowerStmt's default (a
// `true` expr-stmt) and is unreachable for the diff-emit corpus.
public function lower_stmt(s: Stmt, scope: LowerScope) returns IrStmt {
    if s.kind == shared_ast.st_return() {
        if s.expr.kind == shared_ast.ex_void() {
            return IrStmt(compiler_ir.irst_return(), compiler_ir.ir_void_expr());
        }
        return IrStmt(compiler_ir.irst_return(), lower_expr(s.expr, scope));
    }
    if s.kind == shared_ast.st_expr() {
        // Assignment `target = value` has no dedicated AST kind: the parser
        // stores it as a st_expr wrapping an ex_binop with op "=" (children
        // [target, value]) — see check.intent. Stage1 lowers that to a distinct
        // AssignStmt (emitted `target = value;`, not `(target = value);`).
        let inner: Expr = s.expr;
        if inner.kind == shared_ast.ex_binop() {
            if inner.name == "=" {
                let mutable asg: IrStmt = IrStmt(compiler_ir.irst_assign(), lower_expr(inner.children[1], scope));
                asg.target = lower_expr(inner.children[0], scope);
                return asg;
            }
        }
        return IrStmt(compiler_ir.irst_expr(), lower_expr(inner, scope));
    }
    if s.kind == shared_ast.st_let() {
        let mutable ls: IrStmt = IrStmt(compiler_ir.irst_let(), lower_expr(s.expr, scope));
        ls.name = s.name;
        ls.is_mutable = s.is_mutable;
        // let_type stays UNMANGLED — it seeds the block scope (so a cross-module-typed
        // local's field lookups resolve, e.g. `md.functions[i]`) and gates the
        // index/field clone by Copy-ness. let_type_emit is the mangled form used only
        // for the emitted `let x: TYPE` annotation (`let p: TypesPoint`).
        ls.let_type = compiler_ir.ir_parse_type(s.type_name);
        ls.let_type_emit = mangle_ir_type(compiler_ir.ir_parse_type(s.type_name), scope.type_names, scope.type_prefixes);
        // An empty array literal assigned to a Map-typed let is a HashMap literal:
        // stamp the value's type Map so the backend emits `HashMap::new()` (mirrors
        // stage1's ArrayLit-with-Map-Type -> HashMap::new()).
        if ls.let_type.name == "Map" {
            if ls.expr.kind == compiler_ir.irex_array() {
                if len(ls.expr.children) == 0 {
                    ls.expr.expr_type = compiler_ir.ir_type_named("Map");
                }
            }
        }
        return ls;
    }
    if s.kind == shared_ast.st_if() {
        let mutable ifs: IrStmt = IrStmt(compiler_ir.irst_if(), lower_expr(s.expr, scope));
        ifs.then_body = lower_block(s.then_block, scope);
        ifs.has_else = s.has_else;
        if s.has_else {
            ifs.else_body = lower_block(s.else_block, scope);
        }
        return ifs;
    }
    if s.kind == shared_ast.st_while() {
        let mutable ws: IrStmt = IrStmt(compiler_ir.irst_while(), lower_expr(s.expr, scope));
        ws.then_body = lower_block(s.then_block, scope);
        return ws;
    }
    if s.kind == shared_ast.st_for() {
        let iter_ir: IrExpr = lower_expr(s.expr, scope);
        let mutable fs: IrStmt = IrStmt(compiler_ir.irst_for(), iter_ir);
        fs.name = s.name;
        // Stamp the loop variable's element type into the body scope (mirrors stage1
        // typing the for-var): a range yields Int, an Array<T> yields T, a String yields
        // Char. This lets clone_if_needed clone a non-Copy for-var arg and string-concat
        // detection fire on `acc + item` inside the loop. Unknown iterables leave it
        // unstamped (-> Copy -> no clone), which is corpus-safe.
        let mutable elem: IrType = compiler_ir.ir_type_named("");
        if iter_ir.kind == compiler_ir.irex_range() {
            elem = compiler_ir.ir_type_named("Int");
        } else {
            if iter_ir.expr_type.name == "Array" {
                if len(iter_ir.expr_type.type_args) == 1 {
                    elem = iter_ir.expr_type.type_args[0];
                }
            } else {
                if iter_ir.expr_type.name == "String" {
                    elem = compiler_ir.ir_type_named("Char");
                }
            }
        }
        let body_scope: LowerScope = lower_scope_define(scope, s.name, elem);
        fs.then_body = lower_block(s.then_block, body_scope);
        return fs;
    }
    if s.kind == shared_ast.st_break() {
        return IrStmt(compiler_ir.irst_break(), compiler_ir.ir_void_expr());
    }
    if s.kind == shared_ast.st_continue() {
        return IrStmt(compiler_ir.irst_continue(), compiler_ir.ir_void_expr());
    }
    return IrStmt(compiler_ir.irst_expr(), compiler_ir.ir_bool_lit(true));
}

// copy_str — return an owned copy of `s`. The argument position clones `s` (a
// non-Copy String arg), so the caller's value survives; the returned owned string
// can then be MOVED into a field inside a loop without consuming the original.
function copy_str(s: String) returns String {
    return s;
}

// char_lexeme_codepoint — the Unicode codepoint of a char literal's raw lexeme
// (`'A'`, `'\n'`, `'\\'`, `'\u{41}'`). Mirrors what stage1's lexer/checker decode
// into CharLit.Value. Handles the common escapes plus the `\u{HEX}` form.
function char_lexeme_codepoint(s: String) returns Int {
    if len(s) < 3 {
        return 0;
    }
    let c1: Char = s[1];
    if c1 == '\\' {
        let esc: Char = s[2];
        if esc == 'n' {
            return 10;
        }
        if esc == 't' {
            return 9;
        }
        if esc == 'r' {
            return 13;
        }
        if esc == '\\' {
            return 92;
        }
        if esc == '\'' {
            return 39;
        }
        if esc == '"' {
            return 34;
        }
        if esc == '0' {
            return 0;
        }
        if esc == 'u' {
            // `'\u{HEX}'` — parse the hex digits between `{` and `}`.
            let mutable v: Int = 0;
            let mutable i: Int = 4;
            while i < len(s) and s[i] != '}' {
                v = v * 16 + hex_digit_value(s[i]);
                i = i + 1;
            }
            return v;
        }
        return esc.to_codepoint();
    }
    return c1.to_codepoint();
}

// hex_digit_value — the numeric value of a hex digit char (0-9, a-f, A-F).
function hex_digit_value(c: Char) returns Int {
    let cp: Int = c.to_codepoint();
    if cp >= 48 and cp <= 57 {
        return cp - 48;
    }
    if cp >= 97 and cp <= 102 {
        return cp - 97 + 10;
    }
    if cp >= 65 and cp <= 70 {
        return cp - 65 + 10;
    }
    return 0;
}

// lower_ir_is_string — is this lowered expression String-typed? A string literal
// always is; any other node is String iff its stamped expr_type is String (a
// VarRef via the scope, or a nested string concat whose type is String). Mirrors
// stage1's isStringType(checker type == String) for the operands the bridge can
// reconstruct. Used to lower `+` on strings to a concat node.
function lower_ir_is_string(e: IrExpr) returns Bool {
    if e.kind == compiler_ir.irex_string() {
        return true;
    }
    return e.expr_type.name == "String";
}

// lower_expr — mirrors lowerExpr for the supported subset (int/bool literal,
// identifier/variable reference, and call). A call's callee is children[0] (an
// ex_ident) and its args are children[1..], per the stage2 AST's ex_call shape.
// call_kind is resolved from the callee name; enum_name stays "" until the
// enum/variant slice (where an ex_ident may instead be a unit variant).
// Unsupported kinds fall back to the void placeholder and are unreachable for
// the diff-emit corpus (grown per slice).
public function lower_expr(e: Expr, scope: LowerScope) returns IrExpr {
    if e.kind == shared_ast.ex_int() {
        return compiler_ir.ir_int_lit(e.int_value);
    }
    if e.kind == shared_ast.ex_float() {
        // The AST keeps the raw float lexeme in str_value (the formatter round-trips
        // it verbatim); stage1's FloatLit.Value is emitted as-is, so pass it through.
        return compiler_ir.ir_float_lit(e.str_value);
    }
    if e.kind == shared_ast.ex_char() {
        // The AST keeps the raw char lexeme (quotes + raw escapes); compute its
        // Unicode codepoint so the backend emits `'\u{HEX}'` (stage1 CharLit.Value).
        return compiler_ir.ir_char_lit(char_lexeme_codepoint(e.str_value));
    }
    if e.kind == shared_ast.ex_bool() {
        return compiler_ir.ir_bool_lit(e.bool_value);
    }
    if e.kind == shared_ast.ex_string() {
        // The AST stores the unquoted content (escapes still raw); stage1's
        // StringLit.Value is the quoted lexeme (the backend appends
        // .to_string()), so re-wrap in quotes here.
        return compiler_ir.ir_string_lit("\"" + e.str_value + "\"");
    }
    if e.kind == shared_ast.ex_ident() {
        // `result` in an ensures clause is stage1's ResultExpr, emitted as the
        // synthetic __result binding of the ensures labeled block. The stage2 AST
        // has no dedicated node (result is reserved, so no real variable collides).
        if e.name == "result" {
            return compiler_ir.ir_var_ref("__result");
        }
        // `self` lowers to the scope's self name: "self" in methods, "__self" in a
        // constructor (where stage1 emits the struct being built).
        if e.name == "self" {
            return compiler_ir.ir_var_ref(scope.self_name);
        }
        // A bare identifier that names an enum variant is a UNIT variant construction
        // (stage1's Identifier -> CallVariant), e.g. `return Running;` -> `Status::
        // Running`. Modelled as a variant call with no args (no field names).
        let unit_enum: String = resolve_enum_for_variant(scope.enums, e.name);
        if unit_enum != "" {
            let mutable uv: IrExpr = IrExpr(compiler_ir.irex_call(), 0, "", false, e.name, compiler_ir.empty_ir_expr_array(), compiler_ir.ir_type_named(unit_enum));
            uv.call_kind = compiler_ir.callkind_variant();
            // Emitted `EnumName::Variant` is mangled for a cross-module enum.
            uv.enum_name = mangle_type_name(unit_enum, scope.type_names, scope.type_prefixes);
            return uv;
        }
        // Stamp the VarRef's type from the local scope (params + prior lets) — the
        // type bridge (ADR 0059 D3) that lets the backend's cloneIfNeeded tell a
        // non-Copy arg (String/Array/entity/…) from a Copy one. An unbound name
        // gets the unknown type -> treated Copy -> never cloned (conservative).
        let mutable vr: IrExpr = compiler_ir.ir_var_ref(e.name);
        vr.expr_type = lower_scope_type_of(scope, e.name);
        return vr;
    }
    if e.kind == shared_ast.ex_binop() {
        // String concatenation (`+` on two String operands) lowers to a distinct
        // irex_string_concat, exactly as stage1's lowerExpr does (it checks
        // isStringType on both sides). The type bridge stamps VarRef / literal
        // types, so a literal + param concat is detected; the Rust backend emits
        // format!("{}{}", …). A `+` where an operand's type is not reconstructable
        // (e.g. a String-returning call) stays a plain binary here — the backend's
        // PLUS-with-a-string-literal fallback still catches the literal cases.
        let left: IrExpr = lower_expr(e.children[0], scope);
        let right: IrExpr = lower_expr(e.children[1], scope);
        if e.name == "+" {
            if lower_ir_is_string(left) and lower_ir_is_string(right) {
                return compiler_ir.ir_string_concat(left, right);
            }
        }
        return compiler_ir.ir_binary(e.name, left, right);
    }
    if e.kind == shared_ast.ex_paren() {
        // The Go AST has no paren node — parens are discarded at parse time and
        // re-added only by binary self-parenthesisation. The stage2 AST preserves
        // ex_paren (the formatter needs it to round-trip source), so lowering
        // unwraps it transparently to the inner expression, matching stage1's IR
        // (and how the checker recurses children[0]).
        return lower_expr(e.children[0], scope);
    }
    if e.kind == shared_ast.ex_unary() {
        // The AST stores the operator text in `name` ("-" / "not"); stage1's
        // UnaryExpr keeps the lexer token, but the backend only distinguishes not
        // from negate, so the op string is sufficient.
        return compiler_ir.ir_unary(e.name, lower_expr(e.children[0], scope));
    }
    if e.kind == shared_ast.ex_range() {
        return compiler_ir.ir_range(lower_expr(e.children[0], scope), lower_expr(e.children[1], scope));
    }
    if e.kind == shared_ast.ex_try() {
        // `expr?` — the operand is children[0]. Mirrors stage1's TryExpr.
        return compiler_ir.ir_try(lower_expr(e.children[0], scope));
    }
    if e.kind == shared_ast.ex_spawn() {
        // `spawn <call>` — operand is children[0]. Mirrors stage1's SpawnExpr.
        return compiler_ir.ir_spawn(lower_expr(e.children[0], scope));
    }
    if e.kind == shared_ast.ex_await() {
        // `await <op>` — is_join_handle when the operand is a spawn directly, or a
        // variable bound to a spawn (join_handle_vars). Mirrors stage1's AwaitExpr.
        let inner: Expr = e.children[0];
        let mutable is_jh: Bool = false;
        if inner.kind == shared_ast.ex_spawn() {
            is_jh = true;
        } else {
            if inner.kind == shared_ast.ex_ident() {
                if string_in(scope.join_handle_vars, inner.name) {
                    is_jh = true;
                }
            }
        }
        return compiler_ir.ir_await(lower_expr(inner, scope), is_jh);
    }
    if e.kind == shared_ast.ex_match() {
        // children[0] is the scrutinee; match_arms hold variant / bindings /
        // is_wildcard / body. is_builtin (Ok/Err/Some/None) is derived by name,
        // exactly as stage1's lowerMatchExpr does. Enum-variant field-name
        // resolution (checker-dependent) lands with the enums slice. lambda-style
        // local-then-assign: the arms array is owned here (a function Array param
        // would lower to `&Vec`, unmovable into the field). Arm bindings are not
        // stamped into the scope yet (their VarRefs stay unknown -> Copy -> no
        // clone); that lands with a slice that needs an arm-bound arg cloned.
        let scrutinee: IrExpr = lower_expr(e.children[0], scope);
        // The scrutinee's enum name (from its stamped type) resolves enum-variant
        // pattern field names, mirroring stage1's lowerMatchExpr (scrutType.IsEnum).
        // Builtin (Ok/Err/Some/None) and wildcard arms carry no enum name.
        let mutable scrut_enum: String = "";
        if is_known_enum(scope.enums, scrutinee.expr_type.name) {
            scrut_enum = scrutinee.expr_type.name;
        }
        let mutable arms: Array<IrMatchArm> = compiler_ir.empty_ir_match_arm_array();
        let mutable ai: Int = 0;
        while ai < len(e.match_arms) {
            let a: MatchArm = e.match_arms[ai];
            let is_builtin: Bool = a.variant == "Ok" or a.variant == "Err" or a.variant == "Some" or a.variant == "None";
            // The arm body sees the pattern bindings typed from the scrutinee: an
            // Ok/Some binding is the Result/Option's first type arg, Err the second.
            // This lets a binding used as a receiver dispatch (e.g. Ok(c) => c.to_codepoint()
            // where c is Char). Enum-variant binding types land when an example needs them.
            let arm_scope: LowerScope = extend_scope_for_arm(scope, scrutinee, a, is_builtin);
            let mutable arm: IrMatchArm = IrMatchArm(a.variant, a.bindings, a.is_wildcard, is_builtin, lower_expr(a.body, arm_scope));
            // Resolve enum name + field names for non-builtin, non-wildcard patterns
            // (stage1 resolves FieldNames only when there are bindings). field_names
            // is a LOCAL owned array assigned to the arm's owned field. copy_str keeps
            // scrut_enum alive across the loop: a plain `arm.enum_name = scrut_enum`
            // would MOVE it (assignments don't clone), breaking later iterations.
            if not is_builtin {
                if not a.is_wildcard {
                    // Emitted `EnumName::Variant` pattern is mangled for a cross-module
                    // enum (StageStatus -> TypesStageStatus). field_names still resolve on
                    // the UNMANGLED scrut_enum (the enum registry is keyed by declared name).
                    arm.enum_name = mangle_type_name(scrut_enum, scope.type_names, scope.type_prefixes);
                    if len(a.bindings) > 0 {
                        arm.field_names = resolve_variant_field_names(scope.enums, scrut_enum, a.variant);
                    }
                }
            }
            arms.push(arm);
            ai = ai + 1;
        }
        let mutable mt: IrExpr = compiler_ir.ir_match(scrutinee);
        mt.match_arms = arms;
        return mt;
    }
    if e.kind == shared_ast.ex_lambda() {
        // The AST stores the params in lambda_params (name + type string), the
        // return type in str_value, and the body in children[0]. Parse the param
        // and return type strings into structured IrTypes (the checker isn't
        // threaded; lambda types are annotated in source).
        let mutable lparams: Array<IrParam> = compiler_ir.empty_ir_param_array();
        let mutable li: Int = 0;
        while li < len(e.lambda_params) {
            let lp: Param = e.lambda_params[li];
            lparams.push(IrParam(lp.name, compiler_ir.ir_parse_type(lp.type_name)));
            li = li + 1;
        }
        let ret_type: IrType = compiler_ir.ir_parse_type(e.str_value);
        // The lambda body sees the enclosing scope plus its own params; stamp each
        // param into a child scope so a param VarRef in the body carries its type.
        let mutable body_scope: LowerScope = scope;
        let mutable bi: Int = 0;
        while bi < len(e.lambda_params) {
            let bp: Param = e.lambda_params[bi];
            body_scope = lower_scope_define(body_scope, bp.name, compiler_ir.ir_parse_type(bp.type_name));
            bi = bi + 1;
        }
        // Assign lambda_params from the LOCAL owned array here (not inside
        // ir_lambda): a function's Array param lowers to `&Vec` and cannot be
        // moved into the owned field — the same reason parse_lambda sets
        // Expr.lambda_params at its build site.
        let mutable lam: IrExpr = compiler_ir.ir_lambda(ret_type, lower_expr(e.children[0], body_scope));
        lam.lambda_params = lparams;
        return lam;
    }
    if e.kind == shared_ast.ex_forall() {
        // `forall var in range: body` — name is the loop var, children [range, body].
        return compiler_ir.ir_forall(e.name, lower_expr(e.children[0], scope), lower_expr(e.children[1], scope));
    }
    if e.kind == shared_ast.ex_exists() {
        return compiler_ir.ir_exists(e.name, lower_expr(e.children[0], scope), lower_expr(e.children[1], scope));
    }
    if e.kind == shared_ast.ex_array() {
        let mutable elems: Array<IrExpr> = compiler_ir.empty_ir_expr_array();
        let mutable ai: Int = 0;
        while ai < len(e.children) {
            elems.push(lower_expr(e.children[ai], scope));
            ai = ai + 1;
        }
        return compiler_ir.ir_array(elems);
    }
    if e.kind == shared_ast.ex_index() {
        let obj_ix: IrExpr = lower_expr(e.children[0], scope);
        let mutable ix: IrExpr = compiler_ir.ir_index(obj_ix, lower_expr(e.children[1], scope));
        // Stamp the element type so the backend can dispatch String indexing/slicing
        // and clone non-Copy results: String[i] -> Char, String[a..b] -> String,
        // Array<T>[i] -> T. (Char is non-Copy per ir_is_copy_type -> cloned as an arg.)
        if obj_ix.expr_type.name == "String" {
            if ix.children[1].kind == compiler_ir.irex_range() {
                ix.expr_type = compiler_ir.ir_type_named("String");
            } else {
                ix.expr_type = compiler_ir.ir_type_named("Char");
            }
        } else {
            if obj_ix.expr_type.name == "Array" {
                if len(obj_ix.expr_type.type_args) == 1 {
                    ix.expr_type = obj_ix.expr_type.type_args[0];
                }
            }
        }
        return ix;
    }
    if e.kind == shared_ast.ex_field() {
        // `object.field` — name is the field, children[0] the object. Mirrors stage1
        // FieldAccessExpr. (An `obj.method(...)` CALL is handled in ex_call below,
        // where the callee is this ex_field.)
        let obj_ir: IrExpr = lower_expr(e.children[0], scope);
        let mutable fld: IrExpr = compiler_ir.ir_field(obj_ir, e.name);
        // Stamp the field's type (for receiver-type method dispatch, e.g. a Map field
        // accessed as `self.settings.get(...)`). The owning entity is the current
        // `self` entity when the object is `self`, else the object's stamped type.
        let mutable ent_name: String = "";
        if e.children[0].kind == shared_ast.ex_ident() {
            if e.children[0].name == "self" {
                ent_name = scope.self_entity_name;
            }
        }
        if ent_name == "" {
            ent_name = obj_ir.expr_type.name;
        }
        if ent_name != "" {
            fld.expr_type = lookup_entity_field_type(scope.entities, ent_name, e.name);
        }
        return fld;
    }
    if e.kind == shared_ast.ex_call() {
        let callee: Expr = e.children[0];
        // `old(expr)` inside an ensures clause -> the pre-mutation capture variable
        // (in_old scope). The capture itself is hoisted at method start (see
        // collect_old_captures); here the reference lowers to its mangled name.
        if scope.in_old {
            if callee.kind == shared_ast.ex_ident() {
                if callee.name == "old" {
                    if len(e.children) == 2 {
                        return compiler_ir.ir_var_ref(mangle_old(e.children[1]));
                    }
                }
            }
        }
        let mutable args: Array<IrExpr> = compiler_ir.empty_ir_expr_array();
        let mutable i: Int = 1;
        while i < len(e.children) {
            args.push(lower_expr(e.children[i], scope));
            i = i + 1;
        }
        // A call whose callee is an ex_field (`obj.name(...)`) is a method call
        // (stage1 MethodCallExpr): the callee's own child[0] is the receiver and its
        // name is the method. EXCEPT a module-qualified call `mod.fn(args)`, where the
        // receiver is an identifier naming an imported module (in scope.module_names):
        // stage1 detects this via typeOf(object)==nil and mangles to a free-fn call
        // `mod_fn(args)`. We resolve the prefix here and emit an irex_call with the
        // mangled name, so the backend's ordinary function-call path emits it. The
        // module map is EMPTY in single-file, so this never fires there.
        if callee.kind == shared_ast.ex_field() {
            let cobj: Expr = callee.children[0];
            if cobj.kind == shared_ast.ex_ident() {
                let mutable qi: Int = 0;
                let mutable found: Int = 0 - 1;
                while qi < len(scope.module_names) {
                    if scope.module_names[qi] == cobj.name {
                        found = qi;
                    }
                    qi = qi + 1;
                }
                if found >= 0 {
                    // Module-qualified generic entity constructor: `pkg.Pair<Int>(...)`.
                    // The type args are baked into callee.name; if the base is a generic
                    // entity, emit the monomorphized constructor (global name, no prefix),
                    // mirroring the bare `Pair<Int>()` path.
                    let gctype: IrType = compiler_ir.ir_parse_type(callee.name);
                    if entity_is_generic(scope.entities, gctype.name) {
                        if len(gctype.type_args) > 0 {
                            let gmangled: String = compiler_ir.ir_mangle_generic_name(gctype.name, gctype.type_args);
                            let mutable gcc: IrExpr = IrExpr(compiler_ir.irex_call(), 0, "", false, gmangled, args, compiler_ir.ir_type_named(gmangled));
                            gcc.call_kind = compiler_ir.callkind_constructor();
                            return gcc;
                        }
                    }
                    // Module-qualified enum variant: `pkg.Rect(w, h)` -> `Shape::Rect { ... }`,
                    // mirroring the bare `Rect(w, h)` variant path.
                    let mq_var_enum: String = resolve_enum_for_variant(scope.enums, callee.name);
                    if mq_var_enum != "" {
                        let mutable mqvc: IrExpr = IrExpr(compiler_ir.irex_call(), 0, "", false, callee.name, args, compiler_ir.ir_type_named(mq_var_enum));
                        mqvc.call_kind = compiler_ir.callkind_variant();
                        mqvc.field_names = resolve_variant_field_names(scope.enums, mq_var_enum, callee.name);
                        mqvc.enum_name = mangle_type_name(mq_var_enum, scope.type_names, scope.type_prefixes);
                        return mqvc;
                    }
                    // A module-qualified call to an ENTITY is a constructor
                    // (`types_pkg.Point(...)` -> `TypesPoint::new(...)`) — mangled by the
                    // type-origins map, not the function prefix. Otherwise a free-fn call.
                    if is_known_entity(scope.entities, callee.name) {
                        let mangled_ctor: String = mangle_type_name(callee.name, scope.type_names, scope.type_prefixes);
                        let mutable cc: IrExpr = IrExpr(compiler_ir.irex_call(), 0, "", false, mangled_ctor, args, compiler_ir.ir_type_named(callee.name));
                        cc.call_kind = compiler_ir.callkind_constructor();
                        return cc;
                    }
                    let mangled: String = scope.module_prefixes[found] + callee.name;
                    // Stamp the cross-module call's result type (by the ORIGINAL fn name).
                    return IrExpr(compiler_ir.irex_call(), 0, "", false, mangled, args, lookup_func_return(scope.func_names, scope.func_returns, callee.name));
                }
            }
            // Module-qualified enum variant `pkg.Enum.Variant(args)`: the callee is a
            // field access whose receiver is itself `pkg.Enum` (a field access on a
            // module ident). If the method names a variant, lower it as a variant
            // construction, mirroring the bare `Variant(args)` path.
            if callee.children[0].kind == shared_ast.ex_field() {
                let cinner: Expr = callee.children[0].children[0];
                if cinner.kind == shared_ast.ex_ident() {
                    let mutable emi: Int = 0;
                    let mutable emfound: Bool = false;
                    while emi < len(scope.module_names) {
                        if scope.module_names[emi] == cinner.name {
                            emfound = true;
                        }
                        emi = emi + 1;
                    }
                    if emfound {
                        let ev: String = resolve_enum_for_variant(scope.enums, callee.name);
                        if ev != "" {
                            let mutable evc: IrExpr = IrExpr(compiler_ir.irex_call(), 0, "", false, callee.name, args, compiler_ir.ir_type_named(ev));
                            evc.call_kind = compiler_ir.callkind_variant();
                            evc.field_names = resolve_variant_field_names(scope.enums, ev, callee.name);
                            evc.enum_name = mangle_type_name(ev, scope.type_names, scope.type_prefixes);
                            return evc;
                        }
                    }
                }
            }
            let object: IrExpr = lower_expr(callee.children[0], scope);
            let mutable mc: IrExpr = compiler_ir.ir_method(object, callee.name, args);
            // Stamp the method call's result type from the receiver entity's method
            // signature (self -> the current self entity, else the object's stamped type),
            // so a chained call dispatches on the right receiver type.
            let mutable recv_ent: String = "";
            if callee.children[0].kind == shared_ast.ex_ident() {
                if callee.children[0].name == "self" {
                    recv_ent = scope.self_entity_name;
                }
            }
            if recv_ent == "" {
                recv_ent = object.expr_type.name;
            }
            if recv_ent != "" {
                mc.expr_type = lookup_method_return(scope.entities, recv_ent, callee.name);
            }
            // Builtin methods with a known String result: to_string (on any scalar),
            // to_lowercase / trim (on String). Typing their result lets string-concat
            // detection fire on `x + c.to_string()`.
            if callee.name == "to_string" or callee.name == "to_lowercase" or callee.name == "trim" {
                mc.expr_type = compiler_ir.ir_type_named("String");
            }
            return mc;
        }
        let kind: Int = resolve_call_kind(callee.name);
        // A non-builtin callee naming an enum variant is a DATA variant construction
        // (stage1 CallVariant): `Circle(r)` -> `Shape::Circle { radius: r }`. Resolve
        // the enum name + declared field names (paired positionally with args) here,
        // so the backend emits without an enum table. field_names is a LOCAL owned
        // array assigned to the node's owned field.
        if kind == compiler_ir.callkind_function() {
            let var_enum: String = resolve_enum_for_variant(scope.enums, callee.name);
            if var_enum != "" {
                let mutable vc: IrExpr = IrExpr(compiler_ir.irex_call(), 0, "", false, callee.name, args, compiler_ir.ir_type_named(var_enum));
                vc.call_kind = compiler_ir.callkind_variant();
                // Resolve field names (which passes var_enum as an arg -> cloned)
                // BEFORE the enum_name assignment, which moves var_enum (a plain
                // VarRef assignment is not cloned by the backend) — its last use.
                vc.field_names = resolve_variant_field_names(scope.enums, var_enum, callee.name);
                // Emitted `EnumName::Variant` is mangled for a cross-module enum
                // (`Circle` -> `TypesShape::Circle`).
                vc.enum_name = mangle_type_name(var_enum, scope.type_names, scope.type_prefixes);
                return vc;
            }
            // A generic constructor call bakes the type args into the callee name
            // (`Stack<Int>()` -> callee.name "Stack<Int>"): parse it and, if the base
            // is a generic entity, emit a constructor call to the mangled concrete name.
            let gctype: IrType = compiler_ir.ir_parse_type(callee.name);
            if entity_is_generic(scope.entities, gctype.name) {
                if len(gctype.type_args) > 0 {
                    let gmangled: String = compiler_ir.ir_mangle_generic_name(gctype.name, gctype.type_args);
                    let mutable gcc: IrExpr = IrExpr(compiler_ir.irex_call(), 0, "", false, gmangled, args, compiler_ir.ir_type_named(gmangled));
                    gcc.call_kind = compiler_ir.callkind_constructor();
                    return gcc;
                }
            }
            // A callee naming a declared entity is a constructor call (stage1
            // CallConstructor): `BankAccount(...)` -> `BankAccount::new(...)`.
            if is_known_entity(scope.entities, callee.name) {
                // The emitted `Name::new` is mangled for a cross-module entity
                // (`Point(...)` -> `TypesPoint::new(...)`); expr_type stays the declared
                // name (unmangled — it is not emitted, only the let annotation is).
                let mangled_ctor: String = mangle_type_name(callee.name, scope.type_names, scope.type_prefixes);
                let mutable cc: IrExpr = IrExpr(compiler_ir.irex_call(), 0, "", false, mangled_ctor, args, compiler_ir.ir_type_named(callee.name));
                cc.call_kind = compiler_ir.callkind_constructor();
                return cc;
            }
        }
        // A plain (non-builtin) function call is a SAME-MODULE call — its target's
        // definition carries the current module's prefix, so the call does too (`foo()`
        // in ir.intent -> `ir_foo()`). Builtins are never prefixed. Mirrors stage1's
        // `g.namePrefix + expr.Function` for CallFunction. name_prefix is "" in the entry
        // module / single-file, so this is byte-unchanged there.
        let mutable fname: String = callee.name;
        let mutable rty: IrType = compiler_ir.ir_type_named("");
        if kind == compiler_ir.callkind_function() {
            // An extern (FFI) call emits its Rust path directly, unprefixed.
            let ext_path: String = lookup_extern_path(scope.extern_names, scope.extern_paths, callee.name);
            if ext_path != "" {
                fname = ext_path;
            } else {
                // The async builtins (sleep/await_all/await_any/timeout) are module-
                // independent — the backend emits them specially (tokio::/futures::), so
                // they must NOT get the current module's name prefix, and the `use futures;`
                // scan matches their ORIGINAL names. Everything else is a same-module call.
                if callee.name == "sleep" or callee.name == "await_all" or callee.name == "await_any" or callee.name == "timeout" {
                    fname = callee.name;
                } else {
                    fname = scope.name_prefix + callee.name;
                    // Stamp the result type (by the ORIGINAL fn name) for concat / dispatch.
                    rty = lookup_func_return(scope.func_names, scope.func_returns, callee.name);
                }
            }
        }
        let mutable call: IrExpr = IrExpr(compiler_ir.irex_call(), 0, "", false, fname, args, rty);
        call.call_kind = kind;
        return call;
    }
    return compiler_ir.ir_void_expr();
}

// resolve_call_kind — mirrors resolveCallKind's builtin classification. Entity
// constructors (CallConstructor) and enum variants (CallVariant) additionally
// need the program's entity/enum tables; that classification lands with the
// entities/enums slices, so for the trivial subset a non-builtin name is a
// plain function call. The builtin set is copied verbatim from lower.go so the
// backend dispatches identically once each builtin's emit slice lands.
public function resolve_call_kind(name: String) returns Int {
    if name == "print" or name == "len" or name == "read_file" or name == "write_file" or name == "create_dir" or name == "file_exists" or name == "env_get" or name == "http_post" or name == "http_get" or name == "json_get" or name == "json_path" or name == "emit_event" or name == "timestamp_ms" or name == "args" {
        return compiler_ir.callkind_builtin();
    }
    if name == "Ok" or name == "Err" or name == "Some" or name == "None" {
        return compiler_ir.callkind_builtin();
    }
    if name == "assert" or name == "assert_eq" or name == "assert_close" or name == "assert_panics" {
        return compiler_ir.callkind_builtin();
    }
    if name == "char_from_codepoint" {
        return compiler_ir.callkind_builtin();
    }
    return compiler_ir.callkind_function();
}

// No entry function here — a library module imported by compile_main.intent
// (same pattern as the other selfhost library modules).
