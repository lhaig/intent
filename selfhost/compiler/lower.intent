// selfhost/compiler/lower.intent — Phase 55 / ADR 0059 stage2 self-hosted compiler.
//
// AST -> IR lowering, reimplemented in Intent. Slice 55b: lowers the trivial
// subset examples/hello.intent uses — one entry function with a `return <int>`,
// and a test whose body is a single `assert(<bool>)` expr-stmt. Mirrors
// internal/ir/lower.go's Lower / lowerFunction / lowerTest / lowerBlock /
// lowerStmt / lowerExpr / resolveCallKind for exactly those cases; more cases
// land per construct slice (each byte-equal-gated by `make diff-emit` in 55c).
//
// Type handling (ADR 0059 D3): the trivial subset's literal types are inferred
// STRUCTURALLY (0 -> Int, "..." -> String, true -> Bool) via the ir_*_lit
// helpers, so no checker CheckResult is threaded. Constructs whose types come
// from inference (variable/field/method types, generics) will introduce a
// checker.Type -> IrType bridge in the slice that needs it.
module compiler_lower version "0.1.0";

import "ir.intent";

import "../shared/ast.intent";

// =============================================================================
// LowerScope — local var-name -> IrType map for the type bridge (ADR 0059 D3).
//
// Stage1 lowering reads every node's type from the checker's precomputed
// exprTypes map (see typeOf in lower.go). Stage2 carries no such map, so lowering
// reconstructs the types it actually needs — currently just enough to stamp each
// VarRef's expr_type so the Rust backend's cloneIfNeeded can tell a non-Copy
// argument (String/Array/entity/…) that must be `.clone()`d from a Copy one.
//
// The scope is FUNCTIONAL/immutable, mirroring the checker's Scope: each
// lower_scope_define copies the arrays and returns a NEW scope (never mutating in
// place). This also sidesteps gotcha (c): a function's `Array` param lowers to
// `&Vec` which cannot be moved into an owned entity field — but the copied
// new_names/new_types arrays are LOCAL owned arrays at the constructor call site,
// so they move in cleanly.
//
// It is seeded from a function's params (name -> param_type) and grows as
// lower_block walks let-bindings (name -> let_type). Nested blocks (if/while/for
// bodies) inherit the enclosing scope by value, so their own lets stay local —
// no leak back out. For-loop / lambda / match-arm bindings are left unstamped for
// now (their VarRefs get the empty/unknown type -> treated Copy -> never cloned,
// which is conservative and corpus-safe); each lands with its construct's slice.
// =============================================================================
entity LowerScope {
    field names: Array<String>;
    field types: Array<IrType>;
    // enums / entities — the program's declarations, carried CONSTANT on the scope
    // so the deep lower_expr chain can resolve variant constructors, unit-variant
    // refs, match-pattern field names, and entity constructor calls without threading
    // extra parameters. Preserved by lower_scope_define, seeded once by _empty.
    field enums: Array<EnumDecl>;
    field entities: Array<EntityDecl>;
    // self_name — what a `self` identifier lowers to: "self" (methods) or "__self"
    // (constructors, where stage1 emits the struct being built). in_old — true while
    // lowering an ensures clause, so an `old(expr)` call lowers to its captured var.
    // self_entity_name — the entity currently being lowered (for stamping `self.field`
    // access types, needed by receiver-type method dispatch like Map/String/Char).
    field self_name: String;
    field in_old: Bool;
    field self_entity_name: String;
    // join_handle_vars — names bound to a `spawn` result (a Future/JoinHandle), so
    // `await <name>` emits the JoinHandle unwrap (`.expect(...)`). Accumulated in
    // lower_block (like let types), mirroring stage1's joinHandleVars.
    field join_handle_vars: Array<String>;

    constructor(names: Array<String>, types: Array<IrType>, enums: Array<EnumDecl>, entities: Array<EntityDecl>, self_name: String, in_old: Bool, self_entity_name: String, join_handle_vars: Array<String>) {
        self.names = names;
        self.types = types;
        self.enums = enums;
        self.entities = entities;
        self.self_name = self_name;
        self.in_old = in_old;
        self.self_entity_name = self_entity_name;
        self.join_handle_vars = join_handle_vars;
    }
}

// lower_scope_empty — a fresh scope with no bindings, seeded with the program's enum
// and entity decls. The `&Vec` params are copied into LOCAL owned arrays before being
// moved into the fields (gotcha (c)). self_name defaults "self", in_old false.
function lower_scope_empty(enums: Array<EnumDecl>, entities: Array<EntityDecl>) returns LowerScope {
    let mutable e: Array<EnumDecl> = [];
    let mutable ei: Int = 0;
    while ei < len(enums) {
        e.push(enums[ei]);
        ei = ei + 1;
    }
    let mutable ent: Array<EntityDecl> = [];
    let mutable enti: Int = 0;
    while enti < len(entities) {
        ent.push(entities[enti]);
        enti = enti + 1;
    }
    return LowerScope(shared_ast.empty_string_array(), compiler_ir.empty_ir_type_array(), e, ent, "self", false, "", shared_ast.empty_string_array());
}

// lower_scope_define — a NEW scope with `name: ty` appended (copies names/types,
// mirroring the checker's scope_define_typed). The registries + self_name + in_old
// carry over (field reads clone them into the new scope).
function lower_scope_define(s: LowerScope, name: String, ty: IrType) returns LowerScope {
    let mutable new_names: Array<String> = shared_ast.empty_string_array();
    let mutable i: Int = 0;
    while i < len(s.names) {
        new_names.push(s.names[i]);
        i = i + 1;
    }
    new_names.push(name);
    let mutable new_types: Array<IrType> = compiler_ir.empty_ir_type_array();
    let mutable ti: Int = 0;
    while ti < len(s.types) {
        new_types.push(s.types[ti]);
        ti = ti + 1;
    }
    new_types.push(ty);
    return LowerScope(new_names, new_types, s.enums, s.entities, s.self_name, s.in_old, s.self_entity_name, s.join_handle_vars);
}

// lower_scope_with_self — a copy of `s` with self_name + self_entity_name set (for
// entity members: methods use "self", constructors "__self").
function lower_scope_with_self(s: LowerScope, name: String, entity_name: String) returns LowerScope {
    return LowerScope(s.names, s.types, s.enums, s.entities, name, s.in_old, entity_name, s.join_handle_vars);
}

// lower_scope_with_old — a copy of `s` with in_old set (for ensures clauses, where
// `old(expr)` lowers to its captured variable).
function lower_scope_with_old(s: LowerScope, flag: Bool) returns LowerScope {
    return LowerScope(s.names, s.types, s.enums, s.entities, s.self_name, flag, s.self_entity_name, s.join_handle_vars);
}

// lower_scope_add_joinhandle — a copy of `s` with `name` recorded as a spawn-bound
// (JoinHandle) variable, so a later `await name` emits the JoinHandle unwrap.
function lower_scope_add_joinhandle(s: LowerScope, name: String) returns LowerScope {
    let mutable jh: Array<String> = shared_ast.empty_string_array();
    let mutable i: Int = 0;
    while i < len(s.join_handle_vars) {
        jh.push(s.join_handle_vars[i]);
        i = i + 1;
    }
    jh.push(name);
    return LowerScope(s.names, s.types, s.enums, s.entities, s.self_name, s.in_old, s.self_entity_name, jh);
}

// lookup_entity_field_type — the declared type of `field_name` in entity `ent_name`,
// or the unknown type if not found. Used to stamp `self.field` / `obj.field` access
// types for receiver-type method dispatch.
function lookup_entity_field_type(entities: Array<EntityDecl>, ent_name: String, field_name: String) returns IrType {
    let mutable i: Int = 0;
    while i < len(entities) {
        let e: EntityDecl = entities[i];
        if e.name == ent_name {
            let mutable j: Int = 0;
            while j < len(e.fields) {
                if e.fields[j].name == field_name {
                    return compiler_ir.ir_parse_type(e.fields[j].type_name);
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return compiler_ir.ir_type_named("");
}

// is_known_entity — is `name` a declared entity? (Used to classify constructor calls.)
function is_known_entity(entities: Array<EntityDecl>, name: String) returns Bool {
    let mutable i: Int = 0;
    while i < len(entities) {
        if entities[i].name == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// expr_to_text / mangle_old — mirror stage1 exprToText + mangleOldExpr: a stable
// name for an `old(expr)` capture. self / identifier / field access are supported
// (the corpus's old() targets); anything else falls back to "expr".
function expr_to_text(e: Expr) returns String {
    if e.kind == shared_ast.ex_ident() {
        return e.name;
    }
    if e.kind == shared_ast.ex_field() {
        return expr_to_text(e.children[0]) + "." + e.name;
    }
    return "expr";
}

function mangle_old(inner: Expr) returns String {
    let text: String = expr_to_text(inner);
    // Replace '.' with '_' (the only separator the corpus's old() targets produce).
    let mutable out: String = "__old_";
    let mutable i: Int = 0;
    while i < len(text) {
        if text[i] == '.' {
            out = out + "_";
        } else {
            out = out + text[i].to_string();
        }
        i = i + 1;
    }
    return out;
}

// lower_scope_type_of — the IrType bound to `name`, or the empty/unknown type if
// unbound. The LAST-defined binding wins (mirrors the checker's scope_last_index),
// so an inner shadow overrides an outer name.
function lower_scope_type_of(s: LowerScope, name: String) returns IrType {
    let mutable found: Int = 0 - 1;
    let mutable i: Int = 0;
    while i < len(s.names) {
        if s.names[i] == name {
            found = i;
        }
        i = i + 1;
    }
    if found >= 0 {
        return s.types[found];
    }
    return compiler_ir.ir_type_named("");
}

// lower — an AST Program to a single IR Module (the entry module: its `entry`
// function becomes the program main in the backend). Mirrors Lower in lower.go
// for the trivial subset (functions + tests; other decl kinds land per slice).
public function lower(prog: Program, path: String) returns IrModule {
    let mutable fns: Array<IrFunction> = compiler_ir.empty_ir_function_array();
    let mutable fi: Int = 0;
    while fi < len(prog.functions) {
        fns.push(lower_function(prog.functions[fi], prog.enums, prog.entities));
        fi = fi + 1;
    }
    let mutable tsts: Array<IrTest> = compiler_ir.empty_ir_test_array();
    let mutable ti: Int = 0;
    while ti < len(prog.tests) {
        tsts.push(lower_test(prog.tests[ti], prog.enums, prog.entities));
        ti = ti + 1;
    }
    // Lower the enum declarations (their struct-style variants + field types), and
    // assign to the module post-construction (enums is an ADR 0054 additive field).
    let mutable ens: Array<IrEnum> = compiler_ir.empty_ir_enum_array();
    let mutable eni: Int = 0;
    while eni < len(prog.enums) {
        ens.push(lower_enum(prog.enums[eni]));
        eni = eni + 1;
    }
    let mutable ents: Array<IrEntity> = compiler_ir.empty_ir_entity_array();
    let mutable eei: Int = 0;
    while eei < len(prog.entities) {
        ents.push(lower_entity(prog.entities[eei], prog.enums, prog.entities));
        eei = eei + 1;
    }
    let mutable ints: Array<IrIntent> = compiler_ir.empty_ir_intent_array();
    let mutable ii: Int = 0;
    while ii < len(prog.intent_blocks) {
        ints.push(lower_intent(prog.intent_blocks[ii]));
        ii = ii + 1;
    }
    let mutable trs: Array<IrTrait> = compiler_ir.empty_ir_trait_array();
    let mutable tri: Int = 0;
    while tri < len(prog.traits) {
        trs.push(lower_trait(prog.traits[tri], prog.enums, prog.entities));
        tri = tri + 1;
    }
    let mutable imps: Array<IrImplBlock> = compiler_ir.empty_ir_impl_array();
    let mutable imi: Int = 0;
    while imi < len(prog.impls) {
        imps.push(lower_impl(prog.impls[imi], prog.enums, prog.entities));
        imi = imi + 1;
    }
    let decl_name: String = prog.module_decl.name;
    let mutable m: IrModule = IrModule(decl_name, decl_name, "", true, path, fns, tsts);
    m.enums = ens;
    m.entities = ents;
    m.intents = ints;
    m.traits = trs;
    m.impls = imps;
    return m;
}

// lower_trait — mirrors lowerTrait: each method signature (TraitMethodSig) becomes an
// IrFunction (name/params/return, empty body). Enum/entity registries seed param types.
public function lower_trait(t: TraitDecl, enums: Array<EnumDecl>, entities: Array<EntityDecl>) returns IrTrait {
    let mutable methods: Array<IrFunction> = compiler_ir.empty_ir_function_array();
    let mutable mi: Int = 0;
    while mi < len(t.methods) {
        let tm: TraitMethodSig = t.methods[mi];
        let mutable params: Array<IrParam> = compiler_ir.empty_ir_param_array();
        let mutable pi: Int = 0;
        while pi < len(tm.params) {
            let p: Param = tm.params[pi];
            params.push(IrParam(p.name, compiler_ir.ir_parse_type(p.type_name)));
            pi = pi + 1;
        }
        methods.push(IrFunction(tm.name, false, false, false, params, compiler_ir.ir_parse_type(tm.return_type), compiler_ir.empty_ir_contract_array(), compiler_ir.empty_ir_contract_array(), compiler_ir.empty_ir_stmt_array()));
        mi = mi + 1;
    }
    return IrTrait(t.name, t.is_public, methods);
}

// lower_impl — mirrors lowerImplBlock: each method is lowered like an entity method
// (self stays "self"; self.field access types resolve against the impl's entity).
public function lower_impl(ib: ImplDecl, enums: Array<EnumDecl>, entities: Array<EntityDecl>) returns IrImplBlock {
    let mutable methods: Array<IrFunction> = compiler_ir.empty_ir_function_array();
    let mutable mi: Int = 0;
    while mi < len(ib.methods) {
        methods.push(lower_member(ib.methods[mi], "self", ib.entity_name, enums, entities));
        mi = mi + 1;
    }
    return IrImplBlock(ib.trait_name, ib.entity_name, methods);
}

// lower_entity — mirrors lowerEntity: fields (parsed types), invariants (with raw
// text -> IrContract), the constructor (self -> __self), and methods (self -> self).
// The enum/entity registries seed each member's scope.
public function lower_entity(e: EntityDecl, enums: Array<EnumDecl>, entities: Array<EntityDecl>) returns IrEntity {
    let mutable fields: Array<IrParam> = compiler_ir.empty_ir_param_array();
    let mutable fi: Int = 0;
    while fi < len(e.fields) {
        let f: FieldDecl = e.fields[fi];
        fields.push(IrParam(f.name, compiler_ir.ir_parse_type(f.type_name)));
        fi = fi + 1;
    }
    // Invariants: lowered in a self-scope (self -> self), paired with raw text.
    let inv_scope: LowerScope = lower_scope_empty(enums, entities);
    let mutable invs: Array<IrContract> = compiler_ir.empty_ir_contract_array();
    let mutable ivi: Int = 0;
    while ivi < len(e.invariants) {
        let iv: Expr = e.invariants[ivi];
        invs.push(IrContract(lower_expr(iv, inv_scope), e.invariants_raw[ivi], iv.line, iv.column));
        ivi = ivi + 1;
    }
    let mutable ctor: IrFunction = compiler_ir.empty_ir_function();
    if e.has_constructor {
        ctor = lower_member(e.ctor, "__self", e.name, enums, entities);
    }
    let mutable methods: Array<IrFunction> = compiler_ir.empty_ir_function_array();
    let mutable mi: Int = 0;
    while mi < len(e.methods) {
        methods.push(lower_member(e.methods[mi], "self", e.name, enums, entities));
        mi = mi + 1;
    }
    return IrEntity(e.name, e.is_public, fields, invs, e.has_constructor, ctor, methods);
}

// lower_member — lower a constructor or method (both FunctionDecl). self_name is
// "__self" for a constructor, "self" for a method. Ensures are lowered in an
// in_old scope so `old(expr)` becomes its captured variable; old captures are
// scanned from the ensures ASTs (mirrors lowerConstructor / lowerMethod).
public function lower_member(f: FunctionDecl, self_name: String, entity_name: String, enums: Array<EnumDecl>, entities: Array<EntityDecl>) returns IrFunction {
    let base: LowerScope = lower_scope_with_self(lower_scope_empty(enums, entities), self_name, entity_name);
    let mutable scope: LowerScope = base;
    let mutable params: Array<IrParam> = compiler_ir.empty_ir_param_array();
    let mutable i: Int = 0;
    while i < len(f.params) {
        let p: Param = f.params[i];
        params.push(IrParam(p.name, compiler_ir.ir_parse_type(p.type_name)));
        scope = lower_scope_define(scope, p.name, compiler_ir.ir_parse_type(p.type_name));
        i = i + 1;
    }
    let reqs: Array<IrContract> = lower_contracts(f.requires_clauses, f.requires_raw, scope);
    // Old captures: scan ensures ASTs for old(expr), collect unique (mangled name +
    // lowered inner). The inner is lowered in the non-old scope (self stays as-is).
    let old_caps: Array<IrOldCapture> = collect_old_captures(f.ensures_clauses, scope);
    // Ensures lowered with in_old=true so old(expr) -> the captured var.
    let ens_scope: LowerScope = lower_scope_with_old(scope, true);
    let enss: Array<IrContract> = lower_contracts(f.ensures_clauses, f.ensures_raw, ens_scope);
    let body: Array<IrStmt> = lower_block(f.body, scope);
    let mutable func: IrFunction = IrFunction(f.name, f.is_entry, f.is_public, f.is_async, params, compiler_ir.ir_parse_type(f.return_type), reqs, enss, body);
    func.old_captures = old_caps;
    return func;
}

// collect_old_captures — scan each ensures AST for `old(expr)` calls, returning one
// IrOldCapture (mangled name + lowered inner) per UNIQUE mangled name, in first-seen
// order (mirrors the lowerer's oldCaptures dedup).
function collect_old_captures(ens_preds: Array<Expr>, scope: LowerScope) returns Array<IrOldCapture> {
    let mutable caps: Array<IrOldCapture> = compiler_ir.empty_ir_old_capture_array();
    let mutable seen: Array<String> = shared_ast.empty_string_array();
    let mutable i: Int = 0;
    while i < len(ens_preds) {
        caps = scan_old_into(ens_preds[i], scope, caps, seen);
        seen = old_capture_names(caps);
        i = i + 1;
    }
    return caps;
}

// old_capture_names — the mangled names already captured (for dedup).
function old_capture_names(caps: Array<IrOldCapture>) returns Array<String> {
    let mutable out: Array<String> = shared_ast.empty_string_array();
    let mutable i: Int = 0;
    while i < len(caps) {
        out.push(caps[i].name);
        i = i + 1;
    }
    return out;
}

// scan_old_into — walk an AST expr; for each `old(inner)` call whose mangled name is
// not in `seen`, append an IrOldCapture. Returns the (possibly extended) captures.
// Functional accumulation (arrays are immutable params), recursing children.
function scan_old_into(e: Expr, scope: LowerScope, caps: Array<IrOldCapture>, seen: Array<String>) returns Array<IrOldCapture> {
    let mutable out: Array<IrOldCapture> = caps;
    if e.kind == shared_ast.ex_call() {
        let callee: Expr = e.children[0];
        if callee.kind == shared_ast.ex_ident() {
            if callee.name == "old" {
                if len(e.children) == 2 {
                    let inner: Expr = e.children[1];
                    let name: String = mangle_old(inner);
                    if not string_in(seen, name) and not old_has(out, name) {
                        out.push(IrOldCapture(name, lower_expr(inner, scope)));
                    }
                    return out;
                }
            }
        }
    }
    let mutable i: Int = 0;
    while i < len(e.children) {
        out = scan_old_into(e.children[i], scope, out, seen);
        i = i + 1;
    }
    return out;
}

function old_has(caps: Array<IrOldCapture>, name: String) returns Bool {
    let mutable i: Int = 0;
    while i < len(caps) {
        if caps[i].name == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

function string_in(arr: Array<String>, name: String) returns Bool {
    let mutable i: Int = 0;
    while i < len(arr) {
        if arr[i] == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// lower_intent — mirrors lowerIntent: copy the description/goals/constraints/
// guarantees and the already-dotted verification reference strings.
public function lower_intent(i: IntentBlock) returns IrIntent {
    return IrIntent(i.description, i.goals, i.constraints, i.guarantees, i.verifications);
}

// lower_enum — mirrors lowerEnum: each variant's fields (name + parsed type) become
// IrParams (empty for a unit variant). Field types are parsed structurally.
public function lower_enum(e: EnumDecl) returns IrEnum {
    let mutable variants: Array<IrEnumVariant> = compiler_ir.empty_ir_enum_variant_array();
    let mutable vi: Int = 0;
    while vi < len(e.variants) {
        let v: EnumVariant = e.variants[vi];
        let mutable fields: Array<IrParam> = compiler_ir.empty_ir_param_array();
        let mutable fj: Int = 0;
        while fj < len(v.params) {
            let p: Param = v.params[fj];
            fields.push(IrParam(p.name, compiler_ir.ir_parse_type(p.type_name)));
            fj = fj + 1;
        }
        variants.push(IrEnumVariant(v.name, fields));
        vi = vi + 1;
    }
    return IrEnum(e.name, e.is_public, variants);
}

// resolve_enum_for_variant — the enum that declares `variant_name`, or "" if none
// (mirrors resolveEnumForVariant). Variant names are unique across enums (checker-
// enforced), so the first match is authoritative.
function resolve_enum_for_variant(enums: Array<EnumDecl>, variant_name: String) returns String {
    let mutable i: Int = 0;
    while i < len(enums) {
        let e: EnumDecl = enums[i];
        let mutable j: Int = 0;
        while j < len(e.variants) {
            if e.variants[j].name == variant_name {
                return e.name;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return "";
}

// is_known_enum — is `name` the name of a declared enum? (Used to decide a match
// scrutinee's enum, mirroring stage1's scrutType.IsEnum check.)
function is_known_enum(enums: Array<EnumDecl>, name: String) returns Bool {
    let mutable i: Int = 0;
    while i < len(enums) {
        if enums[i].name == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// resolve_variant_field_names — the declared field names of `variant_name` in
// `enum_name` (mirrors resolveVariantFieldNames), as a LOCAL owned array so it moves
// into the IR node's owned field. Empty if the enum/variant is unknown or a unit.
function resolve_variant_field_names(enums: Array<EnumDecl>, enum_name: String, variant_name: String) returns Array<String> {
    let mutable out: Array<String> = shared_ast.empty_string_array();
    let mutable i: Int = 0;
    while i < len(enums) {
        let e: EnumDecl = enums[i];
        if e.name == enum_name {
            let mutable j: Int = 0;
            while j < len(e.variants) {
                let v: EnumVariant = e.variants[j];
                if v.name == variant_name {
                    let mutable k: Int = 0;
                    while k < len(v.params) {
                        out.push(v.params[k].name);
                        k = k + 1;
                    }
                    return out;
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return out;
}

// lower_function — mirrors lowerFunction: params (types parsed structurally),
// requires/ensures contracts (via lower_contracts), and the lowered body. `enums`
// seeds the scope's enum registry (variant / match resolution).
public function lower_function(f: FunctionDecl, enums: Array<EnumDecl>, entities: Array<EntityDecl>) returns IrFunction {
    let mutable params: Array<IrParam> = compiler_ir.empty_ir_param_array();
    let mutable scope: LowerScope = lower_scope_empty(enums, entities);
    let mutable i: Int = 0;
    while i < len(f.params) {
        let p: Param = f.params[i];
        let pty: IrType = compiler_ir.ir_parse_type(p.type_name);
        params.push(IrParam(p.name, pty));
        // Seed the scope with each param so VarRefs to it carry its type (the
        // checker's exprTypes equivalent). Copy pty via a fresh parse: a param's
        // Array type lowered to `&Vec` cannot be shared into two owned fields.
        scope = lower_scope_define(scope, p.name, compiler_ir.ir_parse_type(p.type_name));
        i = i + 1;
    }
    let reqs: Array<IrContract> = lower_contracts(f.requires_clauses, f.requires_raw, scope);
    let enss: Array<IrContract> = lower_contracts(f.ensures_clauses, f.ensures_raw, scope);
    let body: Array<IrStmt> = lower_block(f.body, scope);
    return IrFunction(f.name, f.is_entry, f.is_public, f.is_async, params, compiler_ir.ir_parse_type(f.return_type), reqs, enss, body);
}

// lower_contracts — pair each contract predicate Expr with its captured raw text
// (Phase 55 shared-AST enrichment, ADR 0059) into IrContracts. The predicate is
// lowered like any expr, so `result` in an ensures clause becomes __result. old()
// captures in ensures are deferred to a later sub-slice (no corpus entry uses
// them yet). requires_raw / ensures_raw are parallel to the clause arrays.
public function lower_contracts(preds: Array<Expr>, raws: Array<String>, scope: LowerScope) returns Array<IrContract> {
    let mutable out: Array<IrContract> = compiler_ir.empty_ir_contract_array();
    let mutable i: Int = 0;
    while i < len(preds) {
        let p: Expr = preds[i];
        out.push(IrContract(lower_expr(p, scope), raws[i], p.line, p.column));
        i = i + 1;
    }
    return out;
}

// lower_test — mirrors lowerTest. The AST already stores annotations as their
// canonical strings, which is exactly the IrTest.annotations shape.
public function lower_test(t: TestDecl, enums: Array<EnumDecl>, entities: Array<EntityDecl>) returns IrTest {
    // A test has no params; its body opens a fresh scope (seeded with the enum +
    // entity registries), growing as its own let-bindings land.
    let body: Array<IrStmt> = lower_block(t.body, lower_scope_empty(enums, entities));
    return IrTest(t.name, t.is_async, t.annotations, body);
}

// lower_block — mirrors lowerBlock: lower each statement in order, threading the
// scope and accumulating each let-binding so a later statement's VarRefs carry
// the binding's type. The accumulation is local to this block (the passed scope
// is copied on each define), so a nested block's lets never leak back out.
public function lower_block(b: Block, scope: LowerScope) returns Array<IrStmt> {
    let mutable stmts: Array<IrStmt> = compiler_ir.empty_ir_stmt_array();
    let mutable s: LowerScope = scope;
    let mutable i: Int = 0;
    while i < len(b.stmts) {
        let st: IrStmt = lower_stmt(b.stmts[i], s);
        stmts.push(st);
        // Extend the scope AFTER lowering the let (its initializer is checked
        // before the name is bound), so subsequent statements see `name: let_type`.
        if st.kind == compiler_ir.irst_let() {
            s = lower_scope_define(s, st.name, st.let_type);
            // Track a `let f = spawn ...` binding so `await f` unwraps the JoinHandle.
            if st.expr.kind == compiler_ir.irex_spawn() {
                s = lower_scope_add_joinhandle(s, st.name);
            }
        }
        i = i + 1;
    }
    return stmts;
}

// lower_stmt — mirrors lowerStmt for the supported subset (return, expr-stmt,
// let-binding). A bare `return;` is st_return whose AST expr is ex_void; it
// lowers to an irst_return carrying the ir_void_expr placeholder (the IR has no
// nil). st_let carries name / is_mutable / type_name from the AST. Other
// statement kinds land per slice; the fallback mirrors lowerStmt's default (a
// `true` expr-stmt) and is unreachable for the diff-emit corpus.
public function lower_stmt(s: Stmt, scope: LowerScope) returns IrStmt {
    if s.kind == shared_ast.st_return() {
        if s.expr.kind == shared_ast.ex_void() {
            return IrStmt(compiler_ir.irst_return(), compiler_ir.ir_void_expr());
        }
        return IrStmt(compiler_ir.irst_return(), lower_expr(s.expr, scope));
    }
    if s.kind == shared_ast.st_expr() {
        // Assignment `target = value` has no dedicated AST kind: the parser
        // stores it as a st_expr wrapping an ex_binop with op "=" (children
        // [target, value]) — see check.intent. Stage1 lowers that to a distinct
        // AssignStmt (emitted `target = value;`, not `(target = value);`).
        let inner: Expr = s.expr;
        if inner.kind == shared_ast.ex_binop() {
            if inner.name == "=" {
                let mutable asg: IrStmt = IrStmt(compiler_ir.irst_assign(), lower_expr(inner.children[1], scope));
                asg.target = lower_expr(inner.children[0], scope);
                return asg;
            }
        }
        return IrStmt(compiler_ir.irst_expr(), lower_expr(inner, scope));
    }
    if s.kind == shared_ast.st_let() {
        let mutable ls: IrStmt = IrStmt(compiler_ir.irst_let(), lower_expr(s.expr, scope));
        ls.name = s.name;
        ls.is_mutable = s.is_mutable;
        ls.let_type = compiler_ir.ir_parse_type(s.type_name);
        // An empty array literal assigned to a Map-typed let is a HashMap literal:
        // stamp the value's type Map so the backend emits `HashMap::new()` (mirrors
        // stage1's ArrayLit-with-Map-Type -> HashMap::new()).
        if ls.let_type.name == "Map" {
            if ls.expr.kind == compiler_ir.irex_array() {
                if len(ls.expr.children) == 0 {
                    ls.expr.expr_type = compiler_ir.ir_type_named("Map");
                }
            }
        }
        return ls;
    }
    if s.kind == shared_ast.st_if() {
        let mutable ifs: IrStmt = IrStmt(compiler_ir.irst_if(), lower_expr(s.expr, scope));
        ifs.then_body = lower_block(s.then_block, scope);
        ifs.has_else = s.has_else;
        if s.has_else {
            ifs.else_body = lower_block(s.else_block, scope);
        }
        return ifs;
    }
    if s.kind == shared_ast.st_while() {
        let mutable ws: IrStmt = IrStmt(compiler_ir.irst_while(), lower_expr(s.expr, scope));
        ws.then_body = lower_block(s.then_block, scope);
        return ws;
    }
    if s.kind == shared_ast.st_for() {
        let mutable fs: IrStmt = IrStmt(compiler_ir.irst_for(), lower_expr(s.expr, scope));
        fs.name = s.name;
        // The loop variable's type is left unstamped (the body inherits the outer
        // scope); a for-var VarRef gets the unknown type -> treated Copy -> never
        // cloned. Binding the loop var's element type lands with a later slice if
        // a corpus example needs a for-var arg cloned.
        fs.then_body = lower_block(s.then_block, scope);
        return fs;
    }
    if s.kind == shared_ast.st_break() {
        return IrStmt(compiler_ir.irst_break(), compiler_ir.ir_void_expr());
    }
    if s.kind == shared_ast.st_continue() {
        return IrStmt(compiler_ir.irst_continue(), compiler_ir.ir_void_expr());
    }
    return IrStmt(compiler_ir.irst_expr(), compiler_ir.ir_bool_lit(true));
}

// copy_str — return an owned copy of `s`. The argument position clones `s` (a
// non-Copy String arg), so the caller's value survives; the returned owned string
// can then be MOVED into a field inside a loop without consuming the original.
function copy_str(s: String) returns String {
    return s;
}

// lower_ir_is_string — is this lowered expression String-typed? A string literal
// always is; any other node is String iff its stamped expr_type is String (a
// VarRef via the scope, or a nested string concat whose type is String). Mirrors
// stage1's isStringType(checker type == String) for the operands the bridge can
// reconstruct. Used to lower `+` on strings to a concat node.
function lower_ir_is_string(e: IrExpr) returns Bool {
    if e.kind == compiler_ir.irex_string() {
        return true;
    }
    return e.expr_type.name == "String";
}

// lower_expr — mirrors lowerExpr for the supported subset (int/bool literal,
// identifier/variable reference, and call). A call's callee is children[0] (an
// ex_ident) and its args are children[1..], per the stage2 AST's ex_call shape.
// call_kind is resolved from the callee name; enum_name stays "" until the
// enum/variant slice (where an ex_ident may instead be a unit variant).
// Unsupported kinds fall back to the void placeholder and are unreachable for
// the diff-emit corpus (grown per slice).
public function lower_expr(e: Expr, scope: LowerScope) returns IrExpr {
    if e.kind == shared_ast.ex_int() {
        return compiler_ir.ir_int_lit(e.int_value);
    }
    if e.kind == shared_ast.ex_float() {
        // The AST keeps the raw float lexeme in str_value (the formatter round-trips
        // it verbatim); stage1's FloatLit.Value is emitted as-is, so pass it through.
        return compiler_ir.ir_float_lit(e.str_value);
    }
    if e.kind == shared_ast.ex_bool() {
        return compiler_ir.ir_bool_lit(e.bool_value);
    }
    if e.kind == shared_ast.ex_string() {
        // The AST stores the unquoted content (escapes still raw); stage1's
        // StringLit.Value is the quoted lexeme (the backend appends
        // .to_string()), so re-wrap in quotes here.
        return compiler_ir.ir_string_lit("\"" + e.str_value + "\"");
    }
    if e.kind == shared_ast.ex_ident() {
        // `result` in an ensures clause is stage1's ResultExpr, emitted as the
        // synthetic __result binding of the ensures labeled block. The stage2 AST
        // has no dedicated node (result is reserved, so no real variable collides).
        if e.name == "result" {
            return compiler_ir.ir_var_ref("__result");
        }
        // `self` lowers to the scope's self name: "self" in methods, "__self" in a
        // constructor (where stage1 emits the struct being built).
        if e.name == "self" {
            return compiler_ir.ir_var_ref(scope.self_name);
        }
        // A bare identifier that names an enum variant is a UNIT variant construction
        // (stage1's Identifier -> CallVariant), e.g. `return Running;` -> `Status::
        // Running`. Modelled as a variant call with no args (no field names).
        let unit_enum: String = resolve_enum_for_variant(scope.enums, e.name);
        if unit_enum != "" {
            let mutable uv: IrExpr = IrExpr(compiler_ir.irex_call(), 0, "", false, e.name, compiler_ir.empty_ir_expr_array(), compiler_ir.ir_type_named(unit_enum));
            uv.call_kind = compiler_ir.callkind_variant();
            uv.enum_name = unit_enum;
            return uv;
        }
        // Stamp the VarRef's type from the local scope (params + prior lets) — the
        // type bridge (ADR 0059 D3) that lets the backend's cloneIfNeeded tell a
        // non-Copy arg (String/Array/entity/…) from a Copy one. An unbound name
        // gets the unknown type -> treated Copy -> never cloned (conservative).
        let mutable vr: IrExpr = compiler_ir.ir_var_ref(e.name);
        vr.expr_type = lower_scope_type_of(scope, e.name);
        return vr;
    }
    if e.kind == shared_ast.ex_binop() {
        // String concatenation (`+` on two String operands) lowers to a distinct
        // irex_string_concat, exactly as stage1's lowerExpr does (it checks
        // isStringType on both sides). The type bridge stamps VarRef / literal
        // types, so a literal + param concat is detected; the Rust backend emits
        // format!("{}{}", …). A `+` where an operand's type is not reconstructable
        // (e.g. a String-returning call) stays a plain binary here — the backend's
        // PLUS-with-a-string-literal fallback still catches the literal cases.
        let left: IrExpr = lower_expr(e.children[0], scope);
        let right: IrExpr = lower_expr(e.children[1], scope);
        if e.name == "+" {
            if lower_ir_is_string(left) and lower_ir_is_string(right) {
                return compiler_ir.ir_string_concat(left, right);
            }
        }
        return compiler_ir.ir_binary(e.name, left, right);
    }
    if e.kind == shared_ast.ex_paren() {
        // The Go AST has no paren node — parens are discarded at parse time and
        // re-added only by binary self-parenthesisation. The stage2 AST preserves
        // ex_paren (the formatter needs it to round-trip source), so lowering
        // unwraps it transparently to the inner expression, matching stage1's IR
        // (and how the checker recurses children[0]).
        return lower_expr(e.children[0], scope);
    }
    if e.kind == shared_ast.ex_unary() {
        // The AST stores the operator text in `name` ("-" / "not"); stage1's
        // UnaryExpr keeps the lexer token, but the backend only distinguishes not
        // from negate, so the op string is sufficient.
        return compiler_ir.ir_unary(e.name, lower_expr(e.children[0], scope));
    }
    if e.kind == shared_ast.ex_range() {
        return compiler_ir.ir_range(lower_expr(e.children[0], scope), lower_expr(e.children[1], scope));
    }
    if e.kind == shared_ast.ex_try() {
        // `expr?` — the operand is children[0]. Mirrors stage1's TryExpr.
        return compiler_ir.ir_try(lower_expr(e.children[0], scope));
    }
    if e.kind == shared_ast.ex_spawn() {
        // `spawn <call>` — operand is children[0]. Mirrors stage1's SpawnExpr.
        return compiler_ir.ir_spawn(lower_expr(e.children[0], scope));
    }
    if e.kind == shared_ast.ex_await() {
        // `await <op>` — is_join_handle when the operand is a spawn directly, or a
        // variable bound to a spawn (join_handle_vars). Mirrors stage1's AwaitExpr.
        let inner: Expr = e.children[0];
        let mutable is_jh: Bool = false;
        if inner.kind == shared_ast.ex_spawn() {
            is_jh = true;
        } else {
            if inner.kind == shared_ast.ex_ident() {
                if string_in(scope.join_handle_vars, inner.name) {
                    is_jh = true;
                }
            }
        }
        return compiler_ir.ir_await(lower_expr(inner, scope), is_jh);
    }
    if e.kind == shared_ast.ex_match() {
        // children[0] is the scrutinee; match_arms hold variant / bindings /
        // is_wildcard / body. is_builtin (Ok/Err/Some/None) is derived by name,
        // exactly as stage1's lowerMatchExpr does. Enum-variant field-name
        // resolution (checker-dependent) lands with the enums slice. lambda-style
        // local-then-assign: the arms array is owned here (a function Array param
        // would lower to `&Vec`, unmovable into the field). Arm bindings are not
        // stamped into the scope yet (their VarRefs stay unknown -> Copy -> no
        // clone); that lands with a slice that needs an arm-bound arg cloned.
        let scrutinee: IrExpr = lower_expr(e.children[0], scope);
        // The scrutinee's enum name (from its stamped type) resolves enum-variant
        // pattern field names, mirroring stage1's lowerMatchExpr (scrutType.IsEnum).
        // Builtin (Ok/Err/Some/None) and wildcard arms carry no enum name.
        let mutable scrut_enum: String = "";
        if is_known_enum(scope.enums, scrutinee.expr_type.name) {
            scrut_enum = scrutinee.expr_type.name;
        }
        let mutable arms: Array<IrMatchArm> = compiler_ir.empty_ir_match_arm_array();
        let mutable ai: Int = 0;
        while ai < len(e.match_arms) {
            let a: MatchArm = e.match_arms[ai];
            let is_builtin: Bool = a.variant == "Ok" or a.variant == "Err" or a.variant == "Some" or a.variant == "None";
            let mutable arm: IrMatchArm = IrMatchArm(a.variant, a.bindings, a.is_wildcard, is_builtin, lower_expr(a.body, scope));
            // Resolve enum name + field names for non-builtin, non-wildcard patterns
            // (stage1 resolves FieldNames only when there are bindings). field_names
            // is a LOCAL owned array assigned to the arm's owned field. copy_str keeps
            // scrut_enum alive across the loop: a plain `arm.enum_name = scrut_enum`
            // would MOVE it (assignments don't clone), breaking later iterations.
            if not is_builtin {
                if not a.is_wildcard {
                    arm.enum_name = copy_str(scrut_enum);
                    if len(a.bindings) > 0 {
                        arm.field_names = resolve_variant_field_names(scope.enums, scrut_enum, a.variant);
                    }
                }
            }
            arms.push(arm);
            ai = ai + 1;
        }
        let mutable mt: IrExpr = compiler_ir.ir_match(scrutinee);
        mt.match_arms = arms;
        return mt;
    }
    if e.kind == shared_ast.ex_lambda() {
        // The AST stores the params in lambda_params (name + type string), the
        // return type in str_value, and the body in children[0]. Parse the param
        // and return type strings into structured IrTypes (the checker isn't
        // threaded; lambda types are annotated in source).
        let mutable lparams: Array<IrParam> = compiler_ir.empty_ir_param_array();
        let mutable li: Int = 0;
        while li < len(e.lambda_params) {
            let lp: Param = e.lambda_params[li];
            lparams.push(IrParam(lp.name, compiler_ir.ir_parse_type(lp.type_name)));
            li = li + 1;
        }
        let ret_type: IrType = compiler_ir.ir_parse_type(e.str_value);
        // The lambda body sees the enclosing scope plus its own params; stamp each
        // param into a child scope so a param VarRef in the body carries its type.
        let mutable body_scope: LowerScope = scope;
        let mutable bi: Int = 0;
        while bi < len(e.lambda_params) {
            let bp: Param = e.lambda_params[bi];
            body_scope = lower_scope_define(body_scope, bp.name, compiler_ir.ir_parse_type(bp.type_name));
            bi = bi + 1;
        }
        // Assign lambda_params from the LOCAL owned array here (not inside
        // ir_lambda): a function's Array param lowers to `&Vec` and cannot be
        // moved into the owned field — the same reason parse_lambda sets
        // Expr.lambda_params at its build site.
        let mutable lam: IrExpr = compiler_ir.ir_lambda(ret_type, lower_expr(e.children[0], body_scope));
        lam.lambda_params = lparams;
        return lam;
    }
    if e.kind == shared_ast.ex_forall() {
        // `forall var in range: body` — name is the loop var, children [range, body].
        return compiler_ir.ir_forall(e.name, lower_expr(e.children[0], scope), lower_expr(e.children[1], scope));
    }
    if e.kind == shared_ast.ex_exists() {
        return compiler_ir.ir_exists(e.name, lower_expr(e.children[0], scope), lower_expr(e.children[1], scope));
    }
    if e.kind == shared_ast.ex_array() {
        let mutable elems: Array<IrExpr> = compiler_ir.empty_ir_expr_array();
        let mutable ai: Int = 0;
        while ai < len(e.children) {
            elems.push(lower_expr(e.children[ai], scope));
            ai = ai + 1;
        }
        return compiler_ir.ir_array(elems);
    }
    if e.kind == shared_ast.ex_index() {
        return compiler_ir.ir_index(lower_expr(e.children[0], scope), lower_expr(e.children[1], scope));
    }
    if e.kind == shared_ast.ex_field() {
        // `object.field` — name is the field, children[0] the object. Mirrors stage1
        // FieldAccessExpr. (An `obj.method(...)` CALL is handled in ex_call below,
        // where the callee is this ex_field.)
        let obj_ir: IrExpr = lower_expr(e.children[0], scope);
        let mutable fld: IrExpr = compiler_ir.ir_field(obj_ir, e.name);
        // Stamp the field's type (for receiver-type method dispatch, e.g. a Map field
        // accessed as `self.settings.get(...)`). The owning entity is the current
        // `self` entity when the object is `self`, else the object's stamped type.
        let mutable ent_name: String = "";
        if e.children[0].kind == shared_ast.ex_ident() {
            if e.children[0].name == "self" {
                ent_name = scope.self_entity_name;
            }
        }
        if ent_name == "" {
            ent_name = obj_ir.expr_type.name;
        }
        if ent_name != "" {
            fld.expr_type = lookup_entity_field_type(scope.entities, ent_name, e.name);
        }
        return fld;
    }
    if e.kind == shared_ast.ex_call() {
        let callee: Expr = e.children[0];
        // `old(expr)` inside an ensures clause -> the pre-mutation capture variable
        // (in_old scope). The capture itself is hoisted at method start (see
        // collect_old_captures); here the reference lowers to its mangled name.
        if scope.in_old {
            if callee.kind == shared_ast.ex_ident() {
                if callee.name == "old" {
                    if len(e.children) == 2 {
                        return compiler_ir.ir_var_ref(mangle_old(e.children[1]));
                    }
                }
            }
        }
        let mutable args: Array<IrExpr> = compiler_ir.empty_ir_expr_array();
        let mutable i: Int = 1;
        while i < len(e.children) {
            args.push(lower_expr(e.children[i], scope));
            i = i + 1;
        }
        // A call whose callee is an ex_field (`obj.name(...)`) is a method call
        // (stage1 MethodCallExpr): the callee's own child[0] is the receiver and
        // its name is the method. Module-qualified calls (`mod.fn()`, where the
        // object has no type) look identical in the AST, but the single-file emit
        // corpus has none, so an ex_field callee is always a genuine method call
        // here; the module-call distinction lands with multi-file emit.
        if callee.kind == shared_ast.ex_field() {
            let object: IrExpr = lower_expr(callee.children[0], scope);
            return compiler_ir.ir_method(object, callee.name, args);
        }
        let kind: Int = resolve_call_kind(callee.name);
        // A non-builtin callee naming an enum variant is a DATA variant construction
        // (stage1 CallVariant): `Circle(r)` -> `Shape::Circle { radius: r }`. Resolve
        // the enum name + declared field names (paired positionally with args) here,
        // so the backend emits without an enum table. field_names is a LOCAL owned
        // array assigned to the node's owned field.
        if kind == compiler_ir.callkind_function() {
            let var_enum: String = resolve_enum_for_variant(scope.enums, callee.name);
            if var_enum != "" {
                let mutable vc: IrExpr = IrExpr(compiler_ir.irex_call(), 0, "", false, callee.name, args, compiler_ir.ir_type_named(var_enum));
                vc.call_kind = compiler_ir.callkind_variant();
                // Resolve field names (which passes var_enum as an arg -> cloned)
                // BEFORE the enum_name assignment, which moves var_enum (a plain
                // VarRef assignment is not cloned by the backend) — its last use.
                vc.field_names = resolve_variant_field_names(scope.enums, var_enum, callee.name);
                vc.enum_name = var_enum;
                return vc;
            }
            // A callee naming a declared entity is a constructor call (stage1
            // CallConstructor): `BankAccount(...)` -> `BankAccount::new(...)`.
            if is_known_entity(scope.entities, callee.name) {
                let mutable cc: IrExpr = IrExpr(compiler_ir.irex_call(), 0, "", false, callee.name, args, compiler_ir.ir_type_named(callee.name));
                cc.call_kind = compiler_ir.callkind_constructor();
                return cc;
            }
        }
        let mutable call: IrExpr = IrExpr(compiler_ir.irex_call(), 0, "", false, callee.name, args, compiler_ir.ir_type_named(""));
        call.call_kind = kind;
        return call;
    }
    return compiler_ir.ir_void_expr();
}

// resolve_call_kind — mirrors resolveCallKind's builtin classification. Entity
// constructors (CallConstructor) and enum variants (CallVariant) additionally
// need the program's entity/enum tables; that classification lands with the
// entities/enums slices, so for the trivial subset a non-builtin name is a
// plain function call. The builtin set is copied verbatim from lower.go so the
// backend dispatches identically once each builtin's emit slice lands.
public function resolve_call_kind(name: String) returns Int {
    if name == "print" or name == "len" or name == "read_file" or name == "write_file" or name == "create_dir" or name == "file_exists" or name == "env_get" or name == "http_post" or name == "http_get" or name == "json_get" or name == "json_path" or name == "emit_event" or name == "timestamp_ms" or name == "args" {
        return compiler_ir.callkind_builtin();
    }
    if name == "Ok" or name == "Err" or name == "Some" or name == "None" {
        return compiler_ir.callkind_builtin();
    }
    if name == "assert" or name == "assert_eq" or name == "assert_close" or name == "assert_panics" {
        return compiler_ir.callkind_builtin();
    }
    if name == "char_from_codepoint" {
        return compiler_ir.callkind_builtin();
    }
    return compiler_ir.callkind_function();
}

// No entry function here — a library module imported by compile_main.intent
// (same pattern as the other selfhost library modules).
