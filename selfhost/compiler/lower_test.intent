// selfhost/compiler/lower_test.intent — Phase 55 / ADR 0059.
//
// Slice 55b verification: parse examples/hello.intent's source and lower it,
// asserting the resulting IR module has exactly the shape the Rust backend
// (55c) will emit from. The hello source is embedded (not read_file) because
// `intentc test` runs from a temp cwd where a relative read would miss it.
// Not part of the selfcheck gates (mirrors check_test.intent).
module compiler_lower_test version "0.1.0";

import "lower.intent";

import "ir.intent";

import "../shared/parser.intent";

import "../shared/ast.intent";

// Literal braces in a string literal would lex as string interpolation, so the
// embedded hello source injects them via char-to-string, exactly as
// check_test.intent does (`lbrace()`/`rbrace()`).
function lbrace() returns String {
    return '{'.to_string();
}

function rbrace() returns String {
    return '}'.to_string();
}

test "lowers hello.intent to the expected IR module" {
    let src: String = "module hello version \"1.0.0\";\n\nentry function main() returns Int " + lbrace() + "\n    return 0;\n" + rbrace() + "\n\ntest \"hello entry returns zero\" " + lbrace() + "\n    assert(true);\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "examples/hello.intent");
    assert(m.name == "hello");
    assert(m.is_entry == true);
    assert(m.path == "examples/hello.intent");
    assert(len(m.functions) == 1);
    assert(len(m.tests) == 1);
    let f: IrFunction = m.functions[0];
    assert(f.name == "main");
    assert(f.is_entry == true);
    assert(f.is_public == false);
    assert(f.is_async == false);
    assert(len(f.params) == 0);
    assert(f.return_type.name == "Int");
    assert(len(f.requires_clauses) == 0);
    assert(len(f.ensures_clauses) == 0);
    assert(len(f.body) == 1);
    let ret: IrStmt = f.body[0];
    assert(ret.kind == compiler_ir.irst_return());
    assert(ret.expr.kind == compiler_ir.irex_int());
    assert(ret.expr.int_value == 0);
    assert(ret.expr.expr_type.name == "Int");
    let t: IrTest = m.tests[0];
    assert(t.name == "hello entry returns zero");
    assert(t.is_async == false);
    assert(len(t.body) == 1);
    let es: IrStmt = t.body[0];
    assert(es.kind == compiler_ir.irst_expr());
    assert(es.expr.kind == compiler_ir.irex_call());
    assert(es.expr.name == "assert");
    assert(es.expr.call_kind == compiler_ir.callkind_builtin());
    assert(es.expr.enum_name == "");
    assert(len(es.expr.children) == 1);
    let arg: IrExpr = es.expr.children[0];
    assert(arg.kind == compiler_ir.irex_bool());
    assert(arg.bool_value == true);
    assert(arg.expr_type.name == "Bool");
}

test "lower_all mangles imported-module functions and module-qualified calls" {
    assert(compiler_lower.path_module_name("examples/multi_file/math.intent") == "math");
    assert(compiler_lower.path_module_name("math.intent") == "math");
    assert(compiler_lower.path_module_name("math") == "math");
    let math_src: String = "module math version \"1.0.0\";\n\npublic function add(a: Int, b: Int) returns Int " + lbrace() + "\n    return a + b;\n" + rbrace() + "\n";
    let main_src: String = "module main version \"1.0.0\";\n\nimport \"math.intent\";\n\nentry function main() returns Int " + lbrace() + "\n    let s: Int = math.add(3, 4);\n    return 0;\n" + rbrace() + "\n";
    let math_prog: Program = shared_parser.parse(math_src);
    let main_prog: Program = shared_parser.parse(main_src);
    let mutable progs: Array<Program> = [];
    progs.push(math_prog);
    progs.push(main_prog);
    let mutable paths: Array<String> = [];
    paths.push("math.intent");
    paths.push("main.intent");
    let p: IrProgram = compiler_lower.lower_all(progs, paths);
    assert(len(p.modules) == 2);
    // math module (non-entry): function prefixed, entry flag cleared.
    let math_mod: IrModule = p.modules[0];
    assert(math_mod.name == "math");
    assert(math_mod.is_entry == false);
    assert(len(math_mod.functions) == 1);
    assert(math_mod.functions[0].name == "math_add");
    assert(math_mod.functions[0].is_entry == false);
    // main module (entry): entry function kept verbatim.
    let main_mod: IrModule = p.modules[1];
    assert(main_mod.name == "main");
    assert(main_mod.is_entry == true);
    assert(main_mod.functions[0].name == "main");
    assert(main_mod.functions[0].is_entry == true);
    // The module-qualified call math.add(3, 4) lowers to an irex_call named math_add.
    let body: Array<IrStmt> = main_mod.functions[0].body;
    let letst: IrStmt = body[0];
    assert(letst.kind == compiler_ir.irst_let());
    let call: IrExpr = letst.expr;
    assert(call.kind == compiler_ir.irex_call());
    assert(call.name == "math_add");
    assert(len(call.children) == 2);
}

test "lowers let-bindings and variable references" {
    let src: String = "module let_locals version \"1.0.0\";\n\nentry function main() returns Int " + lbrace() + "\n    let x: Int = 42;\n    let mutable y: Int = x;\n    return y;\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "let_locals.intent");
    let body: Array<IrStmt> = m.functions[0].body;
    assert(len(body) == 3);
    let s0: IrStmt = body[0];
    assert(s0.kind == compiler_ir.irst_let());
    assert(s0.name == "x");
    assert(s0.is_mutable == false);
    assert(s0.let_type.name == "Int");
    assert(s0.expr.kind == compiler_ir.irex_int());
    assert(s0.expr.int_value == 42);
    let s1: IrStmt = body[1];
    assert(s1.kind == compiler_ir.irst_let());
    assert(s1.name == "y");
    assert(s1.is_mutable == true);
    assert(s1.expr.kind == compiler_ir.irex_var());
    assert(s1.expr.name == "x");
    let s2: IrStmt = body[2];
    assert(s2.kind == compiler_ir.irst_return());
    assert(s2.expr.kind == compiler_ir.irex_var());
    assert(s2.expr.name == "y");
}

test "lowers binary operators preserving parser precedence" {
    let src: String = "module b version \"1.0.0\";\n\nentry function main() returns Int " + lbrace() + "\n    let a: Int = 1 + 2 * 3;\n    return a;\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "b.intent");
    let rhs: IrExpr = m.functions[0].body[0].expr;
    assert(rhs.kind == compiler_ir.irex_binary());
    assert(rhs.name == "+");
    assert(rhs.children[0].kind == compiler_ir.irex_int());
    assert(rhs.children[0].int_value == 1);
    assert(rhs.children[1].kind == compiler_ir.irex_binary());
    assert(rhs.children[1].name == "*");
    assert(rhs.children[1].children[0].int_value == 2);
    assert(rhs.children[1].children[1].int_value == 3);
}

test "lowers assignment (st_expr of ex_binop '=') to a distinct irst_assign" {
    let src: String = "module a version \"1.0.0\";\n\nentry function main() returns Int " + lbrace() + "\n    let mutable x: Int = 0;\n    x = x + 1;\n    return x;\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "a.intent");
    let asg: IrStmt = m.functions[0].body[1];
    assert(asg.kind == compiler_ir.irst_assign());
    assert(asg.target.kind == compiler_ir.irex_var());
    assert(asg.target.name == "x");
    assert(asg.expr.kind == compiler_ir.irex_binary());
    assert(asg.expr.name == "+");
}

test "lowers a non-entry function with params, and a call to it" {
    let src: String = "module f version \"1.0.0\";\n\nfunction add(a: Int, b: Int) returns Int " + lbrace() + "\n    return a + b;\n" + rbrace() + "\n\nentry function main() returns Int " + lbrace() + "\n    return add(2, 3);\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "f.intent");
    assert(len(m.functions) == 2);
    let addfn: IrFunction = m.functions[0];
    assert(addfn.name == "add");
    assert(addfn.is_entry == false);
    assert(len(addfn.params) == 2);
    assert(addfn.params[0].name == "a");
    assert(addfn.params[0].param_type.name == "Int");
    let call: IrExpr = m.functions[1].body[0].expr;
    assert(call.kind == compiler_ir.irex_call());
    assert(call.name == "add");
    assert(call.call_kind == compiler_ir.callkind_function());
    assert(len(call.children) == 2);
}

test "lowers a string literal by re-quoting the AST's unquoted content" {
    let src: String = "module s version \"1.0.0\";\n\nentry function main() returns Int " + lbrace() + "\n    let g: String = \"hi\";\n    print(g);\n    return 0;\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "s.intent");
    let lit: IrExpr = m.functions[0].body[0].expr;
    assert(lit.kind == compiler_ir.irex_string());
    assert(lit.str_value == "\"hi\"");
    let printcall: IrExpr = m.functions[0].body[1].expr;
    assert(printcall.kind == compiler_ir.irex_call());
    assert(printcall.name == "print");
    assert(printcall.call_kind == compiler_ir.callkind_builtin());
}

test "lowers requires/ensures with captured raw text and result -> __result" {
    let src: String = "module c version \"1.0.0\";\n\nfunction f(n: Int) returns Int\n    requires n >= 0\n    ensures result >= 0\n" + lbrace() + "\n    return n;\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "c.intent");
    let func: IrFunction = m.functions[0];
    assert(len(func.requires_clauses) == 1);
    assert(func.requires_clauses[0].raw_text == "n >= 0");
    assert(func.requires_clauses[0].expr.kind == compiler_ir.irex_binary());
    assert(len(func.ensures_clauses) == 1);
    assert(func.ensures_clauses[0].raw_text == "result >= 0");
    let post: IrExpr = func.ensures_clauses[0].expr;
    assert(post.children[0].kind == compiler_ir.irex_var());
    assert(post.children[0].name == "__result");
}

test "lowers an Array param structurally and a method call (obj.push)" {
    let src: String = "module m version \"1.0.0\";\n\nfunction sum(numbers: Array<Int>) returns Int " + lbrace() + "\n    return 0;\n" + rbrace() + "\n\nentry function main() returns Int " + lbrace() + "\n    let mutable d: Array<Int> = [1];\n    d.push(2);\n    return sum(d);\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "m.intent");
    // The Array param is parsed into a structured IrType (Array<Int>).
    let sumfn: IrFunction = m.functions[0];
    assert(sumfn.params[0].param_type.name == "Array");
    assert(sumfn.params[0].param_type.type_args[0].name == "Int");
    // `d.push(2)` lowers to an irex_method whose receiver is `d` and arg is 2.
    let mainbody: Array<IrStmt> = m.functions[1].body;
    let push_stmt: IrStmt = mainbody[1];
    assert(push_stmt.kind == compiler_ir.irst_expr());
    let mc: IrExpr = push_stmt.expr;
    assert(mc.kind == compiler_ir.irex_method());
    assert(mc.name == "push");
    assert(mc.children[0].kind == compiler_ir.irex_var());
    assert(mc.children[0].name == "d");
    assert(mc.children[1].int_value == 2);
    // `sum(d)` stays a plain call (callee is an ident, not a field).
    let ret_call: IrExpr = mainbody[2].expr;
    assert(ret_call.kind == compiler_ir.irex_call());
    assert(ret_call.name == "sum");
    assert(ret_call.call_kind == compiler_ir.callkind_function());
}

test "lowers unary negation and unwraps parentheses transparently" {
    let src: String = "module m version \"1.0.0\";\n\nentry function main() returns Int " + lbrace() + "\n    let x: Int = 5;\n    let y: Int = -x;\n    let z: Int = (0 - y);\n    return z;\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "m.intent");
    let body: Array<IrStmt> = m.functions[0].body;
    // `-x` lowers to an irex_unary with op "-" over the var ref.
    let neg: IrExpr = body[1].expr;
    assert(neg.kind == compiler_ir.irex_unary());
    assert(neg.name == "-");
    assert(neg.children[0].kind == compiler_ir.irex_var());
    assert(neg.children[0].name == "x");
    // `(0 - y)` is an ex_paren wrapping an ex_binop; lowering unwraps the paren
    // to the inner binary (the IR has no paren node, matching stage1).
    let par: IrExpr = body[2].expr;
    assert(par.kind == compiler_ir.irex_binary());
    assert(par.name == "-");
    assert(par.children[0].int_value == 0);
    assert(par.children[1].name == "y");
}

test "lowers a forall quantifier in a contract to irex_forall" {
    let src: String = "module m version \"1.0.0\";\n\nfunction f(xs: Array<Int>) returns Bool\n    requires forall i in 0..len(xs): xs[i] >= 0\n" + lbrace() + "\n    return true;\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "m.intent");
    let req: IrContract = m.functions[0].requires_clauses[0];
    let q: IrExpr = req.expr;
    assert(q.kind == compiler_ir.irex_forall());
    assert(q.name == "i");
    // children[0] is the range (0..len(xs)), children[1] the body (xs[i] >= 0).
    assert(q.children[0].kind == compiler_ir.irex_range());
    assert(q.children[0].children[0].int_value == 0);
    assert(q.children[1].kind == compiler_ir.irex_binary());
    assert(q.children[1].name == ">=");
    assert(req.raw_text == "forall i in 0 .. len ( xs ) : xs [ i ] >= 0");
}

test "lowers a lambda and its inferred Fn-typed let binding" {
    let src: String = "module m version \"1.0.0\";\n\nentry function main() returns Int " + lbrace() + "\n    let double: Fn(Int) -> Int = |x: Int| -> Int => x * 2;\n    return double(3);\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "m.intent");
    let let_stmt: IrStmt = m.functions[0].body[0];
    assert(let_stmt.kind == compiler_ir.irst_let());
    // The let's type parses to a Fn IrType (backend drops the annotation).
    assert(let_stmt.let_type.name == "Fn");
    assert(let_stmt.let_type.fn_param_count == 1);
    let lam: IrExpr = let_stmt.expr;
    assert(lam.kind == compiler_ir.irex_lambda());
    assert(len(lam.lambda_params) == 1);
    assert(lam.lambda_params[0].name == "x");
    assert(lam.lambda_params[0].param_type.name == "Int");
    assert(lam.expr_type.name == "Int");
    assert(lam.children[0].kind == compiler_ir.irex_binary());
    assert(lam.children[0].name == "*");
}

test "lowers a match expression with builtin Ok/Err arms" {
    let src: String = "module m version \"1.0.0\";\n\nfunction f(n: Int) returns Result<Int, String> " + lbrace() + "\n    return Ok(n);\n" + rbrace() + "\n\nentry function main() returns Int " + lbrace() + "\n    let r: Result<Int, String> = f(5);\n    let v: Int = match r " + lbrace() + "\n        Ok(x) => x,\n        Err(e) => 0,\n    " + rbrace() + ";\n    return v;\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "m.intent");
    // `Ok(n)` lowers to a builtin call.
    let ok_call: IrExpr = m.functions[0].body[0].expr;
    assert(ok_call.kind == compiler_ir.irex_call());
    assert(ok_call.name == "Ok");
    assert(ok_call.call_kind == compiler_ir.callkind_builtin());
    // `match r { Ok(x) => x, Err(e) => 0 }` lowers to irex_match.
    let mt: IrExpr = m.functions[1].body[1].expr;
    assert(mt.kind == compiler_ir.irex_match());
    assert(mt.children[0].kind == compiler_ir.irex_var());
    assert(mt.children[0].name == "r");
    assert(len(mt.match_arms) == 2);
    assert(mt.match_arms[0].variant == "Ok");
    assert(mt.match_arms[0].is_builtin == true);
    assert(mt.match_arms[0].bindings[0] == "x");
    assert(mt.match_arms[1].variant == "Err");
    assert(mt.match_arms[1].bindings[0] == "e");
}

test "lowers the ? operator to irex_try wrapping the call" {
    let src: String = "module m version \"1.0.0\";\n\nfunction p(n: Int) returns Result<Int, String> " + lbrace() + "\n    return Ok(n);\n" + rbrace() + "\n\nfunction q(n: Int) returns Result<Int, String> " + lbrace() + "\n    let x: Int = p(n)?;\n    return Ok(x);\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "m.intent");
    let try_expr: IrExpr = m.functions[1].body[0].expr;
    assert(try_expr.kind == compiler_ir.irex_try());
    assert(try_expr.children[0].kind == compiler_ir.irex_call());
    assert(try_expr.children[0].name == "p");
}

test "stamps a param VarRef's expr_type from the scope (type bridge)" {
    let src: String = "module m version \"1.0.0\";\n\nfunction parse(s: String) returns Int " + lbrace() + "\n    return 0;\n" + rbrace() + "\n\nfunction use(a: String) returns Int " + lbrace() + "\n    return parse(a);\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "m.intent");
    // In `use`, the call `parse(a)` has arg `a` — a VarRef to the String param,
    // so its expr_type is stamped String (a non-Copy type the backend clones).
    let call: IrExpr = m.functions[1].body[0].expr;
    assert(call.kind == compiler_ir.irex_call());
    assert(call.name == "parse");
    let arg: IrExpr = call.children[0];
    assert(arg.kind == compiler_ir.irex_var());
    assert(arg.name == "a");
    assert(arg.expr_type.name == "String");
}

test "stamps a let-bound VarRef's expr_type from the accumulated scope" {
    let src: String = "module m version \"1.0.0\";\n\nentry function main() returns Int " + lbrace() + "\n    let name: String = \"hi\";\n    print(name);\n    return 0;\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "m.intent");
    // `print(name)` — `name` is a VarRef to the String let, stamped String.
    let printcall: IrExpr = m.functions[0].body[1].expr;
    assert(printcall.name == "print");
    let arg: IrExpr = printcall.children[0];
    assert(arg.kind == compiler_ir.irex_var());
    assert(arg.name == "name");
    assert(arg.expr_type.name == "String");
}

test "stamps builtin match-arm binding types from the scrutinee (Ok -> arg0)" {
    // The scrutinee `r` is Result<Int, String>; the Ok(x) binding is typed from its
    // first type arg (Int), so a binding used as a receiver dispatches on its type.
    let src: String = "module m version \"1.0.0\";\n\nfunction f(r: Result<Int, String>) returns Int " + lbrace() + "\n    return match r " + lbrace() + "\n        Ok(x) => x,\n        Err(e) => 0,\n    " + rbrace() + ";\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "m.intent");
    let mt: IrExpr = m.functions[0].body[0].expr;
    assert(mt.kind == compiler_ir.irex_match());
    // scrutinee `r` is a stamped param (Result), non-Copy.
    assert(mt.children[0].name == "r");
    assert(mt.children[0].expr_type.name == "Result");
    // the Ok arm body `x` is now stamped Int (Result's first type arg).
    let ok_body: IrExpr = mt.match_arms[0].body;
    assert(ok_body.kind == compiler_ir.irex_var());
    assert(ok_body.name == "x");
    assert(ok_body.expr_type.name == "Int");
}

test "lowers break and continue statements" {
    let src: String = "module m version \"1.0.0\";\n\nentry function main() returns Int " + lbrace() + "\n    let mutable i: Int = 0;\n    while i < 10 " + lbrace() + "\n        i = i + 1;\n        if i == 3 " + lbrace() + "\n            continue;\n        " + rbrace() + "\n        if i == 7 " + lbrace() + "\n            break;\n        " + rbrace() + "\n    " + rbrace() + "\n    return i;\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "m.intent");
    let loop_body: Array<IrStmt> = m.functions[0].body[1].then_body;
    // loop body: [i = i + 1, if(continue), if(break)]
    let cont_if: IrStmt = loop_body[1];
    assert(cont_if.kind == compiler_ir.irst_if());
    assert(cont_if.then_body[0].kind == compiler_ir.irst_continue());
    let break_if: IrStmt = loop_body[2];
    assert(break_if.then_body[0].kind == compiler_ir.irst_break());
}

test "lowers `+` on two String operands to irex_string_concat" {
    let src: String = "module m version \"1.0.0\";\n\nfunction f(s: String) returns String " + lbrace() + "\n    return \"prefix: \" + s;\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "m.intent");
    let ret: IrExpr = m.functions[0].body[0].expr;
    // "prefix: " (String literal) + s (String param, stamped) -> string concat.
    assert(ret.kind == compiler_ir.irex_string_concat());
    assert(ret.expr_type.name == "String");
    assert(ret.children[0].kind == compiler_ir.irex_string());
    assert(ret.children[1].kind == compiler_ir.irex_var());
    assert(ret.children[1].name == "s");
}

test "keeps numeric `+` as a plain binary (not a string concat)" {
    let src: String = "module m version \"1.0.0\";\n\nfunction f(a: Int, b: Int) returns Int " + lbrace() + "\n    return a + b;\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "m.intent");
    let ret: IrExpr = m.functions[0].body[0].expr;
    assert(ret.kind == compiler_ir.irex_binary());
    assert(ret.name == "+");
}

test "lowers a float literal keeping its raw lexeme" {
    let src: String = "module m version \"1.0.0\";\n\nentry function main() returns Int " + lbrace() + "\n    let pi: Float = 3.14;\n    return 0;\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "m.intent");
    let lit: IrExpr = m.functions[0].body[0].expr;
    assert(lit.kind == compiler_ir.irex_float());
    assert(lit.str_value == "3.14");
    assert(lit.expr_type.name == "Float");
}

test "lowers enum decls, variant construction, and enum-match patterns" {
    let src: String = "module m version \"1.0.0\";\n\nenum Shape " + lbrace() + "\n    Circle(radius: Float),\n    Point,\n" + rbrace() + "\n\nfunction mk() returns Shape " + lbrace() + "\n    return Circle(5.0);\n" + rbrace() + "\n\nfunction unit() returns Shape " + lbrace() + "\n    return Point;\n" + rbrace() + "\n\nfunction kind(s: Shape) returns Int " + lbrace() + "\n    return match s " + lbrace() + "\n        Circle(r) => 1,\n        Point => 0,\n    " + rbrace() + ";\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "m.intent");
    // Enum decl lowered with a data variant (radius: Float) and a unit variant.
    assert(len(m.enums) == 1);
    let en: IrEnum = m.enums[0];
    assert(en.name == "Shape");
    assert(len(en.variants) == 2);
    assert(en.variants[0].name == "Circle");
    assert(len(en.variants[0].fields) == 1);
    assert(en.variants[0].fields[0].name == "radius");
    assert(en.variants[0].fields[0].param_type.name == "Float");
    assert(len(en.variants[1].fields) == 0);
    // `Circle(5.0)` -> a variant call with enum_name + field_names.
    let data_call: IrExpr = m.functions[0].body[0].expr;
    assert(data_call.kind == compiler_ir.irex_call());
    assert(data_call.call_kind == compiler_ir.callkind_variant());
    assert(data_call.enum_name == "Shape");
    assert(data_call.field_names[0] == "radius");
    // `Point` (bare unit variant ref) -> a variant call, no field names.
    let unit_call: IrExpr = m.functions[1].body[0].expr;
    assert(unit_call.call_kind == compiler_ir.callkind_variant());
    assert(unit_call.enum_name == "Shape");
    assert(unit_call.name == "Point");
    assert(len(unit_call.field_names) == 0);
    // match arm `Circle(r)` gets enum_name (from scrutinee `s: Shape`) + field_names.
    let mt: IrExpr = m.functions[2].body[0].expr;
    assert(mt.kind == compiler_ir.irex_match());
    assert(mt.match_arms[0].enum_name == "Shape");
    assert(mt.match_arms[0].field_names[0] == "radius");
    assert(mt.match_arms[1].variant == "Point");
    assert(len(mt.match_arms[1].bindings) == 0);
}

test "lowers an entity: fields, invariant raw, constructor (__self), method, old()" {
    let src: String = "module m version \"1.0.0\";\n\nentity Acct " + lbrace() + "\n    field bal: Int;\n    invariant self.bal >= 0;\n    constructor(b: Int)\n        requires b >= 0\n    " + lbrace() + "\n        self.bal = b;\n    " + rbrace() + "\n    method dep(a: Int) returns Void\n        ensures self.bal == old(self.bal) + a\n    " + lbrace() + "\n        self.bal = self.bal + a;\n    " + rbrace() + "\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "m.intent");
    assert(len(m.entities) == 1);
    let en: IrEntity = m.entities[0];
    assert(en.name == "Acct");
    assert(en.fields[0].name == "bal");
    assert(en.fields[0].param_type.name == "Int");
    // Invariant lowered with raw text; self stays `self`.
    assert(len(en.invariants) == 1);
    assert(en.invariants[0].raw_text == "self . bal >= 0");
    assert(en.invariants[0].expr.kind == compiler_ir.irex_binary());
    // Constructor: self -> __self, so `self.bal = b` targets a __self field access.
    assert(en.has_constructor);
    let ctor: IrFunction = en.constructor_fn;
    assert(len(ctor.requires_clauses) == 1);
    assert(ctor.requires_clauses[0].raw_text == "b >= 0");
    let asg: IrStmt = ctor.body[0];
    assert(asg.kind == compiler_ir.irst_assign());
    assert(asg.target.kind == compiler_ir.irex_field());
    assert(asg.target.children[0].name == "__self");
    // Method: self stays `self`; the ensures old(self.bal) becomes a capture.
    let dep: IrFunction = en.methods[0];
    assert(dep.name == "dep");
    assert(len(dep.old_captures) == 1);
    assert(dep.old_captures[0].name == "__old_self_bal");
    // The ensures references the captured var (an irex_var to __old_self_bal).
    assert(len(dep.ensures_clauses) == 1);
    let post: IrExpr = dep.ensures_clauses[0].expr;
    assert(post.children[1].children[0].kind == compiler_ir.irex_var());
    assert(post.children[1].children[0].name == "__old_self_bal");
}

test "lowers an entity constructor call to callkind_constructor" {
    let src: String = "module m version \"1.0.0\";\n\nentity P " + lbrace() + "\n    field x: Int;\n    constructor(x: Int) " + lbrace() + "\n        self.x = x;\n    " + rbrace() + "\n" + rbrace() + "\n\nentry function main() returns Int " + lbrace() + "\n    let p: P = P(5);\n    return 0;\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "m.intent");
    let ctor_call: IrExpr = m.functions[0].body[0].expr;
    assert(ctor_call.kind == compiler_ir.irex_call());
    assert(ctor_call.call_kind == compiler_ir.callkind_constructor());
    assert(ctor_call.name == "P");
}

test "stamps a Map field access type and an empty-array Map let" {
    let src: String = "module m version \"1.0.0\";\n\nentity C " + lbrace() + "\n    field settings: Map<String, String>;\n    constructor(settings: Map<String, String>) " + lbrace() + "\n        self.settings = settings;\n    " + rbrace() + "\n    method g(k: String) returns String " + lbrace() + "\n        return self.settings.get(k, k);\n    " + rbrace() + "\n" + rbrace() + "\n\nentry function main() returns Int " + lbrace() + "\n    let mutable scores: Map<String, Int> = [];\n    return 0;\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "m.intent");
    // In method g, `self.settings.get(...)` receiver `self.settings` is stamped Map.
    let g: IrFunction = m.entities[0].methods[0];
    let ret_call: IrExpr = g.body[0].expr;
    assert(ret_call.kind == compiler_ir.irex_method());
    assert(ret_call.children[0].kind == compiler_ir.irex_field());
    assert(ret_call.children[0].expr_type.name == "Map");
    // `let scores: Map = []` stamps the empty array literal's type Map.
    let scores_let: IrStmt = m.functions[0].body[0];
    assert(scores_let.kind == compiler_ir.irst_let());
    assert(scores_let.expr.kind == compiler_ir.irex_array());
    assert(scores_let.expr.expr_type.name == "Map");
}

test "lowers spawn/await with join-handle tracking" {
    let src: String = "module m version \"1.0.0\";\n\nasync function work(a: Int) returns Int " + lbrace() + "\n    return a;\n" + rbrace() + "\n\nasync entry function main() returns Int " + lbrace() + "\n    let f: Future<Int> = spawn work(3);\n    let r: Int = await f;\n    return r;\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "m.intent");
    // work is async; main is async entry.
    assert(m.functions[0].is_async);
    assert(m.functions[1].is_async);
    let mainbody: Array<IrStmt> = m.functions[1].body;
    // `spawn work(3)` -> irex_spawn wrapping the call.
    let spawn_let: IrStmt = mainbody[0];
    assert(spawn_let.expr.kind == compiler_ir.irex_spawn());
    assert(spawn_let.expr.children[0].kind == compiler_ir.irex_call());
    // `await f` -> irex_await with is_join_handle (f bound to a spawn) = bool_value true.
    let await_let: IrStmt = mainbody[1];
    assert(await_let.expr.kind == compiler_ir.irex_await());
    assert(await_let.expr.bool_value == true);
    assert(await_let.expr.children[0].name == "f");
}

test "lowers a trait and an impl block" {
    let src: String = "module m version \"1.0.0\";\n\nentity E " + lbrace() + "\n    field n: Int;\n    constructor(n: Int) " + lbrace() + "\n        self.n = n;\n    " + rbrace() + "\n" + rbrace() + "\n\ntrait T " + lbrace() + "\n    method run(x: Int) returns Int;\n" + rbrace() + "\n\nimpl T for E " + lbrace() + "\n    method run(x: Int) returns Int " + lbrace() + "\n        return self.n + x;\n    " + rbrace() + "\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "m.intent");
    assert(len(m.traits) == 1);
    assert(m.traits[0].name == "T");
    assert(m.traits[0].methods[0].name == "run");
    assert(m.traits[0].methods[0].return_type.name == "Int");
    assert(len(m.impls) == 1);
    assert(m.impls[0].trait_name == "T");
    assert(m.impls[0].entity_name == "E");
    // impl method body: `self.n + x` — self.n is a field access stamped Int.
    let run: IrFunction = m.impls[0].methods[0];
    let ret: IrExpr = run.body[0].expr;
    assert(ret.kind == compiler_ir.irex_binary());
    assert(ret.children[0].kind == compiler_ir.irex_field());
    assert(ret.children[0].expr_type.name == "Int");
}

test "monomorphizes a generic entity per instantiation" {
    let src: String = "module m version \"1.0.0\";\n\nentity Box<T> " + lbrace() + "\n    field val: T;\n    constructor(v: T) " + lbrace() + "\n        self.val = v;\n    " + rbrace() + "\n" + rbrace() + "\n\nentry function main() returns Int " + lbrace() + "\n    let a: Box<Int> = Box<Int>(1);\n    let b: Box<String> = Box<String>(\"x\");\n    return 0;\n" + rbrace() + "\n";
    let prog: Program = shared_parser.parse(src);
    let m: IrModule = compiler_lower.lower(prog, "m.intent");
    // The generic Box<T> is NOT emitted; Box__Int and Box__String are.
    assert(len(m.entities) == 2);
    assert(m.entities[0].name == "Box__Int");
    assert(m.entities[1].name == "Box__String");
    // Box__Int's field is substituted to Int; Box__String's to String.
    assert(m.entities[0].fields[0].param_type.name == "Int");
    assert(m.entities[1].fields[0].param_type.name == "String");
    // `Box<Int>(1)` lowers to a constructor call on the mangled name.
    let ctor_call: IrExpr = m.functions[0].body[0].expr;
    assert(ctor_call.call_kind == compiler_ir.callkind_constructor());
    assert(ctor_call.name == "Box__Int");
}

