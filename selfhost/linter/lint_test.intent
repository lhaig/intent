// --- Enum tests (43.7) -------------------------------------------------------

test "R7: enum with non-PascalCase name produces diag" {
    let src: String = "module m version \"1.0\"; enum bad_name " + '{'.to_string() + " A, B " + '}'.to_string();
    let prog: Program = shared_parser.parse(src);
    let diags: Array<LintDiag> = linter.lint_program(prog);
    assert_eq(has_diag_msg(diags, "enum 'bad_name' should use PascalCase naming"), true);
}

test "R7: PascalCase enum name produces no R7 diag" {
    let src: String = "module m version \"1.0\"; enum Color " + '{'.to_string() + " Red, Green " + '}'.to_string();
    let prog: Program = shared_parser.parse(src);
    let diags: Array<LintDiag> = linter.lint_program(prog);
    assert_eq(has_diag_msg(diags, "enum 'Color' should use PascalCase naming"), false);
}

test "R8: non-PascalCase variant produces diag" {
    let src: String = "module m version \"1.0\"; enum Color " + '{'.to_string() + " red, Green " + '}'.to_string();
    let prog: Program = shared_parser.parse(src);
    let diags: Array<LintDiag> = linter.lint_program(prog);
    assert_eq(has_diag_msg(diags, "variant 'red' in enum 'Color' should use PascalCase naming"), true);
}

test "R8: PascalCase variant produces no R8 diag" {
    let src: String = "module m version \"1.0\"; enum Color " + '{'.to_string() + " Red, Green " + '}'.to_string();
    let prog: Program = shared_parser.parse(src);
    let diags: Array<LintDiag> = linter.lint_program(prog);
    assert_eq(has_diag_msg(diags, "variant 'Green' in enum 'Color' should use PascalCase naming"), false);
}

test "R8: only bad variant in mixed enum produces diag; good variant produces no diag" {
    let src: String = "module m version \"1.0\"; enum Color " + '{'.to_string() + " red, Green " + '}'.to_string();
    let prog: Program = shared_parser.parse(src);
    let diags: Array<LintDiag> = linter.lint_program(prog);
    assert_eq(has_diag_msg(diags, "variant 'red' in enum 'Color' should use PascalCase naming"), true);
    assert_eq(has_diag_msg(diags, "variant 'Green' in enum 'Color' should use PascalCase naming"), false);
}

