test "entity ctor R14: unused constructor param produces diag" {
    let src: String = "module m version \"1.0\"; entity Foo " + '{'.to_string() + " field x: Int; constructor(x: Int, unused: Int) " + '{'.to_string() + " self.x = x; " + '}'.to_string() + ' '.to_string() + '}'.to_string();
    let prog: Program = shared_parser.parse(src);
    let diags: Array<LintDiag> = linter.lint_program(prog);
    assert_eq(has_diag_msg(diags, "parameter 'unused' in 'Foo.constructor' is never used"), true);
}

test "entity method R10/R2/R5 ORDER: empty-body + no-contracts + bad-name in stage1 order" {
    let src: String = "module m version \"1.0\"; entity Foo " + '{'.to_string() + " method BadM() returns Int " + '{'.to_string() + ' '.to_string() + '}'.to_string() + ' '.to_string() + '}'.to_string();
    let prog: Program = shared_parser.parse(src);
    let diags: Array<LintDiag> = linter.lint_program(prog);
    // Find positions
    let mutable r10_pos: Int = -1;
    let mutable r2_pos: Int = -1;
    let mutable r5_pos: Int = -1;
    let mutable i: Int = 0;
    while i < len(diags) {
        if diags[i].message == "function 'Foo.BadM' has an empty body" {
            r10_pos = i;
        }
        if diags[i].message == "method 'Foo.BadM' has no requires or ensures contracts" {
            r2_pos = i;
        }
        if diags[i].message == "function 'BadM' should use snake_case naming" {
            r5_pos = i;
        }
        i = i + 1;
    }
    assert_eq(r10_pos >= 0, true);
    assert_eq(r2_pos >= 0, true);
    assert_eq(r5_pos >= 0, true);
    assert_eq(r10_pos < r2_pos, true);
    assert_eq(r2_pos < r5_pos, true);
}

test "entity method R14: unused method param produces diag" {
    let src: String = "module m version \"1.0\"; entity Foo " + '{'.to_string() + " method do_work(x: Int, y: Int) returns Int requires x > 0; ensures true; " + '{'.to_string() + " return x; " + '}'.to_string() + ' '.to_string() + '}'.to_string();
    let prog: Program = shared_parser.parse(src);
    let diags: Array<LintDiag> = linter.lint_program(prog);
    assert_eq(has_diag_msg(diags, "parameter 'y' in 'Foo.do_work' is never used"), true);
}

test "entity method R12: unused variable in method produces diag" {
    // No contracts intentionally (R2 fires too, but we check for R12 only)
    let src: String = "module m version \"1.0\"; entity Foo " + '{'.to_string() + " method do_work() returns Int " + '{'.to_string() + " let z = 5; return 1; " + '}'.to_string() + ' '.to_string() + '}'.to_string();
    let prog: Program = shared_parser.parse(src);
    let diags: Array<LintDiag> = linter.lint_program(prog);
    assert_eq(has_diag_msg(diags, "variable 'z' is declared but never used"), true);
}

test "entity method R13: mutable never reassigned in method produces diag" {
    // No contracts intentionally (R2 fires too, but we check for R13 only)
    let src: String = "module m version \"1.0\"; entity Foo " + '{'.to_string() + " method do_work() returns Int " + '{'.to_string() + " let mutable w = 1; return w; " + '}'.to_string() + ' '.to_string() + '}'.to_string();
    let prog: Program = shared_parser.parse(src);
    let diags: Array<LintDiag> = linter.lint_program(prog);
    assert_eq(has_diag_msg(diags, "variable 'w' is declared mutable but never reassigned"), true);
}

