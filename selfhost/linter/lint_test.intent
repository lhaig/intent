// --- ORDER: exact diag sequence test -----------------------------------------
// BadFn() — empty body + no contracts + non-snake_case → exactly 3 diags
// in stage1's order: R10, R1, R5.

test "ORDER: empty-body + no-contracts + bad-name diags in stage1 order" {
    let src: String = "module m version \"1.0\"; function BadFn() returns Int " + '{'.to_string() + ' '.to_string() + '}'.to_string();
    let prog: Program = shared_parser.parse(src);
    let diags: Array<LintDiag> = linter.lint_program(prog);
    assert_eq(len(diags), 3);
    assert_eq(diags[0].message, "function 'BadFn' has an empty body");
    assert_eq(diags[1].message, "function 'BadFn' has no requires or ensures contracts");
    assert_eq(diags[2].message, "function 'BadFn' should use snake_case naming");
}

test "ORDER: R12 full pass before R13 full pass for multiple mutable lets" {
    // Two unused mutable lets: stage1 order is R12(a), R12(b), R13(a), R13(b)
    // not interleaved R12(a)/R13(a), R12(b)/R13(b).
    let src: String = "module m version \"1.0\"; function two_lets() returns Int " + '{'.to_string() + " let mutable a = 1; let mutable b = 2; return 0; " + '}'.to_string();
    let prog: Program = shared_parser.parse(src);
    let diags: Array<LintDiag> = linter.lint_program(prog);
    let mutable r12a: Int = -1;
    let mutable r12b: Int = -1;
    let mutable r13a: Int = -1;
    let mutable r13b: Int = -1;
    let mutable i: Int = 0;
    while i < len(diags) {
        if diags[i].message == "variable 'a' is declared but never used" {
            r12a = i;
        }
        if diags[i].message == "variable 'b' is declared but never used" {
            r12b = i;
        }
        if diags[i].message == "variable 'a' is declared mutable but never reassigned" {
            r13a = i;
        }
        if diags[i].message == "variable 'b' is declared mutable but never reassigned" {
            r13b = i;
        }
        i = i + 1;
    }
    assert_eq(r12a >= 0, true);
    assert_eq(r12b >= 0, true);
    assert_eq(r13a >= 0, true);
    assert_eq(r13b >= 0, true);
    assert_eq(r12a < r13a, true);
    assert_eq(r12a < r13b, true);
    assert_eq(r12b < r13a, true);
    assert_eq(r12b < r13b, true);
}

test "R13: mutable in nested if block does NOT produce R13 diag (top-level only)" {
    let src: String = "module m version \"1.0\"; function nested_mut() returns Int " + '{'.to_string() + " if true " + '{'.to_string() + " let mutable y = 5; " + '}'.to_string() + " return 0; " + '}'.to_string();
    let prog: Program = shared_parser.parse(src);
    let diags: Array<LintDiag> = linter.lint_program(prog);
    assert_eq(has_diag_msg(diags, "variable 'y' is declared mutable but never reassigned"), false);
}

test "R16: spawn nested inside if block fires R16 diag" {
    let src: String = "module m version \"1.0\"; function nested_spawn() returns Int " + '{'.to_string() + " if true " + '{'.to_string() + " spawn foo(); " + '}'.to_string() + " return 1; " + '}'.to_string();
    let prog: Program = shared_parser.parse(src);
    let diags: Array<LintDiag> = linter.lint_program(prog);
    assert_eq(has_diag_msg(diags, "spawn result in 'nested_spawn' is discarded; assign to a Future variable and await it"), true);
}

// --- R16: discarded spawn ----------------------------------------------------
// `spawn foo();` parses as st_expr(expr=ex_spawn(children=[ex_call(ex_ident("foo"))])).
// Verified: stage2 parse_unary wraps the operand in ex_spawn.

test "R16: discarded spawn in function body produces diag" {
    let src: String = "module m version \"1.0\"; function do_spawn() returns Int " + '{'.to_string() + " spawn foo(); return 1; " + '}'.to_string();
    let prog: Program = shared_parser.parse(src);
    let diags: Array<LintDiag> = linter.lint_program(prog);
    assert_eq(has_diag_msg(diags, "spawn result in 'do_spawn' is discarded; assign to a Future variable and await it"), true);
}

test "R16: no spawn in body produces no spawn diag" {
    let src: String = "module m version \"1.0\"; function no_spawn() returns Int " + '{'.to_string() + " return 1; " + '}'.to_string();
    let prog: Program = shared_parser.parse(src);
    let diags: Array<LintDiag> = linter.lint_program(prog);
    assert_eq(has_diag_msg(diags, "spawn result in 'no_spawn' is discarded; assign to a Future variable and await it"), false);
}

