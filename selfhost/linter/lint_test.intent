// --- Intent block tests (43.7) ------------------------------------------------
// IntentBlock.verifications = the verified_by list (Array<String>).
// R11 fires when len(verifications) == 0.

test "R11: intent block with no verified_by produces diag" {
    let src: String = "module m version \"1.0\"; intent \"do something\" " + '{'.to_string() + " goal: \"be correct\"; " + '}'.to_string();
    let prog: Program = shared_parser.parse(src);
    let diags: Array<LintDiag> = linter.lint_program(prog);
    assert_eq(has_diag_msg(diags, "intent block has no verified_by references"), true);
}

test "R11: intent block with verified_by produces no R11 diag" {
    let src: String = "module m version \"1.0\"; intent \"do something\" " + '{'.to_string() + " goal: \"be correct\"; verified_by: [some_contract]; " + '}'.to_string();
    let prog: Program = shared_parser.parse(src);
    let diags: Array<LintDiag> = linter.lint_program(prog);
    assert_eq(has_diag_msg(diags, "intent block has no verified_by references"), false);
}

// --- R3: trait method contracts (43.8) ----------------------------------------
// R3 always fires — stage2 parse_trait_method_sig does not parse requires/ensures,
// so every successfully-parsed trait method has no contracts.

test "R3: trait method always produces no-contracts diag" {
    let src: String = "module m version \"1.0\"; trait T " + '{'.to_string() + " method execute() returns Int; " + '}'.to_string();
    let prog: Program = shared_parser.parse(src);
    let diags: Array<LintDiag> = linter.lint_program(prog);
    assert_eq(has_diag_msg(diags, "trait method 'T.execute' has no requires or ensures contracts"), true);
}

test "R3/R5 ORDER: R5 naming fires before R3 contracts for same method" {
    // BadName violates R5; R5 must appear before R3 in diags array.
    let src: String = "module m version \"1.0\"; trait T " + '{'.to_string() + " method BadName() returns Int; " + '}'.to_string();
    let prog: Program = shared_parser.parse(src);
    let diags: Array<LintDiag> = linter.lint_program(prog);
    let mutable r5_pos: Int = -1;
    let mutable r3_pos: Int = -1;
    let mutable i: Int = 0;
    while i < len(diags) {
        if diags[i].message == "function 'BadName' should use snake_case naming" {
            r5_pos = i;
        }
        if diags[i].message == "trait method 'T.BadName' has no requires or ensures contracts" {
            r3_pos = i;
        }
        i = i + 1;
    }
    assert_eq(r5_pos >= 0, true);
    assert_eq(r3_pos >= 0, true);
    assert_eq(r5_pos < r3_pos, true);
}

// --- R4: extern contracts (43.8) ----------------------------------------------
// R4 always fires — stage2 parse_extern_decl parses requires/ensures but DISCARDS them
// (they are not stored on ExternDecl), so every parsed extern has no contracts.
// Extern syntax: extern function name(...) returns T from "crate::path";
// ExternDecl.func_name holds the function name.

test "R4: extern always produces no-contracts diag" {
    let src: String = "module m version \"1.0\"; extern function panic(msg: String) returns Void from \"std::process::abort\";";
    let prog: Program = shared_parser.parse(src);
    let diags: Array<LintDiag> = linter.lint_program(prog);
    assert_eq(has_diag_msg(diags, "extern function 'panic' has no requires/ensures; FFI declarations should document the boundary contract"), true);
}

// --- type_uses_param helper tests (43.9) --------------------------------------

test "type_uses_param: Array<T> contains T" {
    assert_eq(linter.type_uses_param("Array<T>", "T"), true);
}

test "type_uses_param: Type does not match T (prefix)" {
    assert_eq(linter.type_uses_param("Type", "T"), false);
}

test "type_uses_param: TT does not match T (longer)" {
    assert_eq(linter.type_uses_param("TT", "T"), false);
}

test "type_uses_param: Int does not match T" {
    assert_eq(linter.type_uses_param("Int", "T"), false);
}

test "type_uses_param: Map<K, V> contains K" {
    assert_eq(linter.type_uses_param("Map<K, V>", "K"), true);
}

test "type_uses_param: Fn(T) -> R contains T" {
    assert_eq(linter.type_uses_param("Fn(T) -> R", "T"), true);
}

// --- R15: unused function type parameters (43.9) ------------------------------
// Column of T in "module m version \"1.0\"; function ident<T>...":
// "module m version \"1.0\"; " = 24 chars, "function ident<" = 15 chars → T at column 40.

test "R15: unused type param in function produces diag" {
    let src: String = "module m version \"1.0\"; function ident<T>(x: Int) returns Int " + '{'.to_string() + " return x; " + '}'.to_string();
    let prog: Program = shared_parser.parse(src);
    let diags: Array<LintDiag> = linter.lint_program(prog);
    assert_eq(has_diag_msg(diags, "type parameter 'T' in function 'ident' is never used in parameters or return type"), true);
}

test "R15: unused type param diag has correct column" {
    let src: String = "module m version \"1.0\"; function ident<T>(x: Int) returns Int " + '{'.to_string() + " return x; " + '}'.to_string();
    let prog: Program = shared_parser.parse(src);
    let diags: Array<LintDiag> = linter.lint_program(prog);
    let mutable col: Int = -1;
    let mutable i: Int = 0;
    while i < len(diags) {
        if diags[i].message == "type parameter 'T' in function 'ident' is never used in parameters or return type" {
            col = diags[i].column;
        }
        i = i + 1;
    }
    assert_eq(col, 40);
}

test "R15: used type param in param type produces no R15 diag" {
    let src: String = "module m version \"1.0\"; function ident<T>(x: T) returns T " + '{'.to_string() + " return x; " + '}'.to_string();
    let prog: Program = shared_parser.parse(src);
    let diags: Array<LintDiag> = linter.lint_program(prog);
    assert_eq(has_diag_msg(diags, "type parameter 'T' in function 'ident' is never used in parameters or return type"), false);
}

test "R15: token-aware — TT param type does not count as T usage" {
    let src: String = "module m version \"1.0\"; function ident<T>(x: TT) returns Int " + '{'.to_string() + " return 1; " + '}'.to_string();
    let prog: Program = shared_parser.parse(src);
    let diags: Array<LintDiag> = linter.lint_program(prog);
    assert_eq(has_diag_msg(diags, "type parameter 'T' in function 'ident' is never used in parameters or return type"), true);
}

