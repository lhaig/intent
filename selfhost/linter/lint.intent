// selfhost/formatter/lint.intent — Phase 43.3 / self-hosted linter scaffold.
//
// Diagnostic model + dispatch walk + R5 (function snake_case naming).
// Emit order mirrors stage1 Lint(): functions → externs → entities → enums
// → traits → impls → intent_blocks, so byte-equal output is achievable in
// the differential gate (43.12).
module linter version "0.1.0";

import "../shared/ast.intent";

// --- Diagnostic entity -------------------------------------------------------

public entity LintDiag {
    field line: Int;
    field column: Int;
    field message: String;

    constructor(line: Int, column: Int, message: String) {
        self.line = line;
        self.column = column;
        self.message = message;
    }
}

// --- Naming helpers ----------------------------------------------------------
// Ported from stage1 linter.go isSnakeCase / isPascalCase (the Go code, not
// the doc comments). Char predicates used: is_lowercase(), is_uppercase(),
// is_digit() — all available as Char methods in the Intent runtime.

public function is_snake_case(name: String) returns Bool {
    if len(name) == 0 {
        return false;
    }
    let mutable i: Int = 0;
    while i < len(name) {
        let c: Char = name[i];
        if not c.is_lowercase() and c != '_' and not c.is_digit() {
            return false;
        }
        i = i + 1;
    }
    return true;
}

public function is_pascal_case(name: String) returns Bool {
    if len(name) == 0 {
        return false;
    }
    if not name[0].is_uppercase() {
        return false;
    }
    let mutable i: Int = 1;
    while i < len(name) {
        if name[i] == '_' {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// --- Diagnostic formatter ----------------------------------------------------
// Produces one line per diag matching stage1 diagnostic.Format exactly:
//   warning[<file>:<line>:<col>]: <message>\n

public function format_diags(diags: Array<LintDiag>, file: String) returns String {
    let mutable s: String = "";
    let mutable i: Int = 0;
    while i < len(diags) {
        let d: LintDiag = diags[i];
        s = s + "warning[" + file + ":" + d.line.to_string() + ":" + d.column.to_string() + "]: " + d.message + "\n";
        i = i + 1;
    }
    return s;
}

// --- Per-kind lint helpers ---------------------------------------------------
// Each returns an Array<LintDiag>; lint_program appends them in order.

// collect_let_stmts returns all st_let statements reachable from stmts,
// recursing into if/else, while, and for blocks. Stage1 collectLetStmts
// does the same full-body walk so R12/R13 catch nested `let` declarations.
public function collect_let_stmts(stmts: Array<Stmt>) returns Array<Stmt> {
    let mutable out: Array<Stmt> = [];
    let mutable i: Int = 0;
    while i < len(stmts) {
        let s: Stmt = stmts[i];
        if s.kind == shared_ast.st_let() {
            out.push(s);
        }
        if s.kind == shared_ast.st_if() {
            let mutable ttmp: Array<Stmt> = collect_let_stmts(s.then_block.stmts);
            let mutable ti: Int = 0;
            while ti < len(ttmp) {
                out.push(ttmp[ti]);
                ti = ti + 1;
            }
            if s.has_else {
                let mutable etmp: Array<Stmt> = collect_let_stmts(s.else_block.stmts);
                let mutable ei: Int = 0;
                while ei < len(etmp) {
                    out.push(etmp[ei]);
                    ei = ei + 1;
                }
            }
        }
        if s.kind == shared_ast.st_while() {
            let mutable wtmp: Array<Stmt> = collect_let_stmts(s.then_block.stmts);
            let mutable wi: Int = 0;
            while wi < len(wtmp) {
                out.push(wtmp[wi]);
                wi = wi + 1;
            }
        }
        if s.kind == shared_ast.st_for() {
            let mutable ftmp: Array<Stmt> = collect_let_stmts(s.then_block.stmts);
            let mutable fi: Int = 0;
            while fi < len(ftmp) {
                out.push(ftmp[fi]);
                fi = fi + 1;
            }
        }
        i = i + 1;
    }
    return out;
}

// check_unused_params emits R14 for each param not present in used.
// scope is the enclosing function/method name for the message.
// Reused by lint_entity_decl and lint_impl_decl (task 43.6).
public function check_unused_params(params: Array<Param>, used: Array<String>, scope: String) returns Array<LintDiag> {
    let mutable diags: Array<LintDiag> = [];
    let mutable i: Int = 0;
    while i < len(params) {
        let prm: Param = params[i];
        if not name_in(used, prm.name) {
            diags.push(LintDiag(prm.line, prm.column, "parameter '" + prm.name + "' in '" + scope + "' is never used"));
        }
        i = i + 1;
    }
    return diags;
}

// check_unused_variables emits R12 for each st_let reachable from stmts
// (recurses into if/else, while, for) whose name is not in used.
// Reused by lint_entity_decl and lint_impl_decl (task 43.6).
public function check_unused_variables(stmts: Array<Stmt>, used: Array<String>) returns Array<LintDiag> {
    let mutable diags: Array<LintDiag> = [];
    let mutable lets: Array<Stmt> = collect_let_stmts(stmts);
    let mutable i: Int = 0;
    while i < len(lets) {
        let ls: Stmt = lets[i];
        if not name_in(used, ls.name) {
            diags.push(LintDiag(ls.line, ls.column, "variable '" + ls.name + "' is declared but never used"));
        }
        i = i + 1;
    }
    return diags;
}

// check_mutable_never_reassigned emits R13 for top-level st_let stmts that
// are is_mutable but whose name is NOT in assigned. Stage1 does NOT recurse
// into nested blocks for R13 (asymmetry with R12). Reused by 43.6.
public function check_mutable_never_reassigned(stmts: Array<Stmt>, assigned: Array<String>) returns Array<LintDiag> {
    let mutable diags: Array<LintDiag> = [];
    let mutable i: Int = 0;
    while i < len(stmts) {
        let s: Stmt = stmts[i];
        if s.kind == shared_ast.st_let() {
            if s.is_mutable {
                if not name_in(assigned, s.name) {
                    diags.push(LintDiag(s.line, s.column, "variable '" + s.name + "' is declared mutable but never reassigned"));
                }
            }
        }
        i = i + 1;
    }
    return diags;
}

// find_discarded_spawns emits R16 for st_expr statements whose expr is
// ex_spawn, recursing into if/else, while, for bodies. Reused by 43.6.
// `spawn x();` parses as st_expr(expr=ex_spawn(children=[ex_call(x)])).
public function find_discarded_spawns(stmts: Array<Stmt>, fname: String) returns Array<LintDiag> {
    let mutable diags: Array<LintDiag> = [];
    let mutable i: Int = 0;
    while i < len(stmts) {
        let s: Stmt = stmts[i];
        if s.kind == shared_ast.st_expr() {
            if s.expr.kind == shared_ast.ex_spawn() {
                diags.push(LintDiag(s.line, s.column, "spawn result in '" + fname + "' is discarded; assign to a Future variable and await it"));
            }
        }
        if s.kind == shared_ast.st_if() {
            let mutable ttmp: Array<LintDiag> = find_discarded_spawns(s.then_block.stmts, fname);
            let mutable ti: Int = 0;
            while ti < len(ttmp) {
                diags.push(ttmp[ti]);
                ti = ti + 1;
            }
            if s.has_else {
                let mutable etmp: Array<LintDiag> = find_discarded_spawns(s.else_block.stmts, fname);
                let mutable ei: Int = 0;
                while ei < len(etmp) {
                    diags.push(etmp[ei]);
                    ei = ei + 1;
                }
            }
        }
        if s.kind == shared_ast.st_while() {
            let mutable wtmp: Array<LintDiag> = find_discarded_spawns(s.then_block.stmts, fname);
            let mutable wi: Int = 0;
            while wi < len(wtmp) {
                diags.push(wtmp[wi]);
                wi = wi + 1;
            }
        }
        if s.kind == shared_ast.st_for() {
            let mutable ftmp: Array<LintDiag> = find_discarded_spawns(s.then_block.stmts, fname);
            let mutable fi: Int = 0;
            while fi < len(ftmp) {
                diags.push(ftmp[fi]);
                fi = fi + 1;
            }
        }
        i = i + 1;
    }
    return diags;
}

// type_uses_param returns true iff param appears as a whole identifier token
// inside typestr. Extracts maximal identifier runs (alpha/digit/underscore)
// and compares each to param. Avoids substring false positives:
// type_uses_param("Type","T")==false, type_uses_param("TT","T")==false.
public function type_uses_param(typestr: String, param: String) returns Bool {
    let mutable i: Int = 0;
    let n: Int = len(typestr);
    while i < n {
        let c: Char = typestr[i];
        if c.is_uppercase() or c.is_lowercase() or c == '_' {
            // start of an identifier run; advance j to its end
            let mutable j: Int = i;
            let mutable running: Bool = true;
            while j < n and running {
                let d: Char = typestr[j];
                if d.is_uppercase() or d.is_lowercase() or d.is_digit() or d == '_' {
                    j = j + 1;
                } else {
                    running = false;
                }
            }
            // identifier is typestr[i..j]; compare to param
            if j - i == len(param) {
                let mutable k: Int = 0;
                let mutable matched: Bool = true;
                while k < len(param) {
                    if typestr[i + k] != param[k] {
                        matched = false;
                    }
                    k = k + 1;
                }
                if matched {
                    return true;
                }
            }
            i = j;
        } else {
            i = i + 1;
        }
    }
    return false;
}

// lint_function_decl checks a single top-level function declaration.
// Stage1 order: R10 (empty body), R1 (missing contracts, skip entry), R5
// (snake_case), R15 (unused type params), then unconditionally (stage1 runs
// these whenever Body != nil, which is always true in stage2):
// R14 (unused params), R12 (unused vars, recursive), R13 (mutable
// never reassigned, top-level only), R16 (discarded spawn, recursive).
public function lint_function_decl(fdecl: FunctionDecl) returns Array<LintDiag> {
    let mutable diags: Array<LintDiag> = [];
    let body_empty: Bool = len(fdecl.body.stmts) == 0;
    // R10: empty body (fires for all functions including entry)
    if body_empty {
        diags.push(LintDiag(fdecl.line, fdecl.column, "function '" + fdecl.name + "' has an empty body"));
    }
    // R1: missing contracts (skip entry functions)
    if not fdecl.is_entry {
        if len(fdecl.requires_clauses) == 0 and len(fdecl.ensures_clauses) == 0 {
            diags.push(LintDiag(fdecl.line, fdecl.column, "function '" + fdecl.name + "' has no requires or ensures contracts"));
        }
    }
    // R5: snake_case naming
    if not is_snake_case(fdecl.name) {
        diags.push(LintDiag(fdecl.line, fdecl.column, "function '" + fdecl.name + "' should use snake_case naming"));
    }
    // R15: unused type parameters
    let mutable tpi: Int = 0;
    while tpi < len(fdecl.type_params) {
        let tp: String = fdecl.type_params[tpi];
        let mutable tp_used: Bool = type_uses_param(fdecl.return_type, tp);
        let mutable pi: Int = 0;
        while pi < len(fdecl.params) {
            if type_uses_param(fdecl.params[pi].type_name, tp) {
                tp_used = true;
            }
            pi = pi + 1;
        }
        if not tp_used {
            diags.push(LintDiag(fdecl.type_param_lines[tpi], fdecl.type_param_columns[tpi], "type parameter '" + tp + "' in function '" + fdecl.name + "' is never used in parameters or return type"));
        }
        tpi = tpi + 1;
    }
    // R14/R12/R13/R16 run unconditionally (stage1 runs whenever Body != nil)
    let mutable used: Array<String> = collect_used_names(fdecl.body.stmts);
    // R14: unused parameters
    let mutable r14: Array<LintDiag> = check_unused_params(fdecl.params, used, fdecl.name);
    let mutable r14i: Int = 0;
    while r14i < len(r14) {
        diags.push(r14[r14i]);
        r14i = r14i + 1;
    }
    // R12: unused variables (recursive into nested blocks)
    let mutable r12: Array<LintDiag> = check_unused_variables(fdecl.body.stmts, used);
    let mutable r12i: Int = 0;
    while r12i < len(r12) {
        diags.push(r12[r12i]);
        r12i = r12i + 1;
    }
    // R13: mutable never reassigned (top-level stmts only — stage1 asymmetry)
    let mutable assigned: Array<String> = collect_assigned_names(fdecl.body.stmts);
    let mutable r13: Array<LintDiag> = check_mutable_never_reassigned(fdecl.body.stmts, assigned);
    let mutable r13i: Int = 0;
    while r13i < len(r13) {
        diags.push(r13[r13i]);
        r13i = r13i + 1;
    }
    // R16: discarded spawn (recursive into nested blocks)
    let mutable r16: Array<LintDiag> = find_discarded_spawns(fdecl.body.stmts, fdecl.name);
    let mutable r16i: Int = 0;
    while r16i < len(r16) {
        diags.push(r16[r16i]);
        r16i = r16i + 1;
    }
    return diags;
}

// lint_extern_decl checks a single extern declaration.
// R4: always fires — stage2 parse_extern_decl expects `;` immediately after the
// return type and does not parse requires/ensures, so every successfully-parsed
// extern has no contracts.
public function lint_extern_decl(ext: ExternDecl) returns Array<LintDiag> {
    let mutable diags: Array<LintDiag> = [];
    // R4: every extern lacks contracts (stage2 parser surface has no contract clause for externs)
    diags.push(LintDiag(ext.line, ext.column, "extern function '" + ext.func_name + "' has no requires/ensures; FFI declarations should document the boundary contract"));
    return diags;
}

// lint_entity_decl checks a single entity declaration.
// Stage1 order: R6 (entity naming), R9 (no-invariant), R15e (unused type
// params), ctor R14, then per method: R10, R2, R5, R14/R12/R13 (no R16).
public function lint_entity_decl(ent: EntityDecl) returns Array<LintDiag> {
    let mutable diags: Array<LintDiag> = [];
    // R6: entity must use PascalCase
    if not is_pascal_case(ent.name) {
        diags.push(LintDiag(ent.line, ent.column, "entity '" + ent.name + "' should use PascalCase naming"));
    }
    // R9: entity with fields but no invariant
    if len(ent.fields) > 0 and len(ent.invariants) == 0 {
        diags.push(LintDiag(ent.line, ent.column, "entity '" + ent.name + "' has fields but no invariant"));
    }
    // R15e: unused entity type parameters
    let mutable etpi: Int = 0;
    while etpi < len(ent.type_params) {
        let etp: String = ent.type_params[etpi];
        let mutable etp_used: Bool = false;
        // check fields
        let mutable efi: Int = 0;
        while efi < len(ent.fields) {
            if type_uses_param(ent.fields[efi].type_name, etp) {
                etp_used = true;
            }
            efi = efi + 1;
        }
        // check methods: params and return type
        let mutable emi: Int = 0;
        while emi < len(ent.methods) {
            let em: FunctionDecl = ent.methods[emi];
            let mutable empi: Int = 0;
            while empi < len(em.params) {
                if type_uses_param(em.params[empi].type_name, etp) {
                    etp_used = true;
                }
                empi = empi + 1;
            }
            if type_uses_param(em.return_type, etp) {
                etp_used = true;
            }
            emi = emi + 1;
        }
        if not etp_used {
            diags.push(LintDiag(ent.type_param_lines[etpi], ent.type_param_columns[etpi], "type parameter '" + etp + "' in entity '" + ent.name + "' is never used"));
        }
        etpi = etpi + 1;
    }
    // Constructor R14: unused params (scope = "EntityName.constructor")
    if ent.has_constructor {
        let mutable ctor_used: Array<String> = collect_used_names(ent.ctor.body.stmts);
        let mutable cr14: Array<LintDiag> = check_unused_params(ent.ctor.params, ctor_used, ent.name + ".constructor");
        let mutable cr14i: Int = 0;
        while cr14i < len(cr14) {
            diags.push(cr14[cr14i]);
            cr14i = cr14i + 1;
        }
    }
    // Per method in declaration order
    let mutable mi: Int = 0;
    while mi < len(ent.methods) {
        let m: FunctionDecl = ent.methods[mi];
        // R10: empty body (qualified name "Entity.method")
        if len(m.body.stmts) == 0 {
            diags.push(LintDiag(m.line, m.column, "function '" + ent.name + "." + m.name + "' has an empty body"));
        }
        // R2: method missing contracts (word "method", qualified name)
        if len(m.requires_clauses) == 0 and len(m.ensures_clauses) == 0 {
            diags.push(LintDiag(m.line, m.column, "method '" + ent.name + "." + m.name + "' has no requires or ensures contracts"));
        }
        // R5: snake_case (word "function", UNqualified name)
        if not is_snake_case(m.name) {
            diags.push(LintDiag(m.line, m.column, "function '" + m.name + "' should use snake_case naming"));
        }
        // R14/R12/R13 body checks (no R16 for methods)
        let mutable m_used: Array<String> = collect_used_names(m.body.stmts);
        let mutable mr14: Array<LintDiag> = check_unused_params(m.params, m_used, ent.name + "." + m.name);
        let mutable mr14i: Int = 0;
        while mr14i < len(mr14) {
            diags.push(mr14[mr14i]);
            mr14i = mr14i + 1;
        }
        let mutable mr12: Array<LintDiag> = check_unused_variables(m.body.stmts, m_used);
        let mutable mr12i: Int = 0;
        while mr12i < len(mr12) {
            diags.push(mr12[mr12i]);
            mr12i = mr12i + 1;
        }
        let mutable m_assigned: Array<String> = collect_assigned_names(m.body.stmts);
        let mutable mr13: Array<LintDiag> = check_mutable_never_reassigned(m.body.stmts, m_assigned);
        let mutable mr13i: Int = 0;
        while mr13i < len(mr13) {
            diags.push(mr13[mr13i]);
            mr13i = mr13i + 1;
        }
        mi = mi + 1;
    }
    return diags;
}

// lint_enum_decl checks a single enum declaration.
// Stage1 order: R7 (enum PascalCase naming), R8 (variant PascalCase naming per variant).
public function lint_enum_decl(en: EnumDecl) returns Array<LintDiag> {
    let mutable diags: Array<LintDiag> = [];
    // R7: enum must use PascalCase
    if not is_pascal_case(en.name) {
        diags.push(LintDiag(en.line, en.column, "enum '" + en.name + "' should use PascalCase naming"));
    }
    // R8: each variant must use PascalCase (declaration order)
    let mutable vi: Int = 0;
    while vi < len(en.variants) {
        let v: EnumVariant = en.variants[vi];
        if not is_pascal_case(v.name) {
            diags.push(LintDiag(v.line, v.column, "variant '" + v.name + "' in enum '" + en.name + "' should use PascalCase naming"));
        }
        vi = vi + 1;
    }
    return diags;
}

// lint_trait_decl checks a single trait declaration.
// R6-trait QUIRK: stage1 calls checkEntityNaming for traits, so the message
// literally says "entity", not "trait".
// Stage1 order per method: R5 (naming), then R3 (contracts).
// R3 always fires — stage2 parse_trait_method_sig expects `;` immediately after
// the return type and does not parse requires/ensures, so every successfully-parsed
// trait method has no contracts.
public function lint_trait_decl(tr: TraitDecl) returns Array<LintDiag> {
    let mutable diags: Array<LintDiag> = [];
    // R6-trait: naming check — message says "entity" (stage1 quirk)
    if not is_pascal_case(tr.name) {
        diags.push(LintDiag(tr.line, tr.column, "entity '" + tr.name + "' should use PascalCase naming"));
    }
    // per method: R5 naming, then R3 contracts (always-fire; stage2 parser has no contract clause for trait methods)
    let mutable mi: Int = 0;
    while mi < len(tr.methods) {
        let m: TraitMethodSig = tr.methods[mi];
        // R5: snake_case naming
        if not is_snake_case(m.name) {
            diags.push(LintDiag(m.line, m.column, "function '" + m.name + "' should use snake_case naming"));
        }
        // R3: no contracts (always fires for every parseable trait method)
        diags.push(LintDiag(m.line, m.column, "trait method '" + tr.name + "." + m.name + "' has no requires or ensures contracts"));
        mi = mi + 1;
    }
    return diags;
}

// lint_impl_decl checks a single impl block.
// Stage1 order per method: R10 (empty body), R5 (naming), R14/R12 body checks.
// Impl methods get NO R2 (contracts), NO R13 (mutable), NO R16 (spawn).
public function lint_impl_decl(impl_decl: ImplDecl) returns Array<LintDiag> {
    let mutable diags: Array<LintDiag> = [];
    let mutable mi: Int = 0;
    while mi < len(impl_decl.methods) {
        let m: FunctionDecl = impl_decl.methods[mi];
        // R10: empty body (qualified name "EntityName.method")
        if len(m.body.stmts) == 0 {
            diags.push(LintDiag(m.line, m.column, "function '" + impl_decl.entity_name + "." + m.name + "' has an empty body"));
        }
        // R5: snake_case (UNqualified name)
        if not is_snake_case(m.name) {
            diags.push(LintDiag(m.line, m.column, "function '" + m.name + "' should use snake_case naming"));
        }
        // R14/R12 body checks (no R2, no R13, no R16)
        let mutable m_used: Array<String> = collect_used_names(m.body.stmts);
        let mutable mr14: Array<LintDiag> = check_unused_params(m.params, m_used, impl_decl.entity_name + "." + m.name);
        let mutable mr14i: Int = 0;
        while mr14i < len(mr14) {
            diags.push(mr14[mr14i]);
            mr14i = mr14i + 1;
        }
        let mutable mr12: Array<LintDiag> = check_unused_variables(m.body.stmts, m_used);
        let mutable mr12i: Int = 0;
        while mr12i < len(mr12) {
            diags.push(mr12[mr12i]);
            mr12i = mr12i + 1;
        }
        mi = mi + 1;
    }
    return diags;
}

// lint_intent_block checks a single intent block.
// R11: intent block must have at least one verified_by reference.
public function lint_intent_block(ib: IntentBlock) returns Array<LintDiag> {
    let mutable diags: Array<LintDiag> = [];
    // R11: no verified_by references
    if len(ib.verifications) == 0 {
        diags.push(LintDiag(ib.line, ib.column, "intent block has no verified_by references"));
    }
    return diags;
}

// --- Used-name / assigned-name engine ----------------------------------------
// Faithful port of stage1 linter.go collectUsedNames / collectAssignedNames.
// Arrays are pass-by-value in stage2 Intent; every helper RETURNS a new array.
//
// Rust backend note: `concat(a, helper_call())` fails because the Rust backend
// emits `fn concat(a: &Vec, b: &Vec)` and a temporary return value cannot be
// borrowed. Pattern: always store helper results in a named `let mutable tmp`
// before appending. collect_used_names_from_expr uses inline push loops for
// recursive cases to avoid the temp-borrow issue entirely.

// concat merges two named Array<String> values into a new one.
// Both args must be bound names (not temporaries) at call sites.
public function concat(a: Array<String>, b: Array<String>) returns Array<String> {
    let mutable out: Array<String> = [];
    let mutable ai: Int = 0;
    while ai < len(a) {
        out.push(a[ai]);
        ai = ai + 1;
    }
    let mutable bi: Int = 0;
    while bi < len(b) {
        out.push(b[bi]);
        bi = bi + 1;
    }
    return out;
}

// append_names pushes every element of src into out (inline; both are named).
// Used instead of concat() where the Rust temp-borrow restriction applies.
function append_names(out: Array<String>, src: Array<String>) returns Array<String> {
    let mutable dst: Array<String> = out;
    let mutable i: Int = 0;
    while i < len(src) {
        dst.push(src[i]);
        i = i + 1;
    }
    return dst;
}

// collect_used_names_from_expr returns every identifier that is read by expr e.
// Method-call representation (verified in parser tests):
//   obj.m(a)  →  ex_call( children=[ ex_field(children=[obj], name="m"), a ] )
// So for ex_call: callee=children[0] — if ex_field, recurse it (collects receiver);
// if ex_ident, skip (function name is not a use). Args = children[1..].
function collect_used_names_from_expr(e: Expr) returns Array<String> {
    let mutable out: Array<String> = [];
    if e.kind == shared_ast.ex_ident() {
        out.push(e.name);
        return out;
    }
    if e.kind == shared_ast.ex_binop() or e.kind == shared_ast.ex_unary() or e.kind == shared_ast.ex_array() or e.kind == shared_ast.ex_index() or e.kind == shared_ast.ex_range() {
        let mutable ci: Int = 0;
        while ci < len(e.children) {
            let mutable tmp: Array<String> = collect_used_names_from_expr(e.children[ci]);
            out = append_names(out, tmp);
            ci = ci + 1;
        }
        return out;
    }
    if e.kind == shared_ast.ex_call() {
        // callee is children[0]
        let callee: Expr = e.children[0];
        if callee.kind == shared_ast.ex_field() {
            let mutable ctmp: Array<String> = collect_used_names_from_expr(callee);
            out = append_names(out, ctmp);
        }
        // if callee is ex_ident: function name, skip
        // collect args: children[1..]
        let mutable ai: Int = 1;
        while ai < len(e.children) {
            let mutable atmp: Array<String> = collect_used_names_from_expr(e.children[ai]);
            out = append_names(out, atmp);
            ai = ai + 1;
        }
        return out;
    }
    if e.kind == shared_ast.ex_field() {
        // recurse object (children[0]); field name is not a read
        let mutable ftmp: Array<String> = collect_used_names_from_expr(e.children[0]);
        out = append_names(out, ftmp);
        return out;
    }
    if e.kind == shared_ast.ex_paren() {
        let mutable ptmp: Array<String> = collect_used_names_from_expr(e.children[0]);
        out = append_names(out, ptmp);
        return out;
    }
    if e.kind == shared_ast.ex_match() {
        // scrutinee is children[0]
        let mutable stmp: Array<String> = collect_used_names_from_expr(e.children[0]);
        out = append_names(out, stmp);
        // each arm body; skip arm bindings
        let mutable mi: Int = 0;
        while mi < len(e.match_arms) {
            let mutable mtmp: Array<String> = collect_used_names_from_expr(e.match_arms[mi].body);
            out = append_names(out, mtmp);
            mi = mi + 1;
        }
        return out;
    }
    if e.kind == shared_ast.ex_try() or e.kind == shared_ast.ex_await() or e.kind == shared_ast.ex_spawn() {
        let mutable ttmp: Array<String> = collect_used_names_from_expr(e.children[0]);
        out = append_names(out, ttmp);
        return out;
    }
    if e.kind == shared_ast.ex_lambda() {
        // skip lambda_params; recurse body (children[0])
        let mutable ltmp: Array<String> = collect_used_names_from_expr(e.children[0]);
        out = append_names(out, ltmp);
        return out;
    }
    if e.kind == shared_ast.ex_forall() or e.kind == shared_ast.ex_exists() {
        // bound name e.name is not a use; recurse all children (domain+body)
        let mutable qi: Int = 0;
        while qi < len(e.children) {
            let mutable qtmp: Array<String> = collect_used_names_from_expr(e.children[qi]);
            out = append_names(out, qtmp);
            qi = qi + 1;
        }
        return out;
    }
    // literals (ex_int, ex_float, ex_char, ex_string, ex_bool, ex_void) → nothing
    return out;
}

// collect_used_names_from_stmt returns names read by statement s.
function collect_used_names_from_stmt(s: Stmt) returns Array<String> {
    let mutable out: Array<String> = [];
    if s.kind == shared_ast.st_let() {
        // bound name s.name is NOT a read; collect initializer expr only
        let mutable ltmp: Array<String> = collect_used_names_from_expr(s.expr);
        out = append_names(out, ltmp);
        return out;
    }
    if s.kind == shared_ast.st_expr() {
        // check if this is an assignment: ex_binop with name "="
        if s.expr.kind == shared_ast.ex_binop() and s.expr.name == "=" {
            // RHS = children[1]: collect fully
            let mutable rtmp: Array<String> = collect_used_names_from_expr(s.expr.children[1]);
            out = append_names(out, rtmp);
            // LHS = children[0]: depends on kind
            let lhs: Expr = s.expr.children[0];
            if lhs.kind == shared_ast.ex_field() {
                // field assignment: collect the object
                let mutable ftmp: Array<String> = collect_used_names_from_expr(lhs.children[0]);
                out = append_names(out, ftmp);
            }
            if lhs.kind == shared_ast.ex_index() {
                // index assignment: collect object + index
                let mutable iotmp: Array<String> = collect_used_names_from_expr(lhs.children[0]);
                out = append_names(out, iotmp);
                let mutable iitmp: Array<String> = collect_used_names_from_expr(lhs.children[1]);
                out = append_names(out, iitmp);
            }
            // plain ex_ident LHS: write target, do NOT collect
            return out;
        }
        // non-assignment st_expr: collect the whole expr
        let mutable etmp: Array<String> = collect_used_names_from_expr(s.expr);
        out = append_names(out, etmp);
        return out;
    }
    if s.kind == shared_ast.st_return() {
        // collect value expr (ex_void = bare `return;` → nothing)
        if s.expr.kind != shared_ast.ex_void() {
            let mutable retmp: Array<String> = collect_used_names_from_expr(s.expr);
            out = append_names(out, retmp);
        }
        return out;
    }
    if s.kind == shared_ast.st_if() {
        // condition + then + else
        let mutable ictmp: Array<String> = collect_used_names_from_expr(s.expr);
        out = append_names(out, ictmp);
        let mutable ittmp: Array<String> = collect_used_names(s.then_block.stmts);
        out = append_names(out, ittmp);
        if s.has_else {
            let mutable ietmp: Array<String> = collect_used_names(s.else_block.stmts);
            out = append_names(out, ietmp);
        }
        return out;
    }
    if s.kind == shared_ast.st_while() {
        // condition + body
        let mutable wctmp: Array<String> = collect_used_names_from_expr(s.expr);
        out = append_names(out, wctmp);
        let mutable wbtmp: Array<String> = collect_used_names(s.then_block.stmts);
        out = append_names(out, wbtmp);
        return out;
    }
    if s.kind == shared_ast.st_for() {
        // iterable (s.expr) + body; do NOT collect loop var (s.name)
        let mutable frtmp: Array<String> = collect_used_names_from_expr(s.expr);
        out = append_names(out, frtmp);
        let mutable fbtmp: Array<String> = collect_used_names(s.then_block.stmts);
        out = append_names(out, fbtmp);
        return out;
    }
    return out;
}

// collect_used_names returns all names read across stmts.
public function collect_used_names(stmts: Array<Stmt>) returns Array<String> {
    let mutable out: Array<String> = [];
    let mutable i: Int = 0;
    while i < len(stmts) {
        let mutable stmp: Array<String> = collect_used_names_from_stmt(stmts[i]);
        out = append_names(out, stmp);
        i = i + 1;
    }
    return out;
}

// collect_assigned_names returns names that are reassigned (LHS of `x = ...`
// where LHS is a plain ident). Field/index targets do not count.
// Recurses into if/else, while, for blocks.
public function collect_assigned_names(stmts: Array<Stmt>) returns Array<String> {
    let mutable out: Array<String> = [];
    let mutable i: Int = 0;
    while i < len(stmts) {
        let s: Stmt = stmts[i];
        if s.kind == shared_ast.st_expr() {
            if s.expr.kind == shared_ast.ex_binop() and s.expr.name == "=" {
                let lhs: Expr = s.expr.children[0];
                if lhs.kind == shared_ast.ex_ident() {
                    out.push(lhs.name);
                }
            }
        }
        if s.kind == shared_ast.st_if() {
            let mutable ittmp: Array<String> = collect_assigned_names(s.then_block.stmts);
            out = append_names(out, ittmp);
            if s.has_else {
                let mutable ietmp: Array<String> = collect_assigned_names(s.else_block.stmts);
                out = append_names(out, ietmp);
            }
        }
        if s.kind == shared_ast.st_while() {
            let mutable wbtmp: Array<String> = collect_assigned_names(s.then_block.stmts);
            out = append_names(out, wbtmp);
        }
        if s.kind == shared_ast.st_for() {
            let mutable fbtmp: Array<String> = collect_assigned_names(s.then_block.stmts);
            out = append_names(out, fbtmp);
        }
        i = i + 1;
    }
    return out;
}

// name_in returns true if n appears anywhere in names (linear scan).
public function name_in(names: Array<String>, n: String) returns Bool {
    let mutable i: Int = 0;
    while i < len(names) {
        if names[i] == n {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// --- Main dispatch walk ------------------------------------------------------
// Mirrors stage1 Lint() call order exactly:
//   lintFunctions → lintExternFunctions → lintEntities → lintEnums
//   → lintTraits → lintImplBlocks → lintIntents

public function lint_program(prog: Program) returns Array<LintDiag> {
    let mutable diags: Array<LintDiag> = [];
    // functions
    let mutable fi: Int = 0;
    while fi < len(prog.functions) {
        let mutable fd: Array<LintDiag> = lint_function_decl(prog.functions[fi]);
        let mutable fj: Int = 0;
        while fj < len(fd) {
            diags.push(fd[fj]);
            fj = fj + 1;
        }
        fi = fi + 1;
    }
    // externs
    let mutable ei: Int = 0;
    while ei < len(prog.externs) {
        let mutable ed: Array<LintDiag> = lint_extern_decl(prog.externs[ei]);
        let mutable ej: Int = 0;
        while ej < len(ed) {
            diags.push(ed[ej]);
            ej = ej + 1;
        }
        ei = ei + 1;
    }
    // entities
    let mutable enti: Int = 0;
    while enti < len(prog.entities) {
        let mutable entd: Array<LintDiag> = lint_entity_decl(prog.entities[enti]);
        let mutable entj: Int = 0;
        while entj < len(entd) {
            diags.push(entd[entj]);
            entj = entj + 1;
        }
        enti = enti + 1;
    }
    // enums
    let mutable eni: Int = 0;
    while eni < len(prog.enums) {
        let mutable end: Array<LintDiag> = lint_enum_decl(prog.enums[eni]);
        let mutable enj: Int = 0;
        while enj < len(end) {
            diags.push(end[enj]);
            enj = enj + 1;
        }
        eni = eni + 1;
    }
    // traits
    let mutable ti: Int = 0;
    while ti < len(prog.traits) {
        let mutable trd: Array<LintDiag> = lint_trait_decl(prog.traits[ti]);
        let mutable tj: Int = 0;
        while tj < len(trd) {
            diags.push(trd[tj]);
            tj = tj + 1;
        }
        ti = ti + 1;
    }
    // impls
    let mutable ii: Int = 0;
    while ii < len(prog.impls) {
        let mutable imd: Array<LintDiag> = lint_impl_decl(prog.impls[ii]);
        let mutable ij: Int = 0;
        while ij < len(imd) {
            diags.push(imd[ij]);
            ij = ij + 1;
        }
        ii = ii + 1;
    }
    // intent blocks
    let mutable ibi: Int = 0;
    while ibi < len(prog.intent_blocks) {
        let mutable ibd: Array<LintDiag> = lint_intent_block(prog.intent_blocks[ibi]);
        let mutable ibj: Int = 0;
        while ibj < len(ibd) {
            diags.push(ibd[ibj]);
            ibj = ibj + 1;
        }
        ibi = ibi + 1;
    }
    return diags;
}

entry function main() returns Int {
    return 0;
}
