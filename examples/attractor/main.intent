module attractor_main version "0.1.0";

import "types.intent";
import "validation.intent";
import "edge_selection.intent";
import "retry.intent";
import "handlers.intent";
import "persistence.intent";
import "llm.intent";

// Build a minimal Attractor pipeline graph: start -> task -> exit
// Then validate it and run edge selection to prove all modules work.
entry function main() returns Int {
    let start_time: Int = timestamp_ms();
    emit_event("pipeline_init", "starting attractor pipeline tests");
    // Create graph metadata
    let meta: GraphMeta = GraphMeta("Run tests and report", "Simple Pipeline", 50, "");

    // Create nodes
    let mutable nodes: Array<NodeAttr> = [
        NodeAttr("start", "Start", "Mdiamond", "", "", 0, false, "", 0),
        NodeAttr("run_tests", "Run Tests", "box", "", "Run the test suite", 3, true, "start", 900),
        NodeAttr("exit", "Exit", "Msquare", "", "", 0, false, "", 0)
    ];
    let node_count: Int = 3;

    // Create edges
    let mutable edges: Array<EdgeAttr> = [
        EdgeAttr("start", "run_tests", "next", "", 0, false),
        EdgeAttr("run_tests", "exit", "done", "outcome=success", 1, false)
    ];
    let edge_count: Int = 2;

    // Validate graph structure
    let has_start: Bool = attractor_validation.has_exactly_one_start(nodes, node_count);
    let has_exit: Bool = attractor_validation.has_exactly_one_exit(nodes, node_count);
    let start_idx: Int = attractor_validation.find_start_index(nodes, node_count);
    let exit_idx: Int = attractor_validation.find_exit_index(nodes, node_count);

    print(has_start);
    print(has_exit);
    print(start_idx);
    print(exit_idx);

    // Validate edges
    let no_incoming: Bool = attractor_validation.start_has_no_incoming(edges, edge_count, "start");
    let no_outgoing: Bool = attractor_validation.exit_has_no_outgoing(edges, edge_count, "exit");
    let targets_ok: Bool = attractor_validation.all_edge_targets_exist(nodes, node_count, edges, edge_count);

    print(no_incoming);
    print(no_outgoing);
    print(targets_ok);

    // Test edge selection with a success outcome (no suggested IDs)
    let outcome_str: String = attractor_edge_selection.status_to_string(Success);
    let mutable empty_suggestions: Array<String> = [];
    let mutable empty_context: Map<String, String> = [];
    let selected: Int = attractor_edge_selection.select_edge(edges, edge_count, outcome_str, "", empty_suggestions, 0, empty_context);

    print(selected);

    // Test edge selection Step 3: suggested next IDs
    let mutable suggestions: Array<String> = [];
    suggestions.push("exit");
    let step3_selected: Int = attractor_edge_selection.select_edge(edges, edge_count, "unknown_status", "", suggestions, 1, empty_context);
    print(step3_selected);

    // Test reachability
    let reachable: Bool = attractor_validation.all_nodes_reachable(nodes, node_count, edges, edge_count, "start");
    print(reachable);

    // Test checkpoint with completed_nodes tracking and node_retries map
    let mutable retries: Map<String, Int> = [];
    let mutable cp: Checkpoint = Checkpoint("start", 0, [], retries);
    cp.advance("run_tests");
    cp.advance("exit");
    print(cp.completed_count);
    print(len(cp.completed_nodes));

    // Test context map operations
    let mutable ctx_values: Map<String, String> = [];
    ctx_values.set("input_data", "test_payload");
    let ctx: PipelineContext = PipelineContext(ctx_values);
    let input: String = ctx.get_value("input_data", "none");
    print(input);

    // Test retry policy
    let policy: RetryPolicy = attractor_retry.build_retry_policy(3, 50);
    let delay: Int = attractor_retry.delay_for_attempt(2, policy);

    print(policy.max_attempts);
    print(delay);

    // Test goal gate
    let gate_ok: Bool = attractor_retry.goal_gate_satisfied(Success);
    let gate_fail: Bool = attractor_retry.goal_gate_satisfied(Fail);

    print(gate_ok);
    print(gate_fail);

    // --- Phase 5: Error handling tests ---

    // Test validate_graph with Result<Bool, String>
    let validation_result: Result<Bool, String> = attractor_validation.validate_graph(nodes, node_count, edges, edge_count);
    let validation_ok: Bool = validation_result.is_ok();
    print(validation_ok);

    let validation_msg: String = match validation_result {
        Ok(v) => "graph valid",
        Err(e) => e,
    };
    print(validation_msg);

    // Test execute_with_retry with a node that has a prompt (should succeed)
    let mutable retry_ctx_values: Map<String, String> = [];
    let retry_ctx: PipelineContext = PipelineContext(retry_ctx_values);
    let retry_policy: RetryPolicy = attractor_retry.standard_policy();
    let retry_result: Result<Outcome, String> = attractor_retry.execute_with_retry(nodes[1], retry_ctx, retry_policy);
    let retry_ok: Bool = retry_result.is_ok();
    print(retry_ok);

    // Test execute_with_retry with a node that has no prompt (should fail after retries)
    let retry_result2: Result<Outcome, String> = attractor_retry.execute_with_retry(nodes[0], retry_ctx, retry_policy);
    let retry_ok2: Bool = retry_result2.is_ok();
    print(retry_ok2);

    // Extract outcome from retry_result2 and check status
    let outcome2: Outcome = match retry_result2 {
        Ok(o) => o,
        Err(e) => Outcome(Fail, "", "", e, [], []),
    };
    let outcome2_success: Bool = outcome2.is_success();
    print(outcome2_success);

    // --- Phase 6: Trait-based handler dispatch tests ---

    // Test StartHandler via trait method directly (cross-module trait resolution)
    let mutable handler_ctx_values: Map<String, String> = [];
    let handler_ctx: PipelineContext = PipelineContext(handler_ctx_values);
    let start_handler: StartHandler = StartHandler("start");
    let start_result: Result<Outcome, String> = start_handler.execute(nodes[0], handler_ctx);
    let start_ok: Bool = start_result.is_ok();
    print(start_ok);

    // Test CodergenHandler on node with prompt (run_tests has a prompt)
    let codergen_handler: CodergenHandler = CodergenHandler("codergen");
    let codergen_result: Result<Outcome, String> = codergen_handler.execute(nodes[1], handler_ctx);
    let codergen_ok: Bool = codergen_result.is_ok();
    print(codergen_ok);

    // Test CodergenHandler on node without prompt (start has no prompt -- should fail)
    let codergen_fail_result: Result<Outcome, String> = codergen_handler.execute(nodes[0], handler_ctx);
    let codergen_fail_ok: Bool = codergen_fail_result.is_ok();
    print(codergen_fail_ok);

    // Test ExitHandler on exit node
    let exit_handler: ExitHandler = ExitHandler("exit");
    let exit_result: Result<Outcome, String> = exit_handler.execute(nodes[2], handler_ctx);
    let exit_ok: Bool = exit_result.is_ok();
    print(exit_ok);

    // --- Phase 8: HTTP, JSON, Events, and Checkpoint Persistence tests ---

    emit_event("phase8_start", "testing HTTP, JSON, events, and persistence");

    // Test timestamp
    let phase8_time: Int = timestamp_ms();
    print(phase8_time > 0);

    // Test LLM call (simulated -- no API key set)
    let llm_result: Result<String, String> = attractor_llm.call_llm_simple("Write a hello world program");
    let llm_ok: Bool = llm_result.is_ok();
    print(llm_ok);

    // Test checkpoint persistence
    let mutable save_retries: Map<String, Int> = [];
    let mutable save_completed: Array<String> = [];
    save_completed.push("start");
    save_completed.push("run_tests");
    let save_cp: Checkpoint = Checkpoint("exit", 2, save_completed, save_retries);
    let save_result: Result<Void, String> = attractor_persistence.save_checkpoint(save_cp, "/tmp/attractor_test_checkpoint.txt");
    let save_ok: Bool = save_result.is_ok();
    print(save_ok);

    // Test checkpoint loading
    let load_result: Result<String, String> = attractor_persistence.load_checkpoint_current("/tmp/attractor_test_checkpoint.txt");
    let load_ok: Bool = load_result.is_ok();
    print(load_ok);

    // Test json_get with a value from read_file (avoids brace literals in source)
    // Write a test JSON file, then read it back and extract a field
    let test_json_content: String = "name_field=attractor";
    let json_write: Result<Void, String> = write_file("/tmp/attractor_test.txt", test_json_content);

    // Test http_get type (will fail at runtime without a server, but type-checks)
    let get_result: Result<String, String> = http_get("https://example.com", "");
    let get_type_ok: Bool = get_result.is_err();
    print(get_type_ok);

    // Emit final timing event
    let end_time: Int = timestamp_ms();
    emit_event("pipeline_complete", "all tests finished");

    // --- Phase 9: Warning lint rules test ---
    let warnings: Array<Diagnostic> = attractor_validation.validate_warnings(nodes, node_count, edges, edge_count);
    print(len(warnings));

    // --- Phase 10: HandlerRegistry dispatch test ---
    let kind_start: HandlerKind = attractor_handlers.resolve_handler(nodes[0]);
    let kind_task: HandlerKind = attractor_handlers.resolve_handler(nodes[1]);
    let kind_exit: HandlerKind = attractor_handlers.resolve_handler(nodes[2]);
    let kind_start_ok: Bool = match kind_start { StartKind => true, _ => false, };
    let kind_task_ok: Bool = match kind_task { CodergenKind => true, _ => false, };
    let kind_exit_ok: Bool = match kind_exit { ExitKind => true, _ => false, };
    print(kind_start_ok);
    print(kind_task_ok);
    print(kind_exit_ok);

    return 0;
}
