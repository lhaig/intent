module attractor version "0.1.0";

// --- Enums ---

// StageStatus represents the result of a pipeline stage execution.
enum StageStatus {
    Success,
    PartialSuccess,
    Retry,
    Fail,
    Skipped,
}

// Severity classifies the importance of a diagnostic message.
enum Severity {
    Error,
    Warning,
    Info,
}

// --- Entities ---

// Outcome records the result of a stage execution including status and diagnostics.
entity Outcome {
    field status: StageStatus;
    field preferred_label: String;
    field notes: String;
    field failure_reason: String;
    field suggested_next_ids: Array<String>;
    field context_updates: Map<String, String>;

    constructor(status: StageStatus, preferred_label: String, notes: String, failure_reason: String, suggested_next_ids: Array<String>, context_updates: Map<String, String>)
        requires true
    {
        self.status = status;
        self.preferred_label = preferred_label;
        self.notes = notes;
        self.failure_reason = failure_reason;
        self.suggested_next_ids = suggested_next_ids;
        self.context_updates = context_updates;
    }

    method is_success() returns Bool
        ensures true
    {
        let val: Bool = match self.status {
            Success => true,
            PartialSuccess => true,
            Retry => false,
            Fail => false,
            Skipped => false,
        };
        return val;
    }

    method is_retriable() returns Bool
        ensures true
    {
        let val: Bool = match self.status {
            Success => false,
            PartialSuccess => false,
            Retry => true,
            Fail => false,
            Skipped => false,
        };
        return val;
    }
}

// NodeAttr holds the attributes of a node in the Attractor pipeline graph.
entity NodeAttr {
    field id: String;
    field label: String;
    field shape: String;
    field node_type: String;
    field prompt: String;
    field max_retries: Int;
    field goal_gate: Bool;
    field retry_target: String;
    field timeout_seconds: Int;

    invariant self.max_retries >= 0;
    invariant self.timeout_seconds >= 0;

    constructor(id: String, label: String, shape: String, node_type: String, prompt: String, max_retries: Int, goal_gate: Bool, retry_target: String, timeout_seconds: Int)
        requires max_retries >= 0
        requires timeout_seconds >= 0
    {
        self.id = id;
        self.label = label;
        self.shape = shape;
        self.node_type = node_type;
        self.prompt = prompt;
        self.max_retries = max_retries;
        self.goal_gate = goal_gate;
        self.retry_target = retry_target;
        self.timeout_seconds = timeout_seconds;
    }

    method is_start() returns Bool
        ensures true
    {
        return self.shape == "Mdiamond";
    }

    method is_exit() returns Bool
        ensures true
    {
        return self.shape == "Msquare";
    }

    method is_decision() returns Bool
        ensures true
    {
        return self.shape == "diamond";
    }

    method is_parallel() returns Bool
        ensures true
    {
        return self.shape == "component";
    }

    method is_human_gate() returns Bool
        ensures true
    {
        return self.shape == "hexagon";
    }
}

// EdgeAttr holds the attributes of a directed edge in the Attractor pipeline graph.
// Self-loops are disallowed: from_node and to_node must differ.
entity EdgeAttr {
    field from_node: String;
    field to_node: String;
    field label: String;
    field condition: String;
    field weight: Int;
    field loop_restart: Bool;

    invariant self.weight >= 0;
    invariant self.from_node != self.to_node;

    constructor(from_node: String, to_node: String, label: String, condition: String, weight: Int, loop_restart: Bool)
        requires weight >= 0
        requires from_node != to_node
    {
        self.from_node = from_node;
        self.to_node = to_node;
        self.label = label;
        self.condition = condition;
        self.weight = weight;
        self.loop_restart = loop_restart;
    }

    method is_conditional() returns Bool
        ensures true
    {
        return self.condition != "";
    }

    method is_unconditional() returns Bool
        ensures true
    {
        return self.condition == "";
    }
}

// RetryPolicy defines how a failed stage should be retried.
// backoff_factor is a Float multiplier applied to the delay on each retry (e.g. 2.0 doubles the delay).
entity RetryPolicy {
    field max_attempts: Int;
    field initial_delay_ms: Int;
    field backoff_factor: Float;
    field max_delay_ms: Int;

    invariant self.max_attempts >= 1;
    invariant self.initial_delay_ms >= 0;
    invariant self.backoff_factor > 0.0;
    invariant self.max_delay_ms >= self.initial_delay_ms;

    constructor(max_attempts: Int, initial_delay_ms: Int, backoff_factor: Float, max_delay_ms: Int)
        requires max_attempts >= 1
        requires initial_delay_ms >= 0
        requires backoff_factor > 0.0
        requires max_delay_ms >= initial_delay_ms
    {
        self.max_attempts = max_attempts;
        self.initial_delay_ms = initial_delay_ms;
        self.backoff_factor = backoff_factor;
        self.max_delay_ms = max_delay_ms;
    }
}

// Diagnostic captures a validation or runtime issue found in the pipeline graph.
entity Diagnostic {
    field rule: String;
    field severity: Severity;
    field message: String;
    field node_id: String;

    constructor(rule: String, severity: Severity, message: String, node_id: String)
        requires true
    {
        self.rule = rule;
        self.severity = severity;
        self.message = message;
        self.node_id = node_id;
    }
}

// GraphMeta holds pipeline-level configuration.
// Nodes and edges are managed as separate arrays passed to functions,
// since Intent does not yet support typed empty array literals.
entity GraphMeta {
    field pipeline_goal: String;
    field label: String;
    field default_max_retry: Int;
    field retry_target: String;

    invariant self.default_max_retry >= 0;

    constructor(pipeline_goal: String, label: String, default_max_retry: Int, retry_target: String)
        requires default_max_retry >= 0
    {
        self.pipeline_goal = pipeline_goal;
        self.label = label;
        self.default_max_retry = default_max_retry;
        self.retry_target = retry_target;
    }
}

// Checkpoint tracks the current execution position within a running pipeline.
entity Checkpoint {
    field current_node: String;
    field completed_count: Int;
    field completed_nodes: Array<String>;
    field node_retries: Map<String, Int>;

    invariant self.completed_count >= 0;

    constructor(current_node: String, completed_count: Int, completed_nodes: Array<String>, node_retries: Map<String, Int>)
        requires completed_count >= 0
    {
        self.current_node = current_node;
        self.completed_count = completed_count;
        self.completed_nodes = completed_nodes;
        self.node_retries = node_retries;
    }

    method advance(next_node: String) returns Void
        ensures self.completed_count == old(self.completed_count) + 1
    {
        self.completed_nodes.push(self.current_node);
        self.current_node = next_node;
        self.completed_count = self.completed_count + 1;
    }
}

// PipelineContext holds the shared state passed between pipeline stages.
entity PipelineContext {
    field values: Map<String, String>;

    constructor(values: Map<String, String>) {
        self.values = values;
    }

    method get_value(key: String, default_val: String) returns String {
        return self.values.get(key, default_val);
    }

    method set_value(key: String, value: String) returns Void {
        self.values.set(key, value);
    }

    method has_key(key: String) returns Bool {
        return self.values.contains(key);
    }
}

// --- Helper functions ---

// status_is_success returns true if the status represents any success variant.
function status_is_success(s: StageStatus) returns Bool
    requires true
    ensures true
{
    let val: Bool = match s {
        Success => true,
        PartialSuccess => true,
        Retry => false,
        Fail => false,
        Skipped => false,
    };
    return val;
}

// status_is_terminal_success returns true only for terminal success variants.
function status_is_terminal_success(s: StageStatus) returns Bool
    requires true
    ensures true
{
    let val: Bool = match s {
        Success => true,
        PartialSuccess => true,
        Retry => false,
        Fail => false,
        Skipped => false,
    };
    return val;
}

// --- Validation functions ---

function has_exactly_one_start(nodes: Array<NodeAttr>, count: Int) returns Bool
    requires count >= 0
    ensures true
{
    let mutable starts: Int = 0;
    for i in 0..count {
        if nodes[i].is_start() {
            starts = starts + 1;
        }
    }
    return starts == 1;
}

function has_exactly_one_exit(nodes: Array<NodeAttr>, count: Int) returns Bool
    requires count >= 0
    ensures true
{
    let mutable exits: Int = 0;
    for i in 0..count {
        if nodes[i].is_exit() {
            exits = exits + 1;
        }
    }
    return exits == 1;
}

function find_start_index(nodes: Array<NodeAttr>, count: Int) returns Int
    requires count >= 0
    ensures result >= -1
    ensures result < count or result == -1
{
    let mutable idx: Int = -1;
    for i in 0..count {
        if nodes[i].is_start() and idx == -1 {
            idx = i;
        }
    }
    return idx;
}

function find_exit_index(nodes: Array<NodeAttr>, count: Int) returns Int
    requires count >= 0
    ensures result >= -1
    ensures result < count or result == -1
{
    let mutable idx: Int = -1;
    for i in 0..count {
        if nodes[i].is_exit() and idx == -1 {
            idx = i;
        }
    }
    return idx;
}

function node_exists(nodes: Array<NodeAttr>, count: Int, id: String) returns Bool
    requires count >= 0
    ensures true
{
    for i in 0..count {
        if nodes[i].id == id {
            return true;
        }
    }
    return false;
}

function start_has_no_incoming(edges: Array<EdgeAttr>, edge_count: Int, start_id: String) returns Bool
    requires edge_count >= 0
    ensures true
{
    let mutable has_incoming: Bool = false;
    for i in 0..edge_count {
        if edges[i].to_node == start_id {
            has_incoming = true;
        }
    }
    return not has_incoming;
}

function exit_has_no_outgoing(edges: Array<EdgeAttr>, edge_count: Int, exit_id: String) returns Bool
    requires edge_count >= 0
    ensures true
{
    let mutable has_outgoing: Bool = false;
    for i in 0..edge_count {
        if edges[i].from_node == exit_id {
            has_outgoing = true;
        }
    }
    return not has_outgoing;
}

function all_edge_targets_exist(nodes: Array<NodeAttr>, node_count: Int, edges: Array<EdgeAttr>, edge_count: Int) returns Bool
    requires node_count >= 0
    requires edge_count >= 0
    ensures true
{
    let mutable all_valid: Bool = true;
    for i in 0..edge_count {
        let from_exists: Bool = node_exists(nodes, node_count, edges[i].from_node);
        let to_exists: Bool = node_exists(nodes, node_count, edges[i].to_node);
        if not from_exists or not to_exists {
            all_valid = false;
        }
    }
    return all_valid;
}

function count_outgoing(edges: Array<EdgeAttr>, edge_count: Int, node_id: String) returns Int
    requires edge_count >= 0
    ensures result >= 0
    ensures result <= edge_count
{
    let mutable count: Int = 0;
    for i in 0..edge_count {
        if edges[i].from_node == node_id {
            count = count + 1;
        }
    }
    return count;
}

function decision_nodes_valid(nodes: Array<NodeAttr>, node_count: Int, edges: Array<EdgeAttr>, edge_count: Int) returns Bool
    requires node_count >= 0
    requires edge_count >= 0
    ensures true
{
    let mutable all_valid: Bool = true;
    for i in 0..node_count {
        if nodes[i].is_decision() {
            let outgoing: Int = count_outgoing(edges, edge_count, nodes[i].id);
            if outgoing < 2 {
                all_valid = false;
            }
        }
    }
    return all_valid;
}

// --- Edge selection functions ---

// Normalize a label by trimming whitespace and converting to lowercase.
function normalize_label(label: String) returns String {
    return label.trim().to_lowercase();
}

// Collect all edges originating from node_id.
// NOTE: Pushing entity values into arrays may not be supported in all Intent
// runtimes. If this causes issues, switch to an index-based approach using
// count_edges_from and iterating the original array.
// NOTE: edges_from_node removed -- requires empty array literal support (future Intent feature).
// Use index-based functions (count_edges_from, find_condition_match, etc.) instead.

// Evaluate a single condition clause of the form: clause_key clause_op clause_value
// Supported clause_key values: "outcome", "preferred_label", context map keys
// Supported clause_op values: "=", "!="
function evaluate_clause(clause_key: String, clause_op: String, clause_value: String, outcome_status: String, preferred_label: String, context: Map<String, String>) returns Bool {
    if clause_key == "outcome" {
        if clause_op == "=" {
            return outcome_status == clause_value;
        }
        if clause_op == "!=" {
            return outcome_status != clause_value;
        }
        return false;
    }
    if clause_key == "preferred_label" {
        if clause_op == "=" {
            return preferred_label == clause_value;
        }
        if clause_op == "!=" {
            return preferred_label != clause_value;
        }
        return false;
    }
    // Look up key in context map
    if context.contains(clause_key) {
        let ctx_val: String = context.get(clause_key, "");
        if clause_op == "=" {
            return ctx_val == clause_value;
        }
        if clause_op == "!=" {
            return ctx_val != clause_value;
        }
    }
    return false;
}

// Parse a single condition clause dynamically using string methods.
// Supported forms: "key=value", "key!=value"
function parse_and_evaluate_clause(clause: String, outcome_status: String, preferred_label: String, context: Map<String, String>) returns Bool {
    let trimmed: String = clause.trim();

    // Check for "!=" operator first (before "=" to avoid partial match)
    if trimmed.contains("!=") {
        let parts: Array<String> = trimmed.split("!=");
        if len(parts) == 2 {
            return evaluate_clause(parts[0].trim(), "!=", parts[1].trim(), outcome_status, preferred_label, context);
        }
        return false;
    }

    // Check for "=" operator
    if trimmed.contains("=") {
        let parts: Array<String> = trimmed.split("=");
        if len(parts) == 2 {
            return evaluate_clause(parts[0].trim(), "=", parts[1].trim(), outcome_status, preferred_label, context);
        }
        return false;
    }

    // No recognized operator
    return false;
}

// Evaluate whether an edge's condition matches the current outcome and preferred label.
// Unconditional edges (empty condition string) always return false here; they are
// handled separately in the highest-weight step.
// Supports single-clause conditions parsed dynamically using string split.
function edge_matches_condition(edge: EdgeAttr, outcome_status: String, preferred_label: String, context: Map<String, String>) returns Bool {
    if edge.condition == "" {
        return false;
    }

    // Dynamic single-clause parsing using string methods.
    return parse_and_evaluate_clause(edge.condition, outcome_status, preferred_label, context);
}

// Step 1: Find the index of the first edge whose condition matches.
// Returns the index into `edges`, or -1 if no edge matches.
function find_condition_matched_edge(edges: Array<EdgeAttr>, edge_count: Int, outcome_status: String, preferred_label: String, context: Map<String, String>) returns Int
    requires edge_count >= 0
    ensures result >= -1
    ensures result < edge_count
{
    let mutable found_idx: Int = -1;
    for i in 0..edge_count {
        if edge_matches_condition(edges[i], outcome_status, preferred_label, context) {
            found_idx = i;
            break;
        }
    }
    return found_idx;
}

// Step 2: Find the index of the first edge whose label matches preferred_label.
// Returns -1 if preferred_label is empty or no edge matches.
function find_preferred_label_edge(edges: Array<EdgeAttr>, edge_count: Int, preferred_label: String) returns Int
    requires edge_count >= 0
    ensures result >= -1
{
    if preferred_label == "" {
        return -1;
    }
    let mutable found_idx: Int = -1;
    for i in 0..edge_count {
        if edges[i].label == preferred_label {
            found_idx = i;
            break;
        }
    }
    return found_idx;
}

// Step 3: Find the first edge whose to_node matches any of the suggested next IDs.
// Returns the index into `edges`, or -1 if no match is found.
function find_suggested_next_edge(edges: Array<EdgeAttr>, edge_count: Int, suggested_next_ids: Array<String>, suggested_count: Int) returns Int
    requires edge_count >= 0
    requires suggested_count >= 0
    ensures result >= -1
{
    let mutable found_idx: Int = -1;
    for i in 0..edge_count {
        for j in 0..suggested_count {
            if edges[i].to_node == suggested_next_ids[j] {
                found_idx = i;
                break;
            }
        }
        if found_idx >= 0 {
            break;
        }
    }
    return found_idx;
}

// Steps 4 & 5: Among unconditional edges, find the one with the highest weight.
// First-encountered highest-weight edge wins (lexical tiebreak requires string
// lt/gt comparison not yet available in Intent).
// Returns -1 if no unconditional edges exist.
function find_highest_weight_edge(edges: Array<EdgeAttr>, edge_count: Int) returns Int
    requires edge_count >= 0
    ensures result >= -1
{
    let mutable best_idx: Int = -1;
    let mutable best_weight: Int = -1;
    for i in 0..edge_count {
        if edges[i].is_unconditional() {
            if edges[i].weight > best_weight {
                best_weight = edges[i].weight;
                best_idx = i;
            }
        }
    }
    return best_idx;
}

// Convert a StageStatus enum value to the string used in condition expressions.
function status_to_string(status: StageStatus) returns String {
    return match status {
        Success => "success",
        PartialSuccess => "partial_success",
        Retry => "retry",
        Fail => "fail",
        Skipped => "skipped"
    };
}

// Main entry point: select the next edge using the Attractor spec Section 3.3
// five-step priority algorithm.
//
// Priority order:
//   1. Condition-matching edges
//   2. Preferred label match
//   3. Suggested next IDs
//   4. Highest weight among unconditional edges
//   5. Lexical tiebreak (simplified: first-wins for equal weights)
//
// Returns the index into `edges` of the selected edge, or -1 if edge_count == 0.
function select_edge(edges: Array<EdgeAttr>, edge_count: Int, outcome_status: String, preferred_label: String, suggested_next_ids: Array<String>, suggested_count: Int, context: Map<String, String>) returns Int
    requires edge_count >= 0
    requires suggested_count >= 0
    ensures result >= -1
    ensures result < edge_count
{
    if edge_count == 0 {
        return -1;
    }

    // Step 1: condition match.
    let step1: Int = find_condition_matched_edge(edges, edge_count, outcome_status, preferred_label, context);
    if step1 >= 0 {
        return step1;
    }

    // Step 2: preferred label match.
    let step2: Int = find_preferred_label_edge(edges, edge_count, preferred_label);
    if step2 >= 0 {
        return step2;
    }

    // Step 3: suggested next IDs.
    let step3: Int = find_suggested_next_edge(edges, edge_count, suggested_next_ids, suggested_count);
    if step3 >= 0 {
        return step3;
    }

    // Steps 4+5: highest weight unconditional edge.
    let step4: Int = find_highest_weight_edge(edges, edge_count);
    if step4 >= 0 {
        return step4;
    }

    // Fallback: first edge.
    return 0;
}

// --- Reachability functions ---

// Check if a string array contains a target value.
function string_array_contains(arr: Array<String>, count: Int, target: String) returns Bool
    requires count >= 0
    ensures true
{
    for i in 0..count {
        if arr[i] == target {
            return true;
        }
    }
    return false;
}

// BFS-based reachability check: returns true if all nodes are reachable from start_id.
// Uses Array<String> as both a worklist (queue) and a visited set.
function all_nodes_reachable(nodes: Array<NodeAttr>, node_count: Int, edges: Array<EdgeAttr>, edge_count: Int, start_id: String) returns Bool
    requires node_count >= 0
    requires edge_count >= 0
    ensures true
{
    let mutable visited: Array<String> = [];
    visited.push(start_id);
    let mutable visited_count: Int = 1;

    let mutable read_idx: Int = 0;
    while read_idx < visited_count {
        let current: String = visited[read_idx];
        read_idx = read_idx + 1;

        for i in 0..edge_count {
            if edges[i].from_node == current {
                let target: String = edges[i].to_node;
                let already: Bool = string_array_contains(visited, visited_count, target);
                if not already {
                    visited.push(target);
                    visited_count = visited_count + 1;
                }
            }
        }
    }

    let mutable all_reached: Bool = true;
    for i in 0..node_count {
        let reached: Bool = string_array_contains(visited, visited_count, nodes[i].id);
        if not reached {
            all_reached = false;
        }
    }
    return all_reached;
}

// --- Retry functions ---

function build_retry_policy(node_max_retries: Int, graph_default_max_retry: Int) returns RetryPolicy
    requires graph_default_max_retry >= 0
    ensures result.max_attempts >= 1
{
    let mutable chosen: Int = graph_default_max_retry;
    if node_max_retries > 0 { chosen = node_max_retries; }
    return RetryPolicy(chosen + 1, 200, 2.0, 60000);
}

function standard_policy() returns RetryPolicy
    ensures result.max_attempts == 5
{
    return RetryPolicy(5, 200, 2.0, 60000);
}

function aggressive_policy() returns RetryPolicy
{
    return RetryPolicy(5, 500, 2.0, 60000);
}

function linear_policy() returns RetryPolicy
    ensures result.backoff_factor == 1.0
{
    return RetryPolicy(3, 500, 1.0, 60000);
}

function patient_policy() returns RetryPolicy
{
    return RetryPolicy(3, 2000, 3.0, 60000);
}

function no_retry_policy() returns RetryPolicy
    ensures result.max_attempts == 1
{
    return RetryPolicy(1, 0, 1.0, 0);
}

// Calculate delay in ms for a given retry attempt (1-indexed).
// Uses integer doubling since Intent does not support Int*Float mixed arithmetic.
// Exact for standard/aggressive policies (factor=2.0).
function delay_for_attempt(attempt: Int, policy: RetryPolicy) returns Int
    requires attempt >= 1
    requires policy.max_attempts >= 1
    ensures result >= 0
    ensures result <= policy.max_delay_ms
{
    let mutable delay: Int = policy.initial_delay_ms;
    let mutable i: Int = 1;
    while i < attempt {
        delay = delay * 2;
        i = i + 1;
    }
    if delay > policy.max_delay_ms { delay = policy.max_delay_ms; }
    return delay;
}

function should_retry(status: StageStatus) returns Bool
{
    let val: Bool = match status { Retry => true, _ => false, };
    return val;
}

function is_retriable(status: StageStatus, attempt: Int, max_attempts: Int) returns Bool
    requires attempt >= 1
    requires max_attempts >= 1
{
    let retryable: Bool = match status { Retry => true, _ => false, };
    return retryable and attempt < max_attempts;
}

function goal_gate_satisfied(status: StageStatus) returns Bool
{
    let val: Bool = match status { Success => true, PartialSuccess => true, _ => false, };
    return val;
}

function max_with_partial(allow_partial: Bool) returns StageStatus
{
    if allow_partial { return PartialSuccess; }
    return Fail;
}

// --- Validation aggregate function ---

// Validate the entire graph structure per Attractor spec Section 7.3.
// Returns Ok(true) if all validations pass, or Err(message) on first failure.
function validate_graph(nodes: Array<NodeAttr>, node_count: Int, edges: Array<EdgeAttr>, edge_count: Int) returns Result<Bool, String>
    requires node_count >= 0
    requires edge_count >= 0
{
    if not has_exactly_one_start(nodes, node_count) {
        return Err("Graph must have exactly one start node");
    }
    if not has_exactly_one_exit(nodes, node_count) {
        return Err("Graph must have exactly one exit node");
    }

    let start_idx: Int = find_start_index(nodes, node_count);
    if start_idx == -1 {
        return Err("Start node not found");
    }
    let exit_idx: Int = find_exit_index(nodes, node_count);
    if exit_idx == -1 {
        return Err("Exit node not found");
    }

    if not start_has_no_incoming(edges, edge_count, nodes[start_idx].id) {
        return Err("Start node must have no incoming edges");
    }
    if not exit_has_no_outgoing(edges, edge_count, nodes[exit_idx].id) {
        return Err("Exit node must have no outgoing edges");
    }
    if not all_edge_targets_exist(nodes, node_count, edges, edge_count) {
        return Err("All edge endpoints must reference existing nodes");
    }
    if not decision_nodes_valid(nodes, node_count, edges, edge_count) {
        return Err("Decision nodes must have at least 2 outgoing edges");
    }
    if not all_nodes_reachable(nodes, node_count, edges, edge_count, nodes[start_idx].id) {
        return Err("All nodes must be reachable from start");
    }

    return Ok(true);
}

// --- Handler execution with retry ---

// Simulate handler execution for a node.
function execute_handler(node: NodeAttr, context: PipelineContext) returns Result<Outcome, String>
    requires node.id != ""
{
    if node.prompt != "" {
        let mutable empty_ids: Array<String> = [];
        let mutable empty_updates: Map<String, String> = [];
        return Ok(Outcome(Success, "", "executed", "", empty_ids, empty_updates));
    }
    return Err("No handler available for node: " + node.id);
}

// Execute a node with retry logic per Attractor spec Section 3.5.
function execute_with_retry(node: NodeAttr, context: PipelineContext, policy: RetryPolicy) returns Result<Outcome, String>
    requires policy.max_attempts >= 1
{
    let mutable last_outcome_status: StageStatus = Fail;
    for attempt in 1..policy.max_attempts + 1 {
        let handler_result: Result<Outcome, String> = execute_handler(node, context);

        let is_error: Bool = handler_result.is_err();
        if is_error {
            if attempt < policy.max_attempts {
                continue;
            }
            let mutable fail_ids: Array<String> = [];
            let mutable fail_updates: Map<String, String> = [];
            return Ok(Outcome(Fail, "", "all attempts exhausted", "handler error", fail_ids, fail_updates));
        }

        let outcome: Outcome = match handler_result {
            Ok(o) => o,
            Err(e) => Outcome(Fail, "", "", e, [], []),
        };

        if outcome.is_success() {
            return Ok(outcome);
        }

        last_outcome_status = outcome.status;
        let can_retry: Bool = is_retriable(last_outcome_status, attempt, policy.max_attempts);
        if can_retry {
            continue;
        }

        return Ok(outcome);
    }

    let mutable final_ids: Array<String> = [];
    let mutable final_updates: Map<String, String> = [];
    return Ok(Outcome(Fail, "", "all retry attempts exhausted", "", final_ids, final_updates));
}

// --- Entry function ---

// Build a minimal Attractor pipeline graph: start -> task -> exit
// Then validate it and run edge selection to prove all functions work.
entry function main() returns Int {
    // Create graph metadata
    let meta: GraphMeta = GraphMeta("Run tests and report", "Simple Pipeline", 50, "");

    // Create nodes
    let mutable nodes: Array<NodeAttr> = [
        NodeAttr("start", "Start", "Mdiamond", "", "", 0, false, "", 0),
        NodeAttr("run_tests", "Run Tests", "box", "", "Run the test suite", 3, true, "start", 900),
        NodeAttr("exit", "Exit", "Msquare", "", "", 0, false, "", 0)
    ];
    let node_count: Int = 3;

    // Create edges
    let mutable edges: Array<EdgeAttr> = [
        EdgeAttr("start", "run_tests", "next", "", 0, false),
        EdgeAttr("run_tests", "exit", "done", "outcome=success", 1, false)
    ];
    let edge_count: Int = 2;

    // Validate graph structure
    let has_start: Bool = has_exactly_one_start(nodes, node_count);
    let has_exit: Bool = has_exactly_one_exit(nodes, node_count);
    let start_idx: Int = find_start_index(nodes, node_count);
    let exit_idx: Int = find_exit_index(nodes, node_count);

    print(has_start);
    print(has_exit);
    print(start_idx);
    print(exit_idx);

    // Validate edges
    let no_incoming: Bool = start_has_no_incoming(edges, edge_count, "start");
    let no_outgoing: Bool = exit_has_no_outgoing(edges, edge_count, "exit");
    let targets_ok: Bool = all_edge_targets_exist(nodes, node_count, edges, edge_count);

    print(no_incoming);
    print(no_outgoing);
    print(targets_ok);

    // Test edge selection with a success outcome (no suggested IDs)
    let outcome_str: String = status_to_string(Success);
    let mutable empty_suggestions: Array<String> = [];
    let mutable empty_context: Map<String, String> = [];
    let selected: Int = select_edge(edges, edge_count, outcome_str, "", empty_suggestions, 0, empty_context);

    print(selected);

    // Test edge selection Step 3: suggested next IDs
    let mutable suggestions: Array<String> = [];
    suggestions.push("exit");
    let step3_selected: Int = select_edge(edges, edge_count, "unknown_status", "", suggestions, 1, empty_context);
    print(step3_selected);

    // Test reachability
    let reachable: Bool = all_nodes_reachable(nodes, node_count, edges, edge_count, "start");
    print(reachable);

    // Test checkpoint with completed_nodes tracking and node_retries map
    let mutable retries: Map<String, Int> = [];
    let mutable cp: Checkpoint = Checkpoint("start", 0, [], retries);
    cp.advance("run_tests");
    cp.advance("exit");
    print(cp.completed_count);
    print(len(cp.completed_nodes));

    // Test retry policy
    let policy: RetryPolicy = build_retry_policy(3, 50);
    let delay: Int = delay_for_attempt(2, policy);

    print(policy.max_attempts);
    print(delay);

    // Test goal gate
    let gate_ok: Bool = goal_gate_satisfied(Success);
    let gate_fail: Bool = goal_gate_satisfied(Fail);

    print(gate_ok);
    print(gate_fail);

    // --- Phase 5: Error handling tests ---

    // Test validate_graph with Result<Bool, String>
    let validation_result: Result<Bool, String> = validate_graph(nodes, node_count, edges, edge_count);
    let validation_ok: Bool = validation_result.is_ok();
    print(validation_ok);

    let validation_msg: String = match validation_result {
        Ok(v) => "graph valid",
        Err(e) => e,
    };
    print(validation_msg);

    // Test execute_with_retry with a node that has a prompt (should succeed)
    let mutable retry_ctx_values: Map<String, String> = [];
    let retry_ctx: PipelineContext = PipelineContext(retry_ctx_values);
    let retry_policy: RetryPolicy = standard_policy();
    let retry_result: Result<Outcome, String> = execute_with_retry(nodes[1], retry_ctx, retry_policy);
    let retry_ok: Bool = retry_result.is_ok();
    print(retry_ok);

    // Test execute_with_retry with a node that has no prompt (should fail after retries)
    let retry_result2: Result<Outcome, String> = execute_with_retry(nodes[0], retry_ctx, retry_policy);
    let retry_ok2: Bool = retry_result2.is_ok();
    print(retry_ok2);

    // Extract outcome from retry_result2 and check status
    let outcome2: Outcome = match retry_result2 {
        Ok(o) => o,
        Err(e) => Outcome(Fail, "", "", e, [], []),
    };
    let outcome2_success: Bool = outcome2.is_success();
    print(outcome2_success);

    return 0;
}
