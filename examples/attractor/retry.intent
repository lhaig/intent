module attractor_retry version "0.1.0";

import "types.intent";
import "handlers.intent";

public function build_retry_policy(node_max_retries: Int, graph_default_max_retry: Int) returns RetryPolicy
    requires graph_default_max_retry >= 0
    ensures result.max_attempts >= 1
{
    let mutable chosen: Int = graph_default_max_retry;
    if node_max_retries > 0 { chosen = node_max_retries; }
    return RetryPolicy(chosen + 1, 200, 2.0, 60000);
}

public function standard_policy() returns RetryPolicy
    ensures result.max_attempts == 5
{
    return RetryPolicy(5, 200, 2.0, 60000);
}

public function aggressive_policy() returns RetryPolicy
{
    return RetryPolicy(5, 500, 2.0, 60000);
}

public function linear_policy() returns RetryPolicy
    ensures result.backoff_factor == 1.0
{
    return RetryPolicy(3, 500, 1.0, 60000);
}

public function patient_policy() returns RetryPolicy
{
    return RetryPolicy(3, 2000, 3.0, 60000);
}

public function no_retry_policy() returns RetryPolicy
    ensures result.max_attempts == 1
{
    return RetryPolicy(1, 0, 1.0, 0);
}

// Calculate delay in ms for a given retry attempt (1-indexed).
// Uses integer doubling since Intent does not support Int*Float mixed arithmetic.
// Exact for standard/aggressive policies (factor=2.0).
public function delay_for_attempt(attempt: Int, policy: RetryPolicy) returns Int
    requires attempt >= 1
    requires policy.max_attempts >= 1
    ensures result >= 0
    ensures result <= policy.max_delay_ms
{
    let mutable delay: Int = policy.initial_delay_ms;
    let mutable i: Int = 1;
    while i < attempt {
        delay = delay * 2;
        i = i + 1;
    }
    if delay > policy.max_delay_ms { delay = policy.max_delay_ms; }
    return delay;
}

public function should_retry(status: StageStatus) returns Bool
{
    let val: Bool = match status { Retry => true, _ => false, };
    return val;
}

public function is_retriable(status: StageStatus, attempt: Int, max_attempts: Int) returns Bool
    requires attempt >= 1
    requires max_attempts >= 1
{
    let retryable: Bool = match status { Retry => true, _ => false, };
    return retryable and attempt < max_attempts;
}

public function goal_gate_satisfied(status: StageStatus) returns Bool
{
    let val: Bool = match status { Success => true, PartialSuccess => true, _ => false, };
    return val;
}

public function max_with_partial(allow_partial: Bool) returns StageStatus
{
    if allow_partial { return PartialSuccess; }
    return Fail;
}

// Execute a handler for a node using trait-based dispatch.
// Uses CodergenHandler for nodes with prompts, StartHandler otherwise.
public function execute_handler(node: NodeAttr, context: PipelineContext) returns Result<Outcome, String>
    requires node.id != ""
{
    if node.prompt != "" {
        let handler: CodergenHandler = CodergenHandler("codergen");
        return handler.execute(node, context);
    }
    let handler: StartHandler = StartHandler("start");
    return handler.execute(node, context);
}

// Execute a node with retry logic per Attractor spec Section 3.5.
// Retries on retriable failures up to policy.max_attempts times.
// Returns Ok(Outcome) with the final outcome (success or fail).
public function execute_with_retry(node: NodeAttr, context: PipelineContext, policy: RetryPolicy) returns Result<Outcome, String>
    requires policy.max_attempts >= 1
{
    let mutable last_outcome_status: StageStatus = Fail;
    for attempt in 1..policy.max_attempts + 1 {
        let handler_result: Result<Outcome, String> = execute_handler(node, context);

        // Check if handler itself errored (not a retriable failure, an actual error)
        let is_error: Bool = handler_result.is_err();
        if is_error {
            // Handler crashed -- if attempts remain, retry; otherwise return fail
            if attempt < policy.max_attempts {
                continue;
            }
            let mutable fail_ids: Array<String> = [];
            let mutable fail_updates: Map<String, String> = [];
            return Ok(Outcome(Fail, "", "all attempts exhausted", "handler error", fail_ids, fail_updates));
        }

        // Extract the outcome from Ok result
        let outcome: Outcome = match handler_result {
            Ok(o) => o,
            Err(e) => Outcome(Fail, "", "", e, [], []),
        };

        // If success, return immediately
        if outcome.is_success() {
            return Ok(outcome);
        }

        // If retriable and attempts remain, continue to next attempt
        last_outcome_status = outcome.status;
        let can_retry: Bool = is_retriable(last_outcome_status, attempt, policy.max_attempts);
        if can_retry {
            continue;
        }

        // Non-retriable failure or final attempt
        return Ok(outcome);
    }

    // All attempts exhausted
    let mutable final_ids: Array<String> = [];
    let mutable final_updates: Map<String, String> = [];
    return Ok(Outcome(Fail, "", "all retry attempts exhausted", "", final_ids, final_updates));
}

intent "Retry policy correctness" {
    goal: "Retry policies enforce Attractor spec Section 3.5-3.6 behavior";
    goal: "Handler execution with retry exhausts attempts before returning failure";
    guarantee: "Backoff delays never exceed max_delay_ms and attempts never exceed max_attempts";
    verified_by: [delay_for_attempt.ensures, build_retry_policy.ensures, is_retriable.requires, execute_with_retry.requires, execute_handler.requires, Handler.execute.requires];
}
