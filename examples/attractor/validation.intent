module attractor_validation version "0.1.0";

import "types.intent";

public function has_exactly_one_start(nodes: Array<NodeAttr>, count: Int) returns Bool
    requires count >= 0
    ensures true
{
    let mutable starts: Int = 0;
    for i in 0..count {
        if nodes[i].is_start() {
            starts = starts + 1;
        }
    }
    return starts == 1;
}

public function has_exactly_one_exit(nodes: Array<NodeAttr>, count: Int) returns Bool
    requires count >= 0
    ensures true
{
    let mutable exits: Int = 0;
    for i in 0..count {
        if nodes[i].is_exit() {
            exits = exits + 1;
        }
    }
    return exits == 1;
}

public function find_start_index(nodes: Array<NodeAttr>, count: Int) returns Int
    requires count >= 0
    ensures result >= -1
    ensures result < count or result == -1
{
    let mutable idx: Int = -1;
    for i in 0..count {
        if nodes[i].is_start() and idx == -1 {
            idx = i;
        }
    }
    return idx;
}

public function find_exit_index(nodes: Array<NodeAttr>, count: Int) returns Int
    requires count >= 0
    ensures result >= -1
    ensures result < count or result == -1
{
    let mutable idx: Int = -1;
    for i in 0..count {
        if nodes[i].is_exit() and idx == -1 {
            idx = i;
        }
    }
    return idx;
}

public function node_exists(nodes: Array<NodeAttr>, count: Int, id: String) returns Bool
    requires count >= 0
    ensures true
{
    for i in 0..count {
        if nodes[i].id == id {
            return true;
        }
    }
    return false;
}

public function start_has_no_incoming(edges: Array<EdgeAttr>, edge_count: Int, start_id: String) returns Bool
    requires edge_count >= 0
    ensures true
{
    let mutable has_incoming: Bool = false;
    for i in 0..edge_count {
        if edges[i].to_node == start_id {
            has_incoming = true;
        }
    }
    return not has_incoming;
}

public function exit_has_no_outgoing(edges: Array<EdgeAttr>, edge_count: Int, exit_id: String) returns Bool
    requires edge_count >= 0
    ensures true
{
    let mutable has_outgoing: Bool = false;
    for i in 0..edge_count {
        if edges[i].from_node == exit_id {
            has_outgoing = true;
        }
    }
    return not has_outgoing;
}

public function all_edge_targets_exist(nodes: Array<NodeAttr>, node_count: Int, edges: Array<EdgeAttr>, edge_count: Int) returns Bool
    requires node_count >= 0
    requires edge_count >= 0
    ensures true
{
    let mutable all_valid: Bool = true;
    for i in 0..edge_count {
        let from_exists: Bool = node_exists(nodes, node_count, edges[i].from_node);
        let to_exists: Bool = node_exists(nodes, node_count, edges[i].to_node);
        if not from_exists or not to_exists {
            all_valid = false;
        }
    }
    return all_valid;
}

public function count_outgoing(edges: Array<EdgeAttr>, edge_count: Int, node_id: String) returns Int
    requires edge_count >= 0
    ensures result >= 0
    ensures result <= edge_count
{
    let mutable count: Int = 0;
    for i in 0..edge_count {
        if edges[i].from_node == node_id {
            count = count + 1;
        }
    }
    return count;
}

public function decision_nodes_valid(nodes: Array<NodeAttr>, node_count: Int, edges: Array<EdgeAttr>, edge_count: Int) returns Bool
    requires node_count >= 0
    requires edge_count >= 0
    ensures true
{
    let mutable all_valid: Bool = true;
    for i in 0..node_count {
        if nodes[i].is_decision() {
            let outgoing: Int = count_outgoing(edges, edge_count, nodes[i].id);
            if outgoing < 2 {
                all_valid = false;
            }
        }
    }
    return all_valid;
}

// Check if a string array contains a target value.
public function string_array_contains(arr: Array<String>, count: Int, target: String) returns Bool
    requires count >= 0
    ensures true
{
    for i in 0..count {
        if arr[i] == target {
            return true;
        }
    }
    return false;
}

// BFS-based reachability check: returns true if all nodes are reachable from start_id.
// Uses Array<String> as both a worklist (queue) and a visited set.
public function all_nodes_reachable(nodes: Array<NodeAttr>, node_count: Int, edges: Array<EdgeAttr>, edge_count: Int, start_id: String) returns Bool
    requires node_count >= 0
    requires edge_count >= 0
    ensures true
{
    // Build worklist starting with start_id.
    let mutable visited: Array<String> = [];
    visited.push(start_id);
    let mutable visited_count: Int = 1;

    // BFS: process each element in visited as a queue.
    // We use a read index to walk through the queue.
    let mutable read_idx: Int = 0;
    while read_idx < visited_count {
        let current: String = visited[read_idx];
        read_idx = read_idx + 1;

        // Find all edges from current node and add unvisited targets.
        for i in 0..edge_count {
            if edges[i].from_node == current {
                let target: String = edges[i].to_node;
                let already: Bool = string_array_contains(visited, visited_count, target);
                if not already {
                    visited.push(target);
                    visited_count = visited_count + 1;
                }
            }
        }
    }

    // Check that every node was visited.
    let mutable all_reached: Bool = true;
    for i in 0..node_count {
        let reached: Bool = string_array_contains(visited, visited_count, nodes[i].id);
        if not reached {
            all_reached = false;
        }
    }
    return all_reached;
}

// Validate the entire graph structure per Attractor spec Section 7.3.
// Returns Ok(true) if all validations pass, or Err(message) on first failure.
public function validate_graph(nodes: Array<NodeAttr>, node_count: Int, edges: Array<EdgeAttr>, edge_count: Int) returns Result<Bool, String>
    requires node_count >= 0
    requires edge_count >= 0
{
    if not has_exactly_one_start(nodes, node_count) {
        return Err("Graph must have exactly one start node");
    }
    if not has_exactly_one_exit(nodes, node_count) {
        return Err("Graph must have exactly one exit node");
    }

    let start_idx: Int = find_start_index(nodes, node_count);
    if start_idx == -1 {
        return Err("Start node not found");
    }
    let exit_idx: Int = find_exit_index(nodes, node_count);
    if exit_idx == -1 {
        return Err("Exit node not found");
    }

    if not start_has_no_incoming(edges, edge_count, nodes[start_idx].id) {
        return Err("Start node must have no incoming edges");
    }
    if not exit_has_no_outgoing(edges, edge_count, nodes[exit_idx].id) {
        return Err("Exit node must have no outgoing edges");
    }
    if not all_edge_targets_exist(nodes, node_count, edges, edge_count) {
        return Err("All edge endpoints must reference existing nodes");
    }
    if not decision_nodes_valid(nodes, node_count, edges, edge_count) {
        return Err("Decision nodes must have at least 2 outgoing edges");
    }
    if not all_nodes_reachable(nodes, node_count, edges, edge_count, nodes[start_idx].id) {
        return Err("All nodes must be reachable from start");
    }

    return Ok(true);
}

// --- Warning lint rules ---

public function retry_target_exists(nodes: Array<NodeAttr>, node_count: Int) returns Array<Diagnostic>
    requires node_count >= 0
    ensures true
{
    let mutable diagnostics: Array<Diagnostic> = [];
    for i in 0..node_count {
        if nodes[i].retry_target != "" {
            let found: Bool = node_exists(nodes, node_count, nodes[i].retry_target);
            if not found {
                diagnostics.push(Diagnostic("retry_target_exists", Warning, "retry_target references unknown node: " + nodes[i].retry_target, nodes[i].id));
            }
        }
    }
    return diagnostics;
}

public function goal_gate_has_retry(nodes: Array<NodeAttr>, node_count: Int) returns Array<Diagnostic>
    requires node_count >= 0
    ensures true
{
    let mutable diagnostics: Array<Diagnostic> = [];
    for i in 0..node_count {
        if nodes[i].goal_gate == true {
            if nodes[i].retry_target == "" {
                diagnostics.push(Diagnostic("goal_gate_has_retry", Warning, "goal_gate node missing retry_target", nodes[i].id));
            }
        }
    }
    return diagnostics;
}

public function prompt_on_llm_nodes(nodes: Array<NodeAttr>, node_count: Int) returns Array<Diagnostic>
    requires node_count >= 0
    ensures true
{
    let mutable diagnostics: Array<Diagnostic> = [];
    for i in 0..node_count {
        if nodes[i].node_type.contains("codegen") {
            if nodes[i].prompt == "" {
                diagnostics.push(Diagnostic("prompt_on_llm_nodes", Warning, "codegen node missing prompt", nodes[i].id));
            }
        }
    }
    return diagnostics;
}

public function type_known(nodes: Array<NodeAttr>, node_count: Int) returns Array<Diagnostic>
    requires node_count >= 0
    ensures true
{
    let mutable diagnostics: Array<Diagnostic> = [];
    for i in 0..node_count {
        let t: String = nodes[i].node_type;
        if t != "" and t != "start" and t != "exit" and t != "codegen" and t != "conditional" and t != "tool" {
            diagnostics.push(Diagnostic("type_known", Warning, "unknown node_type: " + t, nodes[i].id));
        }
    }
    return diagnostics;
}

public function condition_syntax(edges: Array<EdgeAttr>, edge_count: Int) returns Array<Diagnostic>
    requires edge_count >= 0
    ensures true
{
    let mutable diagnostics: Array<Diagnostic> = [];
    for i in 0..edge_count {
        if edges[i].condition != "" {
            if not edges[i].condition.contains("=") {
                diagnostics.push(Diagnostic("condition_syntax", Warning, "condition missing '=' operator: " + edges[i].condition, edges[i].from_node));
            }
        }
    }
    return diagnostics;
}

public function validate_warnings(nodes: Array<NodeAttr>, node_count: Int, edges: Array<EdgeAttr>, edge_count: Int) returns Array<Diagnostic>
    requires node_count >= 0
    requires edge_count >= 0
    ensures true
{
    let mutable all: Array<Diagnostic> = [];

    let r1: Array<Diagnostic> = retry_target_exists(nodes, node_count);
    for i in 0..len(r1) {
        all.push(r1[i]);
    }

    let r2: Array<Diagnostic> = goal_gate_has_retry(nodes, node_count);
    for i in 0..len(r2) {
        all.push(r2[i]);
    }

    let r3: Array<Diagnostic> = prompt_on_llm_nodes(nodes, node_count);
    for i in 0..len(r3) {
        all.push(r3[i]);
    }

    let r4: Array<Diagnostic> = type_known(nodes, node_count);
    for i in 0..len(r4) {
        all.push(r4[i]);
    }

    let r5: Array<Diagnostic> = condition_syntax(edges, edge_count);
    for i in 0..len(r5) {
        all.push(r5[i]);
    }

    return all;
}

intent "Graph validation completeness" {
    goal: "validate_graph checks all structural invariants in a single call";
    guarantee: "Returns Err with descriptive message on first validation failure";
    verified_by: [validate_graph.requires, has_exactly_one_start.ensures, has_exactly_one_exit.ensures];
}

intent "Graph structural integrity" {
    goal: "Validation rules enforce Attractor spec Section 7 invariants";
    guarantee: "No graph with structural errors can pass validation";
    verified_by: [has_exactly_one_start.ensures, has_exactly_one_exit.ensures, find_start_index.ensures, find_exit_index.ensures, all_edge_targets_exist.requires];
}
