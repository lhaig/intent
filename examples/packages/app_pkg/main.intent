module main version "0.1.0";

import types_pkg;

entry function main() returns Int {
    let p1: Point = types_pkg.Point(0.0, 0.0);
    let p2: Point = types_pkg.Point(3.0, 4.0);
    let d: Float = types_pkg.distance_squared(p1, p2);
    print(d);
    let origin_class: Classification = types_pkg.classify(p1);
    let p2_class: Classification = types_pkg.classify(p2);
    print(types_pkg.rank(origin_class));
    print(types_pkg.rank(p2_class));
    let tagged: Labeled<Int> = Labeled<Int>("answer", 42);
    print(tagged.value_of());
    return 0;
}

