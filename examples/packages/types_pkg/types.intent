module types version "0.1.0";

public enum Classification {
    Origin,
    OnAxis,
    General(quadrant: Int),
}

public entity Point {
    field x: Float;
    field y: Float;

    constructor(x: Float, y: Float)
        requires true
        ensures self.x == x
        ensures self.y == y
    {
        self.x = x;
        self.y = y;
    }

    method get_x() returns Float {
        return self.x;
    }

    method get_y() returns Float {
        return self.y;
    }
}

public entity Labeled<T> {
    field name: String;
    field value: T;

    constructor(name: String, value: T) {
        self.name = name;
        self.value = value;
    }

    method value_of() returns T {
        return self.value;
    }
}

public function distance_squared(a: Point, b: Point) returns Float
    requires true
    ensures result >= 0.0
{
    let dx: Float = b.get_x() - a.get_x();
    let dy: Float = b.get_y() - a.get_y();
    return dx * dx + dy * dy;
}

public function classify(p: Point) returns Classification {
    if p.get_x() == 0.0 {
        if p.get_y() == 0.0 {
            return Origin;
        }
        return OnAxis;
    }
    return General(1);
}

public function rank(c: Classification) returns Int {
    return match c {
        Origin => 0,
        OnAxis => 1,
        General(q) => q + 1,
    };
}

test "distance_squared of (0,0) and (3,4) is 25" {
    let p1: Point = Point(0.0, 0.0);
    let p2: Point = Point(3.0, 4.0);
    assert_close(distance_squared(p1, p2), 25.0, 0.0001);
}

test "distance_squared is zero for identical points" {
    let p: Point = Point(2.0, 7.0);
    assert_close(distance_squared(p, p), 0.0, 0.0001);
}

