module result_option version "0.1.0";

function safe_divide(a: Int, b: Int) returns Result<Int, String>
    requires true
    ensures true
{
    if b == 0 {
        return Err("Division by zero");
    }
    return Ok(a / b);
}

function get_element(arr: Array<Int>, index: Int) returns Option<Int>
    requires index >= 0
    ensures true
{
    if index < len(arr) {
        return Some(arr[index]);
    }
    return None;
}

entry function main() returns Int {
    let res: Result<Int, String> = safe_divide(10, 2);
    let value: Int = match res {
        Ok(v) => v,
        Err(e) => 0,
    };
    print(value);
    let nums: Array<Int> = [3, 4, 5];
    let found: Option<Int> = get_element(nums, 1);
    let found_val: Int = match found {
        Some(v) => v,
        None => -1,
    };
    print(found_val);
    return 0;
}

test "safe_divide returns Ok for valid divisor" {
    let r: Result<Int, String> = safe_divide(10, 2);
    let v: Int = match r {
        Ok(x) => x,
        Err(_) => -1,
    };
    assert_eq(v, 5);
}

test "safe_divide returns Err for zero divisor" {
    let r: Result<Int, String> = safe_divide(10, 0);
    let is_err: Bool = match r {
        Ok(_) => false,
        Err(_) => true,
    };
    assert(is_err);
}

test "get_element returns Some for in-bounds index" {
    let nums: Array<Int> = [10, 20, 30];
    let o: Option<Int> = get_element(nums, 1);
    let v: Int = match o {
        Some(x) => x,
        None => -1,
    };
    assert_eq(v, 20);
}

test "get_element returns None for out-of-bounds index" {
    let nums: Array<Int> = [10, 20, 30];
    let o: Option<Int> = get_element(nums, 99);
    let is_none: Bool = match o {
        Some(_) => false,
        None => true,
    };
    assert(is_none);
}

