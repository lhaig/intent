module generic_stack version "0.1.0";

entity Stack<T> {
    field items: Array<T>;
    field count: Int;

    invariant self.count >= 0;

    constructor()
        ensures self.count == 0
    {
        self.items = [];
        self.count = 0;
    }

    method push(item: T) returns Void
        ensures self.count == old(self.count) + 1
    {
        self.items.push(item);
        self.count = self.count + 1;
    }

    method is_empty() returns Bool
        ensures result == true implies self.count == 0
    {
        return self.count == 0;
    }
}

entry function main() returns Int {
    let mutable int_stack: Stack<Int> = Stack<Int>();
    int_stack.push(10);
    int_stack.push(20);
    print(int_stack.count);
    let mutable str_stack: Stack<String> = Stack<String>();
    str_stack.push("hello");
    print(str_stack.is_empty());
    return 0;
}

test "new Stack is empty" {
    let mutable s: Stack<Int> = Stack<Int>();
    assert(s.is_empty());
    assert_eq(s.count, 0);
}

test "push increments count" {
    let mutable s: Stack<Int> = Stack<Int>();
    s.push(1);
    s.push(2);
    s.push(3);
    assert_eq(s.count, 3);
    assert(not s.is_empty());
}

test "Stack<String> is a distinct monomorphization" {
    let mutable s: Stack<String> = Stack<String>();
    s.push("hello");
    s.push("world");
    assert_eq(s.count, 2);
}

