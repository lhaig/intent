module fibonacci version "1.0.0";

function fib(n: Int) returns Int
    requires n >= 0
    ensures result >= 0
{
    if n <= 0 {
        return 0;
    }
    if n == 1 {
        return 1;
    }
    let mutable a: Int = 0;
    let mutable b: Int = 1;
    let mutable i: Int = 2;
    while i <= n {
        let temp: Int = a + b;
        a = b;
        b = temp;
        i = i + 1;
    }
    return b;
}

entry function main() returns Int {
    let res: Int = fib(10);
    print(res);
    return 0;
}

test "fib(0) is 0 and fib(1) is 1" {
    assert_eq(fib(0), 0);
    assert_eq(fib(1), 1);
}

test "fib(10) is 55" {
    assert_eq(fib(10), 55);
}

test "fib is non-negative across the contract range" {
    let mutable n: Int = 0;
    while n <= 15 {
        assert(fib(n) >= 0);
        n = n + 1;
    }
}

