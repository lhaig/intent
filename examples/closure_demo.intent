module closure_demo version "0.1.0";

function apply(x: Int, f: Fn(Int) -> Int) returns Int {
    return f(x);
}

function apply_to_pair(a: Int, b: Int, f: Fn(Int, Int) -> Int) returns Int {
    return f(a, b);
}

entry function main() returns Int {
    let double: Fn(Int) -> Int = |x: Int| -> Int => x * 2;
    let val1: Int = apply(5, double);
    print(val1);
    let sum: Fn(Int, Int) -> Int = |a: Int, b: Int| -> Int => a + b;
    let val2: Int = apply_to_pair(3, 7, sum);
    print(val2);
    return 0;
}

test "apply invokes a 1-arg closure" {
    let double: Fn(Int) -> Int = |x: Int| -> Int => x * 2;
    assert_eq(apply(5, double), 10);
}

test "apply_to_pair invokes a 2-arg closure" {
    let add: Fn(Int, Int) -> Int = |a: Int, b: Int| -> Int => a + b;
    assert_eq(apply_to_pair(3, 7, add), 10);
}

