module async_demo version "0.1.0";

async function delayed_add(a: Int, b: Int) returns Int
    requires a >= 0
    requires b >= 0
    ensures result == a + b
{
    await sleep(100);
    return a + b;
}

async entry function main() returns Int {
    let f1: Future<Int> = spawn delayed_add(3, 4);
    let f2: Future<Int> = spawn delayed_add(10, 20);
    let r1: Int = await f1;
    let r2: Int = await f2;
    print(r1);
    print(r2);
    return 0;
}

async test "delayed_add resolves to the sum" {
    let f: Future<Int> = spawn delayed_add(3, 4);
    let r: Int = await f;
    assert_eq(r, 7);
}

async test "two spawned futures complete independently" {
    let f1: Future<Int> = spawn delayed_add(10, 20);
    let f2: Future<Int> = spawn delayed_add(100, 200);
    let r1: Int = await f1;
    let r2: Int = await f2;
    assert_eq(r1, 30);
    assert_eq(r2, 300);
}

