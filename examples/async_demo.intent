module async_demo version "0.1.0";

async function delayed_add(a: Int, b: Int) returns Int
    requires a >= 0
    requires b >= 0
    ensures result == a + b
{
    await sleep(100);
    return a + b;
}

async entry function main() returns Int {
    let f1: Future<Int> = spawn delayed_add(3, 4);
    let f2: Future<Int> = spawn delayed_add(10, 20);
    let r1: Int = await f1;
    let r2: Int = await f2;
    print(r1);
    print(r2);
    return 0;
}

