{
  "name": "intent-vscode",
  "displayName": "Intent",
  "description": "Language support for the Intent contract-based programming language",
  "version": "0.1.0",
  "publisher": "intent-lang",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "repository": {
    "type": "git",
    "url": "https://github.com/lhaig/intent.git",
    "directory": "editors/vscode"
  },
  "activationEvents": ["onLanguage:intent"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "intent",
        "aliases": ["Intent"],
        "extensions": [".intent"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "intent",
        "scopeName": "source.intent",
        "path": "./syntaxes/intent.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "intent.restartServer",
        "title": "Intent: Restart Server",
        "category": "Intent"
      },
      {
        "command": "intent.showOutput",
        "title": "Intent: Show Output",
        "category": "Intent"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Intent",
      "properties": {
        "intent.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Override the path to the intentc binary. Defaults to looking up 'intentc' on PATH."
        },
        "intent.lsp.trace": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Enables LSP protocol tracing. 'messages' logs method names; 'verbose' includes payloads."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p ./ --noEmit",
    "compile": "node esbuild.js",
    "compile:dev": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "node esbuild.js --production",
    "package": "node esbuild.js --production && vsce package --no-yarn"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
